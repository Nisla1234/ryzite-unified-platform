{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "name": "ryzite-unified-platform",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "171bc7ca8a0a4dfb9a3ff7caccb3892c",
      "preview_id": "171bc7ca8a0a4dfb9a3ff7caccb3892c"
    }
  ],
  "observability": {
    "enabled": true
  }
}

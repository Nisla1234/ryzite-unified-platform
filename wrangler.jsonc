{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "ryzite",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "d05dc99fb00945048f7a80de2da0e726"
		}
	],
	"observability": {
		"enabled": true
	}
}
---
import { homeSectionsTranslations } from '../../data/home-sections-translations';

const copy = homeSectionsTranslations.en.branding;
const icons = [
  'M12 3 4 7v10l8 4 8-4V7z M12 3v18 M4 7l8 4 8-4',
  'M12 3a9 9 0 1 0 0 18c1.1 0 1.5-.8 1.5-1.6 0-1.3-1-1.4-1-2.6 0-.9.7-1.6 1.6-1.6H16a5 5 0 0 0 5-5c0-4-4-7.2-9-7.2z M7.5 11h.01 M10.5 7.5h.01 M15 7.5h.01',
  'M4 20 9.5 5h1L16 20 M6.5 14h7 M17 20v-7 M17 13a3 3 0 1 1 3 3h-3',
  'M3 5h18v14H3z M3 15l5-5 4 4 3-3 6 6 M15.5 9h.01',
  'M4 12a8 8 0 0 1 14-5.3L20 9 M20 4v5h-5 M20 12a8 8 0 0 1-14 5.3L4 15 M4 20v-5h5',
];
---

<section class="hs-section hs-section--pale branding" aria-labelledby="branding-title">
  <div class="hs-shell branding-layout">
    <div class="branding-copy" data-hs-reveal>
      <div class="hs-heading hs-heading--start">
        <h2 id="branding-title" data-home-key="sections.branding.title">{copy.title}</h2>
        <p data-home-key="sections.branding.body">{copy.body}</p>
      </div>
      <ul class="branding-highlights">
        {copy.highlights.map((highlight, index) => (
          <li>
            <span class="hs-icon branding-highlights__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icons[index]} /></svg>
            </span>
            <span data-home-key={`sections.branding.highlights.${index}`}>{highlight}</span>
          </li>
        ))}
      </ul>
      <a class="hs-button branding-cta" href="/services/branding-and-logo-design">
        <span data-home-key="sections.branding.cta">{copy.cta}</span> <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="branding-board" data-hs-reveal="branding" data-hs-delay="0.15" aria-hidden="true">
      <svg viewBox="0 0 520 440" fill="none">
        <defs>
          <linearGradient id="brand-mark" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#078be9" /><stop offset="1" stop-color="#0643cf" /></linearGradient>
          <filter id="brand-shadow" x="-20%" y="-20%" width="140%" height="150%"><feDropShadow dx="0" dy="10" stdDeviation="12" flood-color="#0655e9" flood-opacity=".14" /></filter>
        </defs>

        <rect x="20" y="20" width="480" height="400" rx="34" fill="#fff" filter="url(#brand-shadow)" />
        <path d="M20 120h480" stroke="#eef3fc" stroke-width="2" />

        <g data-brand-part>
          <rect x="52" y="52" width="160" height="150" rx="24" fill="url(#brand-mark)" />
          <circle cx="132" cy="127" r="46" stroke="#fff" stroke-opacity=".35" stroke-width="2" />
          <path d="M112 152v-52h24a15 15 0 0 1 0 30h-24m22 0 18 22" stroke="#fff" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" />
        </g>

        <g data-brand-part>
          <text x="246" y="112" fill="#0a1734" font-family="Fira Sans, sans-serif" font-size="64" font-weight="700">Aa</text>
          <rect x="248" y="134" width="150" height="10" rx="5" fill="#0a1734" />
          <rect x="248" y="154" width="210" height="8" rx="4" fill="#c9d7ee" />
          <rect x="248" y="170" width="180" height="8" rx="4" fill="#c9d7ee" />
          <rect x="248" y="186" width="120" height="8" rx="4" fill="#c9d7ee" />
        </g>

        <g data-brand-part>
          <rect x="52" y="232" width="78" height="78" rx="18" fill="#0655e9" />
          <rect x="140" y="232" width="78" height="78" rx="18" fill="#0643cf" />
          <rect x="228" y="232" width="78" height="78" rx="18" fill="#078be9" />
          <rect x="316" y="232" width="78" height="78" rx="18" fill="#e3eeff" />
          <rect x="404" y="232" width="64" height="78" rx="18" fill="#fff" stroke="#dce7fb" stroke-width="2" />
        </g>

        <g data-brand-part data-brand-float>
          <rect x="52" y="336" width="196" height="56" rx="14" fill="#f3f7ff" stroke="#dce7fb" stroke-width="2" />
          <rect x="66" y="350" width="28" height="28" rx="8" fill="url(#brand-mark)" />
          <rect x="106" y="354" width="90" height="8" rx="4" fill="#0a1734" />
          <rect x="106" y="368" width="120" height="6" rx="3" fill="#c9d7ee" />
        </g>

        <g data-brand-part data-brand-float>
          <rect x="272" y="336" width="196" height="56" rx="14" fill="#0655e9" />
          <circle cx="300" cy="364" r="13" stroke="#fff" stroke-width="3" />
          <rect x="324" y="354" width="96" height="8" rx="4" fill="#fff" />
          <rect x="324" y="368" width="70" height="6" rx="3" fill="#fff" fill-opacity=".55" />
        </g>
      </svg>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { onHomeReveal, prefersReducedMotion } from '../../scripts/home-reveal';

  onHomeReveal('branding', (board) => {
    if (prefersReducedMotion()) return;
    const parts = board.querySelectorAll('[data-brand-part]');
    gsap.from(parts, { autoAlpha: 0, y: 16, scale: .96, transformOrigin: '50% 50%', duration: .6, ease: 'power3.out', stagger: .12, delay: .25 });
    gsap.to(board.querySelectorAll('[data-brand-float]'), { y: -5, duration: 2.6, ease: 'sine.inOut', yoyo: true, repeat: -1, stagger: .6, delay: 1.2 });
  });
</script>

<style>
  .branding::after { content: ''; position: absolute; z-index: -1; top: -30%; right: -18%; width: 640px; height: 640px; border-radius: 42%; background: linear-gradient(135deg, #c9dcff80, #eef5ff40); rotate: 30deg; pointer-events: none; }
  .branding-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); align-items: center; gap: clamp(2rem, 6vw, 5rem); }
  .branding-copy .hs-heading { margin-bottom: 1.75rem; }
  .branding-highlights { display: grid; gap: .75rem; margin: 0 0 2rem; padding: 0; list-style: none; }
  .branding-highlights li { display: flex; align-items: center; gap: .9rem; color: var(--hs-ink); font-size: var(--size-body); font-weight: 600; line-height: 1.4; }
  .branding-highlights__icon { width: 2.6rem; height: 2.6rem; border-radius: .8rem; }
  .branding-highlights__icon svg { width: 1.3rem; height: 1.3rem; }
  .branding-board svg { display: block; width: 100%; height: auto; }
  @media (max-width: 900px) {
    .branding-layout { grid-template-columns: 1fr; }
    .branding-board { order: -1; max-width: 560px; margin-inline: auto; width: 100%; }
  }
  @media (max-width: 700px) { .branding-cta { margin-inline: auto; display: flex; } }
</style>

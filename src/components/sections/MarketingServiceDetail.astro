---
import ArrowUpRight from '../ui/ArrowUpRight.astro';
import WindingRoad from './WindingRoad.astro';
import RelatedArrowCards from '../ui/RelatedArrowCards.astro';
import { serviceIcons, benefitIcons } from '../../data/detail-icons';
import MainLayout from '../../layouts/MainLayout.astro';
import { marketingServices } from '../../data/marketing-service-content';
import { marketingServicePhotos, marketingServicePhotoSrc } from '../../data/marketing-service-photos';
import { marketingServiceTranslations } from '../../data/marketing-service-translations';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const service = marketingServices.find((item) => item.slug === slug);

if (!service) {
  throw new Error(`Unknown Marketing Service slug "${slug}".`);
}

const copy = marketingServiceTranslations.en;
const translatedService = copy.services[service.slug];
const relatedServices = service.related.map((relatedSlug) => {
  const related = marketingServices.find((item) => item.slug === relatedSlug);
  if (!related) throw new Error(`Related Marketing Service "${relatedSlug}" could not be found.`);
  return related;
});
const heroPhoto = marketingServicePhotos[service.slug];
const pageTitle = `${translatedService.title} | Marketing Services | RYZITE`;
const pageDescription = `${translatedService.description} Explore possible ${translatedService.focus} approaches with RYZITE.`;
const canonicalUrl = new URL(`/services/${service.slug}/`, Astro.url).href;
const contactUrl = `/contact/?service=${encodeURIComponent(service.slug)}`;
const detailTranslations = Object.fromEntries(
  Object.entries(marketingServiceTranslations).map(([locale, translation]) => [
    locale,
    {
      detailLabel: translation.detailLabel,
      backToServices: translation.backToServices,
      detailHeading: translation.detailHeading,
      detailSupporting: translation.detailSupporting,
      challengesTitle: translation.challengesTitle,
      challengesEyebrow: translation.challengesEyebrow,
      challengesIntro: translation.challengesIntro,
      challengeTemplates: translation.challengeTemplates,
      providesEyebrow: translation.providesEyebrow,
      providesTitle: translation.providesTitle,
      scopeDisclaimer: translation.scopeDisclaimer,
      proposedScope: translation.proposedScope,
      capabilitiesTitle: translation.capabilitiesTitle,
      benefitsTitle: translation.benefitsTitle,
      benefitsEyebrow: translation.benefitsEyebrow,
      benefitTemplates: translation.benefitTemplates,
      approachTitle: translation.approachTitle,
      approachEyebrow: translation.approachEyebrow,
      approachIntro: translation.approachIntro,
      approachSteps: translation.approachSteps,
      relatedTitle: translation.relatedTitle,
      relatedEyebrow: translation.relatedEyebrow,
      detailFaqTitle: translation.detailFaqTitle,
      detailFaqs: translation.detailFaqs,
      contactCtaTitle: translation.contactCtaTitle,
      contactCtaEyebrow: translation.contactCtaEyebrow,
      contactCtaDescription: translation.contactCtaDescription,
      contactCta: translation.contactCta,
      service: translation.services[service.slug],
      relatedServices: Object.fromEntries(relatedServices.map((related) => [
        related.slug,
        { title: translation.services[related.slug].title },
      ])),
    },
  ]),
);
---

<MainLayout title={pageTitle} description={pageDescription} openGraph={true} canonicalUrl={canonicalUrl}>
  <div class="marketing-detail" data-marketing-detail-slug={service.slug}>
    <section class="marketing-detail-hero" aria-labelledby="marketing-detail-title">
      <div class="marketing-detail-hero__glow" aria-hidden="true"></div>
      <div class="marketing-shell marketing-detail-hero__inner">
        <div class="marketing-detail-hero__copy">
          <a class="marketing-detail-back" href="/services/"><span aria-hidden="true">←</span><span data-marketing-key="backToServices">{copy.backToServices}</span></a>
          <h1 id="marketing-detail-title" data-marketing-service-field="title">{translatedService.title}</h1>
          <h2 class="marketing-detail-hero__subheading" data-marketing-template-key="detailHeading">{copy.detailHeading.replace('{focus}', translatedService.focus)}</h2>
          <p class="marketing-detail-hero__description" data-marketing-service-field="description">{translatedService.description}</p>
          <p class="marketing-detail-hero__supporting" data-marketing-template-key="detailSupporting">{copy.detailSupporting}</p>
          <a class="marketing-button marketing-button--primary" href={contactUrl}>
            <span data-marketing-key="contactCta">{copy.contactCta}</span><span aria-hidden="true"><ArrowUpRight /></span>
          </a>
        </div>
        {heroPhoto ? (
          <div class="marketing-detail-hero__frame">
            <span class="marketing-detail-hero__blob marketing-detail-hero__blob--one" aria-hidden="true"></span>
            <span class="marketing-detail-hero__blob marketing-detail-hero__blob--two" aria-hidden="true"></span>
            <figure class="marketing-detail-hero__photo">
              <img src={marketingServicePhotoSrc(service.slug)} alt="" width={heroPhoto.width} height={heroPhoto.height} fetchpriority="high" decoding="async" />
            </figure>
          </div>
        ) : (
          <div class="marketing-detail-hero__visual" aria-hidden="true">
          <div class="marketing-detail-hero__orbit marketing-detail-hero__orbit--one"></div>
          <div class="marketing-detail-hero__orbit marketing-detail-hero__orbit--two"></div>
          <div class="marketing-detail-hero__symbol">{service.icon === "\u2197" ? <ArrowUpRight /> : service.icon}</div>
          <span class="marketing-detail-hero__spark marketing-detail-hero__spark--one">✳</span>
          <span class="marketing-detail-hero__spark marketing-detail-hero__spark--two">✦</span>
          <span class="marketing-detail-hero__index">{String(marketingServices.findIndex(({ slug: itemSlug }) => itemSlug === service.slug) + 1).padStart(2, '0')} / {String(marketingServices.length).padStart(2, '0')}</span>
          </div>
        )}
      </div>
    </section>

    <section class="marketing-detail-section marketing-challenge-section" aria-labelledby="marketing-challenges-title">
      <div class="marketing-shell marketing-detail-split">
        <header class="marketing-detail-heading" data-marketing-reveal>
          <h2 id="marketing-challenges-title" data-marketing-key="challengesTitle">{copy.challengesTitle}</h2>
          <p class="marketing-detail-lead" data-marketing-template-key="challengesIntro">{copy.challengesIntro.replace('{focus}', translatedService.focus)}</p>
        </header>
        <ul class="marketing-detail-numbered-list">
          {copy.challengeTemplates.map((template, index) => (
            <li data-marketing-reveal>
              <span class="marketing-detail-number">0{index + 1}</span>
              <p data-marketing-template-array="challengeTemplates" data-marketing-index={index}>{template.replace('{focus}', translatedService.focus)}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="marketing-detail-section marketing-provides-section" aria-labelledby="marketing-provides-title">
      {heroPhoto && (
        <div class="marketing-provides-backdrop" aria-hidden="true">
          <img src={marketingServicePhotoSrc(service.slug)} alt="" width={heroPhoto.width} height={heroPhoto.height} loading="lazy" decoding="async" />
        </div>
      )}
      <div class="marketing-shell marketing-provides-layout">
        <div class="marketing-provides-mark" aria-hidden="true">
          {serviceIcons[service.slug]
            ? <svg class="provides-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false" set:html={serviceIcons[service.slug]} />
            : service.icon === "\u2197" ? <ArrowUpRight /> : service.icon}
        </div>
        <div class="marketing-provides-glass" data-marketing-reveal>
          <h2 id="marketing-provides-title" data-marketing-key="providesTitle">{copy.providesTitle}</h2>
          <p class="marketing-provides-copy" data-marketing-template-key="detailSupporting">{copy.detailSupporting}</p>
          <p class="marketing-proposed-note" data-marketing-key="scopeDisclaimer">{copy.scopeDisclaimer}</p>
        </div>
      </div>
    </section>

    <section class="marketing-detail-section marketing-capabilities-section" aria-labelledby="marketing-capabilities-title">
      <div class="marketing-shell">
        <header class="marketing-detail-heading marketing-detail-heading--center" data-marketing-reveal>
          <h2 id="marketing-capabilities-title" data-marketing-key="capabilitiesTitle">{copy.capabilitiesTitle}</h2>
        </header>
        <div class="marketing-capability-grid">
          {translatedService.capabilities.map((capability, index) => (
            <article class="marketing-capability-card" data-marketing-reveal>
              <h3 data-marketing-capability-field="title" data-marketing-capability-index={index}>{capability.title}</h3>
              <p data-marketing-capability-field="description" data-marketing-capability-index={index}>{capability.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="marketing-detail-section marketing-benefits-section" aria-labelledby="marketing-benefits-title">
      <div class="marketing-shell">
        <header class="marketing-detail-heading marketing-detail-heading--center" data-marketing-reveal>
          <h2 id="marketing-benefits-title" data-marketing-key="benefitsTitle">{copy.benefitsTitle}</h2>
        </header>
        <ul class="marketing-benefit-grid">
          {copy.benefitTemplates.map((template, index) => (
            <li class="marketing-benefit-card" data-marketing-reveal>
              <svg class="marketing-benefit-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={benefitIcons[index % benefitIcons.length]} />
              <p data-marketing-template-array="benefitTemplates" data-marketing-index={index}>{template.replace('{focus}', translatedService.focus)}</p>
              <span class="marketing-benefit-card__dome" aria-hidden="true"><span>{String(index + 1).padStart(2, '0')}</span></span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="marketing-detail-section marketing-approach-section" aria-labelledby="marketing-approach-title">
      <div class="marketing-shell">
        <header class="marketing-detail-heading marketing-detail-heading--center" data-marketing-reveal>
          <h2 id="marketing-approach-title" data-marketing-key="approachTitle">{copy.approachTitle}</h2>
          <p class="marketing-detail-lead" data-marketing-key="approachIntro">{copy.approachIntro}</p>
        </header>
        <WindingRoad steps={copy.approachSteps.map((step, index) => ({
          title: step.title,
          body: step.body.replace('{focus}', translatedService.focus),
          itemAttrs: { 'data-marketing-approach-step': index, 'data-marketing-reveal': true },
          titleAttrs: { 'data-marketing-approach-field': 'title', 'data-marketing-index': index },
          bodyAttrs: { 'data-marketing-approach-field': 'body', 'data-marketing-index': index },
        }))} />
      </div>
    </section>

    <section class="marketing-detail-section marketing-related-section" aria-labelledby="marketing-related-title">
      <div class="marketing-shell">
        <header class="marketing-detail-heading" data-marketing-reveal>
          <h2 id="marketing-related-title" data-marketing-key="relatedTitle">{copy.relatedTitle}</h2>
        </header>
        <RelatedArrowCards items={relatedServices.map((related) => ({
          href: `/services/${related.slug}/`,
          title: copy.services[related.slug].title,
          icon: serviceIcons[related.slug],
          attrs: { 'data-marketing-related-slug': related.slug, 'data-marketing-reveal': true },
        }))} />
      </div>
    </section>

    <section class="marketing-detail-section marketing-detail-faq-section" aria-labelledby="marketing-detail-faq-title">
      <div class="marketing-shell marketing-detail-faq-layout">
        <header class="marketing-detail-heading" data-marketing-reveal>
          <h2 id="marketing-detail-faq-title" data-marketing-key="detailFaqTitle">{copy.detailFaqTitle}</h2>
        </header>
        <div class="marketing-detail-faq-list" data-marketing-reveal>
          {copy.detailFaqs.map((faq, index) => (
            <details class="marketing-detail-faq-item">
              <summary data-marketing-detail-faq-field="question" data-marketing-index={index}>{faq.question.replaceAll('{title}', translatedService.title)}</summary>
              <div class="marketing-detail-faq-item__answer">
                <p data-marketing-detail-faq-field="answer" data-marketing-index={index}>{faq.answer.replaceAll('{title}', translatedService.title)}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </div>
</MainLayout>

<script is:inline define:vars={{ marketingServiceTranslations: detailTranslations, serviceSlug: service.slug }}>
  const substituteMarketingText = (template, values) => template.replace(/\{(\w+)\}/g, (_, key) => values[key] || '');

  const applyMarketingDetailLocale = (locale) => {
    const copy = marketingServiceTranslations[locale] || marketingServiceTranslations.en;
    const service = copy.service;
    const values = { focus: service.focus, title: service.title };
    document.querySelectorAll('.marketing-detail [data-marketing-key]').forEach((element) => {
      const value = copy[element.dataset.marketingKey];
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('.marketing-detail [data-marketing-service-field]').forEach((element) => {
      const value = service[element.dataset.marketingServiceField];
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('.marketing-detail [data-marketing-template-key]').forEach((element) => {
      const template = copy[element.dataset.marketingTemplateKey];
      if (typeof template === 'string') element.textContent = substituteMarketingText(template, { ...values, description: service.description });
    });
    document.querySelectorAll('.marketing-detail [data-marketing-template-array]').forEach((element) => {
      const template = copy[element.dataset.marketingTemplateArray]?.[Number(element.dataset.marketingIndex)];
      if (typeof template === 'string') element.textContent = substituteMarketingText(template, values);
    });
    document.querySelectorAll('.marketing-detail [data-marketing-capability-field]').forEach((element) => {
      const capability = service.capabilities[Number(element.dataset.marketingCapabilityIndex)];
      const value = capability?.[element.dataset.marketingCapabilityField];
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('.marketing-detail [data-marketing-approach-field]').forEach((element) => {
      const step = copy.approachSteps[Number(element.dataset.marketingIndex)];
      const value = step?.[element.dataset.marketingApproachField];
      if (typeof value === 'string') element.textContent = substituteMarketingText(value, values);
    });
    document.querySelectorAll('.marketing-detail [data-marketing-related-slug]').forEach((element) => {
      const related = copy.relatedServices[element.dataset.marketingRelatedSlug];
      const title = element.querySelector('.arrow-card__title');
      if (related && title) title.textContent = related.title;
    });
    document.querySelectorAll('.marketing-detail [data-marketing-detail-faq-field]').forEach((element) => {
      const faq = copy.detailFaqs[Number(element.dataset.marketingIndex)];
      const value = faq?.[element.dataset.marketingDetailFaqField];
      if (typeof value === 'string') element.textContent = substituteMarketingText(value, values);
    });

    const pageTitle = `${service.title} | Marketing Services | RYZITE`;
    const pageDescription = `${service.description} Explore possible ${service.focus} approaches with RYZITE.`;
    const description = document.querySelector('meta[name="description"]');
    if (description) description.setAttribute('content', pageDescription);
    const openGraphTitle = document.querySelector('meta[property="og:title"]');
    if (openGraphTitle) openGraphTitle.setAttribute('content', pageTitle);
    const openGraphDescription = document.querySelector('meta[property="og:description"]');
    if (openGraphDescription) openGraphDescription.setAttribute('content', pageDescription);
  };

  applyMarketingDetailLocale(document.body.dataset.locale || 'en');
  window.addEventListener('ryzite:locale-change', (event) => applyMarketingDetailLocale(event.detail?.locale || 'en'));
</script>

<script>
  import { gsap } from 'gsap';

  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!motionPreference.matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        gsap.fromTo(entry.target, { autoAlpha: 0, y: 18 }, {
          autoAlpha: 1,
          y: 0,
          duration: 0.6,
          ease: 'power2.out',
          // Clear only what GSAP set: 'all' would wipe the inline style, including the
          // winding-road steps' --col / --pin-y placement variables.
          clearProps: 'opacity,visibility,transform',
        });
        currentObserver.unobserve(entry.target);
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.marketing-detail [data-marketing-reveal]').forEach((element) => observer.observe(element));

    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  }
</script>

<style>
  .marketing-detail { --marketing-blue: var(--color-brand); --marketing-deep: var(--color-brand); --marketing-ink: var(--color-heading); --marketing-muted: var(--color-body); color: var(--marketing-ink); background: var(--color-paper); }
  .marketing-detail *, .marketing-detail *::before, .marketing-detail *::after { box-sizing: border-box; }
  .marketing-shell { width: min(100%, var(--content-max)); margin-inline: auto; padding-inline: var(--space-frame); }
  .marketing-detail-hero { position: relative; isolation: isolate; overflow: hidden; padding: clamp(4rem, 7vw, 6.5rem) var(--space-frame); background: linear-gradient(118deg, var(--color-paper), var(--color-milk-highlight) 64%, var(--color-milk)); }
  .marketing-detail-hero__inner { display: grid; min-height: 490px; grid-template-columns: minmax(0, 1fr) minmax(270px, .7fr); align-items: center; gap: clamp(2rem, 6vw, 6rem); }
  .marketing-detail-hero__copy { position: relative; z-index: 1; max-width: 800px; }
  .marketing-detail-back { display: inline-flex; min-height: 2.75rem; align-items: center; gap: .55rem; margin-bottom: 1.4rem; color: #52647b; font-size: .902rem; font-weight: 600; text-decoration: none; }
  .marketing-detail-back:hover { color: var(--marketing-blue); }
  .marketing-detail-back:focus-visible { outline: 3px solid var(--marketing-blue); outline-offset: 4px; }
  .marketing-detail .marketing-eyebrow { display: flex; align-items: center; gap: .65rem; margin: 0 0 1rem; color: var(--marketing-blue); font-size: var(--size-eyebrow); font-weight: 600; letter-spacing: .15em; line-height: 1.5; text-transform: uppercase; }
  .marketing-detail .marketing-eyebrow::before { width: 1.5rem; height: 2px; flex: 0 0 auto; border-radius: 2px; background: currentColor; content: ''; }
  .marketing-detail-hero h1 { max-width: var(--measure-h1); margin: 0; color: #101827; font-family: var(--font-display); font-size: var(--size-h1); font-weight: 700; letter-spacing: var(--tracking-h1); line-height: var(--leading-h1); overflow-wrap: anywhere; }
  .marketing-detail-hero__subheading { max-width: 700px; margin: 1.1rem 0 0; color: #1c385d; font-family: var(--font-display); font-size: var(--size-h3); font-weight: 700; line-height: var(--leading-h3); }
  .marketing-detail-hero__description, .marketing-detail-hero__supporting { max-width: 680px; margin: 1rem 0 0; color: var(--marketing-muted); font-size: var(--size-lead); line-height: 1.75; }
  .marketing-detail-hero__supporting { margin-top: .65rem; font-size: 1.056rem; }
  .marketing-detail .marketing-button { display: inline-flex; min-height: 3.1rem; align-items: center; justify-content: center; gap: 1rem; margin-top: 1.6rem; padding: .78rem 1.2rem; border: 1px solid transparent; border-radius: 999px; font-size: .99rem; font-weight: 600; text-align: center; text-decoration: none; transition: transform 180ms var(--ease-out), background 180ms ease, box-shadow 180ms ease; }
  .marketing-detail .marketing-button:hover { transform: translateY(-3px); }
  .marketing-detail .marketing-button:focus-visible { outline: 3px solid var(--marketing-blue); outline-offset: 4px; }
  .marketing-button--primary { color: #fff; background: var(--color-brand); box-shadow: 0 .7rem 1.5rem #0b1c5830; }
  .marketing-button--primary:hover { background: var(--color-brand-hover); }
  .marketing-detail-hero__frame { position: relative; isolation: isolate; width: min(100%, 460px); justify-self: center; }
  .marketing-detail-hero__blob { position: absolute; z-index: -1; border-radius: 50%; filter: blur(8px); pointer-events: none; }
  .marketing-detail-hero__blob--one { top: -8%; right: -6%; width: 46%; aspect-ratio: 1; background: radial-gradient(circle at 35% 35%, #078be9, #0655e9 70%); opacity: .75; }
  .marketing-detail-hero__blob--two { bottom: -10%; left: -8%; width: 38%; aspect-ratio: 1; background: radial-gradient(circle at 60% 40%, #8cc8ff, #0643cf 75%); opacity: .6; }
  .marketing-detail-hero__photo { position: relative; margin: 0; padding: .85rem; border: 1px solid rgb(255 255 255 / 65%); border-radius: 2rem; background: linear-gradient(145deg, rgb(255 255 255 / 55%), rgb(255 255 255 / 18%)); box-shadow: inset 0 1px 0 rgb(255 255 255 / 80%), 0 1.6rem 3.6rem rgb(23 59 113 / 18%); backdrop-filter: blur(18px) saturate(150%); -webkit-backdrop-filter: blur(18px) saturate(150%); }
  .marketing-detail-hero__photo img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 1.4rem; }
  .marketing-detail-hero__visual { position: relative; display: grid; width: min(100%, 400px); aspect-ratio: 1; place-items: center; justify-self: center; overflow: hidden; border: 1px solid #d5e5f8; border-radius: 2.2rem; background: radial-gradient(circle at center, var(--color-milk) 0 22%, #eef6ff 23% 66%, #e1efff 67%); box-shadow: inset 0 0 0 1rem #ffffff50, 0 1.5rem 3.5rem #173b7110; }
  .marketing-detail-hero__visual::before { position: absolute; inset: 12%; border: 1px solid #8cb9ee80; border-radius: 50%; background-image: linear-gradient(#0b1c5814 1px, transparent 1px), linear-gradient(90deg, #0b1c5814 1px, transparent 1px); background-size: 16% 16%; content: ''; mask-image: radial-gradient(circle, #000 0 68%, transparent 69%); }
  .marketing-detail-hero__symbol { position: relative; z-index: 1; display: grid; width: 34%; aspect-ratio: 1; place-items: center; border: 1px solid #ffffffa0; border-radius: 1.5rem; color: #fff; background: var(--color-brand); box-shadow: 0 1.2rem 2.7rem #0b1c583b; font-family: var(--font-display); font-size: clamp(2.2rem, 4.4vw, 3.3rem); font-weight: 700; }
  .marketing-detail-hero__orbit { position: absolute; inset: 7%; border: 1px solid #0b1c582e; border-radius: 50%; }
  .marketing-detail-hero__orbit--two { inset: 22%; border-style: dashed; border-color: #0b1c5855; }
  .marketing-detail-hero__spark { position: absolute; color: var(--marketing-blue); }
  .marketing-detail-hero__spark--one { top: 15%; right: 22%; }
  .marketing-detail-hero__spark--two { bottom: 16%; left: 19%; }
  .marketing-detail-hero__index { position: absolute; right: 1.2rem; bottom: 1rem; color: #617794; font-size: .8125rem; font-weight: 600; letter-spacing: .13em; }
  .marketing-detail-hero__glow { position: absolute; z-index: -1; top: -38%; right: 5%; width: min(40vw, 560px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, #0b1c5828, transparent 68%); }
  .marketing-detail-section { padding-block: clamp(4.5rem, 8vw, 7rem); }
  .marketing-detail-split { display: grid; grid-template-columns: minmax(250px, .75fr) minmax(0, 1.25fr); align-items: start; gap: clamp(2rem, 7vw, 7rem); }
  .marketing-challenge-section { background: var(--color-milk); }
  .marketing-detail-heading h2 { max-width: var(--measure-h2); margin: 0; color: #111d30; font-family: var(--font-display); font-size: var(--size-h2); font-weight: 700; letter-spacing: var(--tracking-h2); line-height: var(--leading-h2); }
  .marketing-detail-heading--center { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .marketing-detail-heading--center .marketing-eyebrow { justify-content: center; }

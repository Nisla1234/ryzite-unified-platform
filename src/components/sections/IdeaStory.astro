---
// "From Idea to Solution" scroll-controlled story. [PROPOSAL] — preview only, planned to sit inside
// ConnectedPlan.astro once the client approves /preview/idea-to-solution.
//
// Without JavaScript, or with prefers-reduced-motion, this renders as a still final composition with
// the four captions as an ordered list. idea-story.ts adds .is-animated, pins the stage, and scrubs the scenes.
import IdeaStoryScene from './IdeaStoryScene.astro';
import { ideaStoryTranslations } from '../../data/idea-story-translations';

const copy = ideaStoryTranslations.en;
---

<div class="idea-story" data-idea-story role="group" aria-label={copy.label} data-idea-aria="label">
  <div class="idea-story__stage" data-idea-stage>
    <div class="idea-story__visual">
      <IdeaStoryScene layout="wide" />
      <IdeaStoryScene layout="narrow" />
    </div>

    <div class="idea-story__copy">
      <div class="idea-story__progress" aria-hidden="true">
        {copy.captions.map(() => <span><i data-idea-progress /></span>)}
      </div>
      <ol class="idea-story__captions">
        {copy.captions.map((caption, index) => (
          <li data-idea-caption>
            <span class="idea-story__step" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span data-idea-key={`captions.${index}`}>{caption}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</div>

<script>
  import '../../scripts/idea-story';
</script>

<script is:inline define:vars={{ ideaStoryTranslations }}>
  const applyIdeaLocale = (locale) => {
    const copy = ideaStoryTranslations[locale] || ideaStoryTranslations.en;
    const read = (path) => path.split('.').reduce((value, key) => value?.[key], copy);
    document.querySelectorAll('[data-idea-key]').forEach((element) => {
      const value = read(element.dataset.ideaKey || '');
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('[data-idea-aria]').forEach((element) => {
      const value = read(element.dataset.ideaAria || '');
      if (typeof value === 'string') element.setAttribute('aria-label', value);
    });
  };
  applyIdeaLocale(document.body.dataset.locale || 'en');
  window.addEventListener('ryzite:locale-change', (event) => applyIdeaLocale(event.detail?.locale || 'en'));
</script>

<style>
  .idea-story {
    --idea-blue: #0655e9;
    --idea-blue-deep: #0643cf;
    --idea-blue-light: #078be9;
    --idea-ink: #0a1734;
    --idea-line: #dce7fb;
    position: relative;
    color: var(--idea-ink);
    font-family: var(--font-body);
    background: #fff;
  }
  .idea-story:not(.is-animated) { padding: clamp(2rem, 5vw, 4rem) var(--space-frame, 1.25rem); }

  .idea-story__stage {
    position: relative;
    display: grid;
    gap: clamp(1rem, 3vw, 2rem);
    width: min(100%, 1240px);
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 3rem) var(--space-frame, 1.25rem);
    border-radius: var(--radius-large, 2rem);
    background:
      radial-gradient(ellipse 60% 55% at 50% 42%, #ffffff 0%, #ffffff00 70%),
      linear-gradient(180deg, #eaf1ff 0%, #f4f8ff 60%, #ffffff 100%);
    overflow: hidden;
  }

  .idea-story__visual { position: relative; width: 100%; }
  /* The SVG is rendered by IdeaStoryScene.astro, so it needs :global() to escape this component's scope. */
  .idea-story__visual :global(.idea-scene) { display: block; width: 100%; height: auto; overflow: visible; }
  .idea-story__visual :global(.idea-scene--narrow) { display: none; }

  .idea-story__progress { display: none; }

  /* Static list: no JS or reduced motion. */
  .idea-story__captions {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .idea-story__captions li {
    display: grid;
    align-content: start;
    gap: .4rem;
    color: var(--idea-ink);
    font-family: var(--font-display);
    font-size: clamp(1.1rem, .99rem + .44vw, 1.375rem);
    font-weight: 700;
    line-height: 1.35;
  }
  .idea-story__step {
    color: var(--idea-blue);
    font-family: var(--font-body);
    font-size: .8938rem;
    font-weight: 600;
    letter-spacing: .16em;
  }

  /* Animated: the stage fills the viewport while pinned and captions crossfade in one slot. */
  .idea-story.is-animated .idea-story__stage {
    grid-template-rows: minmax(0, 1fr) auto;
    height: 100svh;
    width: 100%;
    max-width: none;
    padding-top: calc(var(--idea-offset, 0px) + clamp(1rem, 3vh, 2rem));
    padding-bottom: clamp(1.5rem, 5vh, 3rem);
    border-radius: 0;
  }
  .idea-story.is-animated .idea-story__visual { min-height: 0; }
  .idea-story.is-animated .idea-story__visual :global(.idea-scene) { position: absolute; inset: 0; width: 100%; height: 100%; }

  .idea-story.is-animated .idea-story__copy { display: grid; justify-items: center; gap: 1rem; }
  .idea-story.is-animated .idea-story__progress {
    display: grid;
    grid-template-columns: repeat(4, 2.5rem);
    gap: .4rem;
  }
  .idea-story__progress span { height: 3px; border-radius: 3px; background: var(--idea-line); overflow: hidden; }
  .idea-story__progress i { display: block; height: 100%; background: var(--idea-blue); transform: scaleX(0); transform-origin: left center; }

  .idea-story.is-animated .idea-story__captions { display: grid; grid-template-columns: 1fr; width: min(100%, 42rem); }
  .idea-story.is-animated .idea-story__captions li {
    grid-area: 1 / 1;
    justify-items: center;
    text-align: center;
    font-size: clamp(1.375rem, 1.1rem + 1.32vw, 2.2rem);
    line-height: 1.25;
    text-wrap: balance;
  }

  @media (max-width: 760px) {
    .idea-story__visual :global(.idea-scene--wide) { display: none; }
    .idea-story__visual :global(.idea-scene--narrow) { display: block; }
    .idea-story__captions { grid-template-columns: 1fr; }
    .idea-story__captions li { grid-template-columns: 2.5rem 1fr; align-items: baseline; }
    .idea-story.is-animated .idea-story__captions li { grid-template-columns: 1fr; }
    .idea-story.is-animated .idea-story__captions { min-height: 4.5em; align-items: start; }
  }
</style>

---
// Steps are read from the /how-we-work content (resources-translations.ts) so both stay identical.
// [PROPOSAL] The winding-road steps live in ProcessRoad.astro (shared with the About page).
import { homeSectionsTranslations } from '../../data/home-sections-translations';
import { resourcesTranslations } from '../../data/resources-translations';
import ProcessRoad from './ProcessRoad.astro';

const copy = homeSectionsTranslations.en.process;
const howWeWork = resourcesTranslations.en.howWeWork;
const steps = howWeWork.processSteps.map((step, index) => ({
  name: step.name,
  description: step.description,
  nameAttrs: { 'data-home-key': `processData.steps.${index}.name` },
  descriptionAttrs: { 'data-home-key': `processData.steps.${index}.description` },
}));
---

<section class="hs-section hs-section--pale process-preview" aria-labelledby="process-preview-title">
  <div class="hs-shell">
    <header class="hs-heading" data-hs-reveal>
      <h2 id="process-preview-title" class="hs-bicolor" data-home-key="sections.process.title">{copy.title}</h2>
      <p data-home-key="processData.intro">{howWeWork.processIntro}</p>
    </header>

    <ProcessRoad steps={steps} />

    <div class="hs-actions" data-hs-reveal>
      <a class="hs-button" href="/how-we-work"><span data-home-key="sections.process.cta">{copy.cta}</span> <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

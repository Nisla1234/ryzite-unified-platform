---
// Steps are read from the /how-we-work content (resources-translations.ts) so both stay identical.
import { homeSectionsTranslations } from '../../data/home-sections-translations';
import { resourcesTranslations } from '../../data/resources-translations';

const copy = homeSectionsTranslations.en.process;
const howWeWork = resourcesTranslations.en.howWeWork;
// Inner SVG markup per step (24x24 grid, white on the blue node).
// Steps 01 and 02 are redrawn from client-supplied artwork: a magnifying glass and a ring-bound calendar.
const icons = [
  '<circle cx="9" cy="9" r="6.3" stroke-width="1.9" /><path d="M5.7 7.3a3.7 3.7 0 0 1 2.3-2.3" stroke-width="1.4" /><path d="m13.7 13.7 1.4 1.4" stroke-width="2.6" /><path d="m16.4 16.4 4.4 4.4" stroke-width="3.2" />',
  '<path fill="currentColor" stroke="none" fill-rule="evenodd" d="M5.8 4.3h12a3 3 0 0 1 3 3v11a3 3 0 0 1-3 3h-12a3 3 0 0 1-3-3v-11a3 3 0 0 1 3-3z M3.9 9.3h15.8v8.9a2 2 0 0 1-2 2H5.9a2 2 0 0 1-2-2z M8.45 6.1a1.25 1.25 0 1 0-2.5 0 1.25 1.25 0 1 0 2.5 0z M17.45 6.1a1.25 1.25 0 1 0-2.5 0 1.25 1.25 0 1 0 2.5 0z" /><path fill="currentColor" stroke="none" d="M6.65 2.85a.55.55 0 0 1 1.1 0V6.6h-1.1z M15.65 2.85a.55.55 0 0 1 1.1 0V6.6h-1.1z M6 10.6h2v2H6z M9.25 10.6h2v2h-2z M12.5 10.6h2v2h-2z M15.75 10.6h2v2h-2z M6 13.85h2v2H6z M9.25 13.85h2v2h-2z M12.5 13.85h2v2h-2z M15.75 13.85h2v2h-2z M6 17.1h2v2H6z M9.25 17.1h2v2h-2z M12.5 17.1h2v2h-2z" />',
  '<path d="M12 20h9 M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />',
  '<path d="m8 7-5 5 5 5 M16 7l5 5-5 5 M14 4l-4 16" />',
  '<path d="M9 11l3 3 8-8 M20 12v7a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h11" />',
  '<path d="M5 15c-1.5 1.3-2 5-2 5s3.7-.5 5-2c.7-.8.7-2.1-.1-2.9a2.2 2.2 0 0 0-2.9-.1z M12 15l-3-3a22 22 0 0 1 2-4A12.9 12.9 0 0 1 22 2c0 2.7-.8 7.5-6 11a22.4 22.4 0 0 1-4 2z M9 12H4s.6-3 2-4c1.6-1.1 5 0 5 0 M12 15v5s3-.6 4-2c1.1-1.6 0-5 0-5" />',
];
---

<section class="hs-section hs-section--pale process-preview" aria-labelledby="process-preview-title">
  <div class="hs-shell">
    <header class="hs-heading" data-hs-reveal>
      <h2 id="process-preview-title" data-home-key="sections.process.title">{copy.title}</h2>
      <p data-home-key="processData.intro">{howWeWork.processIntro}</p>
    </header>

    <ol class="process-timeline">
      {howWeWork.processSteps.map((step, index) => (
        <li class="process-step" data-hs-reveal data-hs-delay={index * 0.1}>
          <span class="process-step__node" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[index]} />
          </span>
          <div class="process-step__copy">
            <p class="process-step__number" aria-hidden="true">0{index + 1}</p>
            <h3 data-home-key={`processData.steps.${index}.name`}>{step.name}</h3>
            <p data-home-key={`processData.steps.${index}.description`}>{step.description}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="hs-actions" data-hs-reveal>
      <a class="hs-button" href="/how-we-work"><span data-home-key="sections.process.cta">{copy.cta}</span> <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .process-timeline { --node: 3.5rem; --gap: 1.25rem; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 2rem var(--gap); margin: 0; padding: 0; list-style: none; counter-reset: step; }
  .process-step { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; }
  /* Connector from this node to the next one in the same row. */
  .process-step:not(:last-child)::after { content: ''; position: absolute; z-index: -1; top: calc(var(--node) / 2); left: calc(50% + var(--node) / 2 + .35rem); width: calc(100% + var(--gap) - var(--node) - .7rem); border-top: 2px solid #a9c8fb; }
  .process-step__node { display: grid; place-items: center; width: var(--node); height: var(--node); margin-bottom: 1rem; border: 2px solid #fff; border-radius: 50%; color: #fff; background: linear-gradient(140deg, var(--hs-blue-light), var(--hs-blue-deep)); box-shadow: 0 8px 18px #0655e930; }
  .process-step__node svg { width: 1.5rem; height: 1.5rem; }
  .process-step__number { margin: 0 0 .2rem; color: var(--hs-blue); font-size: var(--size-eyebrow); font-weight: 600; letter-spacing: .12em; }
  .process-step h3 { margin: 0 0 .45rem; font-size: var(--size-h4); line-height: var(--leading-h3); overflow-wrap: anywhere; }
  .process-step p:not(.process-step__number) { margin: 0; color: var(--hs-muted); font-size: .9625rem; line-height: 1.55; overflow-wrap: anywhere; }

  @media (max-width: 1100px) {
    .process-timeline { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 2.5rem; }
    .process-step:nth-child(3n)::after { display: none; }
  }

  @media (max-width: 700px) {
    .process-timeline { grid-template-columns: 1fr; row-gap: 1.75rem; max-width: 30rem; margin-inline: auto; }
    .process-step { flex-direction: row; align-items: flex-start; gap: 1rem; text-align: start; }
    .process-step__node { flex-shrink: 0; margin: 0; }
    .process-step:nth-child(3n)::after, .process-step:not(:last-child)::after { display: block; top: calc(var(--node) + .35rem); left: calc(var(--node) / 2 - 1px); width: 0; height: calc(100% - var(--node) + 1.75rem - .7rem); border-top: 0; border-left: 2px solid #a9c8fb; }
  }
</style>

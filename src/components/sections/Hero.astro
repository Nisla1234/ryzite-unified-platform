<section class="connection-hero" aria-labelledby="connection-title">
  <div class="connection-stage" data-connection-hero>
    <div class="hero-halo" aria-hidden="true"></div>
    <div class="hero-message">
      <h1 id="connection-title" class="hero-title"><span>{' '}</span><strong class="digital-line"><span data-headline-word>One Site.</span></strong><span><span data-headline-word>Solve</span>{' '}<span data-headline-word>Every</span></span><strong><span data-headline-word>Problems.</span></strong></h1>
      <p data-hero-description>{'We turn ideas into digital solutions that help businesses grow and stay ahead.'.split(' ').map((word) => <><span data-description-word>{word}</span>{' '}</>)}</p>
      <a class="hero-cta" href="/contact" data-home-key="heroCta">Let’s Talk</a>
    </div>

    <svg class="landscape" viewBox="0 0 1440 680" preserveAspectRatio="none" fill="none" aria-hidden="true">
      <g class="wave-layer wave-layer--light">
        <path d="M-100 350C200 650 450 680 760 590S1200 410 1540 550V780H-100Z" fill="#dcecff" />
      </g>
      <g class="wave-layer wave-layer--sky">
        <path d="M-100 480C230 710 550 720 920 620S1300 470 1540 510V780H-100Z" fill="#b9ddff" />
      </g>
      <g class="wave-layer wave-layer--blue">
        <path d="M-100 620C350 760 650 710 1000 660S1300 540 1540 580V780H-100Z" fill="#70b6ff" opacity=".5" />
      </g>
    </svg>
    <div class="floor-glow" aria-hidden="true"></div>
    <div class="robot robot-ry">
      <div class="robot-float">
        <img class="robot-body" src="/images/hero/ry.webp" alt="RY, a blue robot wearing a cap marked RY, pulling the glowing rope" width="1180" height="1333" fetchpriority="high" />
        <div class="robot-leg leg-back" aria-hidden="true"></div>
        <div class="robot-leg leg-front" aria-hidden="true"></div>
        <img class="robot-front" src="/images/hero/ry-front-plain.webp" alt="" aria-hidden="true" width="1180" height="1333" />
        <div class="ground-shadow" aria-hidden="true"></div>
      </div>
    </div>
    <div class="robot robot-zite">
      <div class="robot-float">
        <img class="robot-body" src="/images/hero/zite.webp" alt="ZITE, a robot wearing a cap marked ZITE, pulling the other end of the rope" width="1180" height="1333" fetchpriority="high" />
        <div class="robot-leg leg-back" aria-hidden="true"></div>
        <div class="robot-leg leg-front" aria-hidden="true"></div>
        <img class="robot-front" src="/images/hero/zite-front-plain.webp" alt="" aria-hidden="true" width="1180" height="1333" />
        <div class="ground-shadow" aria-hidden="true"></div>
      </div>
    </div>
    <svg class="connection-rope" aria-hidden="true">
      <defs>
        <linearGradient id="rope-color" x1="0%" y1="0%" x2="100%" y2="0%"><stop stop-color="#087aff" /><stop offset=".5" stop-color="#2fe9ff" /><stop offset="1" stop-color="#087aff" /></linearGradient>
      </defs>
      <path class="rope-aura" />
      <path class="rope-body" />
      <path class="rope-light" />
    </svg>
    <div class="meeting-flash" aria-hidden="true"></div>
    <noscript><style>.connection-hero .hero-message { opacity: 1; visibility: visible; transform: none; }</style></noscript>
  </div>
  <div class="hero-marquee" aria-hidden="true">
    <div class="hero-marquee-track">
      {Array.from({ length: 4 }, () => (
        <div class="hero-marquee-set">
          <span data-home-key="marqueeDesign">DESIGN</span><span class="hero-marquee-star">✳</span>
          <span data-home-key="marqueeDevelopment">DEVELOPMENT</span><span class="hero-marquee-star">✳</span>
          <span data-home-key="marqueeDigitalTransformation">DIGITAL TRANSFORMATION</span><span class="hero-marquee-star">✳</span>
          <span data-home-key="marqueeInnovation">INNOVATION</span><span class="hero-marquee-star">✳</span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  declare global {
    interface Window {
      ryziteIntroFallback?: ReturnType<typeof setTimeout>;
    }
  }

  const initializeConnection = () => {
    const stage = document.querySelector<HTMLElement>('[data-connection-hero]');
    if (!stage || stage.dataset.initialized) return;
    const left = stage.querySelector<HTMLElement>('.robot-ry');
    const right = stage.querySelector<HTMLElement>('.robot-zite');
    const message = stage.querySelector<HTMLElement>('.hero-message');
    const rope = stage.querySelector<SVGSVGElement>('.connection-rope');
    const landscape = stage.querySelector<SVGSVGElement>('.landscape');
    const flash = stage.querySelector<HTMLElement>('.meeting-flash');
    if (!left || !right || !message || !rope || !landscape || !flash) return;
    stage.dataset.initialized = 'true';
    const headlineWords = message.querySelectorAll('[data-headline-word]');
    const descriptionWords = message.querySelectorAll('[data-description-word]');
    const cta = message.querySelector<HTMLElement>('.hero-cta')!;
    const chrome = document.querySelectorAll('.site-header, .footer');
    const paths = rope.querySelectorAll('path');
    const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
    const introSeenKey = 'ryzite-home-intro-seen';
    let skipIntro = false;
    try { skipIntro = window.sessionStorage.getItem(introSeenKey) === 'true'; } catch {}
    const bodies = [left.querySelector<HTMLImageElement>('.robot-body')!, right.querySelector<HTMLImageElement>('.robot-body')!];
    const frontPoses = [left.querySelector<HTMLImageElement>('.robot-front')!, right.querySelector<HTMLImageElement>('.robot-front')!];
    const legs = [left.querySelectorAll('.robot-leg'), right.querySelectorAll('.robot-leg')];
    const shadows = [left.querySelector<HTMLElement>('.ground-shadow')!, right.querySelector<HTMLElement>('.ground-shadow')!];
    const pullLayers = [...bodies, ...legs[0], ...legs[1]];
    const state = { progress: 0, tension: 0, ripple: 0, dissolve: 0 };
    let timeline: gsap.core.Timeline | undefined;
    let imagesReady = false;
    const waveLayers = [...stage.querySelectorAll('.wave-layer')];
    const waveSettings = [
      { x: 28, y: 9, duration: 68, direction: 1, offset: 0 },
      { x: 40, y: 12, duration: 56, direction: -1, offset: Math.PI / 2 },
      { x: 52, y: 15, duration: 44, direction: 1, offset: Math.PI },
    ];
    const waveTweens: gsap.core.Tween[] = [];
    const stopWaveMotion = () => {
      waveTweens.forEach((tween) => tween.kill());
      waveTweens.length = 0;
      waveLayers.forEach((layer) => layer.removeAttribute('transform'));
    };
    const startWaveMotion = () => {
      stopWaveMotion();
      if (preference.matches) return;

      waveLayers.forEach((layer, index) => {
        const settings = waveSettings[index];
        if (!settings) return;
        const motion = { phase: 0 };
        const updatePosition = () => {
          const angle = settings.offset + motion.phase * settings.direction;
          const x = settings.x * Math.cos(angle);
          const y = settings.y * Math.sin(angle);
          layer.setAttribute('transform', `translate(${x.toFixed(3)} ${y.toFixed(3)})`);
        };
        updatePosition();
        waveTweens.push(gsap.to(motion, {
          phase: Math.PI * 2,
          duration: settings.duration,
          ease: 'none',
          repeat: -1,
          onUpdate: updatePosition,
        }));
      });
    };
    startWaveMotion();

    let introDone = false;
    const ambientTweens: gsap.core.Tween[] = [];
    const markLive = () => {
      introDone = true;
      stage.classList.add('is-live');
    };
    const scrollScrub = { trigger: stage, start: 'top top', end: 'bottom top', scrub: .6 };
    const setupAmbient = () => {
      if (preference.matches || ambientTweens.length) return;
      ambientTweens.push(
        gsap.to(message, { yPercent: -6, ease: 'none', scrollTrigger: { ...scrollScrub } }),
        gsap.to([left, right], { yPercent: 4, ease: 'none', scrollTrigger: { ...scrollScrub } }),
        gsap.to(landscape, { yPercent: 9, ease: 'none', scrollTrigger: { ...scrollScrub } }),
      );
    };
    const teardownAmbient = () => {
      ambientTweens.forEach((tween) => tween.kill());
      ambientTweens.length = 0;
      gsap.set([message, landscape], { yPercent: 0 });
      gsap.set([left, right], { x: 0, y: 0, yPercent: 0 });
    };

    const finePointer = window.matchMedia('(pointer: fine)');
    const parallax = {
      ryX: gsap.quickTo(left, 'x', { duration: .7, ease: 'power3.out' }),
      ryY: gsap.quickTo(left, 'y', { duration: .7, ease: 'power3.out' }),
      ziteX: gsap.quickTo(right, 'x', { duration: .7, ease: 'power3.out' }),
      ziteY: gsap.quickTo(right, 'y', { duration: .7, ease: 'power3.out' }),
    };
    const resetParallax = () => {
      parallax.ryX(0); parallax.ryY(0); parallax.ziteX(0); parallax.ziteY(0);
    };
    const handleHeroPointerMove = (event: PointerEvent) => {
      if (!introDone || preference.matches || event.pointerType === 'touch') return;
      const rect = stage.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > window.innerHeight) return;
      const dx = Math.max(-1, Math.min(1, ((event.clientX - rect.left) / rect.width - .5) * 2));
      const dy = Math.max(-1, Math.min(1, ((event.clientY - rect.top) / rect.height - .5) * 2));
      parallax.ryX(dx * 8); parallax.ryY(dy * 6);
      parallax.ziteX(dx * 10); parallax.ziteY(dy * 8);
    };
    const handleHeroPointerLeave = () => resetParallax();
    if (finePointer.matches) {
      stage.addEventListener('pointermove', handleHeroPointerMove);
      stage.addEventListener('pointerleave', handleHeroPointerLeave);
    }

    const handleMotionPreferenceChange = () => {
      startWaveMotion();
      if (preference.matches) {
        teardownAmbient();
        resetParallax();
        if (timeline) timeline.progress(1).pause();
      } else {
        setupAmbient();
      }
    };

    const drawRope = () => {
      const bounds = stage.getBoundingClientRect();
      const hand = (actor: HTMLElement, body: Element, x: number, y: number) => {
        const rect = actor.getBoundingClientRect();
        const style = getComputedStyle(body);
        const origin = style.transformOrigin.split(' ').map(Number.parseFloat);
        const point = new DOMPoint(actor.offsetWidth * x - origin[0], actor.offsetHeight * y - origin[1]);
        const transformed = point.matrixTransform(new DOMMatrix(style.transform === 'none' ? undefined : style.transform));
        return { x: rect.left - bounds.left + transformed.x + origin[0], y: rect.top - bounds.top + transformed.y + origin[1] };
      };
      const a = hand(left, bodies[0], .81, .45);
      const b = hand(right, bodies[1], .22, .45);
      const aInner = hand(left, bodies[0], .64, .51);
      const bInner = hand(right, bodies[1], .42, .51);
      const x1 = a.x;
      const x2 = b.x;
      const y1 = a.y;
      const y2 = b.y;
      const width = Math.max(0, x2 - x1);
      const wave = Math.min(width * .18, bounds.height * .075) * (1 - state.tension * .94);
      const vibration = Math.sin(state.ripple * Math.PI * 8) * state.tension * Math.min(width * .012, 4);
      const d = `M${aInner.x},${aInner.y} L${x1},${y1} C${x1 + width * .3},${y1 + wave + vibration} ${x2 - width * .3},${y2 + wave - vibration} ${x2},${y2} L${bInner.x},${bInner.y}`;
      paths.forEach((path) => path.setAttribute('d', d));
      rope.style.opacity = String((.8 + state.tension * .2) * (1 - state.dissolve));
    };

    const createTimeline = () => {
      timeline?.kill();
      clearTimeout(window.ryziteIntroFallback);
      document.documentElement.classList.add('home-intro');
      document.documentElement.classList.add('home-transition');
      gsap.set(chrome, { autoAlpha: 0, y: -12 });
      gsap.set([left, right], { x: 0, y: 0, rotation: 0, autoAlpha: 1 });
      gsap.set([...bodies, ...legs[0], ...legs[1]], { x: 0, y: 0, rotation: 0, scaleY: 1 });
      gsap.set(pullLayers, { autoAlpha: 1 });
      gsap.set(frontPoses, { autoAlpha: 0, scaleX: .95, transformOrigin: '50% 95%' });
      gsap.set(message, { autoAlpha: 0, y: 24 });
      gsap.set(headlineWords, { autoAlpha: 0, y: 35, rotation: 3, filter: 'blur(7px)' });
      gsap.set(descriptionWords, { autoAlpha: 0, y: 10, filter: 'blur(3px)' });
      gsap.set(cta, { autoAlpha: 0, y: 18, scale: .94 });
      gsap.set(stage, { '--underline-scale': 0 });
      gsap.set(shadows, { scaleX: 1, opacity: .65 });
      gsap.set(flash, { opacity: 0, scale: .6 });
      Object.assign(state, { progress: 0, tension: 0, ripple: 0, dissolve: 0 });
      const travel = Math.max(0, stage.clientWidth * .5 - left.offsetWidth * 1.02 - left.offsetLeft);
      timeline = gsap.timeline({
        delay: .2,
        onUpdate: drawRope,
        onComplete: () => {
          document.documentElement.classList.remove('home-intro', 'home-transition');
          markLive();
        },
      });
      const steps = 3;
      const stride = .6;
      for (let step = 1; step <= steps; step++) {
        const position = (step - 1) * stride;
        // Plant the feet, lean away, then overcome the rope's resistance.
        timeline.to(bodies[0], { rotation: -7, x: -3, y: 4, duration: .24, ease: 'power2.inOut' }, position)
          .to(bodies[1], { rotation: 7, x: 3, y: 4, duration: .24, ease: 'power2.inOut' }, position)
          .to(state, { tension: 1, ripple: step, duration: .24, ease: 'power2.in' }, position);
        timeline.to(state, { progress: step / steps, duration: .52, ease: 'none' }, position + .08);

        const activeTimeline = timeline;
        [left, right].forEach((actor, index) => {
          const direction = index === 0 ? 1 : -1;
          const lift = Math.min(actor.offsetHeight * .035, 15);
          const reach = Math.min(actor.offsetWidth * .028, 10);
          const footfall = (step - 1) % 2;
          const time = position + .08;
          const swing = legs[index][footfall];
          const planted = legs[index][1 - footfall];
          activeTimeline.to(actor, { x: direction * travel * step / steps, duration: .52, ease: 'sine.inOut' }, time)
            .to(swing, { rotation: -direction * 8, x: direction * reach, y: -lift, duration: .24, ease: 'sine.out' }, time)
            .to(planted, { rotation: direction * 3, x: -direction * reach * .5, y: 0, duration: .45, ease: 'sine.inOut' }, time)
            .to(bodies[index], { rotation: -direction * 3, x: direction, y: -3, scaleY: 1, duration: .22, ease: 'sine.out' }, time)
            .to(shadows[index], { scaleX: .94, opacity: .6, duration: .22 }, time)
            .to(swing, { rotation: 0, x: 0, y: 0, duration: .22, ease: 'power2.in' }, time + .26)
            .to(bodies[index], { rotation: 0, x: 0, y: 0, scaleY: 1, duration: .2, ease: 'power1.out' }, time + .38)
            .to(shadows[index], { scaleX: 1, opacity: .65, duration: .2 }, time + .38);
        });
        timeline.to(state, { tension: .38, duration: .18, ease: 'power2.out' }, position + .45);
      }
      const finish = (steps - 1) * stride + .64;
      timeline.to(bodies, { rotation: 0, x: 0, y: 0, duration: .4 }, finish)
        .to(state, { tension: .15, duration: .6 }, finish)
        .to(flash, { opacity: .85, scale: 1, duration: .35 }, finish)
        .to(state, { dissolve: 1, duration: .25 }, finish + .1)
        // Rope pulled: a small celebratory hop, then the hero comes in straight away.
        .to([left, right], { scaleY: .93, y: 8, duration: .16, ease: 'power2.in' }, finish + .1)
        .to([left, right], { scaleY: 1.03, y: () => -Math.min(stage.clientHeight * .07, 48), duration: .3, ease: 'power2.out' }, finish + .26)
        .to(shadows, { scaleX: .8, opacity: .4, duration: .3 }, finish + .26)
        .to([left, right], { scaleY: 1, y: 0, duration: .26, ease: 'power2.in' }, finish + .56)
        .to(shadows, { scaleX: 1, opacity: .65, duration: .26 }, finish + .56)
        .to(flash, { opacity: 0, duration: .3, ease: 'power2.out' }, finish + .6)
        .to([left, right], { autoAlpha: 0, duration: .22, ease: 'power2.in' }, finish + .85)
        .set([left, right], { x: 0, y: 16 }, finish + 1.08)
        .set(pullLayers, { autoAlpha: 0 }, finish + 1.08)
        .set(frontPoses, { autoAlpha: 1, scaleX: 1 }, finish + 1.08)
        .set(message, { autoAlpha: 1, y: 0 }, finish + 1.08)
        .call(() => {
          document.documentElement.classList.remove('home-intro');
        }, [], finish + 1.08)
        .to(chrome, { autoAlpha: 1, y: 0, duration: .6, ease: 'power2.out' }, finish + 1.08)
        .to([left, right], { autoAlpha: 1, y: 0, duration: .7, stagger: .1, ease: 'power2.out' }, finish + 1.12)
        .to(headlineWords, { autoAlpha: 1, y: 0, rotation: 0, filter: 'blur(0px)', duration: .7, stagger: .14, ease: 'power3.out' }, finish + 1.18)
        .to(stage, { '--underline-scale': 1, duration: .5, ease: 'power2.out' }, finish + 1.68)
        .to(descriptionWords, { autoAlpha: 1, y: 0, filter: 'blur(0px)', duration: .4, stagger: .04, ease: 'power2.out' }, finish + 1.93)
        .to(cta, { autoAlpha: 1, y: 0, scale: 1, duration: .55, ease: 'back.out(1.4)' }, finish + 2.53);
      if (preference.matches || skipIntro) {
        timeline.progress(1).pause();
        document.documentElement.classList.remove('home-intro', 'home-transition');
        markLive();
      }
      drawRope();
    };

    preference.addEventListener('change', handleMotionPreferenceChange);
    document.addEventListener('astro:before-swap', () => {
      stopWaveMotion();
      teardownAmbient();
      stage.removeEventListener('pointermove', handleHeroPointerMove);
      stage.removeEventListener('pointerleave', handleHeroPointerLeave);
      preference.removeEventListener('change', handleMotionPreferenceChange);
    }, { once: true });
    let resizeTimer: ReturnType<typeof setTimeout> | undefined;
    let observedWidth = stage.clientWidth;
    new ResizeObserver(() => {
      if (!imagesReady) return;
      if (stage.clientWidth === observedWidth) return;
      observedWidth = stage.clientWidth;
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        const progress = timeline?.progress() || 0;
        const paused = timeline?.paused();
        createTimeline();
        timeline?.progress(progress).paused(paused || progress === 1);
        if (progress === 1) markLive();
        drawRope();
      }, 150);
    }).observe(stage);
    Promise.all([...bodies, ...frontPoses].map((img) => img.decode().catch(() => {}))).then(() => {
      if (!stage.isConnected) return;
      imagesReady = true;
      if (!skipIntro) {
        try { window.sessionStorage.setItem(introSeenKey, 'true'); } catch {}
      }
      createTimeline();
      setupAmbient();
    });
  };
  initializeConnection();
  document.addEventListener('astro:page-load', initializeConnection);
</script>

<style>
  .connection-hero { overflow: hidden; background: var(--color-paper); }
  .hero-marquee { overflow: hidden; padding-block: 14px; color: #fff; background: #242427; }
  .hero-marquee-track { display: flex; width: max-content; animation: hero-marquee-scroll 28s linear infinite; }
  .hero-marquee-set { display: flex; flex: 0 0 auto; align-items: center; gap: 14px; padding-right: 30px; white-space: nowrap; font-family: var(--font-display); font-size: 28px; font-weight: 700; line-height: 1.1; }
  .hero-marquee-star { font-family: var(--font-body); font-weight: 400; }
  @keyframes hero-marquee-scroll { to { transform: translateX(-50%); } }
  .connection-stage { position: relative; isolation: isolate; height: clamp(680px, 84svh, 840px); max-width: 1800px; margin-inline: auto; overflow: hidden; background: var(--color-paper); }
  .hero-halo { position: absolute; inset: 15% 10% 4%; background: radial-gradient(ellipse, #d8f9ff60, transparent 68%); }
  .hero-message { position: absolute; z-index: 4; top: 15%; left: 29%; width: 42%; text-align: center; font-family: var(--font-body); opacity: 0; visibility: hidden; }
  h1 { margin: 0; color: #080c12; font-size: clamp(2.2rem, 5.5vw, 5.5rem); font-weight: 900; font-style: normal; line-height: .9; letter-spacing: -.027em; text-transform: uppercase; }
  .hero-title { font-family: var(--font-display); font-size: clamp(2.75rem, 6vw, 6rem); font-weight: 800; line-height: .95; text-transform: uppercase; }
  h1 > span, h1 > strong { display: block; }
  [data-headline-word], [data-description-word] { display: inline-block; }
  h1 strong { color: #064bed; font-size: 1.2em; font-weight: 400; line-height: 1; }
  .digital-line { position: relative; margin-bottom: .2em; }
  .digital-line::after { content: ''; position: absolute; left: 22%; right: 14%; bottom: -.07em; height: 5px; background: #064bed; border-radius: 50%; transform: rotate(-2deg) scaleX(var(--underline-scale, 1)); transform-origin: left; }
  .hero-message p { margin: 24px 0; color: #344159; font-size: 15px; line-height: 1.45; }
  .hero-cta { display: inline-flex; align-items: center; gap: 15px; padding: 17px 30px; border-radius: 999px; background: #064bed; box-shadow: 0 9px 20px #064bed25; color: white; font-size: 17px; font-weight: 800; text-decoration: none; text-transform: uppercase; transition: background .25s ease, transform .25s ease, box-shadow .25s ease; }
  .hero-cta:hover { background: #0539b7; transform: translateY(-2px) scale(1.04); box-shadow: 0 14px 30px #064bed38; }
  .hero-cta:focus-visible { outline: 3px solid #064bed; outline-offset: 5px; }
  .landscape { position: absolute; width: 100%; height: 100%; inset: 0; z-index: -1; }
  .wave-layer { transform-box: fill-box; transform-origin: center; will-change: transform; }
  .floor-glow { position: absolute; bottom: 0; width: 100%; height: 26%; background: radial-gradient(ellipse at 50% 10%, #b4f9ffb3, #599cfb40 60%, transparent 80%); }
  .robot { position: absolute; z-index: 2; bottom: 9%; width: 29%; aspect-ratio: 1180 / 1333; transform-origin: 50% 95%; will-change: transform; }
  .robot-float { position: absolute; inset: 0; transform-origin: 50% 95%; }
  .connection-stage.is-live .robot-ry .robot-float { --float-y: 9px; --float-r: 1deg; animation: robot-float 4.6s ease-in-out infinite; }
  .connection-stage.is-live .robot-zite .robot-float { --float-y: 11px; --float-r: 1.2deg; animation: robot-float 5.5s ease-in-out -2.4s infinite; }
  @keyframes robot-float {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
    25% { transform: translate3d(0, calc(var(--float-y) * -.75), 0) rotate(calc(var(--float-r) * -.7)); }
    50% { transform: translate3d(0, calc(var(--float-y) * -1), 0) rotate(calc(var(--float-r) * -1)); }
    75% { transform: translate3d(0, calc(var(--float-y) * -.35), 0) rotate(calc(var(--float-r) * .6)); }
  }
  .ground-shadow { position: absolute; bottom: -1%; left: 12%; width: 76%; height: 5%; background: #174ecb55; filter: blur(10px); border-radius: 50%; z-index: -1; }
  .robot-ry { left: 3%; }
  .robot-zite { right: 3%; }

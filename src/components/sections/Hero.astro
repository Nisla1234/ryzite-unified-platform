---
import { buildRibbon, reflectionLength, ribbons } from '../../scripts/hero-ribbon';

const initialRibbons = ribbons.map((ribbon) => buildRibbon(ribbon, 0));
const marqueeItems = [
  { key: 'marqueeDesign', label: 'DESIGN' },
  { key: 'marqueeDevelopment', label: 'DEVELOPMENT' },
  { key: 'marqueeDigitalTransformation', label: 'DIGITAL TRANSFORMATION' },
  { key: 'marqueeInnovation', label: 'INNOVATION' },
];
---

<section class="connection-hero" aria-labelledby="connection-title">
  <div class="connection-stage" data-connection-hero>
    <div class="hero-halo" aria-hidden="true"></div>
    <div class="hero-message">
      <h1 id="connection-title" class="hero-title"><span>{' '}</span><strong class="digital-line"><span data-headline-word>One Site.</span></strong><span><span data-headline-word>Solve</span>{' '}<span data-headline-word>Every</span></span><strong><span data-headline-word>Problems.</span></strong></h1>
      <p data-hero-description>{'We turn ideas into digital solutions that help businesses grow and stay ahead.'.split(' ').map((word) => <><span data-description-word>{word}</span>{' '}</>)}</p>
      <a class="hero-cta" href="/contact" data-home-key="heroCta">Let’s Talk</a>
    </div>

    <svg class="landscape" viewBox="0 0 1440 680" preserveAspectRatio="none" fill="none" aria-hidden="true">
      <defs>
        <!-- Repeating reflections that slide along the ribbon as it flows. -->
        <linearGradient id="ribbon-reflection-0" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2={reflectionLength} y2="0" spreadMethod="repeat">
          <stop offset="0" stop-color="#9ccdff" /><stop offset=".3" stop-color="#eef7ff" /><stop offset=".55" stop-color="#5aa9ff" /><stop offset=".8" stop-color="#cfe6ff" /><stop offset="1" stop-color="#9ccdff" />
        </linearGradient>
        <linearGradient id="ribbon-reflection-1" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2={reflectionLength} y2="0" spreadMethod="repeat">
          <stop offset="0" stop-color="#0643cf" /><stop offset=".16" stop-color="#0a6cf0" /><stop offset=".3" stop-color="#e6f3ff" /><stop offset=".38" stop-color="#8cc6ff" /><stop offset=".52" stop-color="#0655e9" /><stop offset=".68" stop-color="#0437b0" /><stop offset=".82" stop-color="#6fb4ff" /><stop offset=".9" stop-color="#d9ecff" /><stop offset="1" stop-color="#0643cf" />
        </linearGradient>
        <!-- Glass depth: a bright sheen on top, deeper blue underneath. -->
        <linearGradient id="ribbon-depth" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#fff" stop-opacity=".5" /><stop offset=".4" stop-color="#fff" stop-opacity="0" /><stop offset=".75" stop-color="#032b8f" stop-opacity="0" /><stop offset="1" stop-color="#032b8f" stop-opacity=".3" />
        </linearGradient>
        <filter id="ribbon-glow" filterUnits="userSpaceOnUse" x="-200" y="0" width="1840" height="780"><feGaussianBlur stdDeviation="16" /></filter>
        <filter id="ribbon-soft" filterUnits="userSpaceOnUse" x="-200" y="0" width="1840" height="780"><feGaussianBlur stdDeviation="1.6" /></filter>
      </defs>
      {initialRibbons.map((shape, index) => (
        <g class:list={['ribbon', index ? 'ribbon--front' : 'ribbon--back']} data-ribbon={index}>
          {index === 1 && <path data-ribbon-part="body" d={shape.body} fill="#078be9" opacity=".22" filter="url(#ribbon-glow)" />}
          <path data-ribbon-part="body" d={shape.body} fill={`url(#ribbon-reflection-${index})`} />
          <path data-ribbon-part="body" d={shape.body} fill="url(#ribbon-depth)" />
          <path data-ribbon-part="top" d={shape.topEdge} stroke="#fff" stroke-width="3" stroke-linecap="round" opacity=".85" filter="url(#ribbon-soft)" />
          <path data-ribbon-part="bottom" d={shape.bottomEdge} stroke="#cfe6ff" stroke-width="1.5" opacity=".6" />
        </g>
      ))}
    </svg>
    <div class="floor-glow" aria-hidden="true"></div>
    <div class="robot robot-ry">
      <div class="robot-float">
        <img class="robot-body" src="/images/hero/ry.webp" alt="RY, a blue robot wearing a cap marked RY, pulling the glowing rope" width="1180" height="1333" fetchpriority="high" />
        <div class="robot-leg leg-back" aria-hidden="true"></div>
        <div class="robot-leg leg-front" aria-hidden="true"></div>
        <img class="robot-front" src="/images/hero/ry-front-plain.webp" alt="" aria-hidden="true" width="1180" height="1333" />
        <div class="ground-shadow" aria-hidden="true"></div>
      </div>
    </div>
    <div class="robot robot-zite">
      <div class="robot-float">
        <img class="robot-body" src="/images/hero/zite.webp" alt="ZITE, a robot wearing a cap marked ZITE, pulling the other end of the rope" width="1180" height="1333" fetchpriority="high" />
        <div class="robot-leg leg-back" aria-hidden="true"></div>
        <div class="robot-leg leg-front" aria-hidden="true"></div>
        <img class="robot-front" src="/images/hero/zite-front-plain.webp" alt="" aria-hidden="true" width="1180" height="1333" />
        <div class="ground-shadow" aria-hidden="true"></div>
      </div>
    </div>
    <svg class="connection-rope" aria-hidden="true">
      <defs>
        <linearGradient id="rope-color" x1="0%" y1="0%" x2="100%" y2="0%"><stop stop-color="#087aff" /><stop offset=".5" stop-color="#2fe9ff" /><stop offset="1" stop-color="#087aff" /></linearGradient>
      </defs>
      <path class="rope-aura" />
      <path class="rope-body" />
      <path class="rope-light" />
    </svg>
    <div class="meeting-flash" aria-hidden="true"></div>
    <noscript><style>.connection-hero .hero-message { opacity: 1; visibility: visible; transform: none; }</style></noscript>
  </div>
  <div class="hero-marquee" aria-hidden="true">
    <svg class="hero-marquee-arc" viewBox="0 0 1600 300" preserveAspectRatio="xMidYMid meet" focusable="false">
      <path id="hero-marquee-curve" class="hero-marquee-band" d="M -80 268 Q 760 -20 1680 92" />
      <text class="hero-marquee-text" dominant-baseline="central">
        <textPath href="#hero-marquee-curve" startOffset="0" data-marquee-path>
          {Array.from({ length: 6 }, () => marqueeItems.map(({ key, label }) => (
            <Fragment><tspan data-home-key={key}>{label}</tspan><tspan class="hero-marquee-star">{'\u00a0\u00a0✳\u00a0\u00a0'}</tspan></Fragment>
          )))}
        </textPath>
      </text>
    </svg>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { CustomEase } from 'gsap/CustomEase';
  import { buildRibbon, reflectionShift, ribbons } from '../../scripts/hero-ribbon';

  gsap.registerPlugin(CustomEase);

  declare global {
    interface Window {
      ryziteIntroFallback?: ReturnType<typeof setTimeout>;
    }
  }

  // Motion values for everything after the rope intro, kept together so they are easy to tune.
  const heroMotion = {
    revealEase: CustomEase.create('heroReveal', '.2,.8,.2,1'),
    words: { duration: .65, stagger: .08 },
    follow: { rise: 34, blur: 8, duration: .9, stagger: .15 },
    // Different periods per robot so the two never move in sync.
    idle: [
      { float: 1, floatPeriod: 4.6, tilt: 1, tiltPeriod: 6.1, turn: 4, turnPeriod: 9.2 },
      { float: 1.1, floatPeriod: 5.5, tilt: 1.2, tiltPeriod: 7.3, turn: 4, turnPeriod: 10.6 },
    ],
    pointerTilt: { turn: 6, pitch: 3, lag: 1.2 },
    // Scroll parallax distances (yPercent at the bottom of the hero) and the chase rate.
    scroll: { message: -6, robots: 4, landscape: 9, chase: 9 },
    // Seconds for one full, seamless cycle of the glass ribbon's flow.
    ribbon: { loop: 18 },
    perspective: 1000,
  };

  const splitIntoWords = (slot: HTMLElement) => {
    const text = slot.textContent?.trim() || '';
    const label = document.createElement('span');
    label.className = 'hero-sr-only';
    label.textContent = text;
    const visual = document.createElement('span');
    visual.className = 'hero-title-visual';
    visual.setAttribute('aria-hidden', 'true');
    const words = text.split(/\s+/u).filter(Boolean).map((word) => {
      const mask = document.createElement('span');
      mask.className = 'word-mask';
      const element = document.createElement('span');
      element.className = 'hero-word';
      element.textContent = word;
      mask.append(element);
      return mask;
    });
    words.forEach((word, index) => {
      if (index) visual.append(' ');
      visual.append(word);
    });
    slot.replaceChildren(label, visual);
    return words.map((word) => word.firstElementChild as HTMLElement);
  };

  // A seamless back-and-forth around zero: out, across, and home again.
  const sway = (target: HTMLElement, property: string, amount: number, period: number) => gsap.timeline({ repeat: -1 })
    .to(target, { [property]: amount, duration: period / 4, ease: 'sine.out' })
    .to(target, { [property]: -amount, duration: period / 2, ease: 'sine.inOut' })
    .to(target, { [property]: 0, duration: period / 4, ease: 'sine.in' });

  const initializeConnection = () => {
    const stage = document.querySelector<HTMLElement>('[data-connection-hero]');
    if (!stage || stage.dataset.initialized) return;
    const left = stage.querySelector<HTMLElement>('.robot-ry');
    const right = stage.querySelector<HTMLElement>('.robot-zite');
    const message = stage.querySelector<HTMLElement>('.hero-message');
    const rope = stage.querySelector<SVGSVGElement>('.connection-rope');
    const landscape = stage.querySelector<SVGSVGElement>('.landscape');
    const flash = stage.querySelector<HTMLElement>('.meeting-flash');
    if (!left || !right || !message || !rope || !landscape || !flash) return;
    stage.dataset.initialized = 'true';
    const headlineWords = [...message.querySelectorAll<HTMLElement>('[data-headline-word]')];
    const description = message.querySelector<HTMLElement>('[data-hero-description]')!;
    const cta = message.querySelector<HTMLElement>('.hero-cta')!;
    const floats = [left.querySelector<HTMLElement>('.robot-float')!, right.querySelector<HTMLElement>('.robot-float')!];
    const headlineTargets = headlineWords.flatMap(splitIntoWords);
    const chrome = document.querySelectorAll('.site-header, .footer');
    const paths = rope.querySelectorAll('path');
    const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
    const introSeenKey = 'ryzite-home-intro-seen';
    let skipIntro = false;
    try { skipIntro = window.sessionStorage.getItem(introSeenKey) === 'true'; } catch {}
    const bodies = [left.querySelector<HTMLImageElement>('.robot-body')!, right.querySelector<HTMLImageElement>('.robot-body')!];
    const frontPoses = [left.querySelector<HTMLImageElement>('.robot-front')!, right.querySelector<HTMLImageElement>('.robot-front')!];
    const legs = [left.querySelectorAll('.robot-leg'), right.querySelectorAll('.robot-leg')];
    const shadows = [left.querySelector<HTMLElement>('.ground-shadow')!, right.querySelector<HTMLElement>('.ground-shadow')!];
    const pullLayers = [...bodies, ...legs[0], ...legs[1]];
    const state = { progress: 0, tension: 0, ripple: 0, dissolve: 0 };
    let timeline: gsap.core.Timeline | undefined;
    let headlineReveal: gsap.core.Tween | undefined;
    let imagesReady = false;
    // The glass ribbons are redrawn each frame: they ripple, twist, and their reflections slide.
    const ribbonGroups = [...stage.querySelectorAll<SVGGElement>('[data-ribbon]')].map((group) => {
      const index = Number(group.dataset.ribbon);
      return {
        config: ribbons[index],
        bodies: [...group.querySelectorAll<SVGPathElement>('[data-ribbon-part="body"]')],
        top: group.querySelector<SVGPathElement>('[data-ribbon-part="top"]'),
        bottom: group.querySelector<SVGPathElement>('[data-ribbon-part="bottom"]'),
        reflection: stage.querySelector<SVGLinearGradientElement>(`#ribbon-reflection-${index}`),
      };
    });
    const renderRibbons = (phase: number) => {
      ribbonGroups.forEach(({ config, bodies, top, bottom, reflection }) => {
        if (!config) return;
        const shape = buildRibbon(config, phase);
        bodies.forEach((path) => path.setAttribute('d', shape.body));
        top?.setAttribute('d', shape.topEdge);
        bottom?.setAttribute('d', shape.bottomEdge);
        reflection?.setAttribute('gradientTransform', `translate(${reflectionShift(config, phase).toFixed(1)} 0)`);
      });
    };
    const waveTweens: gsap.core.Tween[] = [];
    const stopWaveMotion = () => {
      waveTweens.forEach((tween) => tween.kill());
      waveTweens.length = 0;
      renderRibbons(0);
    };
    const startWaveMotion = () => {
      stopWaveMotion();
      if (preference.matches) return;
      const flow = { phase: 0 };
      waveTweens.push(gsap.to(flow, {
        phase: Math.PI * 2,
        duration: heroMotion.ribbon.loop,
        ease: 'none',
        repeat: -1,
        onUpdate: () => renderRibbons(flow.phase),
      }));
    };
    startWaveMotion();

    // Idle robots: a slow float, tilt and turn on the inner wrapper, so it never fights
    // the intro or pointer transforms on the outer .robot element.
    const idleLoops: gsap.core.Timeline[] = [];
    const stopIdle = () => {
      idleLoops.forEach((loop) => loop.kill());
      idleLoops.length = 0;
      gsap.set(floats, { yPercent: 0, rotation: 0, rotationY: 0 });
    };
    const startIdle = () => {
      stopIdle();
      if (preference.matches) return;
      floats.forEach((float, index) => {
        const idle = heroMotion.idle[index];
        const side = index ? -1 : 1;
        idleLoops.push(
          sway(float, 'yPercent', -idle.float, idle.floatPeriod),
          sway(float, 'rotation', idle.tilt * side, idle.tiltPeriod),
          sway(float, 'rotationY', idle.turn * side, idle.turnPeriod),
        );
      });
      syncLoops();
    };

    // Scroll parallax that eases toward the scroll position instead of jumping to it.
    const scrollFollow = { active: false, current: 0, top: 0, height: 1 };
    const measureStage = () => {
      scrollFollow.top = stage.getBoundingClientRect().top + window.scrollY;
      scrollFollow.height = Math.max(1, stage.offsetHeight);
    };
    const applyScroll = (progress: number) => {
      const { scroll } = heroMotion;
      gsap.set(message, { yPercent: scroll.message * progress });
      gsap.set([left, right], { yPercent: scroll.robots * progress });
      gsap.set(landscape, { yPercent: scroll.landscape * progress });
    };
    const followScroll = (_time: number, deltaTime: number) => {
      const target = Math.min(1, Math.max(0, (window.scrollY - scrollFollow.top) / scrollFollow.height));
      const gap = target - scrollFollow.current;
      if (Math.abs(gap) < .0005) return;
      const seconds = Math.min(deltaTime, 100) / 1000;
      scrollFollow.current += gap * (1 - Math.exp(-seconds * heroMotion.scroll.chase));
      applyScroll(scrollFollow.current);
    };
    const startFollow = () => {
      if (preference.matches) return;
      measureStage();
      scrollFollow.active = true;
      syncLoops();
    };
    const stopFollow = () => {
      scrollFollow.active = false;
      gsap.ticker.remove(followScroll);
      scrollFollow.current = 0;
      applyScroll(0);
    };

    // Loops run only while the hero is on screen and the tab is visible.
    let inView = true;
    let following = false;
    function syncLoops() {
      const run = inView && !document.hidden;
      [...waveTweens, ...idleLoops].forEach((loop) => loop.paused(!run));
      const follow = run && scrollFollow.active;
      if (follow && !following) gsap.ticker.add(followScroll);
      if (!follow && following) gsap.ticker.remove(followScroll);
      following = follow;
    }

    let introDone = false;
    const markLive = () => {
      introDone = true;
      stage.classList.add('is-live');
      startIdle();
      startFollow();
    };
    const revealHeadline = () => {
      headlineReveal?.kill();
      headlineReveal = gsap.fromTo(headlineTargets, { yPercent: 110, autoAlpha: 0 }, {
        yPercent: 0,
        autoAlpha: 1,
        duration: heroMotion.words.duration,
        stagger: heroMotion.words.stagger,
        ease: 'power3.out',
        clearProps: 'transform,opacity,visibility',
      });
    };

    const finePointer = window.matchMedia('(pointer: fine)');
    const parallax = {
      ryX: gsap.quickTo(left, 'x', { duration: .7, ease: 'power3.out' }),
      ryY: gsap.quickTo(left, 'y', { duration: .7, ease: 'power3.out' }),
      ziteX: gsap.quickTo(right, 'x', { duration: .7, ease: 'power3.out' }),
      ziteY: gsap.quickTo(right, 'y', { duration: .7, ease: 'power3.out' }),
    };
    // The pointer tilt trails the cursor on a longer ease than the position parallax.
    gsap.set([left, right, ...floats], { transformPerspective: heroMotion.perspective });
    const tiltEase = { duration: heroMotion.pointerTilt.lag, ease: 'power3.out' };
    const tilt = [left, right].map((robot) => ({
      turn: gsap.quickTo(robot, 'rotationY', tiltEase),
      pitch: gsap.quickTo(robot, 'rotationX', tiltEase),
    }));
    const resetParallax = () => {
      parallax.ryX(0); parallax.ryY(0); parallax.ziteX(0); parallax.ziteY(0);
      tilt.forEach(({ turn, pitch }) => { turn(0); pitch(0); });
    };
    const handleHeroPointerMove = (event: PointerEvent) => {
      if (!introDone || preference.matches || event.pointerType === 'touch') return;
      const rect = stage.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > window.innerHeight) return;
      const dx = Math.max(-1, Math.min(1, ((event.clientX - rect.left) / rect.width - .5) * 2));
      const dy = Math.max(-1, Math.min(1, ((event.clientY - rect.top) / rect.height - .5) * 2));
      parallax.ryX(dx * 8); parallax.ryY(dy * 6);
      parallax.ziteX(dx * 10); parallax.ziteY(dy * 8);
      const { turn, pitch } = heroMotion.pointerTilt;
      tilt.forEach((robot) => { robot.turn(dx * turn); robot.pitch(-dy * pitch); });
    };
    const handleHeroPointerLeave = () => resetParallax();
    if (finePointer.matches) {
      stage.addEventListener('pointermove', handleHeroPointerMove);
      stage.addEventListener('pointerleave', handleHeroPointerLeave);
    }

    const handleMotionPreferenceChange = () => {
      startWaveMotion();
      if (preference.matches) {
        stopIdle();
        stopFollow();
        resetParallax();
        if (timeline) timeline.progress(1).pause();
        headlineReveal?.progress(1).kill();
        gsap.set(headlineTargets, { clearProps: 'all' });
      } else if (introDone) {
        startIdle();
        startFollow();
      }
    };
    const handleVisibilityChange = () => syncLoops();
    document.addEventListener('visibilitychange', handleVisibilityChange);
    const visibility = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      syncLoops();
    });
    visibility.observe(stage);

    const drawRope = () => {
      const bounds = stage.getBoundingClientRect();
      const hand = (actor: HTMLElement, body: Element, x: number, y: number) => {
        const rect = actor.getBoundingClientRect();
        const style = getComputedStyle(body);
        const origin = style.transformOrigin.split(' ').map(Number.parseFloat);
        const point = new DOMPoint(actor.offsetWidth * x - origin[0], actor.offsetHeight * y - origin[1]);
        const transformed = point.matrixTransform(new DOMMatrix(style.transform === 'none' ? undefined : style.transform));
        return { x: rect.left - bounds.left + transformed.x + origin[0], y: rect.top - bounds.top + transformed.y + origin[1] };
      };
      const a = hand(left, bodies[0], .81, .45);
      const b = hand(right, bodies[1], .22, .45);
      const aInner = hand(left, bodies[0], .64, .51);
      const bInner = hand(right, bodies[1], .42, .51);
      const x1 = a.x;
      const x2 = b.x;
      const y1 = a.y;
      const y2 = b.y;
      const width = Math.max(0, x2 - x1);
      const wave = Math.min(width * .18, bounds.height * .075) * (1 - state.tension * .94);
      const vibration = Math.sin(state.ripple * Math.PI * 8) * state.tension * Math.min(width * .012, 4);
      const d = `M${aInner.x},${aInner.y} L${x1},${y1} C${x1 + width * .3},${y1 + wave + vibration} ${x2 - width * .3},${y2 + wave - vibration} ${x2},${y2} L${bInner.x},${bInner.y}`;
      paths.forEach((path) => path.setAttribute('d', d));
      rope.style.opacity = String((.8 + state.tension * .2) * (1 - state.dissolve));
    };

    const createTimeline = () => {
      timeline?.kill();
      clearTimeout(window.ryziteIntroFallback);
      document.documentElement.classList.add('home-intro');
      document.documentElement.classList.add('home-transition');
      gsap.set(chrome, { autoAlpha: 0, y: -12 });
      gsap.set([left, right], { x: 0, y: 0, rotation: 0, autoAlpha: 1 });
      gsap.set([...bodies, ...legs[0], ...legs[1]], { x: 0, y: 0, rotation: 0, scaleY: 1 });
      gsap.set(pullLayers, { autoAlpha: 1 });
      gsap.set(frontPoses, { autoAlpha: 0, scaleX: .95, transformOrigin: '50% 95%' });
      gsap.set(message, { autoAlpha: 0, y: 24 });
      const { follow } = heroMotion;
      gsap.set(headlineTargets, { autoAlpha: 0, yPercent: 110 });
      gsap.set([description, cta], { autoAlpha: 0, y: follow.rise, filter: `blur(${follow.blur}px)` });
      gsap.set(shadows, { scaleX: 1, opacity: .65 });
      gsap.set(flash, { opacity: 0, scale: .6 });
      Object.assign(state, { progress: 0, tension: 0, ripple: 0, dissolve: 0 });
      const travel = Math.max(0, stage.clientWidth * .5 - left.offsetWidth * 1.02 - left.offsetLeft);
      timeline = gsap.timeline({
        delay: .2,
        onUpdate: drawRope,
        onComplete: () => {
          document.documentElement.classList.remove('home-intro', 'home-transition');
          markLive();
        },
      });
      const steps = 3;
      const stride = .6;
      for (let step = 1; step <= steps; step++) {
        const position = (step - 1) * stride;
        // Plant the feet, lean away, then overcome the rope's resistance.
        timeline.to(bodies[0], { rotation: -7, x: -3, y: 4, duration: .24, ease: 'power2.inOut' }, position)
          .to(bodies[1], { rotation: 7, x: 3, y: 4, duration: .24, ease: 'power2.inOut' }, position)
          .to(state, { tension: 1, ripple: step, duration: .24, ease: 'power2.in' }, position);
        timeline.to(state, { progress: step / steps, duration: .52, ease: 'none' }, position + .08);

        const activeTimeline = timeline;
        [left, right].forEach((actor, index) => {
          const direction = index === 0 ? 1 : -1;
          const lift = Math.min(actor.offsetHeight * .035, 15);
          const reach = Math.min(actor.offsetWidth * .028, 10);
          const footfall = (step - 1) % 2;
          const time = position + .08;
          const swing = legs[index][footfall];
          const planted = legs[index][1 - footfall];
          activeTimeline.to(actor, { x: direction * travel * step / steps, duration: .52, ease: 'sine.inOut' }, time)
            .to(swing, { rotation: -direction * 8, x: direction * reach, y: -lift, duration: .24, ease: 'sine.out' }, time)
            .to(planted, { rotation: direction * 3, x: -direction * reach * .5, y: 0, duration: .45, ease: 'sine.inOut' }, time)
            .to(bodies[index], { rotation: -direction * 3, x: direction, y: -3, scaleY: 1, duration: .22, ease: 'sine.out' }, time)
            .to(shadows[index], { scaleX: .94, opacity: .6, duration: .22 }, time)
            .to(swing, { rotation: 0, x: 0, y: 0, duration: .22, ease: 'power2.in' }, time + .26)
            .to(bodies[index], { rotation: 0, x: 0, y: 0, scaleY: 1, duration: .2, ease: 'power1.out' }, time + .38)
            .to(shadows[index], { scaleX: 1, opacity: .65, duration: .2 }, time + .38);
        });
        timeline.to(state, { tension: .38, duration: .18, ease: 'power2.out' }, position + .45);
      }
      const finish = (steps - 1) * stride + .64;
      timeline.to(bodies, { rotation: 0, x: 0, y: 0, duration: .4 }, finish)
        .to(state, { tension: .15, duration: .6 }, finish)
        .to(flash, { opacity: .85, scale: 1, duration: .35 }, finish)
        .to(state, { dissolve: 1, duration: .25 }, finish + .1)
        // Rope pulled: a small celebratory hop, then the hero comes in straight away.
        .to([left, right], { scaleY: .93, y: 8, duration: .16, ease: 'power2.in' }, finish + .1)
        .to([left, right], { scaleY: 1.03, y: () => -Math.min(stage.clientHeight * .07, 48), duration: .3, ease: 'power2.out' }, finish + .26)
        .to(shadows, { scaleX: .8, opacity: .4, duration: .3 }, finish + .26)
        .to([left, right], { scaleY: 1, y: 0, duration: .26, ease: 'power2.in' }, finish + .56)
        .to(shadows, { scaleX: 1, opacity: .65, duration: .26 }, finish + .56)
        .to(flash, { opacity: 0, duration: .3, ease: 'power2.out' }, finish + .6)
        .to([left, right], { autoAlpha: 0, duration: .22, ease: 'power2.in' }, finish + .85)
        .set([left, right], { x: 0, y: 16 }, finish + 1.08)
        .set(pullLayers, { autoAlpha: 0 }, finish + 1.08)
        .set(frontPoses, { autoAlpha: 1, scaleX: 1 }, finish + 1.08)
        .set(message, { autoAlpha: 1, y: 0 }, finish + 1.08)
        .call(() => {
          document.documentElement.classList.remove('home-intro');
        }, [], finish + 1.08)
        .to(chrome, { autoAlpha: 1, y: 0, duration: .6, ease: 'power2.out' }, finish + 1.08)
        .to([left, right], { autoAlpha: 1, y: 0, duration: .7, stagger: .1, ease: 'power2.out' }, finish + 1.12)
        .to([description, cta], { autoAlpha: 1, y: 0, filter: 'blur(0px)', duration: follow.duration, stagger: follow.stagger, ease: heroMotion.revealEase, clearProps: 'transform,filter' }, finish + 2.55);
      if (!preference.matches && !skipIntro) timeline.call(revealHeadline, [], finish + 1.18);
      if (preference.matches || skipIntro) {
        timeline.progress(1).pause();
        document.documentElement.classList.remove('home-intro', 'home-transition');
        if (preference.matches) gsap.set(headlineTargets, { clearProps: 'all' });
        else revealHeadline();
        markLive();
      }
      drawRope();
    };

    preference.addEventListener('change', handleMotionPreferenceChange);
    document.addEventListener('astro:before-swap', () => {
      timeline?.kill();
      headlineReveal?.kill();
      stopWaveMotion();
      stopIdle();
      stopFollow();
      visibility.disconnect();
      resizeObserver.disconnect();
      document.removeEventListener('visibilitychange', handleVisibilityChange);
      stage.removeEventListener('pointermove', handleHeroPointerMove);
      stage.removeEventListener('pointerleave', handleHeroPointerLeave);
      preference.removeEventListener('change', handleMotionPreferenceChange);
    }, { once: true });
    let resizeTimer: ReturnType<typeof setTimeout> | undefined;
    let observedWidth = stage.clientWidth;
    const resizeObserver = new ResizeObserver(() => {
      if (introDone) measureStage();
      if (!imagesReady) return;
      if (stage.clientWidth === observedWidth) return;
      observedWidth = stage.clientWidth;
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        const progress = timeline?.progress() || 0;
        const paused = timeline?.paused();
        createTimeline();
        timeline?.progress(progress).paused(paused || progress === 1);
        if (progress === 1) markLive();
        drawRope();
      }, 150);
    });
    resizeObserver.observe(stage);
    Promise.all([...bodies, ...frontPoses].map((img) => img.decode().catch(() => {}))).then(() => {
      if (!stage.isConnected) return;
      imagesReady = true;
      if (!skipIntro) {
        try { window.sessionStorage.setItem(introSeenKey, 'true'); } catch {}
      }
      createTimeline();
    });
  };
  initializeConnection();
  document.addEventListener('astro:page-load', initializeConnection);
</script>


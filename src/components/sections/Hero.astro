---
import ArrowUpRight from '../ui/ArrowUpRight.astro';
import { homeTranslations } from '../../data/home-translations';
import { homeSectionsTranslations } from '../../data/home-sections-translations';

const scenes = homeTranslations.en.heroStory;
const { marketing, technology } = homeSectionsTranslations.en.divisions;

// Animated wave layers drawn over the footage's own (baked-in) waves. Each path repeats every
// 1440 units across a 2880-unit canvas, so sliding it by half its width loops seamlessly.
const WAVE_WIDTH = 2880;
const WAVE_HEIGHT = 900;
const wavePath = (base: number, amplitude: number, wavelength: number, phase = 0) => {
  const points: string[] = [];
  for (let x = 0; x <= WAVE_WIDTH; x += 16) {
    const angle = (2 * Math.PI * x) / wavelength + phase;
    const y = base + amplitude * Math.sin(angle) + amplitude * .28 * Math.sin(2 * angle + 1.3);
    points.push(`${x},${y.toFixed(1)}`);
  }
  return `M${points.join(' L')} L${WAVE_WIDTH},${WAVE_HEIGHT} L0,${WAVE_HEIGHT} Z`;
};
const crestPath = (base: number, amplitude: number, wavelength: number, phase = 0) =>
  wavePath(base, amplitude, wavelength, phase).split(` L${WAVE_WIDTH},${WAVE_HEIGHT}`)[0];

const waveLayers = [
  { name: 'back', d: wavePath(300, 85, 1440, .4), gradient: ['#078be9', .2, '#cfe8ff', 0] },
  { name: 'middle', d: wavePath(440, 75, 1440, 2.4), gradient: ['#0655e9', .18, '#078be9', .03] },
  { name: 'front', d: wavePath(570, 62, 1440, 4.2), gradient: ['#0643cf', .2, '#ffffff', .06], crest: crestPath(570, 62, 1440, 4.2) },
] as const;

// Fill waves sit behind the footage. Their mask is the inverse of the video's edge fade, shifted by
// the same pan, so they only show in the strip the sliding video uncovers and blend through its fade.
// Colours are sampled from the footage's own waves.
const fillLayers = [
  { name: 'back', d: wavePath(330, 70, 1440, 1.1), gradient: ['#8bbdd6', .95, '#b6cfdc', .2] },
  { name: 'middle', d: wavePath(430, 62, 1440, 3.1), gradient: ['#3d7cc4', .85, '#6ea9d3', .25] },
  { name: 'front', d: wavePath(520, 54, 1440, 5.2), gradient: ['#6ea9d3', .8, '#c3d4de', 0] },
] as const;

// Two-tone scene titles: scene index → number of leading words in ink; the rest is blue.
// Keep in sync with splitRules in index.astro, which re-applies the split on language change.
const titleSplits: Record<number, number> = { 0: 2, 2: 2 };

// Each scene sits opposite the robot in the footage: robot right → text left, and so on.
const sceneLayout = [
  { side: 'left', href: '/solutions/' },
  { side: 'right', href: '/services/' },
  { side: 'left', href: '/contact/' },
];
---

<section class="video-hero" data-video-hero aria-labelledby="hero-title">
  <div class="video-hero__stage" data-video-stage>
    <div class="video-hero__media" aria-hidden="true">
      <div class="video-hero__fill">
        {fillLayers.map((layer) => (
          <div class={`video-hero__fill-layer video-hero__fill-layer--${layer.name}`}>
            <svg viewBox={`0 0 ${WAVE_WIDTH} ${WAVE_HEIGHT}`} preserveAspectRatio="none" focusable="false">
              <defs>
                <linearGradient id={`hero-fill-${layer.name}`} x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color={layer.gradient[0]} stop-opacity={layer.gradient[1]} />
                  <stop offset="1" stop-color={layer.gradient[2]} stop-opacity={layer.gradient[3]} />
                </linearGradient>
              </defs>
              <path d={layer.d} fill={`url(#hero-fill-${layer.name})`} />
            </svg>
          </div>
        ))}
      </div>
      <img
        class="video-hero__poster"
        src="/images/hero/ryzite-robot-poster.jpg"
        alt=""
        width="1000"
        height="562"
        fetchpriority="high"
      />
      <video
        class="video-hero__video"
        src="/images/hero/Novu_London_fashion_landing_page_b5275c3a.mp4"
        poster="/images/hero/ryzite-robot-poster.jpg"
        muted
        playsinline
        preload="auto"
        aria-hidden="true"
      ></video>
    </div>
    <div class="video-hero__waves" aria-hidden="true">
      {waveLayers.map((layer) => (
        <div class={`video-hero__wave video-hero__wave--${layer.name}`}>
          <svg viewBox={`0 0 ${WAVE_WIDTH} ${WAVE_HEIGHT}`} preserveAspectRatio="none" focusable="false">
            <defs>
              <linearGradient id={`hero-wave-${layer.name}`} x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color={layer.gradient[0]} stop-opacity={layer.gradient[1]} />
                <stop offset="1" stop-color={layer.gradient[2]} stop-opacity={layer.gradient[3]} />
              </linearGradient>
            </defs>
            <path d={layer.d} fill={`url(#hero-wave-${layer.name})`} />
            {'crest' in layer && <path class="video-hero__crest" d={layer.crest} fill="none" />}
          </svg>
        </div>
      ))}
    </div>
    <div class="video-hero__overlay" aria-hidden="true"></div>

    {scenes.map((scene, index) => {
      const layout = sceneLayout[index] ?? sceneLayout[0];
      const isFirst = index === 0;
      const Heading = isFirst ? 'h1' : 'h2';
      return (
        <article
          class:list={['video-hero__panel', `video-hero__panel--${layout.side}`, { 'is-visible': isFirst }]}
          data-video-panel={index}
          aria-hidden={isFirst ? 'false' : 'true'}
          inert={!isFirst}
        >
          {isFirst ? (
            <p class="video-hero__eyebrow video-hero__eyebrow--logo">
              <img
                class="video-hero__wordmark"
                src="/images/hero/ryzite-wordmark.png"
                alt="RYZITE"
                width="640"
                height="386"
                fetchpriority="high"
              />
            </p>
          ) : (
            <p class="video-hero__eyebrow" data-home-key={`heroStory.${index}.eyebrow`}>{scene.eyebrow}</p>
          )}
          <Heading class:list={['video-hero__title', { 'hs-bicolor': index in titleSplits, 'video-hero__title--stacked': index === 0 }]} id={isFirst ? 'hero-title' : undefined} data-home-key={`heroStory.${index}.title`}>
            {index in titleSplits ? (
              <>
                <span class="hs-bicolor__base">{scene.title.split(/\s+/).slice(0, titleSplits[index]).join(' ')}</span>
                <span class="hs-bicolor__accent"> {scene.title.split(/\s+/).slice(titleSplits[index]).join(' ')}</span>
              </>
            ) : scene.title}
          </Heading>
          <p class="video-hero__body" data-home-key={`heroStory.${index}.body`}>{scene.body}</p>
          <a class="video-hero__button" href={layout.href}>
            <span data-home-key={`heroStory.${index}.cta`}>{scene.cta}</span>
            <span class="video-hero__arrow" aria-hidden="true"><ArrowUpRight /></span>
          </a>
          {isFirst && (
            <nav class="video-hero__fallback-pathways" aria-label="Explore RYZITE">
              <a class="video-hero__button video-hero__button--ghost" href="/services/" data-home-key="sections.divisions.marketing.kicker">{marketing.kicker}</a>
              <a class="video-hero__button video-hero__button--ghost" href="/solutions/" data-home-key="sections.divisions.technology.kicker">{technology.kicker}</a>
            </nav>
          )}
        </article>
      );
    })}

    <div class="video-hero__progress" aria-hidden="true">
      {scenes.map(() => <span data-video-dot></span>)}
    </div>
  </div>
</section>

<script>
  import '../../scripts/hero-video-story';
</script>

<style is:global>
  /* On the homepage the header is hidden from first paint (so it never flashes on refresh) and
     appears when the Business Challenge section reaches the top. hero-video-story.ts adds
     .hero-shows-header at that point, and also for the static fallback. */
  .site-header {
    transition: transform 360ms cubic-bezier(.22, 1, .36, 1), opacity 240ms ease;
  }

  html:has([data-video-hero]):not(.hero-shows-header) .site-header:not(:focus-within) {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-100%);
  }

  /* Reduced motion and no-JS keep the header visible. */
  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
    html:has([data-video-hero]) .site-header { opacity: 1 !important; pointer-events: auto !important; transform: none !important; }
  }

  @media (scripting: none) {
    html:has([data-video-hero]) .site-header { opacity: 1 !important; pointer-events: auto !important; transform: none !important; }
  }
</style>

<style>
  .video-hero {
    /* Same palette as the homepage sections (home-sections.css, BusinessChallenge). */
    --hero-ink: #0a1734;
    --hero-body: #465771;
    --hero-accent: var(--color-brand);
    --hero-cta: var(--color-brand);
    --hero-cta-shadow: 0 8px 18px #0b1c5835;
    --hero-bg: #dfe9f1;
    --hero-gutter: max(28px, calc((100vw - 1300px) / 2)); /* aligns with the header logo */
    --hero-ease: var(--ease-out);
    /* Footage has the robot centred; slide it sideways so it sits opposite the copy. */
    --pan-distance: 24%;

    position: relative;
    height: 100svh;
    margin-top: -86px;
    background: var(--hero-bg);
    color: var(--hero-ink);
    font-family: var(--font-body);
  }

  .video-hero.is-animated {
    height: 500svh;
  }

  .video-hero__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    isolation: isolate;
    overflow: hidden;
    background: var(--hero-bg);
  }

  .video-hero__media,
  .video-hero__poster,
  .video-hero__video,
  .video-hero__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Matches the footage's edge colours, so the gap the slide opens blends in. */
  .video-hero__media {
    background:
      linear-gradient(180deg, #c8dbe2 0%, #c9dbe2 28%, #8fcbe0 44%, #6cbfdc 52%, #bdd4de 64%, #b5cdd9 100%) left / 50% 100% no-repeat,
      linear-gradient(180deg, #c4d6da 0%, #bdcfd9 28%, #7fa6cf 46%, #8fb9d1 54%, #b6c8d2 64%, #b0c4cf 100%) right / 50% 100% no-repeat;
  }

  .video-hero__fill {
    --pan-offset: calc(var(--video-pan, 1) * var(--pan-distance));
    position: absolute;
    right: 0;
    bottom: 12%;
    left: 0;
    height: 62%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg,
      #000 var(--pan-offset),
      transparent calc(var(--pan-offset) + 14%),
      transparent calc(var(--pan-offset) + 86%),
      #000 calc(var(--pan-offset) + 100%));
    mask-image: linear-gradient(90deg,
      #000 var(--pan-offset),
      transparent calc(var(--pan-offset) + 14%),
      transparent calc(var(--pan-offset) + 86%),
      #000 calc(var(--pan-offset) + 100%));
  }

  .video-hero__fill-layer {
    position: absolute;
    inset: 0;
  }

  .video-hero__fill-layer--back svg { animation: hero-wave-flow-left 80s linear infinite; }
  .video-hero__fill-layer--middle svg { animation: hero-wave-flow-right 56s linear infinite; }
  .video-hero__fill-layer--front svg { animation: hero-wave-flow-left 38s linear infinite; }

  .video-hero.is-offscreen .video-hero__fill-layer svg {
    animation-play-state: paused;
  }

  .video-hero__poster,
  .video-hero__video {
    display: block;
    object-fit: cover;
    object-position: var(--video-x, 50%) center;
    transform: translate3d(calc(var(--video-pan, 1) * var(--pan-distance)), 0, 0);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 14%, #000 86%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 14%, #000 86%, transparent 100%);
    will-change: transform;
  }

  .video-hero__video {
    opacity: 0;
  }

  .video-hero.is-animated .video-hero__video {
    opacity: 1;
  }

  .video-hero.is-animated .video-hero__poster {
    opacity: 0;
  }

  .video-hero__overlay {
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgb(223 233 241 / 35%), transparent 18%),
      /* Soft hand-off into the paper background of the next section. */
      linear-gradient(0deg, var(--color-paper) 0%, rgb(250 248 244 / 0%) 9%);
  }

  /* Wave layers: blended over the footage's waves, behind the copy. A soft gap follows the robot
     (--robot-x, set by hero-video-story.ts) so the waves never cross its body. */
  .video-hero__waves {
    --robot-x: 50%;
    --robot-hole: 12%;
    --robot-feather: 6%;
    --wave-mask: linear-gradient(90deg,
      #000 calc(var(--robot-x) - var(--robot-hole) - var(--robot-feather)),
      transparent calc(var(--robot-x) - var(--robot-hole)),
      transparent calc(var(--robot-x) + var(--robot-hole)),
      #000 calc(var(--robot-x) + var(--robot-hole) + var(--robot-feather)));

    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 0;
    left: 0;
    height: 62%;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: var(--wave-mask);
    mask-image: var(--wave-mask);
  }

  .video-hero:not(.is-animated) .video-hero__waves {
    display: none;
  }

  .video-hero__wave {
    position: absolute;
    inset: 0;
  }

  .video-hero__wave svg,
  .video-hero__fill svg {
    display: block;
    width: 200%;
    /* The global reset caps svg at 100%; without this the layer is only one screen wide and its
       end slides into view as a hard vertical edge while it drifts. */
    max-width: none;
    height: 100%;
  }

  .video-hero__crest {
    stroke: rgb(255 255 255 / 38%);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  /* Background: very slow drift right→left with a gentle light swell. */
  .video-hero__wave--back {
    animation: hero-wave-light 14s ease-in-out infinite alternate;
  }

  .video-hero__wave--back svg {
    animation: hero-wave-flow-left 70s linear infinite;
  }

  /* Middle: gentle flow left→right. */
  .video-hero__wave--middle {
    animation: hero-wave-swell 11s ease-in-out infinite alternate;
  }

  .video-hero__wave--middle svg {
    animation: hero-wave-flow-right 46s linear infinite;
  }

  /* Foreground: strongest rise and fall, a little faster. */
  .video-hero__wave--front {
    animation: hero-wave-rise 8s ease-in-out infinite alternate;
  }

  .video-hero__wave--front svg {
    animation: hero-wave-flow-left 30s linear infinite;
  }

  .video-hero.is-offscreen .video-hero__wave,
  .video-hero.is-offscreen .video-hero__wave svg {
    animation-play-state: paused;
  }

  @keyframes hero-wave-flow-left {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  @keyframes hero-wave-flow-right {
    from { transform: translate3d(-50%, 0, 0); }
    to { transform: translate3d(0, 0, 0); }
  }

  @keyframes hero-wave-light {
    from { opacity: .75; transform: translate3d(0, 0, 0); }
    to { opacity: 1; transform: translate3d(0, -6px, 0); }
  }

  @keyframes hero-wave-swell {
    from { transform: translate3d(0, 6px, 0); }
    to { transform: translate3d(0, -10px, 0); }
  }

  @keyframes hero-wave-rise {
    from { transform: translate3d(0, 10px, 0) scaleY(.97); }
    to { transform: translate3d(0, -16px, 0) scaleY(1.03); }
  }

  /* Scenes: text sits straight on the footage, no card. */
  .video-hero__panel {
    position: absolute;
    z-index: 2;
    top: 50%;
    display: flex;
    width: min(44%, 40rem);
    flex-direction: column;
    align-items: flex-start;
    opacity: 0;
    transform: translate3d(0, calc(-50% + var(--panel-shift, 24px)), 0);
    visibility: hidden;
    will-change: opacity, transform;
  }

  .video-hero__panel--left {
    left: var(--hero-gutter);
  }

  .video-hero__panel--right {
    left: 53%;
  }

  .video-hero__panel.is-visible,
  .video-hero:not(.is-animated) .video-hero__panel[data-video-panel="0"] {
    opacity: 1;
    visibility: visible;
  }

  .video-hero:not(.is-animated) .video-hero__panel[data-video-panel="0"] {
    transform: translate3d(0, -50%, 0);
  }

  .video-hero__eyebrow {
    margin: 0 0 18px;
    color: var(--hero-accent);
    font-size: var(--size-eyebrow);
    font-weight: var(--weight-strong);
    letter-spacing: .16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  /* Slide 1 shows the RYZITE wordmark itself, so it matches the logo lettering exactly. */
  .video-hero__eyebrow--logo {
    margin-bottom: clamp(10px, 1.2vw, 18px);
    line-height: 0;
  }

  .video-hero__wordmark {
    display: block;
    width: auto;
    height: clamp(48px, 5.4vw, 92px);
  }

  .video-hero__title :global(.hs-bicolor__base) { color: var(--hero-ink); }
  .video-hero__title :global(.hs-bicolor__accent) { color: var(--color-brand); }
  /* Scene 1: ink phrase ("One Agency.") on its own line above the blue phrase. */
  .video-hero__title--stacked :global(.hs-bicolor__base) { display: block; }

  .video-hero__title {
    margin: 0;
    color: var(--hero-ink);
    font-family: var(--font-heading);
    font-size: var(--size-hero);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-hero);
    line-height: var(--leading-hero);
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  /* Tamil and Sinhala words run long; scale the headline down so it fits on every width. */
  :global(html[lang='ta']) .video-hero__title,
  :global(html[lang='si']) .video-hero__title {
    font-size: var(--size-h1);
    letter-spacing: 0;
    line-height: 1.2;
  }

  .video-hero__body {
    max-width: 30rem;
    margin: clamp(18px, 2vw, 28px) 0 clamp(24px, 2.6vw, 36px);
    color: var(--hero-body);
    font-size: var(--size-lead);
    font-weight: var(--weight-strong);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .video-hero__button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: 14px;
    padding: 15px 28px;
    border: 0;
    border-radius: 999px;
    background: var(--hero-cta);
    box-shadow: var(--hero-cta-shadow);
    color: #fff;
    font-size: 17.5px;
    font-weight: var(--weight-strong);
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition: transform var(--duration-fast) var(--hero-ease), box-shadow var(--duration-fast) var(--hero-ease);
  }

  .video-hero__button:hover {
    box-shadow: 0 12px 24px #0b1c584d;
    transform: translateY(-3px);
  }

  .video-hero__button:not(.video-hero__button--ghost):hover {
    background: var(--color-brand-hover);
  }

  .video-hero__button:focus-visible {
    outline: 3px solid var(--hero-accent);
    outline-offset: 4px;
  }

  .video-hero__arrow {
    font-size: .85em;
    transition: transform 200ms var(--hero-ease);
  }

  .video-hero__button:hover .video-hero__arrow {
    transform: translateX(3px);
  }

  .video-hero__button--ghost {
    border: 2px solid #fff;
    background: linear-gradient(135deg, var(--color-milk), #edf3ff);
    box-shadow: 0 9px 24px #0b1c5824;
    color: var(--hero-accent);
  }

  .video-hero__fallback-pathways {
    display: none;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 14px;
  }

  /* Only for the real static fallback (no JS, video error, reduced motion), not while the video loads. */
  .video-hero:not([data-initialized]) .video-hero__fallback-pathways,
  .video-hero.is-static .video-hero__fallback-pathways {
    display: flex;
  }

  @media (prefers-reduced-motion: reduce) {
    .video-hero:not(.is-animated) .video-hero__fallback-pathways {
      display: flex;
    }
  }

  /* Scene progress dots */
  .video-hero__progress {
    position: absolute;
    z-index: 2;
    bottom: 28px;
    left: 50%;
    display: none;
    gap: 8px;
    transform: translateX(-50%);
  }

  .video-hero.is-animated .video-hero__progress {
    display: flex;
  }

  .video-hero__progress span {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: rgb(19 40 92 / 25%);
    transition: width 300ms var(--hero-ease), background-color 300ms ease;
  }

  .video-hero__progress span.is-active {
    width: 22px;
    background: var(--hero-accent);
  }

  @media (max-width: 760px) {
    .video-hero {
      --pan-distance: 0%;

      margin-top: -70px;
    }

    /* The footage is 16:9. Filling a tall phone screen would upscale it ~3.5x (blurry) and crop
       the robot to a sliver, so on phones the video keeps its own 16:9 box in the lower part of
       the stage, below the copy. The robot is centred in the footage, so centring that box on
       --robot-x places the robot there on every phone height (hero-video-story.ts reads the box
       to keep the wave gap on the robot; it also moves --robot-x-mobile right → left → right with
       the scenes and sets --robot-in-footage, since the robot walks off-centre by scene 3). Its top edge fades into the background. */
    .video-hero {
      --mobile-video-height: 50svh;
      --robot-x-mobile: 74%;
      --robot-in-footage: .5; /* robot's x inside the footage, as a fraction of its width */
    }

    .video-hero__poster,
    .video-hero__video {
      top: auto;
      right: auto;
      bottom: 0;
      /* clamp() keeps the box covering both screen edges, whichever side the robot is on. */
      left: clamp(
        calc(100% - var(--mobile-video-height) * 16 / 9),
        calc(var(--robot-x-mobile) - var(--mobile-video-height) * 16 / 9 * var(--robot-in-footage)),
        0px
      );
      width: calc(var(--mobile-video-height) * 16 / 9);
      max-width: none;
      height: var(--mobile-video-height);
      object-position: 50% 50%;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 22%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 22%);
    }

    .video-hero__media {
      background: linear-gradient(180deg, var(--hero-bg) 0%, var(--hero-bg) 46%, #c9dbe2 62%, #b5cdd9 100%);
    }

    .video-hero__fill {
      display: none;
    }

    .video-hero__overlay {
      background: linear-gradient(180deg, rgb(223 233 241 / 60%) 0%, transparent 40%);
    }

    /* On phones the copy stacks above the robot instead of beside it. */
    .video-hero__panel,
    .video-hero__panel--left,
    .video-hero__panel--right {
      top: calc(70px + 6svh);
      right: 20px;
      left: 20px;
      width: auto;
      transform: translate3d(0, var(--panel-shift, 24px), 0);
    }


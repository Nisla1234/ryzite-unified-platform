---
// [OPEN] General overview only, not a confirmed payment policy. Do not add amounts,
// percentages, schedules, or deadlines until payment terms are approved.
import { homeSectionsTranslations } from '../../data/home-sections-translations';

const copy = homeSectionsTranslations.en.payments;
// Step images supplied by the client. [UNVERIFIED] Confirm usage rights before launch.
const images = [
  { src: '/images/payments/initial-payment.jpg', width: 736, height: 412 },
  { src: '/images/payments/milestone-payments.jpg', width: 735, height: 412 },
  { src: '/images/payments/final-payment-handover.jpg', width: 636, height: 382 },
];
---

<section class="hs-section payments" aria-labelledby="payments-title">
  <div class="payments-glow" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="hs-shell">
    <header class="hs-heading" data-hs-reveal>
      <h2 id="payments-title" class="hs-bicolor" data-home-key="sections.payments.title">{copy.title}</h2>
      <p data-home-key="sections.payments.intro">{copy.intro}</p>
    </header>

    <ol class="payments-steps">
      {copy.steps.map((step, index) => (
        <li class="hs-card payment-step" data-hs-reveal data-hs-delay={index * 0.12}>
          <div class="payment-step__media">
            <img src={images[index].src} alt="" width={images[index].width} height={images[index].height} loading="lazy" decoding="async" />
            <span class="payment-step__number" aria-hidden="true">0{index + 1}</span>
          </div>
          <h3 data-home-key={`sections.payments.steps.${index}.title`}>{step.title}</h3>
          <p data-home-key={`sections.payments.steps.${index}.body`}>{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .payments-steps { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-grid); margin: 0; padding: 0; list-style: none; }
  .payments-steps::before { content: ''; position: absolute; z-index: -1; top: 6rem; left: 12%; right: 12%; border-top: 2px dashed #8db6fa; }
  /* Glassmorphism: soft colour glows behind frosted, translucent cards. */
  .payments { background: linear-gradient(180deg, #f6f9ff 0%, #eef4ff 100%); }
  .payments-glow { position: absolute; inset: 0; z-index: -2; overflow: hidden; pointer-events: none; }
  .payments-glow span { position: absolute; border-radius: 50%; filter: blur(60px); opacity: .55; }
  .payments-glow span:nth-child(1) { top: 30%; left: -6%; width: 34vw; height: 34vw; max-width: 520px; max-height: 520px; background: #4f9bff; }
  .payments-glow span:nth-child(2) { top: 45%; left: 38%; width: 26vw; height: 26vw; max-width: 400px; max-height: 400px; background: #8fd3ff; }
  .payments-glow span:nth-child(3) { top: 22%; right: -8%; width: 36vw; height: 36vw; max-width: 540px; max-height: 540px; background: #6b7dff; opacity: .4; }

  .payment-step.hs-card {
    padding: clamp(1.4rem, 2.5vw, 1.9rem);
    border: 1px solid rgb(255 255 255 / 65%);
    background: linear-gradient(145deg, rgb(255 255 255 / 62%), rgb(255 255 255 / 28%));
    box-shadow: 0 18px 40px #0655e91f, inset 0 1px 0 rgb(255 255 255 / 85%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
  }
  @media (hover: hover) {
    .payment-step.hs-card:hover { border-color: rgb(255 255 255 / 90%); box-shadow: 0 24px 48px #0655e92e, inset 0 1px 0 #fff; }
  }
  /* Browsers without backdrop-filter get a solid, readable card instead. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .payment-step.hs-card { background: rgb(255 255 255 / 92%); }
  }
  .payment-step__media { position: relative; overflow: hidden; aspect-ratio: 16 / 9; margin-bottom: 1.2rem; border-radius: var(--radius-small); background: var(--hs-pale); box-shadow: 0 8px 20px #0655e91a; }
  .payment-step__media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: scale var(--duration-medium) var(--ease-out); }
  .payment-step__number { position: absolute; top: .7rem; left: .7rem; display: grid; place-items: center; min-width: 2.6rem; height: 2.6rem; padding: 0 .55rem; border-radius: 999px; background: linear-gradient(110deg, #008aff, #063df3); box-shadow: 0 6px 14px #085be740; color: #fff; font-family: var(--font-display); font-size: 1rem; font-weight: 700; line-height: 1; }
  @media (hover: hover) { .payment-step:hover .payment-step__media img { scale: 1.05; } }
  @media (prefers-reduced-motion: reduce) { .payment-step__media img { transition: none; } }
  @media (max-width: 800px) {
    .payments-glow span:nth-child(1) { top: 20%; width: 70vw; height: 70vw; }
    .payments-glow span:nth-child(2) { top: 50%; left: 30%; width: 60vw; height: 60vw; }
    .payments-glow span:nth-child(3) { top: 75%; width: 70vw; height: 70vw; }
    .payments-steps { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
    .payments-steps::before { top: 2rem; bottom: 2rem; left: 2.9rem; right: auto; border-top: 0; border-left: 2px dashed #a9c8fb; }
  }
</style>

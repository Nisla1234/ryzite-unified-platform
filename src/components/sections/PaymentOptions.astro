---
// [OPEN] General overview only, not a confirmed payment policy. Do not add amounts,
// percentages, schedules, or deadlines until payment terms are approved.
import { homeSectionsTranslations } from '../../data/home-sections-translations';

const copy = homeSectionsTranslations.en.payments;
const icons = [
  'M4 7h15a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z M4 7l11-3v3 M16 13h.01',
  'M5 21V4 M5 4h11l-2 4 2 4H5 M9 21h-4',
  'M20 6 9 17l-5-5',
];
---

<section class="hs-section payments" aria-labelledby="payments-title">
  <div class="hs-shell">
    <header class="hs-heading" data-hs-reveal>
      <p class="hs-eyebrow" data-home-key="sections.payments.eyebrow">{copy.eyebrow}</p>
      <h2 id="payments-title" data-home-key="sections.payments.title">{copy.title}</h2>
      <p data-home-key="sections.payments.intro">{copy.intro}</p>
    </header>

    <ol class="payments-steps">
      {copy.steps.map((step, index) => (
        <li class="hs-card payment-step" data-hs-reveal data-hs-delay={index * 0.12}>
          <div class="payment-step__top">
            <span class="hs-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icons[index]} /></svg></span>
            <span class="payment-step__number" aria-hidden="true">0{index + 1}</span>
          </div>
          <h3 data-home-key={`sections.payments.steps.${index}.title`}>{step.title}</h3>
          <p data-home-key={`sections.payments.steps.${index}.body`}>{step.body}</p>
        </li>
      ))}
    </ol>

    <p class="payments-note" data-hs-reveal>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5 M12 8h.01" /></svg>
      <span data-home-key="sections.payments.note">{copy.note}</span>
    </p>
  </div>
</section>

<style>
  .payments-steps { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-grid); margin: 0; padding: 0; list-style: none; }
  .payments-steps::before { content: ''; position: absolute; z-index: -1; top: 3.2rem; left: 12%; right: 12%; border-top: 2px dashed #a9c8fb; }
  .payment-step { padding: clamp(1.4rem, 2.5vw, 1.9rem); }
  .payment-step__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.1rem; }
  .payment-step__number { color: #c9dcff; font-family: var(--font-display); font-size: 2rem; font-weight: 800; line-height: 1; }
  .payments-note { display: flex; align-items: flex-start; gap: .75rem; max-width: 46rem; margin: clamp(1.75rem, 4vw, 2.5rem) auto 0; padding: 1rem 1.25rem; border: 1px solid var(--hs-line); border-left: 4px solid var(--hs-blue); border-radius: var(--radius-small); color: var(--hs-ink); background: var(--hs-pale); font-size: .9375rem; font-weight: 600; line-height: 1.6; }
  .payments-note svg { flex-shrink: 0; width: 1.35rem; height: 1.35rem; margin-top: .1rem; color: var(--hs-blue); }
  @media (max-width: 800px) {
    .payments-steps { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
    .payments-steps::before { top: 2rem; bottom: 2rem; left: 2.9rem; right: auto; border-top: 0; border-left: 2px dashed #a9c8fb; }
  }
</style>

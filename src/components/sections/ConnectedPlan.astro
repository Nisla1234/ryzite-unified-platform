---
import { homeSectionsTranslations } from '../../data/home-sections-translations';

const copy = homeSectionsTranslations.en.connected;
// Material Symbols (outlined, 24px): home, target, link, electric_bolt, trending_up. Filled paths, coloured via currentColor.
const highlightIcons = [
  'M6,19H9V13h6v6h3V10L12,5.5L6,10v9ZM4,21V9l8-6l8,6V21H13V15H11v6H4Zm8-8.75Z',
  'M8.1,21.21q-1.82-0.79-3.17-2.14Q3.58,17.73 2.79,15.9T2,12Q2,9.92 2.79,8.1Q3.58,6.27 4.93,4.93Q6.28,3.57 8.1,2.79Q9.93,2 12,2t3.9,0.79t3.17,2.14q1.35,1.35 2.14,3.17Q22,9.92 22,12t-0.79,3.9t-2.14,3.17q-1.35,1.35-3.17,2.14T12,22q-2.07,0-3.9-0.79Zm9.58-3.54Q20,15.35 20,12T17.68,6.32T12,4T6.33,6.32T4,12t2.33,5.68T12,20t5.68-2.32ZM7.75,16.25Q6,14.5 6,12T7.75,7.75T12,6t4.25,1.75T18,12t-1.75,4.25T12,18T7.75,16.25Zm7.08-1.43Q16,13.65 16,12T14.83,9.17T12,8T9.18,9.17T8,12t1.18,2.82T12,16t2.83-1.18Zm-4.24-1.41Q10,12.83 10,12t0.59-1.41T12,10t1.41,0.59Q14,11.18 14,12t-0.59,1.41T12,14t-1.41-0.59Z',
  'M11,17H7q-2.07,0-3.54-1.46T2,12Q2,9.92 3.46,8.46T7,7h4V9H7Q5.75,9 4.88,9.88T4,12t0.88,2.13T7,15h4v2ZM8,13V11h8v2H8Zm5,4V15h4q1.25,0 2.13-0.88T20,12T19.13,9.88T17,9H13V7h4q2.07,0 3.54,1.46T22,12t-1.46,3.54T17,17H13Z',
  'M7,22l4-7.5l-8-1L15,2h2L13,9.5l8,1L9,22H7Zm5.55-6.18l4.02-3.85L9.85,11.13L11.43,8.2l-4,3.85l6.7,0.83l-1.57,2.95ZM12,12Z',
  'M3.4,18L2,16.6L9.4,9.15l4,4L18.6,8H16V6h6v6H20V9.4L13.4,16l-4-4l-6,6Z',
];
---

<section class="hs-section connected" aria-labelledby="connected-title">
  <div class="hs-shell">
    <header class="hs-heading" data-hs-reveal>
      <h2 id="connected-title" data-home-key="sections.connected.title">{copy.title}</h2>
      <p data-home-key="sections.connected.body">{copy.body}</p>
    </header>

    <div class="connected-flow" data-hs-reveal="connected">
      <div class="connected-inputs">
        <div class="hs-card connected-node">
          <!-- [OPEN] Client-supplied icon images; confirm usage rights before launch. -->
          <img class="connected-node__image" src="/images/connected/marketing-icon.webp" alt="" width="256" height="256" loading="lazy" decoding="async" />
          <p data-home-key="sections.connected.marketing">{copy.marketing}</p>
        </div>
        <span class="connected-plus" aria-hidden="true">+</span>
        <div class="hs-card connected-node">
          <img class="connected-node__image" src="/images/connected/technology-icon.webp" alt="" width="363" height="256" loading="lazy" decoding="async" />
          <p data-home-key="sections.connected.technology">{copy.technology}</p>
        </div>
      </div>

      <svg class="connected-lines connected-lines--wide" viewBox="0 0 200 220" fill="none" aria-hidden="true" preserveAspectRatio="none">
        <path data-connector d="M0 50C90 50 90 110 196 110" stroke="#7fb0ff" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke" />
        <path data-connector d="M0 170C90 170 90 110 196 110" stroke="#078be9" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke" />
        <path class="connected-pulse" d="M0 50C90 50 90 110 196 110M0 170C90 170 90 110 196 110" stroke="#0655e9" stroke-width="3" stroke-linecap="round" stroke-dasharray="6 22" vector-effect="non-scaling-stroke" />
      </svg>
      <svg class="connected-lines connected-lines--narrow" viewBox="0 0 220 80" fill="none" aria-hidden="true" preserveAspectRatio="none">
        <path data-connector d="M55 0C55 40 110 40 110 78" stroke="#7fb0ff" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke" />
        <path data-connector d="M165 0C165 40 110 40 110 78" stroke="#078be9" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke" />
      </svg>

      <div class="connected-result">
        <!-- PLACEHOLDER: Adobe Stock preview #1046642754 (watermarked). Replace with the licensed file before launch. -->
        <img class="connected-result__bg" src="/images/connected-growth.webp" alt="" width="736" height="412" loading="lazy" decoding="async" aria-hidden="true" />
        <span class="connected-result__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8 M15 7h6v6 M3 21h18" /></svg>
        </span>
        <p data-home-key="sections.connected.result">{copy.result}</p>
      </div>
    </div>

    <ul class="connected-highlights">
      {copy.highlights.map((highlight, index) => (
        <li class="hs-card" data-hs-reveal data-hs-delay={index * 0.08}>
          <span class="hs-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d={highlightIcons[index]} /></svg></span>
          <span data-home-key={`sections.connected.highlights.${index}`}>{highlight}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { onHomeReveal, prefersReducedMotion } from '../../scripts/home-reveal';

  onHomeReveal('connected', (flow) => {
    if (prefersReducedMotion()) return;
    // Wipe the connectors in along their direction of travel (left→right wide, top→bottom narrow).
    gsap.fromTo(flow.querySelector('.connected-lines--wide'), { clipPath: 'inset(0 100% 0 0)' }, { clipPath: 'inset(0 0% 0 0)', duration: 1.1, ease: 'power2.inOut', delay: .3, clearProps: 'clipPath' });
    gsap.fromTo(flow.querySelector('.connected-lines--narrow'), { clipPath: 'inset(0 0 100% 0)' }, { clipPath: 'inset(0 0 0% 0)', duration: .9, ease: 'power2.inOut', delay: .3, clearProps: 'clipPath' });
    gsap.from(flow.querySelector('.connected-result'), { scale: .9, autoAlpha: 0, duration: .6, ease: 'back.out(1.6)', delay: 1.1 });
  });
</script>

<style>
  .connected-flow { display: grid; grid-template-columns: minmax(0, 1fr) minmax(80px, 200px) minmax(0, 1fr); align-items: center; max-width: 960px; margin: 0 auto clamp(2.5rem, 5vw, 3.5rem); }
  .connected-inputs { display: grid; gap: 1.1rem; justify-items: stretch; }
  .connected-node { display: flex; align-items: center; gap: 1rem; padding: 1.1rem 1.25rem; }
  .connected-node p { color: var(--hs-ink); font-size: var(--size-h4); font-weight: 600; line-height: 1.3; }
  .connected-node__image { display: block; flex-shrink: 0; width: 4.5rem; height: 4.5rem; border-radius: 1rem; object-fit: cover; box-shadow: 0 6px 14px #0655e91c; }
  .connected-plus { display: none; color: var(--hs-blue); font-size: 1.65rem; font-weight: 600; text-align: center; }
  .connected-lines { width: 100%; height: 100%; min-height: 200px; }
  .connected-lines--narrow { display: none; }
  .connected-pulse { animation: connected-pulse 2.8s linear infinite; }
  @keyframes connected-pulse { to { stroke-dashoffset: -56; } }
  .connected-result { position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .9rem; min-height: 240px; padding: clamp(1.5rem, 3vw, 2.25rem); border-radius: var(--radius-large); color: #fff; background: #0643cf; box-shadow: 0 18px 40px #0655e940; text-align: center; }
  /* Growth image behind the card; pink tones rotated onto brand blue, then a blue wash keeps the text legible. */
  .connected-result__bg { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; filter: hue-rotate(-110deg) saturate(1.1); }
  .connected-result::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(circle at 30% 20%, #078be9b3, #0655e9b3 45%, #0643cfd9); }
  .connected-result p { margin: 0; color: #fff; font-family: var(--font-display); font-size: var(--size-h3); font-weight: 700; line-height: var(--leading-h3); }
  .connected-result__icon { display: grid; place-items: center; width: 4rem; height: 4rem; border: 2px solid #ffffff55; border-radius: 50%; background: #ffffff1f; }
  .connected-result__icon svg { width: 2rem; height: 2rem; }
  .connected-highlights { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .connected-highlights li { display: flex; flex-direction: column; align-items: center; gap: .85rem; padding: 1.25rem 1rem; color: var(--hs-ink); font-size: 1.0312rem; font-weight: 600; line-height: 1.45; text-align: center; overflow-wrap: anywhere; }
  @media (max-width: 1100px) { .connected-highlights { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .connected-flow { grid-template-columns: 1fr; }
    .connected-inputs { grid-template-columns: 1fr 1fr; gap: .75rem; }
    .connected-node { flex-direction: column; text-align: center; padding: 1rem .75rem; }
    .connected-node p { font-size: 1.0312rem; }
    .connected-lines--wide { display: none; }
    .connected-lines--narrow { display: block; height: 70px; min-height: 0; }
    .connected-highlights { grid-template-columns: 1fr; gap: .75rem; }
    .connected-highlights li { flex-direction: row; gap: 1rem; padding: .9rem 1.1rem; text-align: start; overflow-wrap: break-word; }
    .connected-highlights .hs-icon { width: 2.75rem; height: 2.75rem; }
  }
  @media (prefers-reduced-motion: reduce) { .connected-pulse { animation: none; } }
</style>

---
import ArrowUpRight from '../ui/ArrowUpRight.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { marketingServices } from '../../data/marketing-service-content';
import { marketingServiceTranslations } from '../../data/marketing-service-translations';

const copy = marketingServiceTranslations.en;
const canonicalUrl = new URL('/services/', Astro.url).href;
const pageTranslations = Object.fromEntries(
  Object.entries(marketingServiceTranslations).map(([locale, translation]) => [
    locale,
    {
      pageTitle: translation.pageTitle,
      metaDescription: translation.metaDescription,
      heroLabel: translation.heroLabel,
      heroVisualCaption: translation.heroVisualCaption,
      heroTitle: translation.heroTitle,
      heroBodyOne: translation.heroBodyOne,
      heroBodyTwo: translation.heroBodyTwo,
      heroCta: translation.heroCta,
      introTitle: translation.introTitle,
      introEyebrow: translation.introEyebrow,
      introBody: translation.introBody,
      servicesEyebrow: translation.servicesEyebrow,
      servicesTitle: translation.servicesTitle,
      servicesBody: translation.servicesBody,
      exploreService: translation.exploreService,
      whyTitle: translation.whyTitle,
      whyEyebrow: translation.whyEyebrow,
      whyItems: translation.whyItems,
      processTitle: translation.processTitle,
      processEyebrow: translation.processEyebrow,
      processIntro: translation.processIntro,
      processSteps: translation.processSteps,
      faqTitle: translation.faqTitle,
      faqEyebrow: translation.faqEyebrow,
      faqs: translation.faqs,
      closingTitle: translation.closingTitle,
      closingEyebrow: translation.closingEyebrow,
      closingDescription: translation.closingDescription,
      closingCta: translation.closingCta,
      services: Object.fromEntries(marketingServices.map(({ slug }) => {
        const service = translation.services[slug];
        return [slug, { title: service.title, description: service.description }];
      })),
    },
  ]),
);
---

<MainLayout
  title={copy.pageTitle}
  description={copy.metaDescription}
  openGraph={true}
  canonicalUrl={canonicalUrl}
>
  <div class="marketing-services-page">
    <section class="marketing-hero" aria-labelledby="marketing-hero-title">
      <div class="marketing-hero__glow" aria-hidden="true"></div>
      <div class="marketing-shell marketing-hero__inner">
        <div class="marketing-hero__copy">
          <h1 id="marketing-hero-title" data-marketing-key="heroTitle">{copy.heroTitle}</h1>
          <p class="marketing-hero__body" data-marketing-key="heroBodyOne">{copy.heroBodyOne}</p>
          <p class="marketing-hero__body marketing-hero__body--secondary" data-marketing-key="heroBodyTwo">{copy.heroBodyTwo}</p>
          <a class="marketing-button marketing-button--primary" href="#marketing-service-list">
            <span data-marketing-key="heroCta">{copy.heroCta}</span><span aria-hidden="true">↓</span>
          </a>
        </div>
        <div class="marketing-hero__visual" aria-hidden="true">
          <div class="marketing-hero__orbit marketing-hero__orbit--outer"></div>
          <div class="marketing-hero__orbit marketing-hero__orbit--inner"></div>
          <div class="marketing-hero__mark">M</div>
          <span class="marketing-hero__spark marketing-hero__spark--one">✦</span>
          <span class="marketing-hero__spark marketing-hero__spark--two">✳</span>
          <span class="marketing-hero__visual-caption" data-marketing-key="heroVisualCaption">{copy.heroVisualCaption}</span>
        </div>
      </div>
      <div class="marketing-hero__edge" aria-hidden="true"><span>RYZITE / MARKETING</span><span>IDEAS INTO ACTION <b>↓</b></span></div>
    </section>

    <section class="marketing-introduction" aria-labelledby="marketing-intro-title">
      <div class="marketing-shell marketing-introduction__inner" data-marketing-reveal>
        <h2 id="marketing-intro-title" data-marketing-key="introTitle">{copy.introTitle}</h2>
        <p data-marketing-key="introBody">{copy.introBody}</p>
      </div>
    </section>

    <section class="marketing-section marketing-service-section" id="marketing-service-list" aria-labelledby="marketing-services-title">
      <div class="marketing-shell">
        <header class="marketing-section-heading" data-marketing-reveal>
          <div>
            <h2 id="marketing-services-title" data-marketing-key="servicesTitle">{copy.servicesTitle}</h2>
          </div>
          <p data-marketing-key="servicesBody">{copy.servicesBody}</p>
        </header>
        <div class="marketing-service-grid">
          {marketingServices.map((service, index) => {
            return (
              <article class="marketing-service-card" id={service.slug} data-marketing-reveal>
                <a
                  class="marketing-service-card__link"
                  href={`/services/${service.slug}/`}
                  aria-label={`${copy.exploreService}: ${service.title}`}
                  data-marketing-card-link={service.slug}
                >
                  <span class="marketing-service-card__topline">
                    <span class="marketing-service-card__icon" aria-hidden="true">{service.icon === "\u2197" ? <ArrowUpRight /> : service.icon}</span>
                    <span class="marketing-service-card__number">{String(index + 1).padStart(2, '0')}</span>
                  </span>
                  <h3 data-marketing-service-field="title" data-marketing-service-slug={service.slug}>{service.title}</h3>
                  <p data-marketing-service-field="description" data-marketing-service-slug={service.slug}>{service.description}</p>
                  <span class="marketing-service-card__more">
                    <span data-marketing-key="exploreService">{copy.exploreService}</span><span aria-hidden="true"><ArrowUpRight /></span>
                  </span>
                </a>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="marketing-section marketing-why-section" aria-labelledby="marketing-why-title">
      <div class="marketing-shell marketing-why-layout">
        <header class="marketing-section-heading marketing-section-heading--stacked" data-marketing-reveal>
          <h2 id="marketing-why-title" data-marketing-key="whyTitle">{copy.whyTitle}</h2>
        </header>
        <div class="marketing-why-grid">
          {copy.whyItems.map((item, index) => (
            <article class="marketing-why-card" data-marketing-reveal>
              <span class="marketing-why-card__number">0{index + 1}</span>
              <span class="marketing-why-card__icon" aria-hidden="true">{['◎', '✦', <ArrowUpRight />, '⌁', '◇'][index]}</span>
              <h3 data-marketing-array="whyItems" data-marketing-index={index} data-marketing-field="title">{item.title}</h3>
              <p data-marketing-array="whyItems" data-marketing-index={index} data-marketing-field="body">{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="marketing-section marketing-process-section" aria-labelledby="marketing-process-title">
      <div class="marketing-shell">
        <header class="marketing-section-heading marketing-section-heading--center" data-marketing-reveal>
          <h2 id="marketing-process-title" data-marketing-key="processTitle">{copy.processTitle}</h2>
          <p data-marketing-key="processIntro">{copy.processIntro}</p>
        </header>
        <ol class="marketing-process">
          {copy.processSteps.map((step, index) => (
            <li data-marketing-process-step={index} data-marketing-reveal>
              <span class="marketing-process__number">0{index + 1}</span>
              <div>
                <h3 data-marketing-array="processSteps" data-marketing-index={index} data-marketing-field="title">{step.title}</h3>
                <p data-marketing-array="processSteps" data-marketing-index={index} data-marketing-field="body">{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="marketing-section marketing-faq-section" aria-labelledby="marketing-faq-title">
      <div class="marketing-shell marketing-faq-layout">
        <header class="marketing-section-heading marketing-section-heading--stacked" data-marketing-reveal>
          <h2 id="marketing-faq-title" data-marketing-key="faqTitle">{copy.faqTitle}</h2>
        </header>
        <div class="marketing-faq-list" data-marketing-reveal>
          {copy.faqs.map((faq, index) => (
            <details class="marketing-faq-item">
              <summary data-marketing-array="faqs" data-marketing-index={index} data-marketing-field="question">{faq.question}</summary>
              <div class="marketing-faq-item__answer">
                <p data-marketing-array="faqs" data-marketing-index={index} data-marketing-field="answer">{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="marketing-closing" aria-labelledby="marketing-closing-title">
      <div class="marketing-closing__orb" aria-hidden="true"></div>
      <div class="marketing-closing__inner" data-marketing-reveal>
        <h2 id="marketing-closing-title" data-marketing-key="closingTitle">{copy.closingTitle}</h2>
        <p data-marketing-key="closingDescription">{copy.closingDescription}</p>
        <a class="marketing-button marketing-button--light" href="/contact/">
          <span data-marketing-key="closingCta">{copy.closingCta}</span><span aria-hidden="true"><ArrowUpRight /></span>
        </a>
      </div>
    </section>
  </div>
</MainLayout>

<script is:inline define:vars={{ marketingServiceTranslations: pageTranslations }}>
  const applyMarketingLocale = (locale) => {
    const copy = marketingServiceTranslations[locale] || marketingServiceTranslations.en;
    document.querySelectorAll('[data-marketing-key]').forEach((element) => {
      const value = copy[element.dataset.marketingKey];
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('[data-marketing-array]').forEach((element) => {
      const value = copy[element.dataset.marketingArray]?.[Number(element.dataset.marketingIndex)]?.[element.dataset.marketingField];
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('[data-marketing-service-field]').forEach((element) => {
      const service = copy.services[element.dataset.marketingServiceSlug] || marketingServiceTranslations.en.services[element.dataset.marketingServiceSlug];
      const value = service?.[element.dataset.marketingServiceField];
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('[data-marketing-card-link]').forEach((element) => {
      const service = copy.services[element.dataset.marketingCardLink] || marketingServiceTranslations.en.services[element.dataset.marketingCardLink];
      if (service) element.setAttribute('aria-label', `${copy.exploreService}: ${service.title}`);
    });

    const description = document.querySelector('meta[name="description"]');
    if (description) description.setAttribute('content', copy.metaDescription);
    const openGraphTitle = document.querySelector('meta[property="og:title"]');
    if (openGraphTitle) openGraphTitle.setAttribute('content', copy.pageTitle);
    const openGraphDescription = document.querySelector('meta[property="og:description"]');
    if (openGraphDescription) openGraphDescription.setAttribute('content', copy.metaDescription);
  };

  applyMarketingLocale(document.body.dataset.locale || 'en');
  window.addEventListener('ryzite:locale-change', (event) => applyMarketingLocale(event.detail?.locale || 'en'));
</script>

<script>
  import { gsap } from 'gsap';

  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!motionPreference.matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        gsap.fromTo(entry.target, { autoAlpha: 0, y: 18 }, {
          autoAlpha: 1,
          y: 0,
          duration: 0.6,
          ease: 'power2.out',
          clearProps: 'all',
        });
        currentObserver.unobserve(entry.target);
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.marketing-services-page [data-marketing-reveal]').forEach((element) => observer.observe(element));

    const hero = document.querySelector('.marketing-hero__copy');
    const heroTimeline = hero && gsap.fromTo(hero, { y: 18, autoAlpha: 0 }, {
      y: 0,
      autoAlpha: 1,
      duration: 0.8,
      ease: 'power3.out',
      delay: 0.08,
    });
    document.addEventListener('astro:before-swap', () => {
      observer.disconnect();
      heroTimeline?.kill();
    }, { once: true });
  }
</script>

<style>
  .marketing-services-page { --marketing-blue: #0756df; --marketing-deep: #073db7; --marketing-ink: #14243a; --marketing-muted: #58677c; color: var(--marketing-ink); background: var(--color-paper); }
  .marketing-services-page *, .marketing-services-page *::before, .marketing-services-page *::after { box-sizing: border-box; }
  .marketing-shell { width: min(100%, var(--content-max)); margin-inline: auto; padding-inline: var(--space-frame); }
  .marketing-hero { position: relative; isolation: isolate; overflow: hidden; padding: clamp(4rem, 7vw, 6.5rem) var(--space-frame) 2rem; background: linear-gradient(118deg, #faf8f4, #f3f8ff 64%, #eaf4ff); }
  .marketing-hero__inner { display: grid; min-height: 570px; grid-template-columns: minmax(0, 1fr) minmax(280px, .75fr); align-items: center; gap: clamp(2rem, 6vw, 6rem); }
  .marketing-hero__copy { position: relative; z-index: 1; max-width: 800px; }
  .marketing-eyebrow { display: flex; align-items: center; gap: .65rem; margin: 0 0 1rem; color: var(--marketing-blue); font-size: var(--size-eyebrow); font-weight: 800; letter-spacing: .15em; line-height: 1.5; text-transform: uppercase; }
  .marketing-eyebrow::before { width: 1.5rem; height: 2px; flex: 0 0 auto; border-radius: 2px; background: currentColor; content: ''; }
  .marketing-hero h1 { max-width: var(--measure-h1); margin: 0; color: #101827; font-family: var(--font-display); font-size: var(--size-h1); font-weight: 900; letter-spacing: var(--tracking-h1); line-height: var(--leading-h1); overflow-wrap: anywhere; }
  .marketing-hero__body { max-width: 680px; margin: 1.4rem 0 0; color: var(--marketing-muted); font-size: var(--size-lead); line-height: 1.75; }
  .marketing-hero__body--secondary { margin-top: .8rem; }
  .marketing-button { display: inline-flex; min-height: 3.1rem; align-items: center; justify-content: center; gap: 1rem; margin-top: 1.6rem; padding: .78rem 1.2rem; border: 1px solid transparent; border-radius: 999px; font-size: .9rem; font-weight: 800; text-align: center; text-decoration: none; transition: transform 180ms var(--ease-out), background 180ms ease, box-shadow 180ms ease; }
  .marketing-button:hover { transform: translateY(-3px); }
  .marketing-button:focus-visible, .marketing-service-card__link:focus-visible, .marketing-faq-item summary:focus-visible { outline: 3px solid var(--marketing-blue); outline-offset: 4px; }
  .marketing-button--primary { color: #fff; background: linear-gradient(110deg, #078be9, #064bed); box-shadow: 0 .7rem 1.5rem #064bed30; }
  .marketing-button--primary:hover { background: linear-gradient(110deg, #087bd2, #043ec9); }
  .marketing-hero__visual { position: relative; display: grid; width: min(100%, 410px); aspect-ratio: 1; place-items: center; justify-self: center; overflow: hidden; border: 1px solid #d5e5f8; border-radius: 2.2rem; background: radial-gradient(circle at center, #fff 0 22%, #eef6ff 23% 66%, #e1efff 67%); box-shadow: inset 0 0 0 1rem #ffffff50, 0 1.5rem 3.5rem #173b7110; }
  .marketing-hero__visual::before { position: absolute; inset: 12%; border: 1px solid #8cb9ee80; border-radius: 50%; background-image: linear-gradient(#0655e914 1px, transparent 1px), linear-gradient(90deg, #0655e914 1px, transparent 1px); background-size: 16% 16%; content: ''; mask-image: radial-gradient(circle, #000 0 68%, transparent 69%); }
  .marketing-hero__mark { position: relative; z-index: 1; display: grid; width: 35%; aspect-ratio: 1; place-items: center; border: 1px solid #ffffffa0; border-radius: 1.5rem; color: #fff; background: linear-gradient(145deg, #078be9, #0643cf); box-shadow: 0 1.2rem 2.7rem #0655e93b; font-family: var(--font-display); font-size: clamp(4rem, 7vw, 6rem); font-weight: 800; }
  .marketing-hero__orbit { position: absolute; inset: 7%; border: 1px solid #0655e92e; border-radius: 50%; }
  .marketing-hero__orbit--inner { inset: 22%; border-style: dashed; border-color: #00a6fa55; }
  .marketing-hero__spark { position: absolute; color: var(--marketing-blue); }
  .marketing-hero__spark--one { top: 15%; right: 22%; }
  .marketing-hero__spark--two { bottom: 17%; left: 19%; }
  .marketing-hero__visual-caption { position: absolute; right: 1rem; bottom: 1.1rem; left: 1rem; color: #617794; font-size: .58rem; font-weight: 800; letter-spacing: .12em; text-align: center; }
  .marketing-hero__glow { position: absolute; z-index: -1; top: -38%; right: 5%; width: min(40vw, 560px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, #459eff28, transparent 68%); }
  .marketing-hero__edge { display: flex; width: min(100%, var(--content-max)); justify-content: space-between; gap: 1rem; margin: 2rem auto 0; padding-top: 1rem; border-top: 1px solid #cdd9e7; color: #52647b; font-size: .62rem; font-weight: 800; letter-spacing: .12em; }
  .marketing-hero__edge b { margin-left: .4rem; color: var(--marketing-blue); }
  .marketing-introduction { padding-block: clamp(4rem, 7vw, 6rem); background: #fff; }
  .marketing-introduction__inner { display: grid; grid-template-columns: minmax(160px, .45fr) minmax(0, 1fr); align-items: start; gap: .7rem 3rem; }
  .marketing-introduction__inner .marketing-eyebrow { grid-row: span 2; margin-top: .8rem; }
  .marketing-introduction h2, .marketing-section-heading h2 { max-width: var(--measure-h2); margin: 0; color: #111d30; font-family: var(--font-display); font-size: var(--size-h2); font-weight: 800; letter-spacing: var(--tracking-h2); line-height: var(--leading-h2); }
  .marketing-introduction > .marketing-introduction__inner > p:last-child { max-width: 720px; margin: .4rem 0 0; color: var(--marketing-muted); font-size: 1.05rem; line-height: 1.75; }
  .marketing-section { padding-block: clamp(4.5rem, 8vw, 7rem); }
  .marketing-service-section { background: #f2f7fd; }
  .marketing-section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2.5rem; }
  .marketing-section-heading > p { max-width: 520px; margin: 0; color: var(--marketing-muted); line-height: 1.7; }
  .marketing-section-heading .marketing-eyebrow { margin-bottom: .9rem; }
  .marketing-service-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .marketing-service-card { min-width: 0; scroll-margin-top: 7rem; }
  .marketing-service-card__link { position: relative; display: flex; min-height: 290px; height: 100%; flex-direction: column; align-items: flex-start; padding: 1.45rem; border: 1px solid #dce5f0; border-radius: var(--radius-medium); color: var(--marketing-ink); background: linear-gradient(145deg, #fff, #f7faff); box-shadow: 0 .8rem 1.8rem #173b7109; text-decoration: none; transition: transform 200ms var(--ease-out), border-color 200ms ease, box-shadow 200ms ease; }
  .marketing-service-card__link:hover { transform: translateY(-5px); border-color: #9fc1eb; box-shadow: 0 1rem 2rem #163f7615; }
  .marketing-service-card__topline { display: flex; width: 100%; align-items: center; justify-content: space-between; }
  .marketing-service-card__icon, .marketing-service-card__number { display: grid; width: 2.8rem; aspect-ratio: 1; place-items: center; border: 1px solid #cfe0f5; border-radius: .9rem; color: var(--marketing-blue); background: #eaf3ff; font-family: var(--font-display); font-size: 1.45rem; font-weight: 700; }
  .marketing-service-card__number { width: auto; border: 0; color: #8292a6; background: transparent; font-family: var(--font-body); font-size: .68rem; letter-spacing: .12em; }
  .marketing-service-card h3 { max-width: 95%; margin: 1.7rem 0 .55rem; color: #162942; font-family: var(--font-display); font-size: var(--size-h3); font-weight: 700; line-height: var(--leading-h3); letter-spacing: var(--tracking-h3); }
  .marketing-service-card p { margin: 0; color: var(--marketing-muted); font-size: .91rem; line-height: 1.65; }
  .marketing-service-card__more { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: .75rem; margin-top: auto; padding-top: 1.35rem; color: var(--marketing-blue); font-size: .84rem; font-weight: 800; }
  .marketing-service-card__more span:last-child { transition: transform 180ms ease; }
  .marketing-service-card__link:hover .marketing-service-card__more span:last-child { transform: translate(3px, -3px); }
  .marketing-why-section { background: #fff; }
  .marketing-why-layout { display: grid; grid-template-columns: minmax(245px, .72fr) minmax(0, 1.28fr); align-items: start; gap: clamp(2rem, 6vw, 6rem); }
  .marketing-section-heading--stacked { display: block; margin: 0; }
  .marketing-section-heading--stacked .marketing-eyebrow { margin-bottom: 1rem; }
  .marketing-why-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .marketing-why-card { position: relative; min-height: 220px; padding: 1.4rem; border: 1px solid #dce5f0; border-radius: var(--radius-medium); background: linear-gradient(145deg, #fff, #f3f8ff); box-shadow: 0 .8rem 1.8rem #173b7109; }
  .marketing-why-card__number { color: #8795a8; font-size: .66rem; font-weight: 800; letter-spacing: .13em; }
  .marketing-why-card__icon { position: absolute; top: 1.2rem; right: 1.2rem; display: grid; width: 2.5rem; aspect-ratio: 1; place-items: center; border: 1px solid #cfe0f5; border-radius: .8rem; color: var(--marketing-blue); background: #eaf3ff; font-size: 1.1rem; }
  .marketing-why-card h3 { margin: 2rem 0 .55rem; color: #172940; font-family: var(--font-display); font-size: var(--size-h3); font-weight: 700; line-height: var(--leading-h3); letter-spacing: var(--tracking-h3); }
  .marketing-why-card p { margin: 0; color: var(--marketing-muted); font-size: .9rem; line-height: 1.65; }
  .marketing-process-section { background: #f2f7fd; }
  .marketing-section-heading--center { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .marketing-section-heading--center .marketing-eyebrow { justify-content: center; }
  .marketing-section-heading--center h2 { max-width: var(--measure-h2-wide); }
  .marketing-section-heading--center > p:last-child { max-width: 680px; margin: .9rem 0 0; color: var(--marketing-muted); line-height: 1.7; }
  .marketing-process { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 1.5rem; margin: 3.2rem 0 0; padding: 0; list-style: none; }
  .marketing-process::before { position: absolute; top: 1.25rem; right: 8%; left: 8%; height: 1px; background: linear-gradient(90deg, #b9d4f4, #4a9cf2, #b9d4f4); content: ''; }
  .marketing-process li { position: relative; display: grid; min-height: 175px; grid-template-columns: 2.5rem minmax(0, 1fr); gap: .9rem; padding-bottom: 1.5rem; }
  .marketing-process__number { position: relative; z-index: 1; display: grid; width: 2.5rem; aspect-ratio: 1; place-items: center; border: 1px solid #9fc1eb; border-radius: 50%; color: var(--marketing-blue); background: #fff; box-shadow: 0 0 0 .35rem #edf5ff; font-size: .68rem; font-weight: 800; }
  .marketing-process h3 { margin: .1rem 0 .45rem; color: #162942; font-family: var(--font-display); font-size: var(--size-h3); font-weight: 700; line-height: var(--leading-h3); letter-spacing: var(--tracking-h3); }

---
import MarketingServiceArt from '../ui/MarketingServiceArt.astro';
import ArrowUpRight from '../ui/ArrowUpRight.astro';
import WindingRoad from './WindingRoad.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { marketingServices } from '../../data/marketing-service-content';
import { marketingServicePhotos as servicePhotos, marketingServicePhotoSrc } from '../../data/marketing-service-photos';
import { marketingServiceTranslations } from '../../data/marketing-service-translations';

const copy = marketingServiceTranslations.en;
const canonicalUrl = new URL('/services/', Astro.url).href;
// FAQPage structured data built from the same English FAQ copy shown on the page, so the two never
// drift apart. `<` is escaped so answer text can never close the script tag.
const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: copy.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
}).replace(/</g, '\\u003c');
const pageTranslations = Object.fromEntries(
  Object.entries(marketingServiceTranslations).map(([locale, translation]) => [
    locale,
    {
      pageTitle: translation.pageTitle,
      metaDescription: translation.metaDescription,
      heroLabel: translation.heroLabel,
      heroVisualCaption: translation.heroVisualCaption,
      heroTitle: translation.heroTitle,
      heroBodyOne: translation.heroBodyOne,
      heroBodyTwo: translation.heroBodyTwo,
      heroCta: translation.heroCta,
      introTitle: translation.introTitle,
      introEyebrow: translation.introEyebrow,
      introBody: translation.introBody,
      servicesEyebrow: translation.servicesEyebrow,
      servicesTitle: translation.servicesTitle,
      servicesBody: translation.servicesBody,
      exploreService: translation.exploreService,
      whyTitle: translation.whyTitle,
      whyEyebrow: translation.whyEyebrow,
      whyItems: translation.whyItems,
      processTitle: translation.processTitle,
      processEyebrow: translation.processEyebrow,
      processIntro: translation.processIntro,
      processSteps: translation.processSteps,
      faqTitle: translation.faqTitle,
      faqEyebrow: translation.faqEyebrow,
      faqs: translation.faqs,
      services: Object.fromEntries(marketingServices.map(({ slug }) => {
        const service = translation.services[slug];
        return [slug, { title: service.title, description: service.description }];
      })),
    },
  ]),
);
// Icons for the "Why RYZITE" glass cards (24x24, stroke).
const whyIcons = [
  // target: business-focused planning
  '<circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="4.5" /><circle cx="12" cy="12" r="1" fill="currentColor" />',
  // speech bubble: creative communication
  '<path d="M4 5.5h16a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H10l-4.5 3.5V16.5H4a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1z M7.5 10h9 M7.5 13h6" />',
  // linked nodes: technology and marketing together
  '<circle cx="6" cy="12" r="3" /><circle cx="18" cy="6" r="3" /><circle cx="18" cy="18" r="3" /><path d="M8.7 10.6l6.6-3.2 M8.7 13.4l6.6 3.2" />',
  // rising chart: performance awareness
  '<path d="M4 20h16 M7 16v-3 M11 16v-6 M15 16v-4 M19 16V7 M5 11l5-5 4 3 6-5" />',
  // sliders: flexible approaches
  '<path d="M4 7h10 M18 7h2 M4 17h4 M12 17h8" /><circle cx="16" cy="7" r="2" /><circle cx="10" cy="17" r="2" />',
];
---

<MainLayout
  title={copy.pageTitle}
  description={copy.metaDescription}
  openGraph={true}
  canonicalUrl={canonicalUrl}
>
  <div class="marketing-services-page">
    <section class="marketing-hero" aria-labelledby="marketing-hero-title">
      <div class="marketing-hero__glow" aria-hidden="true"></div>
      <div class="marketing-shell marketing-hero__inner">
        <div class="marketing-hero__copy">
          <h1 id="marketing-hero-title" data-marketing-key="heroTitle">{copy.heroTitle}</h1>
          <p class="marketing-hero__body" data-marketing-key="heroBodyOne">{copy.heroBodyOne}</p>
          <p class="marketing-hero__body marketing-hero__body--secondary" data-marketing-key="heroBodyTwo">{copy.heroBodyTwo}</p>
          <a class="marketing-button marketing-button--primary" href="#marketing-service-list">
            <span data-marketing-key="heroCta">{copy.heroCta}</span><span aria-hidden="true"><ArrowUpRight /></span>
          </a>
        </div>
        <div class="marketing-hero__frame">
          <span class="marketing-hero__blob marketing-hero__blob--one" aria-hidden="true"></span>
          <span class="marketing-hero__blob marketing-hero__blob--two" aria-hidden="true"></span>
          <figure class="marketing-hero__visual">
            <img src="/images/services/marketing-hero.webp" alt="A business professional selecting connected icons for strategy, partnership, growth and security on a digital interface." width="735" height="617" fetchpriority="high" decoding="async" />
          </figure>
        </div>
      </div>
    </section>

    <section class="marketing-section marketing-service-section" id="marketing-service-list" aria-labelledby="marketing-services-title">
      <div class="marketing-shell">
        <header class="marketing-section-heading" data-marketing-reveal>
          <div>
            <h2 id="marketing-services-title" data-marketing-key="servicesTitle">{copy.servicesTitle}</h2>
          </div>
          <p data-marketing-key="servicesBody">{copy.servicesBody}</p>
        </header>
        <div class="marketing-service-grid">
          {marketingServices.map((service, index) => {
            return (
              <article class="marketing-service-card" id={service.slug} data-marketing-reveal>
                <a
                  class="marketing-service-card__link"
                  href={`/services/${service.slug}/`}
                  aria-label={`${copy.exploreService}: ${service.title}`}
                  data-marketing-card-link={service.slug}
                >
                  <span class="marketing-service-card__media">
                    {servicePhotos[service.slug] ? (
                      <img class="marketing-service-card__photo" src={marketingServicePhotoSrc(service.slug)} alt="" width={servicePhotos[service.slug].width} height={servicePhotos[service.slug].height} loading="lazy" decoding="async" />
                    ) : (
                      <MarketingServiceArt slug={service.slug} />
                    )}
                  </span>
                  <div class="marketing-service-card__panel">
                    <span class="marketing-service-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                    <h3 data-marketing-service-field="title" data-marketing-service-slug={service.slug}>{service.title}</h3>
                    <p data-marketing-service-field="description" data-marketing-service-slug={service.slug}>{service.description}</p>
                    <span class="marketing-service-card__more">
                      <span data-marketing-key="exploreService">{copy.exploreService}</span><span aria-hidden="true"><ArrowUpRight /></span>
                    </span>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="marketing-section marketing-why-section" aria-labelledby="marketing-why-title">
      <span class="marketing-why-orb marketing-why-orb--one" aria-hidden="true"></span>
      <span class="marketing-why-orb marketing-why-orb--two" aria-hidden="true"></span>
      <span class="marketing-why-orb marketing-why-orb--three" aria-hidden="true"></span>
      <div class="marketing-shell">
        <header class="marketing-section-heading marketing-section-heading--center" data-marketing-reveal>
          <h2 id="marketing-why-title" data-marketing-key="whyTitle">{copy.whyTitle}</h2>
        </header>
        <div class="marketing-why-grid">
          {copy.whyItems.map((item, index) => (
            <article class="marketing-why-card" data-marketing-reveal>
              <div class="marketing-why-card__top">
                <span class="marketing-why-card__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={whyIcons[index]} />
                </span>
                <span class="marketing-why-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              </div>
              <h3 data-marketing-array="whyItems" data-marketing-index={index} data-marketing-field="title">{item.title}</h3>
              <p data-marketing-array="whyItems" data-marketing-index={index} data-marketing-field="body">{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="marketing-section marketing-process-section" aria-labelledby="marketing-process-title">
      <div class="marketing-shell">
        <header class="marketing-section-heading marketing-section-heading--center" data-marketing-reveal>
          <h2 id="marketing-process-title" data-marketing-key="processTitle">{copy.processTitle}</h2>
          <p data-marketing-key="processIntro">{copy.processIntro}</p>
        </header>
        <WindingRoad steps={copy.processSteps.map((step, index) => ({
          title: step.title,
          body: step.body,
          itemAttrs: { 'data-marketing-process-step': index, 'data-marketing-reveal': true },
          titleAttrs: { 'data-marketing-array': 'processSteps', 'data-marketing-index': index, 'data-marketing-field': 'title' },
          bodyAttrs: { 'data-marketing-array': 'processSteps', 'data-marketing-index': index, 'data-marketing-field': 'body' },
        }))} />
      </div>
    </section>

    <section class="marketing-section marketing-faq-section" aria-labelledby="marketing-faq-title">
      <div class="marketing-shell marketing-faq-layout">
        <header class="marketing-section-heading marketing-section-heading--stacked" data-marketing-reveal>
          <h2 id="marketing-faq-title" data-marketing-key="faqTitle">{copy.faqTitle}</h2>
        </header>
        <div class="marketing-faq-list" data-marketing-reveal>
          {copy.faqs.map((faq, index) => (
            <details class="marketing-faq-item">
              <summary data-marketing-array="faqs" data-marketing-index={index} data-marketing-field="question">{faq.question}</summary>
              <div class="marketing-faq-item__answer">
                <p data-marketing-array="faqs" data-marketing-index={index} data-marketing-field="answer">{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
    <script type="application/ld+json" set:html={faqSchema} />
  </div>
</MainLayout>

<script is:inline define:vars={{ marketingServiceTranslations: pageTranslations }}>
  const applyMarketingLocale = (locale) => {
    const copy = marketingServiceTranslations[locale] || marketingServiceTranslations.en;
    document.querySelectorAll('[data-marketing-key]').forEach((element) => {
      const value = copy[element.dataset.marketingKey];
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('[data-marketing-array]').forEach((element) => {
      const value = copy[element.dataset.marketingArray]?.[Number(element.dataset.marketingIndex)]?.[element.dataset.marketingField];
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('[data-marketing-service-field]').forEach((element) => {
      const service = copy.services[element.dataset.marketingServiceSlug] || marketingServiceTranslations.en.services[element.dataset.marketingServiceSlug];
      const value = service?.[element.dataset.marketingServiceField];
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('[data-marketing-card-link]').forEach((element) => {
      const service = copy.services[element.dataset.marketingCardLink] || marketingServiceTranslations.en.services[element.dataset.marketingCardLink];
      if (service) element.setAttribute('aria-label', `${copy.exploreService}: ${service.title}`);
    });

    const description = document.querySelector('meta[name="description"]');
    if (description) description.setAttribute('content', copy.metaDescription);
    const openGraphTitle = document.querySelector('meta[property="og:title"]');
    if (openGraphTitle) openGraphTitle.setAttribute('content', copy.pageTitle);
    const openGraphDescription = document.querySelector('meta[property="og:description"]');
    if (openGraphDescription) openGraphDescription.setAttribute('content', copy.metaDescription);
  };

  applyMarketingLocale(document.body.dataset.locale || 'en');
  window.addEventListener('ryzite:locale-change', (event) => applyMarketingLocale(event.detail?.locale || 'en'));
</script>

<script>
  import { gsap } from 'gsap';

  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!motionPreference.matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        gsap.fromTo(entry.target, { autoAlpha: 0, y: 18 }, {
          autoAlpha: 1,
          y: 0,
          duration: 0.6,
          ease: 'power2.out',
          // Clear only what GSAP set: 'all' would wipe the inline style, including the
          // process steps' --col / --pin-y placement variables.
          clearProps: 'opacity,visibility,transform',
        });
        currentObserver.unobserve(entry.target);
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.marketing-services-page [data-marketing-reveal]').forEach((element) => observer.observe(element));

    const hero = document.querySelector('.marketing-hero__copy');
    const heroTimeline = hero && gsap.fromTo(hero, { y: 18, autoAlpha: 0 }, {
      y: 0,
      autoAlpha: 1,
      duration: 0.8,
      ease: 'power3.out',
      delay: 0.08,
    });
    document.addEventListener('astro:before-swap', () => {
      observer.disconnect();
      heroTimeline?.kill();
    }, { once: true });
  }
</script>

<style>
  .marketing-services-page { --marketing-blue: var(--color-brand); --marketing-deep: var(--color-brand); --marketing-ink: var(--color-heading); --marketing-muted: var(--color-body); color: var(--marketing-ink); background: var(--color-paper); }
  .marketing-services-page *, .marketing-services-page *::before, .marketing-services-page *::after { box-sizing: border-box; }
  .marketing-shell { width: min(100%, var(--content-max)); margin-inline: auto; padding-inline: var(--space-frame); }
  .marketing-hero { position: relative; isolation: isolate; overflow: hidden; padding: clamp(4rem, 7vw, 6.5rem) var(--space-frame) 2rem; background: linear-gradient(118deg, var(--color-paper), var(--color-milk-highlight) 64%, var(--color-milk)); }
  .marketing-hero__inner { display: grid; min-height: 570px; grid-template-columns: minmax(0, 1fr) minmax(280px, .75fr); align-items: center; gap: clamp(2rem, 6vw, 6rem); }
  .marketing-hero__copy { position: relative; z-index: 1; max-width: 800px; }
  .marketing-eyebrow { display: flex; align-items: center; gap: .65rem; margin: 0 0 1rem; color: var(--marketing-blue); font-size: var(--size-eyebrow); font-weight: 600; letter-spacing: .15em; line-height: 1.5; text-transform: uppercase; }
  .marketing-eyebrow::before { width: 1.5rem; height: 2px; flex: 0 0 auto; border-radius: 2px; background: currentColor; content: ''; }
  .marketing-hero h1 { max-width: var(--measure-h1); margin: 0; color: #101827; font-family: var(--font-display); font-size: var(--size-h1); font-weight: 700; letter-spacing: var(--tracking-h1); line-height: var(--leading-h1); overflow-wrap: anywhere; }
  .marketing-hero__body { max-width: 680px; margin: 1.4rem 0 0; color: var(--marketing-muted); font-size: var(--size-lead); line-height: 1.75; }
  .marketing-hero__body--secondary { margin-top: .8rem; }
  .marketing-button { display: inline-flex; min-height: 3.1rem; align-items: center; justify-content: center; gap: 1rem; margin-top: 1.6rem; padding: .78rem 1.2rem; border: 1px solid transparent; border-radius: 999px; font-size: .99rem; font-weight: 600; text-align: center; text-decoration: none; transition: transform 180ms var(--ease-out), background 180ms ease, box-shadow 180ms ease; }
  .marketing-button:hover { transform: translateY(-3px); }
  .marketing-button:focus-visible, .marketing-service-card__link:focus-visible, .marketing-faq-item summary:focus-visible { outline: 3px solid var(--marketing-blue); outline-offset: 4px; }
  .marketing-button--primary { color: #fff; background: var(--color-brand); box-shadow: 0 .7rem 1.5rem #0b1c5830; }
  .marketing-button--primary:hover { background: var(--color-brand-hover); }
  .marketing-hero__frame { position: relative; isolation: isolate; width: min(100%, 560px); justify-self: center; }
  .marketing-hero__blob { position: absolute; z-index: -1; border-radius: 50%; filter: blur(8px); pointer-events: none; }
  .marketing-hero__blob--one { top: -8%; right: -6%; width: 46%; aspect-ratio: 1; background: radial-gradient(circle at 35% 35%, #078be9, #0655e9 70%); opacity: .75; }
  .marketing-hero__blob--two { bottom: -10%; left: -8%; width: 38%; aspect-ratio: 1; background: radial-gradient(circle at 60% 40%, #8cc8ff, #0643cf 75%); opacity: .6; }
  .marketing-hero__visual { position: relative; margin: 0; padding: .85rem; border: 1px solid rgb(255 255 255 / 65%); border-radius: 2rem; background: linear-gradient(145deg, rgb(255 255 255 / 55%), rgb(255 255 255 / 18%)); box-shadow: inset 0 1px 0 rgb(255 255 255 / 80%), 0 1.6rem 3.6rem rgb(23 59 113 / 18%); backdrop-filter: blur(18px) saturate(150%); -webkit-backdrop-filter: blur(18px) saturate(150%); }
  .marketing-hero__visual img { display: block; width: 100%; height: auto; border-radius: 1.4rem; }
  .marketing-hero__visual::after { content: ''; position: absolute; inset: .85rem; border-radius: 1.4rem; background: linear-gradient(125deg, rgb(255 255 255 / 22%) 0%, rgb(255 255 255 / 6%) 28%, transparent 45%); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 18%); pointer-events: none; }
  .marketing-hero__glow { position: absolute; z-index: -1; top: -38%; right: 5%; width: min(40vw, 560px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, #0b1c5828, transparent 68%); }
  .marketing-section-heading h2 { max-width: var(--measure-h2); margin: 0; color: #111d30; font-family: var(--font-display); font-size: var(--size-h2); font-weight: 700; letter-spacing: var(--tracking-h2); line-height: var(--leading-h2); }
  .marketing-section { padding-block: clamp(4.5rem, 8vw, 7rem); }
  .marketing-section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2.5rem; }
  .marketing-section-heading > p { max-width: 520px; margin: 0; color: var(--marketing-muted); line-height: 1.7; }
  .marketing-section-heading .marketing-eyebrow { margin-bottom: .9rem; }
  /* Pinned-note layout (client reference 2026-11-19): tilted notes, dashed links. */
  .marketing-service-section { background: var(--color-milk); }
  .marketing-service-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3.2rem 3rem; padding-top: 1.5rem; }
  .marketing-service-card { --note-tilt: -2.5deg; --note-tint: #fff3eb; --note-line: #fbd9c4; --note-accent: #e8662f; position: relative; min-width: 0; scroll-margin-top: 7rem; }
  .marketing-service-card:nth-child(3n+2) { --note-tilt: 2.5deg; --note-tint: #ecf2ff; --note-line: #cddcfb; --note-accent: #0655e9; margin-top: 3rem; }
  .marketing-service-card:nth-child(3n) { --note-tilt: -1.5deg; --note-tint: #f3edff; --note-line: #dccffb; --note-accent: #6d4bd8; }
  .marketing-service-card:not(:nth-child(3n)):not(:last-child)::after { content: ''; position: absolute; z-index: 0; top: 46%; right: -3.2rem; width: 3.4rem; height: 2.4rem; border-top: 2px dashed #b4c2d6; border-radius: 50% 50% 0 0; pointer-events: none; }
  .marketing-service-card:nth-child(3n+2)::after { top: 30%; transform: scaleY(-1); }
  .marketing-service-card__link { position: relative; z-index: 1; display: flex; height: 100%; flex-direction: column; padding: .85rem; border: 1px solid #edf1f6; border-radius: 1.6rem; color: var(--marketing-ink); background: #fff; box-shadow: 0 1.4rem 2.6rem rgb(22 41 66 / 10%), 0 .2rem .5rem rgb(22 41 66 / 5%); text-decoration: none; transform: rotate(var(--note-tilt)); transition: transform 320ms var(--ease-out), box-shadow 320ms ease; }
  .marketing-service-card__link:hover { transform: rotate(0deg) translateY(-6px); box-shadow: 0 1.8rem 3.2rem rgb(22 41 66 / 16%); }
  .marketing-service-card__media { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 1.1rem; background: var(--color-brand); }
  .marketing-service-card__photo { display: block; width: 100%; height: 100%; object-fit: cover; }
  .marketing-service-card__media :global(.marketing-art), .marketing-service-card__photo { transition: scale 400ms var(--ease-out); }
  .marketing-service-card__link:hover .marketing-service-card__media :global(.marketing-art), .marketing-service-card__link:hover .marketing-service-card__photo { scale: 1.05; }
  .marketing-service-card__panel { display: flex; flex: 1; flex-direction: column; margin-top: .75rem; padding: 1.15rem 1.2rem 1.1rem; border: 1px solid var(--note-line); border-radius: 1.1rem; background: var(--note-tint); }
  .marketing-service-card__number { color: var(--note-accent); font-family: var(--font-display); font-size: 1.6rem; font-weight: 400; font-style: italic; letter-spacing: .02em; line-height: 1; }
  .marketing-service-card h3 { margin: .6rem 0 .45rem; color: #162942; font-family: var(--font-display); font-size: var(--size-h4); font-weight: 700; line-height: var(--leading-h3); letter-spacing: var(--tracking-h3); }
  .marketing-service-card p { margin: 0; color: var(--marketing-muted); font-size: .95rem; line-height: 1.6; }
  .marketing-service-card__more { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: .75rem; margin-top: auto; padding-top: 1.1rem; color: var(--note-accent); font-size: .924rem; font-weight: 600; }
  .marketing-service-card__more span:last-child { transition: transform 180ms ease; }
  .marketing-service-card__link:hover .marketing-service-card__more span:last-child { transform: translateX(4px); }
  /* Glassmorphism "Why RYZITE" cards over soft brand-blue light (client request 2026-11-19). */
  .marketing-why-section { position: relative; isolation: isolate; overflow: hidden; background: var(--color-milk); }
  .marketing-why-orb { position: absolute; z-index: -1; border-radius: 50%; filter: blur(60px); pointer-events: none; }
  .marketing-why-orb--one { top: 18%; left: -6%; width: min(42vw, 520px); aspect-ratio: 1; background: #0655e9; opacity: .32; }
  .marketing-why-orb--two { right: -8%; bottom: 4%; width: min(46vw, 580px); aspect-ratio: 1; background: #078be9; opacity: .3; }
  .marketing-why-orb--three { top: 42%; left: 38%; width: min(28vw, 340px); aspect-ratio: 1; background: #6d4bd8; opacity: .18; }
  .marketing-why-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.25rem; margin-top: clamp(2.5rem, 5vw, 3.5rem); }
  .marketing-why-card { display: flex; flex: 0 1 calc((100% - 2.5rem) / 3); min-width: 0; flex-direction: column; padding: 1.6rem; border: 1px solid rgb(255 255 255 / 70%); border-radius: 1.5rem; background: linear-gradient(145deg, rgb(255 255 255 / 62%), rgb(255 255 255 / 28%)); box-shadow: inset 0 1px 0 rgb(255 255 255 / 85%), 0 1.2rem 2.8rem rgb(11 28 88 / 10%); backdrop-filter: blur(18px) saturate(160%); -webkit-backdrop-filter: blur(18px) saturate(160%); transition: translate 320ms var(--ease-out), box-shadow 320ms ease, background 320ms ease; }

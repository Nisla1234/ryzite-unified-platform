---
// One SVG composition for the "From Idea to Solution" story, drawn in its final (Scene 4) state.
// The markup is the no-JS / reduced-motion fallback; idea-story.ts animates from the earlier scenes into it.
// Two layouts share the same artwork: "wide" (desktop/tablet, six cards) and "narrow" (phones, four cards).

type Layout = 'wide' | 'narrow';
type CardKind = 'web' | 'phone' | 'chart' | 'social' | 'search' | 'automation';

interface Props { layout: Layout }
const { layout } = Astro.props;

const layouts = {
  wide: {
    width: 1200,
    height: 720,
    core: { x: 600, y: 360 },
    cardScale: 1,
    cards: [
      { kind: 'web', x: 262, y: 168 },
      { kind: 'phone', x: 938, y: 168 },
      { kind: 'chart', x: 1000, y: 360 },
      { kind: 'automation', x: 938, y: 552 },
      { kind: 'social', x: 262, y: 552 },
      { kind: 'search', x: 200, y: 360 },
    ],
  },
  narrow: {
    width: 400,
    height: 620,
    core: { x: 200, y: 310 },
    cardScale: 0.74,
    cards: [
      { kind: 'web', x: 103, y: 104 },
      { kind: 'phone', x: 297, y: 104 },
      { kind: 'chart', x: 297, y: 516 },
      { kind: 'social', x: 103, y: 516 },
    ],
  },
} satisfies Record<Layout, { width: number; height: number; core: { x: number; y: number }; cardScale: number; cards: { kind: CardKind; x: number; y: number }[] }>;

const { width, height, core, cardScale, cards } = layouts[layout];
const id = (name: string) => `idea-${layout}-${name}`;
const url = (name: string) => `url(#${id(name)})`;

// Closed loop through every card centre: the "ecosystem" ring drawn in the final scene.
const network = `M${cards.map(({ x, y }) => `${x} ${y}`).join(' L')} Z`;
const spokes = cards.map(({ x, y }) => `M${core.x} ${core.y} L${x} ${y}`);
const sparks = layout === 'wide'
  ? [[420, 110], [780, 96], [1080, 250], [1110, 470], [760, 640], [420, 650], [96, 470], [120, 240], [520, 250], [690, 480]]
  : [[60, 230], [340, 220], [50, 410], [350, 400], [200, 70], [200, 560]];
---

<svg
  class={`idea-scene idea-scene--${layout}`}
  data-idea-scene={layout}
  data-core-x={core.x}
  data-core-y={core.y}
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="xMidYMid meet"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <radialGradient id={id('halo')}>
      <stop offset="0" stop-color="#078be9" stop-opacity=".38" />
      <stop offset=".45" stop-color="#0655e9" stop-opacity=".12" />
      <stop offset="1" stop-color="#0655e9" stop-opacity="0" />
    </radialGradient>
    <radialGradient id={id('core')} cx=".5" cy=".5" r=".5" fx=".34" fy=".3">
      <stop offset="0" stop-color="#9fd2ff" />
      <stop offset=".28" stop-color="#078be9" />
      <stop offset=".68" stop-color="#0655e9" />
      <stop offset="1" stop-color="#0643cf" />
    </radialGradient>
    <radialGradient id={id('beam')}>
      <stop offset="0" stop-color="#ffffff" stop-opacity="1" />
      <stop offset=".55" stop-color="#ffffff" stop-opacity=".55" />
      <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
    <linearGradient id={id('sweep')} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0" />
      <stop offset=".5" stop-color="#ffffff" stop-opacity=".85" />
      <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
    </linearGradient>
    <linearGradient id={id('tile')} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#078be9" />
      <stop offset="1" stop-color="#0643cf" />
    </linearGradient>
    <radialGradient id={id('shadow')}>
      <stop offset="0" stop-color="#0643cf" stop-opacity=".22" />
      <stop offset="1" stop-color="#0643cf" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- Cinematic key light from above, falling onto the core. -->
  <ellipse data-idea="beam" cx={core.x} cy={core.y * 0.45} rx={layout === 'wide' ? 240 : 150} ry={core.y * 0.95} fill={url('beam')} opacity=".55" />
  <circle data-idea="halo" cx={core.x} cy={core.y} r={layout === 'wide' ? 260 : 190} fill={url('halo')} />

  {layout === 'wide' && (
    <rect data-idea="sweep" x="-260" y="-200" width="200" height={height + 400} fill={url('sweep')} transform="rotate(18)" opacity="0" />
  )}

  <g data-idea="sparks" fill="#078be9">
    {sparks.map(([x, y], index) => <circle cx={x} cy={y} r={index % 3 ? 2.5 : 4} opacity={index % 2 ? .35 : .55} />)}
  </g>

  <path data-idea="network" d={network} fill="none" stroke="#9cc3ff" stroke-width="2" stroke-linejoin="round" />
  <g data-idea="spokes" fill="none" stroke="#0655e9" stroke-opacity=".8" stroke-width="2.5" stroke-linecap="round">
    {spokes.map((d) => <path d={d} />)}
  </g>
  <!-- Data packets that travel outward along the spokes; their position is driven by scroll. -->
  <g data-idea="flow" fill="none" stroke="#0655e9" stroke-width="5" stroke-linecap="round" opacity="0">
    {spokes.map((d) => <path d={d} />)}
  </g>

  <g data-idea="nodes">
    {cards.map(({ x, y }) => (
      <g class="idea-node" transform={`translate(${x} ${y})`} opacity="0">
        <circle r="16" fill="#0655e9" opacity=".18" />
        <circle r="8" fill={url('tile')} />
      </g>
    ))}
  </g>

  <g data-idea="cards">
    {cards.map(({ kind, x, y }) => (
      <g class="idea-card" data-kind={kind} transform={`translate(${x} ${y})`}>
        <g transform={`scale(${cardScale})`}>
          <ellipse cx="0" cy="78" rx="96" ry="14" fill={url('shadow')} />
          <rect x="-100" y="-66" width="200" height="132" rx="18" fill="#fff" stroke="#dce7fb" stroke-width="1.5" />

          {kind === 'web' && (
            <g>
              <path d="M-100 -48v-0a18 18 0 0 1 18-18h164a18 18 0 0 1 18 18v0z" fill="#f3f7ff" />
              <line x1="-100" y1="-44" x2="100" y2="-44" stroke="#dce7fb" stroke-width="1.5" />
              <circle cx="-84" cy="-55" r="3.5" fill="#078be9" /><circle cx="-73" cy="-55" r="3.5" fill="#9cc3ff" /><circle cx="-62" cy="-55" r="3.5" fill="#dce7fb" />
              <rect x="-82" y="-30" width="92" height="11" rx="5.5" fill="#0643cf" />
              <rect x="-82" y="-12" width="76" height="7" rx="3.5" fill="#c9daf8" />
              <rect x="-82" y="0" width="62" height="7" rx="3.5" fill="#c9daf8" />
              <rect x="-82" y="22" width="48" height="16" rx="8" fill="#0655e9" />
              <rect x="24" y="-30" width="60" height="68" rx="10" fill={url('tile')} />
              <circle cx="42" cy="-12" r="7" fill="#fff" opacity=".85" />
              <path d="M28 34l18-22 12 14 8-8 16 16z" fill="#fff" opacity=".55" />
            </g>
          )}

          {kind === 'phone' && (
            <g>
              <rect x="-74" y="-52" width="56" height="104" rx="12" fill="#f3f7ff" stroke="#0643cf" stroke-width="2.5" />
              <rect x="-56" y="-46" width="20" height="4" rx="2" fill="#0643cf" />
              <rect x="-66" y="-34" width="40" height="28" rx="6" fill={url('tile')} />
              <rect x="-66" y="0" width="40" height="6" rx="3" fill="#9cc3ff" />
              <rect x="-66" y="12" width="28" height="6" rx="3" fill="#c9daf8" />
              <rect x="-66" y="28" width="40" height="12" rx="6" fill="#0655e9" />
              <rect x="-4" y="-38" width="84" height="26" rx="10" fill="#f3f7ff" stroke="#dce7fb" />
              <circle cx="10" cy="-25" r="6" fill="#078be9" />
              <rect x="22" y="-29" width="48" height="5" rx="2.5" fill="#9cc3ff" /><rect x="22" y="-21" width="32" height="5" rx="2.5" fill="#dce7fb" />
              <rect x="-4" y="-2" width="84" height="26" rx="10" fill="#f3f7ff" stroke="#dce7fb" />
              <circle cx="10" cy="11" r="6" fill="#0655e9" />
              <rect x="22" y="7" width="40" height="5" rx="2.5" fill="#9cc3ff" /><rect x="22" y="15" width="48" height="5" rx="2.5" fill="#dce7fb" />
              <rect x="-4" y="34" width="56" height="14" rx="7" fill="#0643cf" />
            </g>
          )}

          {kind === 'chart' && (
            <g>
              <rect x="-80" y="-46" width="64" height="9" rx="4.5" fill="#0643cf" />
              <rect x="-80" y="-31" width="40" height="6" rx="3" fill="#c9daf8" />
              <line x1="-80" y1="46" x2="80" y2="46" stroke="#dce7fb" stroke-width="2" />
              <rect x="-74" y="22" width="18" height="24" rx="4" fill="#c9daf8" />
              <rect x="-46" y="10" width="18" height="36" rx="4" fill="#9cc3ff" />
              <rect x="-18" y="-2" width="18" height="48" rx="4" fill="#078be9" />
              <rect x="10" y="-14" width="18" height="60" rx="4" fill="#0655e9" />
              <rect x="38" y="-26" width="18" height="72" rx="4" fill="#0643cf" />
              <path d="M-65 12 L-37 0 L-9 -12 L19 -26 L52 -48" fill="none" stroke="#078be9" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M42 -50 L54 -50 L54 -38" fill="none" stroke="#078be9" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            </g>
          )}

          {kind === 'social' && (
            <g>
              <circle cx="-74" cy="-44" r="10" fill={url('tile')} />
              <rect x="-58" y="-50" width="52" height="6" rx="3" fill="#0643cf" />
              <rect x="-58" y="-40" width="34" height="5" rx="2.5" fill="#c9daf8" />
              <rect x="-84" y="-24" width="168" height="58" rx="10" fill="#eaf2ff" />
              <path d="M-84 22l40-30 28 22 22-14 78 34v0a10 10 0 0 1-10 10h-148a10 10 0 0 1-10-10z" fill="#9cc3ff" opacity=".8" />
              <circle cx="46" cy="-6" r="9" fill="#fff" />
              <path d="M-78 52c0-6 9-8 9-2 0-6 9-4 9 2 0 5-9 10-9 10s-9-5-9-10z" fill="#0655e9" />
              <rect x="-50" y="47" width="14" height="10" rx="4" fill="none" stroke="#078be9" stroke-width="2.5" />
              <rect x="40" y="46" width="44" height="12" rx="6" fill="#0655e9" />
            </g>
          )}

          {kind === 'search' && (
            <g>
              <rect x="-84" y="-48" width="168" height="26" rx="13" fill="#f3f7ff" stroke="#9cc3ff" stroke-width="1.5" />
              <circle cx="-66" cy="-36" r="6" fill="none" stroke="#0655e9" stroke-width="2.5" />
              <line x1="-61.5" y1="-31.5" x2="-57" y2="-27" stroke="#0655e9" stroke-width="2.5" stroke-linecap="round" />
              <rect x="-48" y="-38" width="66" height="5" rx="2.5" fill="#9cc3ff" />
              <rect x="-84" y="-8" width="8" height="8" rx="2" fill="#0655e9" />
              <rect x="-70" y="-8" width="96" height="7" rx="3.5" fill="#0643cf" />
              <rect x="-70" y="4" width="132" height="5" rx="2.5" fill="#c9daf8" />
              <rect x="-84" y="22" width="8" height="8" rx="2" fill="#9cc3ff" />
              <rect x="-70" y="22" width="80" height="7" rx="3.5" fill="#078be9" />
              <rect x="-70" y="34" width="120" height="5" rx="2.5" fill="#dce7fb" />
              <rect x="-70" y="46" width="96" height="5" rx="2.5" fill="#dce7fb" />
            </g>
          )}

          {kind === 'automation' && (
            <g>
              <g transform="translate(-48 -6)">
                <circle r="22" fill="none" stroke="#0655e9" stroke-width="10" stroke-dasharray="7.2 6.6" />
                <circle r="18" fill="#0655e9" />
                <circle r="7" fill="#fff" />
              </g>
              <path d="M-18 -6 H6" stroke="#9cc3ff" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 7" />
              <path d="M12 -40h62a10 10 0 0 1 10 10v30a10 10 0 0 1-10 10h-42l-14 12v-12h-6a10 10 0 0 1-10-10v-30a10 10 0 0 1 10-10z" fill={url('tile')} />
              <circle cx="30" cy="-15" r="4" fill="#fff" /><circle cx="44" cy="-15" r="4" fill="#fff" opacity=".8" /><circle cx="58" cy="-15" r="4" fill="#fff" opacity=".6" />
              <rect x="-80" y="34" width="72" height="16" rx="8" fill="#f3f7ff" stroke="#dce7fb" />
              <circle cx="-70" cy="42" r="4" fill="#078be9" />
              <rect x="-62" y="39" width="44" height="6" rx="3" fill="#9cc3ff" />
              <rect x="4" y="34" width="76" height="16" rx="8" fill="#0643cf" />
              <path d="M30 42l6 5 10-10" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </g>
          )}
        </g>
      </g>
    ))}
  </g>

  <g data-idea="core" transform={`translate(${core.x} ${core.y})`}>
    <circle data-idea="ring" r="122" fill="none" stroke="#078be9" stroke-opacity=".55" stroke-width="2" stroke-dasharray="2 10" stroke-linecap="round" />
    <g data-idea="orbit" transform="rotate(-18)">
      <ellipse rx="160" ry="48" fill="none" stroke="#9cc3ff" stroke-width="1.5" />
      <circle cx="160" cy="0" r="5" fill="#078be9" />
    </g>
    <circle data-idea="pulse" r="100" fill="none" stroke="#0655e9" stroke-width="2" opacity="0" />

    <!-- Scene 1-3: the glowing idea core. Hidden in the final composition. -->
    <g data-idea="sphere" opacity="0">
      <circle r="72" fill={url('core')} />
      <circle r="72" fill="none" stroke="#fff" stroke-opacity=".35" stroke-width="1.5" />
      <ellipse cx="-24" cy="-28" rx="24" ry="13" fill="#fff" opacity=".5" transform="rotate(-32 -24 -28)" />
      <path d="M0 -26 C3 -6 6 -3 26 0 C6 3 3 6 0 26 C-3 6 -6 3 -26 0 C-6 -3 -3 -6 0 -26z" fill="#fff" opacity=".92" />
    </g>

    <!-- Scene 4: the official RYZITE logo on a white badge. -->
    <g data-idea="badge">
      <ellipse cx="0" cy="112" rx="96" ry="14" fill={url('shadow')} />
      <circle r="102" fill="#fff" stroke="#dce7fb" stroke-width="2" />
      <circle r="92" fill="none" stroke="#0655e9" stroke-opacity=".18" stroke-width="1.5" />
      <image href="/assets/ryzite-footer-logo.webp" x="-74" y="-54" width="148" height="102" preserveAspectRatio="xMidYMid meet" />
    </g>
  </g>
</svg>

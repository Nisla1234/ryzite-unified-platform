---
import ArrowUpRight from '../ui/ArrowUpRight.astro';
---

<section class="about-preview" aria-labelledby="about-preview-title">
  <div class="about-preview__inner">
    <div class="about-preview__copy">
      <h2 id="about-preview-title" data-home-key="aboutTitle">A Digital Partner for Modern Businesses.</h2>
      <p data-home-key="aboutBody">
        We bring marketing services and technology solutions together to help businesses build their online presence,
        connect with customers, and simplify the way they work.
      </p>
      <a class="about-preview__link" href="/about/">
        <span data-home-key="aboutLink">More About RYZITE</span> <span aria-hidden="true"><ArrowUpRight /></span>
      </a>
    </div>

    <div class="about-preview__visual">
      <img
        class="about-preview__image"
        src="/images/about-marketing-technology.svg"
        alt="Two linked blue rings showing marketing and technology working together"
        width="1000"
        height="1000"
        loading="lazy"
        decoding="async"
      />
      <span class="about-preview__label about-preview__label--one" aria-hidden="true" data-home-key="aboutLabelMarketing">MARKETING</span>
      <span class="about-preview__label about-preview__label--two" aria-hidden="true" data-home-key="aboutLabelTechnology">TECHNOLOGY</span>
    </div>
  </div>
</section>

<style>
  .about-preview {
    position: relative;
    overflow: hidden;
    padding: clamp(4.5rem, 8vw, 7rem) var(--space-frame);
    color: #101d32;
    background: #fff;
    font-family: var(--font-body);
  }

  .about-preview__inner {
    display: grid;
    width: min(100%, 1240px);
    margin-inline: auto;
    grid-template-columns: minmax(0, 1.1fr) minmax(260px, .9fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 7rem);
  }

  .about-preview__copy { max-width: 700px; }

  .about-preview__eyebrow {
    display: flex;
    align-items: center;
    gap: .65rem;
    margin: 0 0 1rem;
    color: #0655e9;
    font-size: var(--size-eyebrow);
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .about-preview__eyebrow::before {
    width: 1.6rem;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    content: '';
  }

  .about-preview h2 {
    max-width: var(--measure-h2);
    margin: 0;
    color: #101827;
    font-family: var(--font-display);
    font-size: var(--size-h2);
    font-weight: 700;
    letter-spacing: var(--tracking-h2);
    line-height: var(--leading-h2);
  }

  .about-preview__copy > p:not(.about-preview__eyebrow) {
    max-width: 630px;
    margin: 1.2rem 0 0;
    color: #5c6674;
    font-size: clamp(.98rem, 1.2vw, 1.08rem);
    line-height: 1.75;
  }

  .about-preview__link {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    gap: 1rem;
    margin-top: 1.4rem;
    padding: .75rem 1.1rem;
    border: 1px solid #d2e0f2;
    border-radius: 999px;
    color: #064bd3;
    background: #f5f9ff;
    font-size: .9rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 180ms ease, background 180ms ease, border-color 180ms ease, transform 180ms ease;
  }

  .about-preview__link span { font-size: 1.05rem; transition: transform 180ms ease; }
  .about-preview__link:hover { transform: translateY(-2px); border-color: #a9c7ef; color: #fff; background: #0655e9; }
  .about-preview__link:hover span { transform: translate(2px, -2px); }
  .about-preview__link:focus-visible { outline: 3px solid #0655e9; outline-offset: 4px; }

  .about-preview__visual {
    position: relative;
    width: min(100%, 410px);
    aspect-ratio: 1;
    justify-self: center;
  }

  .about-preview__image {
    display: block;
    width: 100%;
    height: 100%;
  }

  .about-preview__label { position: absolute; padding: .45rem .7rem; border: 1px solid #d3e3f7; border-radius: 999px; color: #305278; background: #fff; box-shadow: 0 .5rem 1rem #193f7212; font-size: .6rem; font-weight: 600; letter-spacing: .12em; }
  .about-preview__label--one { top: 8%; left: 10%; }
  .about-preview__label--two { right: 3%; bottom: 8%; }

  @media (max-width: 720px) {
    .about-preview { padding: 4.5rem 1.25rem; }
    .about-preview__inner { grid-template-columns: 1fr; gap: 2rem; }
    
    .about-preview__visual { width: min(78vw, 340px); }
  }

  @media (max-width: 380px) {
    .about-preview__visual { width: min(82vw, 300px); }
    .about-preview__label { font-size: .53rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-preview__link, .about-preview__link span { transition: none; }
  }
</style>

---
// [PROPOSAL] Package names, descriptions, and features come from resources-translations.ts and
// are labelled as proposed options there. No prices are shown because none are approved.
// [PROPOSAL] Dark "light beam" presentation, now in the approved brand navy #0b1c58 [CLIENT 2026-11-19]. The centre card is highlighted visually
// as requested; package options remain proposals and the styling does not label one as recommended.
import { homeSectionsTranslations } from '../../data/home-sections-translations';
import { resourcesTranslations } from '../../data/resources-translations';

const copy = homeSectionsTranslations.en.packages;
const packages = resourcesTranslations.en.packages;
const featureCount = 4;
---

<section class="hs-section packages-preview" aria-labelledby="packages-preview-title">
  <div class="hs-shell">
    <header class="hs-heading packages-heading" data-hs-reveal>
      <h2 id="packages-preview-title" data-home-key="sections.packages.title">{copy.title}</h2>
      <p data-home-key="sections.packages.intro">{copy.intro}</p>
    </header>

    <div class="packages-grid">
      {packages.packageCards.map((card, index) => (
        <article class="package-card" tabindex="0" data-hs-reveal data-hs-delay={index * 0.12}>
          <div class="package-card__body">
            <h3 data-home-key={`packageData.cards.${index}.name`}>{card.name}</h3>
            <p class="package-card__description" data-home-key={`packageData.cards.${index}.description`}>{card.description}</p>

            <div class="package-card__suitable">
              <p class="package-card__subhead" data-home-key="sections.packages.suitableLabel">{copy.suitableLabel}</p>
              <p data-home-key={`sections.packages.suitable.${index}`}>{copy.suitable[index]}</p>
            </div>

            <p class="package-card__subhead" data-home-key="packageData.featuresLabel">{packages.packageFeaturesLabel}</p>
            <ul>
              {card.features.slice(0, featureCount).map((feature, featureIndex) => (
                <li>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="url(#package-check)" /><path d="m6 10.5 2.5 2.5L14 7.5" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  <span data-home-key={`packageData.cards.${index}.features.${featureIndex}`}>{feature}</span>
                </li>
              ))}
            </ul>

            <a class="package-card__cta" href="/contact/?package=guidance">
              <span data-home-key="packageData.cta">{packages.packageCta}</span> <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <svg class="package-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="package-check" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#0b1c58" />
          <stop offset="1" stop-color="#0b1c58" />
        </linearGradient>
      </defs>
    </svg>

    <div class="hs-actions" data-hs-reveal>
      <a class="hs-button" href="/packages"><span data-home-key="sections.packages.cta">{copy.cta}</span> <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  /* Brand colour: approved navy #0b1c58 (--color-brand) [CLIENT 2026-11-19]. The logo-* names are kept for existing references. */
  .packages-preview {
    --logo-navy: var(--color-brand);
    --logo-royal: var(--color-brand);
    --logo-azure: var(--color-brand);
    --pk-night: #0a1734;
    --pk-card: #ffffff;
    --pk-card-edge: #dce6f3;
    --pk-text: var(--color-heading);
    --pk-muted: var(--color-body);
    --pk-cyan: var(--color-brand);
    --pk-glow: linear-gradient(100deg, var(--logo-azure), var(--logo-royal) 55%, var(--logo-navy));
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    color: var(--pk-text);
    background-color: #07184f;
  }
  .packages-preview::before, .packages-preview::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
  }
  .packages-preview::before {
    background: url('/images/packages/technology-blue-background.webp') center / cover no-repeat;
    filter: brightness(.58) saturate(.62);
    transform: scale(1.025);
  }
  .packages-preview::after {
    background: linear-gradient(112deg, rgb(5 26 82 / 58%), rgb(11 28 88 / 16%) 50%, rgb(5 26 82 / 58%));
  }
  .packages-preview > .hs-shell {
    position: relative;
    z-index: 1;
  }
  .packages-heading h2 {
    color: #fff;
  }
  .packages-heading > p:not(.hs-eyebrow) { color: #f2f7ff; }

  .packages-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); padding-top: 1.5rem; }
  .package-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 36rem;
    padding: clamp(1.4rem, 2.4vw, 1.9rem);
    overflow: hidden;
    border: 1px solid rgb(220 231 251 / 94%);
    border-radius: 1.6rem;
    background: rgb(253 255 245 / 90%);
    box-shadow: 0 16px 38px rgb(2 16 66 / 22%), 0 3px 8px rgb(2 16 66 / 10%), inset 0 1px 0 rgb(255 255 255 / 90%);
    backdrop-filter: blur(18px) saturate(110%);
    -webkit-backdrop-filter: blur(18px) saturate(110%);
    transform: translateY(0) scale(1);
    transition: transform 420ms cubic-bezier(.2, .8, .2, 1), opacity 420ms cubic-bezier(.2, .8, .2, 1), border-color 420ms cubic-bezier(.2, .8, .2, 1), box-shadow 420ms cubic-bezier(.2, .8, .2, 1);
  }
  /* Top glow, shown on hover or keyboard focus. */
  .package-card::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 0 auto;
    height: 9rem;
    background: radial-gradient(ellipse 70% 100% at 50% 0%, rgb(11 28 88 / 32%) 0%, rgb(11 28 88 / 14%) 45%, transparent 75%);
    opacity: 0;
    transition: opacity 420ms cubic-bezier(.2, .8, .2, 1);
  }
  .package-card:nth-child(2) {
    z-index: 2;
    border-color: rgb(11 28 88 / 48%);
    box-shadow: 0 24px 54px rgb(2 16 66 / 30%), 0 0 0 1px rgb(11 28 88 / 14%), inset 0 1px 0 rgb(255 255 255 / 92%);
    transform: translateY(-12px) scale(1.03);
  }
  .package-card:is(:hover, :focus-within, [data-active="true"]) {
    z-index: 5;
    border-color: rgb(11 28 88 / 76%);
    box-shadow: 0 30px 64px rgb(2 16 66 / 34%), 0 0 24px rgb(11 28 88 / 22%), inset 0 1px 0 rgb(255 255 255 / 95%);
  }
  .package-card:is(:hover, :focus-within, [data-active="true"])::before { opacity: 1; }
  .package-card:focus-visible { outline: 3px solid #b9c8ff; outline-offset: 4px; }
  .package-card:nth-child(2):is(:hover, :focus-within, [data-active="true"]) {
    transform: translateY(-18px) scale(1.04);
  }
  @media (hover: hover) {
    .package-card:hover { transform: translateY(-10px) scale(1.015); }
    .package-card:nth-child(2):hover { transform: translateY(-18px) scale(1.04); }
  }
  .packages-grid:has(.package-card:is(:hover, :focus-within, [data-active="true"])) .package-card:not(:hover, :focus-within, [data-active="true"]) { opacity: .76; }

  .package-card__body { display: flex; flex: 1; flex-direction: column; }
  .package-card h3 { margin: 0 0 .6rem; color: var(--pk-text); font-size: var(--size-h3); line-height: var(--leading-h3); letter-spacing: var(--tracking-h3); overflow-wrap: anywhere; }
  .package-card p { margin: 0; overflow-wrap: anywhere; }
  .package-card__description { color: var(--pk-muted); font-size: 1.0312rem; line-height: 1.6; }
  .package-card__suitable { margin: 1.25rem 0; padding: .9rem 1rem; border: 1px solid #d5e4ff; border-radius: var(--radius-small); background: #f4f8ff; }
  .package-card__suitable p:last-child { color: var(--pk-text); font-size: 1.0312rem; font-weight: 600; line-height: 1.5; }
  .package-card__subhead { margin-bottom: .35rem; color: var(--color-brand); font-size: var(--size-small); font-weight: 600; }
  .package-card ul { display: grid; gap: .65rem; margin: .5rem 0 1.75rem; padding: 0; list-style: none; }
  .package-card li { display: flex; align-items: flex-start; gap: .65rem; color: #465771; font-size: 1.0312rem; line-height: 1.45; overflow-wrap: anywhere; }
  .package-card li svg { flex-shrink: 0; width: 1.15rem; height: 1.15rem; margin-top: .12rem; }

  .package-card__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .6rem;
    min-height: 3rem;
    margin-top: auto;
    padding: .75rem 1.25rem;
    border: 0;
    border-radius: .85rem;
    color: #fff;
    background: var(--color-brand);
    box-shadow: 0 9px 20px rgb(11 28 88 / 22%);
    font-size: 1.0312rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 180ms var(--ease-out), transform 180ms var(--ease-out), box-shadow 180ms var(--ease-out);
  }
  .package-card__cta:hover { background: var(--color-brand-hover); transform: translateY(-2px); box-shadow: 0 14px 30px rgb(11 28 88 / 32%); }
  .package-card__cta:focus-visible { outline: 3px solid #b9c8ff; outline-offset: 3px; }

  .package-defs { position: absolute; }
  .packages-preview .hs-button { background: var(--pk-glow); box-shadow: 0 8px 18px #0b1c5847; }
  .packages-preview .hs-button:focus-visible { outline-color: var(--logo-royal); }

  @media (max-width: 1000px) {
    .packages-grid { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; padding-inline: .5rem; }
    .package-card { min-height: 0; }
    .package-card__body { margin-top: 2rem; }
    .packages-grid { gap: 1.5rem; padding-top: 0; }
    .package-card, .package-card:nth-child(2), .package-card:is(:hover, :focus-within, [data-active="true"]), .package-card:nth-child(2):is(:hover, :focus-within, [data-active="true"]) { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .package-card, .package-card::before, .package-card__cta { transition: none; }
    .package-card__cta:hover { transform: none; }
    .package-card:is(:hover, :focus-within, [data-active="true"]) { transform: none; }
    .package-card:nth-child(2):is(:hover, :focus-within, [data-active="true"]) { transform: translateY(-12px) scale(1.03); }
  }
  @media (prefers-reduced-motion: reduce) and (max-width: 1000px) {
    .package-card:nth-child(2):is(:hover, :focus-within, [data-active="true"]) { transform: none; }
  }
</style>

<script>
  const packageGrid = document.querySelector('.packages-preview .packages-grid');

  packageGrid?.addEventListener('pointerup', (event) => {
    if (event.pointerType !== 'touch' || !(event.target instanceof Element)) return;

    const target = event.target;
    if (target.closest('a, button, input, select, textarea, [contenteditable="true"]')) return;

    const card = target.closest<HTMLElement>('.package-card');
    if (!card || !packageGrid.contains(card)) return;

    packageGrid.querySelectorAll<HTMLElement>('.package-card').forEach((item) => {
      item.dataset.active = item === card ? 'true' : 'false';
    });
  });
</script>

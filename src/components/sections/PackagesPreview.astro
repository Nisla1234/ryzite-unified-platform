---
// [PROPOSAL] Package names, descriptions, and features come from resources-translations.ts and
// are labelled as proposed options there. No prices are shown because none are approved.
// [PROPOSAL] Dark "light beam" presentation in the RYZITE logo blues (navy #0a1080, royal #2840c8, azure #2078f0). No card is highlighted by default,
// so no package is implied as recommended; the glow follows hover and keyboard focus instead.
import { homeSectionsTranslations } from '../../data/home-sections-translations';
import { resourcesTranslations } from '../../data/resources-translations';

const copy = homeSectionsTranslations.en.packages;
const packages = resourcesTranslations.en.packages;
const featureCount = 4;
---

<section class="hs-section packages-preview" aria-labelledby="packages-preview-title">
  <div class="hs-shell">
    <header class="hs-heading packages-heading" data-hs-reveal>
      <h2 id="packages-preview-title" data-home-key="sections.packages.title">{copy.title}</h2>
      <p data-home-key="sections.packages.intro">{copy.intro}</p>
    </header>

    <div class="packages-grid">
      {packages.packageCards.map((card, index) => (
        <article class="package-card" data-hs-reveal data-hs-delay={index * 0.12}>
          <div class="package-card__body">
            <h3 data-home-key={`packageData.cards.${index}.name`}>{card.name}</h3>
            <p class="package-card__description" data-home-key={`packageData.cards.${index}.description`}>{card.description}</p>

            <div class="package-card__suitable">
              <p class="package-card__subhead" data-home-key="sections.packages.suitableLabel">{copy.suitableLabel}</p>
              <p data-home-key={`sections.packages.suitable.${index}`}>{copy.suitable[index]}</p>
            </div>

            <p class="package-card__subhead" data-home-key="packageData.featuresLabel">{packages.packageFeaturesLabel}</p>
            <ul>
              {card.features.slice(0, featureCount).map((feature, featureIndex) => (
                <li>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="url(#package-check)" /><path d="m6 10.5 2.5 2.5L14 7.5" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  <span data-home-key={`packageData.cards.${index}.features.${featureIndex}`}>{feature}</span>
                </li>
              ))}
            </ul>

            <a class="package-card__cta" href="/contact/?package=guidance">
              <span data-home-key="packageData.cta">{packages.packageCta}</span> <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <svg class="package-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="package-check" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#2078f0" />
          <stop offset="1" stop-color="#2840c8" />
        </linearGradient>
      </defs>
    </svg>

    <div class="hs-actions" data-hs-reveal>
      <a class="hs-button" href="/packages"><span data-home-key="sections.packages.cta">{copy.cta}</span> <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  /* Colours sampled from the RYZITE logo: deep navy #0a1080, royal blue #2840c8, bright azure #2078f0. */
  .packages-preview {
    --logo-navy: #0a1080;
    --logo-royal: #2840c8;
    --logo-azure: #2078f0;
    --pk-night: #0a1734;
    --pk-card: #ffffff;
    --pk-card-edge: #dce6f3;
    --pk-text: #0a1734;
    --pk-muted: #465771;
    --pk-cyan: #5b9bff;
    --pk-glow: linear-gradient(100deg, var(--logo-azure), var(--logo-royal) 55%, var(--logo-navy));
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    color: var(--pk-text);
    background-color: #07184f;
    background-image: linear-gradient(rgba(5, 24, 79, .18), rgba(5, 24, 79, .18)), url('/images/packages/technology-blue-background.webp');
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }
  .packages-heading h2 {
    color: #fff;
  }
  .packages-heading > p:not(.hs-eyebrow) { color: #edf4ff; }

  .packages-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); }
  .package-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 36rem;
    padding: clamp(1.4rem, 2.4vw, 1.9rem);
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 32%);
    border-radius: 1.6rem;
    background: rgb(255 255 255 / 58%);
    box-shadow: 0 18px 44px rgb(2 16 66 / 24%), inset 0 1px 0 rgb(255 255 255 / 70%);
    backdrop-filter: blur(18px) saturate(135%);
    -webkit-backdrop-filter: blur(18px) saturate(135%);
    transition: border-color var(--duration-fast) var(--ease-out), translate var(--duration-fast) var(--ease-out);
  }
  /* Top glow, shown on hover or keyboard focus. */
  .package-card::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 0 auto;
    height: 9rem;
    background: radial-gradient(ellipse 70% 100% at 50% 0%, #2840c8b3 0%, #2078f033 45%, transparent 75%);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .package-card:hover, .package-card:focus-within { border-color: rgb(255 255 255 / 58%); }
  .package-card:hover::before, .package-card:focus-within::before { opacity: 1; }
  @media (hover: hover) { .package-card:hover { translate: 0 -4px; } }

  .package-card__body { display: flex; flex: 1; flex-direction: column; }
  .package-card h3 { margin: 0 0 .6rem; color: var(--pk-text); font-size: var(--size-h3); line-height: var(--leading-h3); letter-spacing: var(--tracking-h3); overflow-wrap: anywhere; }
  .package-card p { margin: 0; overflow-wrap: anywhere; }
  .package-card__description { color: var(--pk-muted); font-size: 1.0312rem; line-height: 1.6; }
  .package-card__suitable { margin: 1.25rem 0; padding: .9rem 1rem; border: 1px solid rgb(255 255 255 / 48%); border-radius: var(--radius-small); background: rgb(255 255 255 / 32%); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .package-card__suitable p:last-child { color: var(--pk-text); font-size: 1.0312rem; font-weight: 600; line-height: 1.5; }
  .package-card__subhead { margin-bottom: .35rem; color: #064bed; font-size: var(--size-small); font-weight: 600; }
  .package-card ul { display: grid; gap: .65rem; margin: .5rem 0 1.75rem; padding: 0; list-style: none; }
  .package-card li { display: flex; align-items: flex-start; gap: .65rem; color: #465771; font-size: 1.0312rem; line-height: 1.45; overflow-wrap: anywhere; }
  .package-card li svg { flex-shrink: 0; width: 1.15rem; height: 1.15rem; margin-top: .12rem; }

  .package-card__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .6rem;
    min-height: 3rem;
    margin-top: auto;
    padding: .75rem 1.25rem;
    border: 0;
    border-radius: .85rem;
    color: #fff;
    background: #064bed;
    box-shadow: 0 9px 20px rgb(6 75 237 / 22%);
    font-size: 1.0312rem;
    font-weight: 600;
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }
  .package-card__cta:hover { background: #0539b7; transform: translateY(-2px); box-shadow: 0 14px 30px rgb(6 75 237 / 32%); }
  .package-card__cta:focus-visible { outline: 3px solid #b9c8ff; outline-offset: 3px; }

  .package-defs { position: absolute; }
  .packages-preview .hs-button { background: var(--pk-glow); box-shadow: 0 8px 18px #2840c847; }
  .packages-preview .hs-button:focus-visible { outline-color: var(--logo-royal); }

  @media (max-width: 1000px) {
    .packages-grid { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
    .package-card { min-height: 0; }
    .package-card__body { margin-top: 2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .package-card, .package-card::before, .package-card__cta::before { transition: none; }
    .package-card:hover { translate: none; }
  }
</style>

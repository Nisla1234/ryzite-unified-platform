---
import ArrowUpRight from '../ui/ArrowUpRight.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { resourcesTranslations } from '../../data/resources-translations';

type ResourcePage = keyof typeof resourcesTranslations.en;

interface Props {
  page: ResourcePage;
}

const { page } = Astro.props;
const copy = resourcesTranslations.en[page];
const packages = page === 'packages' ? resourcesTranslations.en.packages : undefined;
const howWeWork = page === 'howWeWork' ? resourcesTranslations.en.howWeWork : undefined;
const ourWork = page === 'ourWork' ? resourcesTranslations.en.ourWork : undefined;
const articles = page === 'articles' ? resourcesTranslations.en.articles : undefined;
const paths: Record<ResourcePage, string> = {
  packages: '/packages/',
  howWeWork: '/how-we-work/',
  ourWork: '/our-work/',
  articles: '/articles/',
};
const heroCtaHref = page === 'packages'
  ? '#package-options'
  : page === 'howWeWork'
    ? '/contact/'
    : page === 'ourWork'
      ? '#our-approach'
      : '#topic-list';
const closingCtaHref = page === 'articles' ? '/solutions/' : '/contact/';
const packageContactHref = '/contact/?package=guidance';
const canonicalUrl = new URL(paths[page], Astro.url).href;
const pageTranslations = Object.fromEntries(
  Object.entries(resourcesTranslations).map(([locale, translations]) => [locale, translations[page]]),
);
---

<MainLayout title={copy.pageTitle} description={copy.metaDescription} openGraph={true} canonicalUrl={canonicalUrl}>
  <div class:list={['resource-page', `resource-page--${page}`]} data-resource-page={page}>
    <section class="resource-hero" aria-labelledby="resource-hero-title">
      <div class="resource-hero__glow" aria-hidden="true"></div>
      <div class="resource-shell resource-hero__inner">
        <div class="resource-hero__copy">
          <h1 id="resource-hero-title" data-resource-key="heroTitle">{copy.heroTitle}</h1>
          <p class="resource-hero__body" data-resource-key="heroBodyOne">{copy.heroBodyOne}</p>
          <p class="resource-hero__body resource-hero__body--secondary" data-resource-key="heroBodyTwo">{copy.heroBodyTwo}</p>
          {ourWork && <p class="resource-hero__body resource-hero__body--secondary" data-resource-key="heroBodyThree">{ourWork.heroBodyThree}</p>}
          <a class="resource-button resource-button--primary" href={heroCtaHref}>
            <span data-resource-key="heroCta">{copy.heroCta}</span><span aria-hidden="true">{page === 'howWeWork' ? <ArrowUpRight /> : '↓'}</span>
          </a>
        </div>
        <div class="resource-hero__visual" aria-hidden="true">
          <div class="resource-hero__orbit resource-hero__orbit--outer"></div>
          <div class="resource-hero__orbit resource-hero__orbit--inner"></div>
          <div class="resource-hero__symbol">{page === 'packages' ? 'P' : page === 'howWeWork' ? <ArrowUpRight /> : page === 'ourWork' ? 'W' : 'I'}</div>
          <span class="resource-hero__spark resource-hero__spark--one">✦</span>
          <span class="resource-hero__spark resource-hero__spark--two">✳</span>
          <span class="resource-hero__visual-caption" aria-hidden="true">RYZITE / DIGITAL SOLUTIONS</span>
        </div>
      </div>
      <div class="resource-hero__edge" aria-hidden="true"><span>RYZITE / RESOURCES</span><span>IDEAS INTO ACTION <b>↓</b></span></div>
    </section>

    {packages && <>
      <section class="resource-section resource-intro" aria-labelledby="package-intro-title">
        <div class="resource-shell resource-intro__inner" data-resource-reveal>
          <h2 id="package-intro-title">{packages.introTitle}</h2>
          <p>{packages.introBody}</p>
        </div>
      </section>

      <section class="resource-section resource-package-section" id="package-options" aria-labelledby="package-options-title">
        <div class="resource-shell">
          <header class="resource-section-heading" data-resource-reveal>
            <div>
              <h2 id="package-options-title" data-resource-key="packagesTitle">{packages.packagesTitle}</h2>
            </div>
            <p class="resource-notice" data-resource-key="packageDisclaimer">{packages.packageDisclaimer}</p>
          </header>
          <div class="resource-package-grid">
            {packages.packageCards.map((packageOption, index) => (
              <article class="resource-package-card" data-resource-reveal data-resource-package-index={index}>
                <p class="resource-package-card__label" data-resource-package-field="label">{packageOption.label}</p>
                <p class="resource-package-card__name" data-resource-package-field="name">{packageOption.name}</p>
                <h3 data-resource-package-field="heading">{packageOption.heading}</h3>
                <p class="resource-package-card__description" data-resource-package-field="description">{packageOption.description}</p>
                <div class="resource-package-card__features">
                  <h4 data-resource-key="packageFeaturesLabel">{packages.packageFeaturesLabel}</h4>
                  <ul>
                    {packageOption.features.map((feature, featureIndex) => (
                      <li data-resource-package-feature-index={featureIndex}>
                        <span aria-hidden="true"><ArrowUpRight /></span>
                        <span data-resource-package-feature>{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <a class="resource-text-link" href={packageContactHref}>
                  <span data-resource-key="packageCta">{packages.packageCta}</span><span aria-hidden="true"><ArrowUpRight /></span>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="resource-section resource-comparison-section" aria-labelledby="package-comparison-title">
        <div class="resource-shell">
          <header class="resource-section-heading resource-section-heading--center" data-resource-reveal>
            <h2 id="package-comparison-title" data-resource-key="compareTitle">{packages.compareTitle}</h2>
            <p data-resource-key="compareDescription">{packages.compareDescription}</p>
          </header>
          <div class="resource-comparison-wrap" data-resource-reveal>
            <table class="resource-comparison">
              <thead>
                <tr>
                  <th scope="col"></th>
                  {packages.packageCards.map((packageOption, index) => (
                    <th scope="col" data-resource-package-name-index={index}>{packageOption.name}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {packages.comparisonFeatures.map((feature, index) => (
                  <tr>
                    <th scope="row" data-resource-array="comparisonFeatures" data-resource-index={index}>{feature}</th>
                    {packages.packageCards.map(() => (
                      <td data-resource-key="comparisonStatus">{packages.comparisonStatus}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="resource-section resource-faq-section" aria-labelledby="packages-faq-title">
        <div class="resource-shell resource-faq-layout">
          <header class="resource-section-heading resource-section-heading--stacked" data-resource-reveal>
            <h2 id="packages-faq-title" data-resource-key="faqTitle">{packages.faqTitle}</h2>
          </header>
          <div class="resource-faq-list" data-resource-reveal>
            {packages.faqs.map((faq, index) => (
              <details class="resource-faq-item">
                <summary data-resource-array="faqs" data-resource-index={index} data-resource-field="question">{faq.question}</summary>
                <div class="resource-faq-item__answer">
                  <p data-resource-array="faqs" data-resource-index={index} data-resource-field="answer">{faq.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    </>}

    {howWeWork && <>
      <section class="resource-section resource-process-section" id="process-steps" aria-labelledby="process-title">
        <div class="resource-shell">
          <header class="resource-section-heading resource-section-heading--center" data-resource-reveal>
            <h2 id="process-title" data-resource-key="processTitle">{howWeWork.processTitle}</h2>
            <p data-resource-key="processIntro">{howWeWork.processIntro}</p>
          </header>
          <ol class="resource-process-list">
            {howWeWork.processSteps.map((step, index) => (
              <li class="resource-process-step" data-resource-reveal data-resource-step-index={index}>
                <span class="resource-process-step__number">0{index + 1}</span>
                <div class="resource-process-step__content">
                  <p class="resource-process-step__name" data-resource-step-field="name">{step.name}</p>
                  <h3 data-resource-step-field="title">{step.title}</h3>
                  <p class="resource-process-step__description" data-resource-step-field="description">{step.description}</p>
                  <ul class="resource-activity-list">
                    {step.activities.map((activity, activityIndex) => (
                      <li data-resource-activity-index={activityIndex}>{activity}</li>
                    ))}
                  </ul>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="resource-section resource-principles-section" aria-labelledby="principles-title">
        <div class="resource-shell">
          <header class="resource-section-heading resource-section-heading--center" data-resource-reveal>
            <h2 id="principles-title" data-resource-key="principlesTitle">{howWeWork.principlesTitle}</h2>
          </header>
          <div class="resource-principles-grid">
            {howWeWork.principles.map((principle, index) => (
              <article class="resource-principle-card" data-resource-reveal>
                <span class="resource-principle-card__number">0{index + 1}</span>
                <span class="resource-principle-card__icon" aria-hidden="true">{['◎', '⌁', '✦', '✓', <ArrowUpRight />, '◇'][index]}</span>
                <h3 data-resource-array="principles" data-resource-index={index} data-resource-field="title">{principle.title}</h3>
                <p data-resource-array="principles" data-resource-index={index} data-resource-field="body">{principle.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    </>}

    {ourWork && <>
      <section class="resource-section resource-work-section" id="project-showcase" aria-labelledby="projects-title">
        <div class="resource-shell">
          <header class="resource-section-heading" data-resource-reveal>
            <div>
              <h2 id="projects-title" data-resource-key="projectsTitle">{ourWork.projectsTitle}</h2>
            </div>
          </header>
          <div class="resource-empty-state" data-resource-reveal>
            <span class="resource-empty-state__icon" aria-hidden="true">✦</span>
            <h3 data-resource-key="emptyTitle">{ourWork.emptyTitle}</h3>
            <p data-resource-key="emptyDescription">{ourWork.emptyDescription}</p>
          </div>
        </div>
      </section>

      <section class="resource-section resource-approach-section" id="our-approach" aria-labelledby="work-approach-title">
        <div class="resource-shell">
          <header class="resource-section-heading resource-section-heading--center" data-resource-reveal>
            <h2 id="work-approach-title" data-resource-key="approachTitle">{ourWork.approachTitle}</h2>
            <p data-resource-key="approachDescription">{ourWork.approachDescription}</p>
          </header>
          <div class="resource-approach-grid">
            {ourWork.approachCards.map((card, index) => (
              <article class="resource-approach-card" data-resource-reveal>
                <span class="resource-approach-card__number">0{index + 1}</span>
                <span class="resource-approach-card__icon" aria-hidden="true">{['◎', '✦', <ArrowUpRight />][index]}</span>
                <h3 data-resource-array="approachCards" data-resource-index={index} data-resource-field="title">{card.title}</h3>
                <p data-resource-array="approachCards" data-resource-index={index} data-resource-field="body">{card.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    </>}

    {articles && <>
      <section class="resource-section resource-topics-section" id="topic-list" aria-labelledby="topics-title">
        <div class="resource-shell">
          <header class="resource-section-heading" data-resource-reveal>
            <div>
              <h2 id="topics-title" data-resource-key="topicsTitle">{articles.topicsTitle}</h2>
            </div>
          </header>
          <div class="resource-topic-grid">
            {articles.topicCategories.map((category, index) => (
              <article class="resource-topic-card" data-resource-reveal>
                <span class="resource-topic-card__number">0{index + 1}</span>
                <h3 data-resource-array="topicCategories" data-resource-index={index} data-resource-field="title">{category.title}</h3>
                <p data-resource-array="topicCategories" data-resource-index={index} data-resource-field="description">{category.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="resource-section resource-articles-section" aria-labelledby="articles-title">
        <div class="resource-shell">
          <header class="resource-section-heading" data-resource-reveal>
            <div>
              <h2 id="articles-title" data-resource-key="articlesTitle">{articles.articlesTitle}</h2>
            </div>
          </header>
          <div class="resource-empty-state resource-empty-state--articles" data-resource-reveal>
            <span class="resource-empty-state__icon" aria-hidden="true">≡</span>
            <h3 data-resource-key="articleEmptyTitle">{articles.articleEmptyTitle}</h3>
            <p data-resource-key="articleEmptyDescription">{articles.articleEmptyDescription}</p>
          </div>
        </div>
      </section>

      <section class="resource-section resource-editorial-section" aria-labelledby="editorial-title">
        <div class="resource-shell resource-editorial-layout">
          <header class="resource-section-heading resource-section-heading--stacked" data-resource-reveal>
            <h2 id="editorial-title" data-resource-key="editorialTitle">{articles.editorialTitle}</h2>
            <p class="resource-editorial-note" data-resource-key="editorialNote">{articles.editorialNote}</p>
          </header>
          <ol class="resource-editorial-list">
            {articles.editorialTopics.map((topic, index) => (
              <li data-resource-reveal>
                <span>0{index + 1}</span>
                <p data-resource-array="editorialTopics" data-resource-index={index}>{topic}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    </>}

    <section class="resource-closing" aria-labelledby="resource-closing-title">
      <div class="resource-closing__orb" aria-hidden="true"></div>
      <div class="resource-closing__inner" data-resource-reveal>
        <h2 id="resource-closing-title" data-resource-key="closingTitle">{copy.closingTitle}</h2>
        <p data-resource-key="closingDescription">{copy.closingDescription}</p>
        <a class="resource-button resource-button--light" href={closingCtaHref}>
          <span data-resource-key="closingCta">{copy.closingCta}</span><span aria-hidden="true"><ArrowUpRight /></span>
        </a>
      </div>
    </section>
  </div>
</MainLayout>

<script is:inline define:vars={{ pageTranslations }}>
  const applyResourceLocale = (locale) => {
    const copy = pageTranslations[locale] || pageTranslations.en;
    document.querySelectorAll('[data-resource-key]').forEach((element) => {
      const value = copy[element.dataset.resourceKey];
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('[data-resource-array]').forEach((element) => {
      const item = copy[element.dataset.resourceArray]?.[Number(element.dataset.resourceIndex)];
      const value = element.dataset.resourceField ? item?.[element.dataset.resourceField] : item;
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('[data-resource-package-field]').forEach((element) => {
      const packageOption = copy.packageCards[Number(element.closest('[data-resource-package-index]').dataset.resourcePackageIndex)];
      const value = packageOption?.[element.dataset.resourcePackageField];
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('[data-resource-package-feature]').forEach((element) => {
      const packageIndex = Number(element.closest('[data-resource-package-index]').dataset.resourcePackageIndex);
      const featureIndex = Number(element.parentElement.dataset.resourcePackageFeatureIndex);
      const value = copy.packageCards[packageIndex]?.features[featureIndex];
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('[data-resource-package-name-index]').forEach((element) => {
      const value = copy.packageCards[Number(element.dataset.resourcePackageNameIndex)]?.name;
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('[data-resource-step-field]').forEach((element) => {
      const value = copy.processSteps[Number(element.closest('[data-resource-step-index]').dataset.resourceStepIndex)]?.[element.dataset.resourceStepField];
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('[data-resource-activity-index]').forEach((element) => {
      const stepIndex = Number(element.closest('[data-resource-step-index]').dataset.resourceStepIndex);
      const activityIndex = Number(element.dataset.resourceActivityIndex);
      const value = copy.processSteps[stepIndex]?.activities[activityIndex];
      if (typeof value === 'string') element.textContent = value;
    });
    const description = document.querySelector('meta[name="description"]');
    if (description) description.setAttribute('content', copy.metaDescription);
    const openGraphTitle = document.querySelector('meta[property="og:title"]');
    if (openGraphTitle) openGraphTitle.setAttribute('content', copy.pageTitle);
    const openGraphDescription = document.querySelector('meta[property="og:description"]');
    if (openGraphDescription) openGraphDescription.setAttribute('content', copy.metaDescription);
  };

  applyResourceLocale(document.body.dataset.locale || 'en');
  window.addEventListener('ryzite:locale-change', (event) => applyResourceLocale(event.detail?.locale || 'en'));
</script>

<script>
  import { gsap } from 'gsap';

  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!motionPreference.matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        gsap.fromTo(entry.target, { autoAlpha: 0, y: 18 }, {
          autoAlpha: 1,
          y: 0,
          duration: 0.6,
          ease: 'power2.out',
          clearProps: 'all',
        });
        currentObserver.unobserve(entry.target);
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.resource-page [data-resource-reveal]').forEach((element) => observer.observe(element));

    const hero = document.querySelector('.resource-hero__copy');
    const heroTween = hero && gsap.fromTo(hero, { y: 18, autoAlpha: 0 }, {
      y: 0,
      autoAlpha: 1,
      duration: 0.8,
      ease: 'power3.out',
      delay: 0.08,
    });
    document.addEventListener('astro:before-swap', () => {
      observer.disconnect();
      heroTween?.kill();
    }, { once: true });
  }
</script>

<style>
  .resource-page { --resource-blue: #0756df; --resource-deep: #073db7; --resource-ink: #14243a; --resource-muted: #58677c; color: var(--resource-ink); background: var(--color-paper); }
  .resource-page *, .resource-page *::before, .resource-page *::after { box-sizing: border-box; }
  .resource-shell { width: min(100%, var(--content-max)); margin-inline: auto; padding-inline: var(--space-frame); }
  .resource-hero { position: relative; isolation: isolate; overflow: hidden; padding: clamp(4rem, 7vw, 6.5rem) var(--space-frame) 2rem; background: linear-gradient(118deg, #faf8f4, #f3f8ff 64%, #eaf4ff); }
  .resource-hero__inner { display: grid; min-height: 530px; grid-template-columns: minmax(0, 1fr) minmax(280px, .75fr); align-items: center; gap: clamp(2rem, 6vw, 6rem); }
  .resource-hero__copy { position: relative; z-index: 1; max-width: 800px; }
  .resource-eyebrow { display: flex; align-items: center; gap: .65rem; margin: 0 0 1rem; color: var(--resource-blue); font-size: var(--size-eyebrow); font-weight: 600; letter-spacing: .15em; line-height: 1.5; text-transform: uppercase; }
  .resource-eyebrow::before { width: 1.5rem; height: 2px; flex: 0 0 auto; border-radius: 2px; background: currentColor; content: ''; }
  .resource-hero h1 { max-width: var(--measure-h1); margin: 0; color: #101827; font-family: var(--font-display); font-size: var(--size-h1); font-weight: 700; letter-spacing: var(--tracking-h1); line-height: var(--leading-h1); overflow-wrap: anywhere; }
  .resource-hero__body { max-width: 680px; margin: 1.3rem 0 0; color: var(--resource-muted); font-size: var(--size-lead); line-height: 1.75; }
  .resource-hero__body--secondary { margin-top: .8rem; font-size: 1.1rem; }
  .resource-button { display: inline-flex; min-height: 3.1rem; align-items: center; justify-content: center; gap: 1rem; margin-top: 1.6rem; padding: .78rem 1.2rem; border: 1px solid transparent; border-radius: 999px; font-size: .99rem; font-weight: 600; text-align: center; text-decoration: none; transition: transform 180ms var(--ease-out), background 180ms ease, box-shadow 180ms ease; }
  .resource-button:hover { transform: translateY(-3px); }
  .resource-button:focus-visible, .resource-text-link:focus-visible, .resource-faq-item summary:focus-visible { outline: 3px solid var(--resource-blue); outline-offset: 4px; }
  .resource-button--primary { color: #fff; background: linear-gradient(110deg, #078be9, #064bed); box-shadow: 0 .7rem 1.5rem #064bed30; }
  .resource-button--primary:hover { background: linear-gradient(110deg, #087bd2, #043ec9); }
  .resource-hero__visual { position: relative; display: grid; width: min(100%, 400px); aspect-ratio: 1; place-items: center; justify-self: center; overflow: hidden; border: 1px solid #d5e5f8; border-radius: 2.2rem; background: radial-gradient(circle at center, #fff 0 22%, #eef6ff 23% 66%, #e1efff 67%); box-shadow: inset 0 0 0 1rem #ffffff50, 0 1.5rem 3.5rem #173b7110; }
  .resource-hero__visual::before { position: absolute; inset: 12%; border: 1px solid #8cb9ee80; border-radius: 50%; background-image: linear-gradient(#0655e914 1px, transparent 1px), linear-gradient(90deg, #0655e914 1px, transparent 1px); background-size: 16% 16%; content: ''; mask-image: radial-gradient(circle, #000 0 68%, transparent 69%); }
  .resource-hero__symbol { position: relative; z-index: 1; display: grid; width: 35%; aspect-ratio: 1; place-items: center; border: 1px solid #ffffffa0; border-radius: 1.5rem; color: #fff; background: linear-gradient(145deg, #078be9, #0643cf); box-shadow: 0 1.2rem 2.7rem #0655e93b; font-family: var(--font-display); font-size: clamp(3.3rem, 6.6vw, 5.5rem); font-weight: 700; }
  .resource-hero__orbit { position: absolute; inset: 7%; border: 1px solid #0655e92e; border-radius: 50%; }
  .resource-hero__orbit--inner { inset: 22%; border-style: dashed; border-color: #00a6fa55; }
  .resource-hero__spark { position: absolute; color: var(--resource-blue); }
  .resource-hero__spark--one { top: 15%; right: 22%; }
  .resource-hero__spark--two { bottom: 17%; left: 19%; }
  .resource-hero__visual-caption { position: absolute; right: 1rem; bottom: 1.1rem; left: 1rem; color: #617794; font-size: .638rem; font-weight: 600; letter-spacing: .12em; text-align: center; }
  .resource-hero__glow { position: absolute; z-index: -1; top: -38%; right: 5%; width: min(40vw, 560px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, #459eff28, transparent 68%); }
  .resource-hero__edge { display: flex; width: min(100%, var(--content-max)); justify-content: space-between; gap: 1rem; margin: 2rem auto 0; padding-top: 1rem; border-top: 1px solid #cdd9e7; color: #52647b; font-size: .682rem; font-weight: 600; letter-spacing: .12em; }
  .resource-hero__edge b { margin-left: .4rem; color: var(--resource-blue); }
  .resource-section { padding-block: clamp(4.5rem, 8vw, 7rem); }
  .resource-section:nth-of-type(even) { background: #fff; }
  .resource-intro { background: #fff; }
  .resource-intro__inner { display: grid; grid-template-columns: minmax(160px, .45fr) minmax(0, 1fr); align-items: start; gap: .7rem 3rem; }
  .resource-intro__inner .resource-eyebrow { grid-row: span 2; margin-top: .8rem; }
  .resource-intro h2, .resource-section-heading h2 { max-width: var(--measure-h2); margin: 0; color: #111d30; font-family: var(--font-display); font-size: var(--size-h2); font-weight: 700; letter-spacing: var(--tracking-h2); line-height: var(--leading-h2); }

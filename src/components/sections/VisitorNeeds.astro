---
const needs = [
  { lead: 'Need a', title: 'Website?', href: '/solutions', icon: 'M4 4h16v12H4z M2 20h20 M8 8h8 M8 11h5', kind: 'website' },
  { lead: 'Sell', title: 'Online?', href: '/solutions', icon: 'M2 3h3l3 13h11l3-10H6 M10 21h.01 M18 21h.01 M12 3v7 M9 6h6', kind: 'store' },
  { lead: 'Grow', title: 'Your Brand?', href: '/services', icon: 'M3 10v5h5l12 5V4L8 10H3z M8 15l2 6h4l-3-5 M23 9v6', kind: 'brand' },
  { lead: 'Build a', title: 'Custom Solution?', href: '/contact', icon: 'm8 7-5 5 5 5 M16 7l5 5-5 5 M14 4l-4 16', kind: 'custom' },
];
---

<section class="visitor-needs" aria-labelledby="visitor-needs-title">
  <header>
    <span class="eyebrow">Visitor Needs</span>
    <h2 id="visitor-needs-title">What does your business <strong>need next?</strong></h2>
    <p>Choose your next step. We’ll help you make it happen.</p>
  </header>
  <div class="needs-scene">
    <div class="needs-grid">
      {needs.map((need) => (
        <a class:list={['need-card', need.kind]} href={need.href}>
          <div class="need-visual" aria-hidden="true">
            <div class="visual-tile"><svg viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={need.icon} /></svg></div>
            <span class="visual-shadow"></span>
          </div>
          <h3>{need.lead}<strong>{need.title}</strong></h3>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
    <div class="scene-platform" aria-hidden="true"></div>
  </div>
</section>

<style>
  .visitor-needs { position: relative; isolation: isolate; overflow: hidden; padding: 76px 28px 65px; color: #18345b; background: radial-gradient(ellipse at 50% 10%, #fff 15%, #f0f5ff 60%, #c7e2ff); }
  .visitor-needs::before { content: ''; position: absolute; z-index: -1; width: 140%; height: 65%; left: -20%; top: 22%; border: 2px solid #59bbef20; border-radius: 50%; rotate: -18deg; box-shadow: 0 -5px 22px #8adfff20; pointer-events: none; }
  header { max-width: 800px; margin: 0 auto 42px; text-align: center; }
  .eyebrow { color: #1476bd; text-transform: uppercase; letter-spacing: .2em; font-size: 11px; font-weight: 800; }
  h2 { margin: 14px 0; font-size: clamp(28px, 3.4vw, 46px); line-height: 1.15; letter-spacing: -.04em; }
  h2 strong { color: #0879ad; }
  header p { margin: 0; color: #63758c; font-size: 16px; }
  .needs-scene { max-width: 1100px; margin: auto; perspective: 1200px; }
  .needs-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px; padding: 12px 18px 40px; }
  .need-card { position: relative; display: flex; align-items: center; gap: 22px; min-height: 220px; padding: 28px; color: #18345b; text-decoration: none; border: 1px solid #ffffffdb; border-radius: 36px; background: linear-gradient(145deg, #b4cfead1, #89b3df99 55%, #6e9dcead); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); box-shadow: inset 2px 3px 6px #ffffffcc, inset -2px -3px 8px #a5d8f533, 0 12px 30px #376b9b33; transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease; }
  .need-card:nth-child(odd) { transform: rotate(2deg); }
  .need-card:nth-child(even) { transform: rotate(-2deg); }
  .need-card:hover, .need-card:focus-visible { transform: translateY(-7px); border-color: #8cceee; box-shadow: inset 0 0 8px #ffffffcc, 0 0 20px #87d9ff33, 0 16px 30px #376b9b20; }
  .need-card:focus-visible { outline: 3px solid #6df6ee; outline-offset: 6px; }
  h3 { position: relative; z-index: 1; margin: 0; padding-right: 28px; font-size: clamp(24px, 2.5vw, 35px); line-height: 1.12; letter-spacing: -.04em; }
  h3 strong { display: block; margin-top: 3px; color: #0879ad; }
  .card-arrow { position: absolute; right: 22px; bottom: 22px; display: grid; place-items: center; width: 45px; height: 45px; border: 1px solid #94dcff; border-radius: 50%; color: white; background: linear-gradient(135deg, #36b7ed, #167acb); box-shadow: inset 0 0 7px #9beaff88, 0 0 12px #008cff66; font-size: 31px; }
  .need-visual { position: relative; flex: 0 0 38%; height: 145px; display: grid; place-items: center; }
  .visual-tile { position: relative; z-index: 1; display: grid; place-items: center; color: white; width: 125px; height: 110px; border: 2px solid #8eeaff; border-radius: 24px; background: linear-gradient(145deg, #51d8ff, #0879fa 55%, #2333c3); box-shadow: inset 2px 3px 8px #e1ffffaa, 6px 10px 0 #092987, 10px 18px 20px #000c3c70; transform: rotate(-10deg); }
  .visual-tile svg { width: 78px; height: 78px; filter: drop-shadow(0 4px 2px #1245a5); }
  .store .visual-tile { transform: rotate(8deg); background: linear-gradient(145deg, #5deeff, #0879fa 65%); }
  .brand .visual-tile { border-radius: 50% 28% 40% 30%; transform: rotate(-18deg); }
  .custom .visual-tile { transform: rotate(-12deg); box-shadow: 5px 10px 0 #83c7ff, 8px 19px 0 #5454db, 11px 28px 0 #ba9cff, 15px 35px 20px #000c3c70; }
  .visual-shadow { position: absolute; width: 140px; height: 18px; bottom: -5px; border-radius: 50%; background: #00aeff50; filter: blur(10px); }
  .scene-platform { height: 30px; margin: 0 10px; border: 2px solid #7eeaff; border-radius: 50%; background: linear-gradient(180deg, #ffffff80, #c5eaff66 45%, #b1d9f333 60%); box-shadow: 0 0 20px #8bdfff30, inset 0 3px 8px #ffffffaa; }
  @media (max-width: 700px) { .visitor-needs { padding: 55px 20px 40px; } header { margin-bottom: 28px; } header p { font-size: 14px; } .needs-grid { grid-template-columns: 1fr; gap: 24px; padding: 8px 4px 30px; } .need-card { min-height: 175px; padding: 22px; gap: 18px; border-radius: 28px; } .need-card:nth-child(n) { transform: none; } .need-card:hover { transform: translateY(-4px); } .need-visual { height: 125px; flex-basis: 34%; } .visual-tile { width: 95px; height: 90px; } .visual-tile svg { width: 62px; height: 62px; } h3 { font-size: 27px; } .card-arrow { width: 35px; height: 35px; font-size: 25px; right: 15px; bottom: 15px; } }
  @media (prefers-reduced-motion: reduce) { .need-card { transition: none; } .need-card:hover { transform: none; } }
</style>

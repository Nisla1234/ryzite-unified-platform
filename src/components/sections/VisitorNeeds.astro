---
// Full-bleed image panels: large vertical title, step label, then question + description at the bottom.
// Cover images in /images/needs were supplied by the client (portrait art). [PROPOSAL] layout pending client review.
// [OPEN] Confirm usage rights for these images; the website and e-commerce covers carry a third-party "REN" mark.
type Need = { lead: string; title: string; description: string; href: string; kind: string; image: string; width: number; height: number };

const needs: Need[] = [
  { lead: 'Need a', title: 'Website?', description: 'Create a powerful online presence with a modern, responsive website designed for your business.', href: '/solutions', kind: 'website', image: '/images/needs/need-website.webp', width: 736, height: 1173 },
  { lead: 'Ready for', title: 'E-Commerce?', description: 'Launch your online store, reach more customers, and grow your business with smart e-commerce solutions.', href: '/solutions', kind: 'store', image: '/images/needs/need-ecommerce.webp', width: 736, height: 1104 },
  { lead: 'Want to Grow', title: 'Your Brand?', description: 'Build a stronger brand identity and connect with your audience through creative digital solutions.', href: '/services', kind: 'brand', image: '/images/needs/need-brand.webp', width: 736, height: 1308 },
  { lead: 'Have an Idea to', title: 'Build?', description: 'Turn your unique ideas into powerful digital solutions tailored to your business needs.', href: '/contact', kind: 'custom', image: '/images/needs/need-build.webp', width: 736, height: 1318 },
];
---

<section class="visitor-needs" aria-labelledby="visitor-needs-title">
  <header>
    <h2 id="visitor-needs-title"><span data-home-key="needsTitleLead">What does your business</span> <strong data-home-key="needsTitleAccent">need next?</strong></h2>
    <p class="needs-subtitle" data-home-key="needsSubtitle">Choose your next step. We’ll help you make it happen.</p>
  </header>

  <div class="needs-grid" data-hs-reveal="needs-drop">
    {needs.map((need, index) => (
      <a class:list={['need-card', need.kind]} href={need.href} data-need-card>
        <img class="need-media" src={need.image} alt="" width={need.width} height={need.height} loading="lazy" decoding="async" />
        <span class="need-overlay" aria-hidden="true"></span>

        <span class="need-vertical" aria-hidden="true" data-home-key={`visitorNeeds.${index}.title`}>{need.title}</span>

        <div class="need-copy">
          <h3><span data-home-key={`visitorNeeds.${index}.lead`}>{need.lead}</span> <span data-home-key={`visitorNeeds.${index}.title`}>{need.title}</span></h3>
          <p data-home-key={`visitorNeeds.${index}.description`}>{need.description}</p>
        </div>
      </a>
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { onHomeReveal, prefersReducedMotion } from '../../scripts/home-reveal';

  // Panels drop in from above one after another; each starts before the previous one lands.
  onHomeReveal('needs-drop', (grid) => {
    if (prefersReducedMotion()) return;
    gsap.fromTo(grid.querySelectorAll('[data-need-card]'),
      { y: -160, autoAlpha: 0 },
      { y: 0, autoAlpha: 1, duration: 0.9, ease: 'back.out(1.3)', stagger: 0.28, clearProps: 'transform,opacity,visibility' });
  });
</script>

<style>
  .visitor-needs { position: relative; isolation: isolate; overflow: hidden; color: #18345b; background: var(--color-paper); }
  .visitor-needs::before { content: ''; position: absolute; z-index: -1; width: 140%; height: 65%; left: -20%; top: 10%; border: 2px solid #0b1c5820; border-radius: 50%; rotate: -18deg; box-shadow: 0 -5px 22px #8adfff20; pointer-events: none; }
  header { max-width: 800px; margin: 0 auto; padding: 28px 24px 44px; text-align: center; }
  h2 { margin: 14px 0; color: #0a1734; font-size: var(--size-h2); line-height: var(--leading-h2); letter-spacing: var(--tracking-h2); }
  h2 strong { color: var(--color-brand); }
  .needs-subtitle { margin: 0; color: #63758c; font-size: var(--size-body); line-height: var(--leading-body); }

  .needs-grid { display: grid; grid-template-columns: 1fr; }

  .need-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    min-height: 460px;
    padding: 28px 24px 26px;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    background: #0a1734;
    border-top: 1px solid rgb(255 255 255 / .14);
  }

  .need-media {
    position: absolute; inset: 0; z-index: -2;
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%;
    transition: transform .7s ease;
  }
  .need-overlay {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, rgb(11 28 88 / .3) 0%, rgb(11 28 88 / .08) 38%, rgb(11 28 88 / .5) 68%, rgb(10 23 52 / .92) 100%),
      rgb(11 28 88 / .2);
    transition: background-color .5s ease;
  }

  .need-vertical {
    /* One unbroken line: wrapping a rotated vertical title stacks its words in reverse order. */
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: 53px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -.02em;
    text-transform: lowercase;
    writing-mode: vertical-lr;
    transform: rotate(180deg);
    text-shadow: 0 2px 24px rgb(10 23 52 / .35);
    transition: translate .5s ease;
  }

  .need-copy { margin-top: 28px; }
  .need-copy h3 { margin: 0 0 10px; font-size: 18.5px; font-weight: 600; line-height: 1.3; }
  .need-copy p { max-width: 30ch; margin: 0; font-size: 14.5px; line-height: 1.55; color: rgb(255 255 255 / .85); }

  .need-card:hover .need-media, .need-card:focus-visible .need-media { transform: scale(1.05); }
  .need-card:hover .need-overlay, .need-card:focus-visible .need-overlay { background-color: rgb(11 28 88 / .3); }
  .need-card:hover .need-vertical, .need-card:focus-visible .need-vertical { translate: 0 -8px; }
  .need-card:focus-visible { outline: 3px solid #6df6ee; outline-offset: -6px; }

  @media (min-width: 640px) {
    .needs-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .need-card { min-height: 520px; border-left: 1px solid rgb(255 255 255 / .14); }
    .need-vertical { font-size: 61.5px; }
  }

  @media (min-width: 1024px) {
    .needs-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .need-card { min-height: 600px; padding: 32px 24px 30px; border-top: 0; }
    .need-card:first-child { border-left: 0; }
    /* Sized so the longest title ("e-commerce?") stays clear of the copy at the bottom. */
    .need-vertical { font-size: clamp(53px, 4.62vw, 79px); }
  }

  @media (max-width: 700px) {
    header { padding: 24px 20px 28px; }
    header h3 { font-size: 15.5px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .need-media, .need-overlay, .need-vertical { transition: none; }
    .need-card:hover .need-media, .need-card:focus-visible .need-media { transform: none; }
    .need-card:hover .need-vertical, .need-card:focus-visible .need-vertical { translate: none; }
  }
</style>

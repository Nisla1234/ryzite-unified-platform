---
// [PROPOSAL] Trust points describe the working approach already stated on /how-we-work.
// They are not guarantees. The Client Reviews subsection (ReviewsTrust) sits below the trust points
// and renders nothing until at least one official review profile URL is confirmed in reviews.ts.
import ReviewsTrust from './ReviewsTrust.astro';
import { homeSectionsTranslations } from '../../data/home-sections-translations';

interface Props { reviewsPreview?: boolean }
const { reviewsPreview = false } = Astro.props;

const copy = homeSectionsTranslations.en.trust;
const icons = [
  'M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z M14 3v5h5 M9 13h6 M9 17h4',
  'M21 12a8 8 0 0 1-11.8 7L4 20l1.2-4.3A8 8 0 1 1 21 12z M9 11h.01 M12 11h.01 M15 11h.01',
  'M12 3 4 6v6c0 4.5 3.4 8 8 9 4.6-1 8-4.5 8-9V6z M9 12l2 2 4-4',
  'M15 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0z M11 11v10 M11 15h4 M11 18h3',
];
---

<section class="hs-section trust" aria-labelledby="trust-title">
  <div class="hs-shell">
    <header class="hs-heading" data-hs-reveal>
      <h2 id="trust-title" data-home-key="sections.trust.title">{copy.title}</h2>
      <p data-home-key="sections.trust.intro">{copy.intro}</p>
    </header>

    <ul class="trust-grid">
      {copy.items.map((item, index) => (
        <li class="hs-card hs-card--hover trust-card" data-hs-reveal data-hs-delay={index * 0.1}>
          <span class="hs-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icons[index]} /></svg></span>
          <h3 data-home-key={`sections.trust.items.${index}.title`}>{item.title}</h3>
          <p data-home-key={`sections.trust.items.${index}.body`}>{item.body}</p>
        </li>
      ))}
    </ul>

    <ReviewsTrust preview={reviewsPreview} />
  </div>
</section>

<style>
  .trust-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-grid); margin: 0; padding: 0; list-style: none; }
  .trust-card { display: flex; flex-direction: column; gap: .35rem; padding: clamp(1.4rem, 2.4vw, 1.8rem); }
  .trust-card .hs-icon { margin-bottom: .8rem; }
  @media (max-width: 1100px) { .trust-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .trust-grid { grid-template-columns: 1fr; } }
</style>

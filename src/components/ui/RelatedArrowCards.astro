---
// Related service/solution links as arrow-shaped navy frosted-glass cards (client reference 2026-11-20).
// Used on service and solution detail pages. The body is clipped into a chevron; its tip edges are
// drawn by a stretched SVG. Put soft light behind the grid (on the section) so the glass has
// something to blur. Each item passes its own attributes for translation and reveal hooks.
type Attrs = Record<string, string | number | boolean | undefined>;
interface Item {
  href: string;
  title: string;
  /** Inner SVG markup on a 24x24 stroke grid (see src/data/detail-icons.ts). */
  icon?: string;
  attrs?: Attrs;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<div class="arrow-cards">
  {items.map((item, index) => (
    <a {...item.attrs} class="arrow-card" href={item.href}>
      <span class="arrow-card__body">
        <svg class="arrow-card__tip" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M88 0 100 50 88 100" vector-effect="non-scaling-stroke" /></svg>
        {item.icon && (
          <svg class="arrow-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={item.icon} />
        )}
        <span class="arrow-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <span class="arrow-card__title">{item.title}</span>
      </span>
    </a>
  ))}
</div>

<style>
  .arrow-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem 1.5rem; margin-top: 2.5rem; }
  .arrow-card { --tip: 12%; position: relative; display: block; min-height: 200px; color: #fff; text-decoration: none; transition: transform 220ms var(--ease-out); }
  .arrow-card:focus-visible { outline: 3px solid var(--color-brand); outline-offset: 4px; }
  .arrow-card__body { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .55rem; padding: 1.5rem calc(var(--tip) + 1.25rem) 1.5rem 1.5rem; border: 1px solid rgb(255 255 255 / 30%); border-right: 0; border-radius: 1.25rem 0 0 1.25rem; text-align: center; background: linear-gradient(160deg, rgb(22 41 111 / 88%), rgb(11 28 88 / 80%) 55%, rgb(11 28 88 / 92%)); box-shadow: inset 0 1px 0 rgb(255 255 255 / 30%); clip-path: polygon(0 0, calc(100% - var(--tip)) 0, 100% 50%, calc(100% - var(--tip)) 100%, 0 100%); -webkit-backdrop-filter: blur(14px) saturate(140%); backdrop-filter: blur(14px) saturate(140%); transition: background 220ms ease; }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) { .arrow-card__body { background: var(--color-brand); } }
  .arrow-card__tip { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .arrow-card__tip path { fill: none; stroke: rgb(255 255 255 / 35%); stroke-width: 1.5px; }
  .arrow-card__icon { width: 2.4rem; height: 2.4rem; color: #fff; }
  .arrow-card__number { color: #b9cdf2; font-size: .75rem; font-weight: 700; letter-spacing: .18em; }
  .arrow-card__title { font-family: var(--font-display); font-size: clamp(1.05rem, 1.5vw, 1.25rem); font-weight: 700; line-height: 1.3; letter-spacing: var(--tracking-h3); text-wrap: balance; }
  .arrow-card:hover { transform: translateX(6px); }
  .arrow-card:hover .arrow-card__body { background: linear-gradient(160deg, rgb(30 55 140 / 92%), rgb(16 36 106 / 86%) 55%, rgb(11 28 88 / 95%)); }
  @media (max-width: 700px) {
    .arrow-cards { grid-template-columns: 1fr; }
    .arrow-card { min-height: 170px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .arrow-card, .arrow-card__body { transition: none; }
    .arrow-card:hover { transform: none; }
  }
</style>

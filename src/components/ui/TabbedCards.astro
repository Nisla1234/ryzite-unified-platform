---
// Tabbed glass cards (client reference 2026-11-20): a navy tab holds the number and points into a frosted
// panel that overlaps it, so the navy shows through the glass; a line icon sits at the right. Used for
// solution capabilities (three across) and the packages "Scope to Confirm Together" list (one per row).
// Each item passes its own attributes so the host page's translation and reveal scripts keep working.
type Attrs = Record<string, string | number | boolean | undefined>;
interface Tag {
  label: string;
  value: string;
  labelAttrs?: Attrs;
  valueAttrs?: Attrs;
}
interface Item {
  text: string;
  textAttrs?: Attrs;
  /** Inner SVG markup on a 24x24 stroke grid. */
  icon?: string;
  /** Optional small chips under the text, e.g. a package name and its status. */
  tags?: Tag[];
  attrs?: Attrs;
}
interface Props {
  items: Item[];
  /** 'row': three across on wide screens; 'stack': one card per row. */
  layout?: 'row' | 'stack';
}
const { items, layout = 'row' } = Astro.props;
---

<div class:list={['tab-cards', `tab-cards--${layout}`]}>
  {items.map((item, index) => (
    <article {...item.attrs} class="tab-card">
      <span class="tab-card__tab" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <div class="tab-card__panel">
        <p {...item.textAttrs} class="tab-card__text">{item.text}</p>
        {item.tags && item.tags.length > 0 && (
          <ul class="tab-card__tags">
            {item.tags.map((tag) => (
              <li class="tab-card__tag"><span {...tag.labelAttrs} class="tab-card__tag-label">{tag.label}</span><span {...tag.valueAttrs} class="tab-card__tag-value">{tag.value}</span></li>
            ))}
          </ul>
        )}
      </div>
      {item.icon && (
        <svg class="tab-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={item.icon} />
      )}
    </article>
  ))}
</div>

<style>
  .tab-cards { display: grid; gap: clamp(1rem, 1.8vw, 1.5rem); margin-top: 2.75rem; }
  .tab-cards--row { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .tab-cards--stack { width: min(100%, 820px); grid-template-columns: 1fr; gap: 1.1rem; margin-inline: auto; }
  @media (max-width: 1100px) { .tab-cards--row { width: min(100%, 860px); grid-template-columns: 1fr; margin-inline: auto; } }
  .tab-card { --tab: 5.25rem; position: relative; display: grid; min-height: 132px; grid-template-columns: var(--tab) minmax(0, 1fr) 3.75rem; align-items: stretch; border: 1px solid rgb(255 255 255 / 90%); border-radius: 1.5rem; background: linear-gradient(160deg, rgb(255 255 255 / 92%), rgb(253 255 245 / 70%)); box-shadow: 0 1rem 2.4rem rgb(11 28 88 / 10%); transition: transform 220ms var(--ease-out), box-shadow 220ms ease; }
  .tab-cards--stack .tab-card { min-height: 112px; grid-template-columns: var(--tab) minmax(0, 1fr) 4.5rem; }
  .tab-card:hover { transform: translateY(-4px); box-shadow: 0 1.4rem 3rem rgb(11 28 88 / 16%); }
  .tab-card__tab { position: relative; display: grid; width: calc(var(--tab) + 2.5rem); place-items: center start; padding-left: 1.3rem; border-radius: 1.5rem 0 0 1.5rem; color: var(--color-milk); background: linear-gradient(160deg, var(--color-brand-hover), var(--color-brand)); font-family: var(--font-display); font-size: 1.7rem; font-weight: 700; line-height: 1; letter-spacing: -.01em; }
  /* Arrow notch on the tab, pointing into the panel. */
  .tab-card__tab::after { position: absolute; z-index: 2; top: 50%; left: calc(var(--tab) - 1.2rem); width: 1.1rem; height: 1.1rem; border-radius: 0 .2rem 0 0; background: var(--color-brand); content: ''; transform: translate(-50%, -50%) rotate(45deg); }
  .tab-card__panel { position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: center; gap: .7rem; margin: .6rem 0 .6rem -1.2rem; padding: 1rem 1rem 1rem 1.6rem; border: 1px solid rgb(255 255 255 / 75%); border-radius: 1.2rem; background: linear-gradient(160deg, rgb(234 240 255 / 72%), rgb(253 255 245 / 55%)); box-shadow: inset 0 1px 0 rgb(255 255 255 / 90%); -webkit-backdrop-filter: blur(14px) saturate(140%); backdrop-filter: blur(14px) saturate(140%); }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) { .tab-card__panel { background: #e6ecfa; } }
  .tab-card__text { margin: 0; color: var(--color-heading); font-family: var(--font-display); font-size: clamp(1.02rem, 1.3vw, 1.15rem); font-weight: 700; line-height: 1.35; letter-spacing: var(--tracking-h3); }
  .tab-card__tags { display: flex; flex-wrap: wrap; gap: .45rem; margin: 0; padding: 0; list-style: none; }
  .tab-card__tag { display: inline-flex; align-items: center; gap: .4rem; padding: .3rem .7rem; border: 1px solid rgb(11 28 88 / 14%); border-radius: 999px; background: rgb(255 255 255 / 70%); font-size: .8rem; line-height: 1.3; }
  .tab-card__tag-label { color: var(--color-brand); font-weight: 700; }
  .tab-card__tag-value { color: var(--color-text-subtle); }
  .tab-card__tag-value::before { margin-right: .4rem; color: rgb(11 28 88 / 35%); content: '·'; }
  .tab-card__icon { width: 2.1rem; height: 2.1rem; align-self: center; justify-self: center; color: var(--color-ink); }
  @media (max-width: 700px) {
    .tab-card, .tab-cards--stack .tab-card { --tab: 4.25rem; grid-template-columns: var(--tab) minmax(0, 1fr) 3.25rem; }
    .tab-card__tab { padding-left: .85rem; font-size: 1.35rem; }
    .tab-card__tab::after { left: calc(var(--tab) - .6rem); width: .9rem; height: .9rem; }
    .tab-card__panel { margin-left: -.6rem; padding: 1rem 1rem 1rem 1.3rem; }
    .tab-card__icon { width: 1.9rem; height: 1.9rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tab-card { transition: none; }
    .tab-card:hover { transform: none; }
  }
</style>

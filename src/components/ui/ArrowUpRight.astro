---
// Shared "go / open" arrow: a right-pointing arrow (client request 2026-11-18, replacing the diagonal ↗).
// The component keeps its original name so existing imports stay valid.
// Sizes to the surrounding font (1em) and takes the text colour, so existing badge/circle styles still apply.
interface Props { class?: string }
const { class: className } = Astro.props;
---

<svg class:list={['arrow-up-right', className]} viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>

<style>
  .arrow-up-right { display: inline-block; flex-shrink: 0; vertical-align: -0.125em; }
</style>

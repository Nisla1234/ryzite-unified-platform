---
// [PROPOSAL] Original illustrations for the marketing service cards (client request 2026-11-18:
// replace the text-glyph icons with a suitable image). One shared frame — brand-blue gradient,
// soft dot grid and a frosted panel — with a motif per service. Decorative only (aria-hidden).
interface Props { slug: string; class?: string }
const { slug, class: className } = Astro.props;
const id = `msa-${slug}`;
---

<svg class:list={['marketing-art', className]} viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}-bg`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0643cf" />
      <stop offset="1" stop-color="#078be9" />
    </linearGradient>
    <pattern id={`${id}-dots`} width="16" height="16" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1" fill="#ffffff" fill-opacity=".14" />
    </pattern>
  </defs>
  <rect width="320" height="180" fill={`url(#${id}-bg)`} />
  <rect width="320" height="180" fill={`url(#${id}-dots)`} />
  <circle cx="290" cy="20" r="70" fill="#ffffff" fill-opacity=".07" />
  <circle cx="20" cy="175" r="55" fill="#ffffff" fill-opacity=".06" />

  <g fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    {slug === 'google-seo-and-search-visibility' && (
      <>
        <rect x="56" y="42" width="208" height="34" rx="17" fill="#fff" fill-opacity=".16" />
        <circle cx="78" cy="59" r="7" /><path d="m83 64 6 6" />
        <path d="M100 59h96" stroke-opacity=".7" />
        <rect x="56" y="92" width="150" height="10" rx="5" fill="#fff" stroke="none" />
        <rect x="56" y="110" width="190" height="7" rx="3.5" fill="#fff" fill-opacity=".45" stroke="none" />
        <rect x="56" y="124" width="120" height="7" rx="3.5" fill="#fff" fill-opacity=".3" stroke="none" />
        <path d="M228 140l12-14 10 8 16-22" stroke="#bfe3ff" /><path d="M256 112h10v10" stroke="#bfe3ff" />
      </>
    )}
    {slug === 'google-ads-management' && (
      <>
        <circle cx="160" cy="92" r="52" fill="#fff" fill-opacity=".1" />
        <circle cx="160" cy="92" r="34" stroke-opacity=".75" />
        <circle cx="160" cy="92" r="16" fill="#fff" fill-opacity=".9" stroke="none" />
        <path d="M214 38l-46 46" /><path d="M214 38h-14m14 0v14" />
        <rect x="40" y="36" width="44" height="22" rx="6" fill="#fff" fill-opacity=".2" />
        <path d="M50 47h24" stroke-width="2.5" />
      </>
    )}
    {slug === 'facebook-and-instagram-ads' && (
      <>
        <rect x="118" y="24" width="84" height="140" rx="16" fill="#fff" fill-opacity=".14" />
        <rect x="130" y="44" width="60" height="50" rx="8" fill="#fff" fill-opacity=".85" stroke="none" />
        <path d="M130 106h44M130 118h30" stroke-opacity=".7" />
        <circle cx="72" cy="70" r="20" fill="#fff" fill-opacity=".16" /><circle cx="72" cy="70" r="7" />
        <rect x="232" y="96" width="44" height="44" rx="12" fill="#fff" fill-opacity=".16" />
        <circle cx="254" cy="118" r="10" /><circle cx="266" cy="106" r="2" fill="#fff" stroke="none" />
      </>
    )}
    {slug === 'social-media-management' && (
      <>
        <rect x="70" y="30" width="180" height="40" rx="12" fill="#fff" fill-opacity=".16" />
        <circle cx="92" cy="50" r="9" fill="#fff" stroke="none" /><path d="M110 46h80M110 56h50" stroke-opacity=".75" stroke-width="2.5" />
        <rect x="70" y="80" width="180" height="40" rx="12" fill="#fff" fill-opacity=".1" />
        <circle cx="92" cy="100" r="9" fill="#fff" fill-opacity=".7" stroke="none" /><path d="M110 96h64M110 106h40" stroke-opacity=".55" stroke-width="2.5" />
        <path d="M232 150c-14-10-22-17-22-26a10 10 0 0 1 20-3 10 10 0 0 1 20 3c0 9-8 16-18 26Z" fill="#fff" fill-opacity=".9" stroke="none" />
      </>
    )}
    {slug === 'branding-and-logo-design' && (
      <>
        <circle cx="128" cy="92" r="46" fill="#fff" fill-opacity=".14" />
        <path d="M128 62l9 20 21 2-16 14 5 21-19-11-19 11 5-21-16-14 21-2Z" fill="#fff" stroke="none" />
        <circle cx="222" cy="58" r="12" fill="#bfe3ff" stroke="none" />
        <circle cx="252" cy="58" r="12" fill="#fff" fill-opacity=".6" stroke="none" />
        <circle cx="282" cy="58" r="12" fill="#fff" fill-opacity=".25" stroke="none" />
        <path d="M206 140l44-44 12 12-44 44h-12Z" fill="#fff" fill-opacity=".18" /><path d="M244 102l12 12" />
      </>
    )}
    {slug === 'content-reels-and-motion-design' && (
      <>
        <rect x="64" y="34" width="150" height="104" rx="14" fill="#fff" fill-opacity=".16" />
        <path d="M128 66v40l32-20Z" fill="#fff" stroke="none" />
        <path d="M64 120h150" stroke-opacity=".5" /><circle cx="110" cy="120" r="5" fill="#fff" stroke="none" />
        <rect x="230" y="50" width="40" height="70" rx="9" fill="#fff" fill-opacity=".12" />
        <rect x="244" y="36" width="40" height="70" rx="9" fill="#fff" fill-opacity=".22" />
        <path d="M258 64v16l12-8Z" fill="#fff" stroke="none" />
      </>
    )}
    {slug === 'online-store-marketing' && (
      <>
        <path d="M58 52h18l16 62h96l16-46H86" />
        <circle cx="104" cy="134" r="8" fill="#fff" stroke="none" /><circle cx="176" cy="134" r="8" fill="#fff" stroke="none" />
        <rect x="108" y="78" width="22" height="22" rx="4" fill="#fff" fill-opacity=".5" stroke="none" />
        <rect x="140" y="72" width="22" height="28" rx="4" fill="#fff" fill-opacity=".8" stroke="none" />
        <path d="M222 140l14-18 12 8 20-28" stroke="#bfe3ff" /><path d="M258 102h10v10" stroke="#bfe3ff" />
      </>
    )}
    {slug === 'marketing-automation-and-crm' && (
      <>
        <rect x="40" y="70" width="58" height="40" rx="10" fill="#fff" fill-opacity=".85" stroke="none" />
        <rect x="131" y="34" width="58" height="40" rx="10" fill="#fff" fill-opacity=".2" />
        <rect x="131" y="106" width="58" height="40" rx="10" fill="#fff" fill-opacity=".2" />
        <rect x="222" y="70" width="58" height="40" rx="10" fill="#fff" fill-opacity=".85" stroke="none" />
        <path d="M98 90h14v-36h19M98 90h14v36h19M189 54h14v36h19M189 126h14v-36" stroke-opacity=".8" />
        <circle cx="160" cy="54" r="5" fill="#fff" stroke="none" /><circle cx="160" cy="126" r="5" fill="#fff" stroke="none" />
      </>
    )}
    {slug === 'blog-writing-and-content-marketing' && (
      <>
        <rect x="80" y="26" width="130" height="130" rx="14" fill="#fff" fill-opacity=".16" />
        <rect x="96" y="44" width="98" height="34" rx="6" fill="#fff" fill-opacity=".8" stroke="none" />
        <path d="M96 94h98M96 108h80M96 122h90M96 136h60" stroke-opacity=".7" stroke-width="2.5" />
        <path d="M232 128l30-62 12 6-30 62-14 6Z" fill="#fff" fill-opacity=".2" /><path d="M256 78l12 6" />
      </>
    )}
    {slug === 'website-tracking-and-conversion-improvement' && (
      <>
        <rect x="48" y="30" width="224" height="122" rx="14" fill="#fff" fill-opacity=".14" />
        <path d="M48 52h224" stroke-opacity=".5" />
        <circle cx="62" cy="41" r="3" fill="#fff" stroke="none" /><circle cx="74" cy="41" r="3" fill="#fff" stroke="none" />
        <rect x="72" y="104" width="22" height="34" rx="4" fill="#fff" fill-opacity=".45" stroke="none" />
        <rect x="104" y="88" width="22" height="50" rx="4" fill="#fff" fill-opacity=".6" stroke="none" />
        <rect x="136" y="74" width="22" height="64" rx="4" fill="#fff" fill-opacity=".8" stroke="none" />
        <rect x="168" y="62" width="22" height="76" rx="4" fill="#fff" stroke="none" />
        <path d="M212 120l14-14 12 10 22-28" stroke="#bfe3ff" /><path d="M250 88h10v10" stroke="#bfe3ff" />
      </>
    )}
    {slug === 'practical-ai-marketing-support' && (
      <>
        <rect x="96" y="40" width="128" height="100" rx="20" fill="#fff" fill-opacity=".16" />
        <path d="M160 64l7 17 17 7-17 7-7 17-7-17-17-7 17-7Z" fill="#fff" stroke="none" />
        <path d="M206 52l3 7 7 3-7 3-3 7-3-7-7-3 7-3Z" fill="#bfe3ff" stroke="none" />
        <path d="M60 64h36M60 90h36M60 116h36M224 64h36M224 90h36M224 116h36" stroke-opacity=".55" stroke-width="2.5" />
        <circle cx="56" cy="64" r="4" fill="#fff" stroke="none" /><circle cx="56" cy="116" r="4" fill="#fff" stroke="none" />
        <circle cx="264" cy="90" r="4" fill="#fff" stroke="none" />
      </>
    )}
  </g>
</svg>

<style>
  .marketing-art { display: block; width: 100%; height: 100%; }
</style>

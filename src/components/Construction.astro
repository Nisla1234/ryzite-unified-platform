---
const currentYear = new Date().getFullYear();
---

<main class="construction-page">
  <header class="site-header">
    <a class="wordmark" href="#top" aria-label="Ryzite home">
      <span>Ryzite</span><span class="wordmark-mark" aria-hidden="true">*</span>
    </a>
    <p class="header-note">Design <span>×</span> Technology <span>×</span> Growth</p>
  </header>

  <section class="hero" id="top" aria-labelledby="page-title">
    <div class="hero-copy">
      <div class="margin-note" aria-hidden="true">
        <span>Same ideas.<br />Bigger things<br />coming!</span>
        <svg viewBox="0 0 94 65">
          <path d="M86 61C88 28 68 7 35 7M35 7l15-6M35 7l14 9"></path>
        </svg>
      </div>

      <h1 id="page-title">We’re<br />Building<br />Something <span>Better.</span></h1>
      <p class="intro">
        Our website is currently under construction. We’re working on a fresh experience to show
        you what Ryzite can do.
      </p>
      <div class="actions" aria-label="Contact Ryzite">
        <a class="primary-action" href="mailto:hello@ryzite.com?subject=Get%20a%20Quote">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5h18v12H3zM3 7l9 7 9-7"></path></svg>
          <span>Get a Quote</span>
          <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M14 7l5 5-5 5"></path></svg>
        </a>
        <a class="email-action" href="mailto:hello@ryzite.com">hello@ryzite.com</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="sticky-note" aria-hidden="true">
        Polishing<br />Designing<br />Building<br />For You. <span>⌣</span>
      </div>
      <svg class="doodle-arrow" viewBox="0 0 78 58" aria-hidden="true">
        <path d="M2 9c34-2 55 13 64 39M54 37l12 12 7-15"></path>
      </svg>
      <img
        src="/assets/ryzite-construction-illustration.png"
        width="1536"
        height="1024"
        alt="A hand-drawn browser window being built with a ladder, paint tools and traffic cone"
        fetchpriority="high"
      />
      <div class="idea-note" aria-hidden="true">
        <svg viewBox="0 0 64 64">
          <rect x="5" y="5" width="54" height="54" rx="8"></rect>
          <path d="M25 41h14M28 47h8M24 27c0-6 4-11 10-11s10 5 10 11c0 4-2 7-5 10H29c-3-3-5-6-5-10zM34 10V5M18 16l-4-4M50 16l4-4M17 30h-6M57 30h-6"></path>
        </svg>
      </div>
      <div class="impact-note" aria-hidden="true">
        <svg viewBox="0 0 140 90">
          <path d="M105 8c35 15 26 43-3 50-31 8-85-8-91 10-4 11 13 14 31 9M32 68l12 9-13 10"></path>
        </svg>
        <span>More ideas<br />More solutions<br />More impact</span>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="footer-left">
      <p>Stay connected</p>
      <a href="mailto:hello@ryzite.com" aria-label="Email Ryzite">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5h18v12H3zM3 7l9 7 9-7"></path></svg>
      </a>
    </div>
    <div class="footer-right">
      <p class="service-line"><span>Grow my business</span><i>×</i><span>Build my idea</span></p>
      <p>© {currentYear} Ryzite. All rights reserved.</p>
    </div>
  </footer>
</main>

<style>
  .construction-page {
    --page-bg: #f7f5ef;
    --page-ink: #0a1117;
    --page-lime: #c7ff4a;
    --page-violet: #cbb8ff;
    min-height: 100svh;
    padding: clamp(28px, 4.4vw, 72px) clamp(24px, 7.1vw, 110px) clamp(24px, 3.7vw, 56px);
    color: var(--page-ink);
    background: var(--page-bg);
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .wordmark {
    display: inline-flex;
    align-items: flex-start;
    color: inherit;
    font-size: clamp(2rem, 2.7vw, 2.75rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.055em;
    text-decoration: none;
  }

  .wordmark-mark {
    margin: -0.15em 0 0 0.16em;
    color: var(--page-lime);
    font-size: 0.72em;
    font-weight: 400;
  }

  .header-note,
  .site-footer p { margin: 0; }

  .header-note {
    color: #42484c;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  .header-note span { margin-inline: 0.45em; }

  .hero {
    display: grid;
    grid-template-columns: minmax(430px, 0.98fr) minmax(500px, 1.02fr);
    align-items: center;
    gap: clamp(38px, 4vw, 74px);
    min-height: clamp(560px, 62vh, 650px);
    padding: clamp(70px, 6.5vw, 96px) 0 clamp(42px, 4vw, 60px);
  }

  .hero-copy,
  .hero-visual {
    position: relative;
    min-width: 0;
  }

  .hero-copy { z-index: 2; }

  .margin-note {
    position: absolute;
    top: -114px;
    left: 10px;
    display: flex;
    align-items: flex-start;
    gap: 6px;
    transform: rotate(-7deg);
    font-family: 'Comic Sans MS', 'Bradley Hand', cursive;
    font-size: clamp(0.84rem, 1.1vw, 1rem);
    line-height: 1.35;
  }

  .margin-note svg {
    width: 64px;
    height: 48px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  h1 {
    max-width: 700px;
    margin: 0;
    font-size: clamp(4rem, 5.4vw, 5.4rem);
    font-weight: 600;
    line-height: 0.88;
    letter-spacing: -0.078em;
  }

  h1 span {
    position: relative;
    z-index: 0;
    display: inline-block;
    padding: 0 0.1em 0.05em 0.04em;
    font-style: italic;
    letter-spacing: -0.075em;
  }

  h1 span::before {
    position: absolute;
    z-index: -1;
    inset: 0.16em -0.03em 0.02em;
    border-radius: 9px;
    background: var(--page-lime);
    content: '';
    transform: rotate(-3deg);
  }

  .intro {
    max-width: 620px;
    margin: 28px 0 0;
    color: #30363a;
    font-size: clamp(1.05rem, 1.42vw, 1.3rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 28px;
  }

  .actions a {
    display: inline-flex;
    min-height: 58px;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--page-ink);
    border-radius: 999px;
    color: inherit;
    font-size: 1rem;
    text-decoration: none;
    transition: transform 180ms ease, background 180ms ease, color 180ms ease;
  }

  .actions a:hover { transform: translateY(-3px); }

  .primary-action {
    gap: 14px;
    min-width: 228px;
    padding: 12px 20px;
    color: #fff !important;
    background: var(--page-ink);
  }

  .primary-action:hover {
    color: var(--page-ink) !important;
    background: var(--page-lime);
  }

  .primary-action svg,
  .footer-left svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .primary-action .arrow { margin-left: auto; }

  .email-action {
    min-width: 205px;
    padding: 12px 28px;
    background: transparent;
  }

  .email-action:hover {
    color: #fff;
    background: var(--page-ink);
  }

  .hero-visual {
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-visual > img {
    position: relative;
    z-index: 1;
    width: min(100%, 740px);
    height: auto;
    filter: contrast(1.03);
  }

  .sticky-note {
    position: absolute;
    z-index: 3;
    top: 2%;
    left: 12%;
    width: 143px;
    padding: 18px 18px 16px;
    border-radius: 8px;
    background: var(--page-lime);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.35;
    transform: rotate(-9deg);
  }

  .sticky-note span {
    float: right;
    font-size: 1.6rem;
    line-height: 0.7;
  }

  .doodle-arrow,
  .impact-note svg,
  .idea-note svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .doodle-arrow {
    position: absolute;
    z-index: 3;
    top: 7%;
    left: 32%;
    width: 78px;
    stroke-width: 2;
  }

  .idea-note {
    position: absolute;
    z-index: 3;
    top: 25%;
    right: -2%;
    width: 82px;
    padding: 12px;
    border-radius: 9px;
    color: var(--page-ink);
    background: var(--page-violet);
    transform: rotate(11deg);
  }

  .idea-note svg {
    display: block;
    stroke-width: 2;
  }

  .impact-note {
    position: absolute;
    z-index: 3;
    right: -3%;
    bottom: 1%;
    display: flex;
    align-items: flex-end;
    font-family: 'Comic Sans MS', 'Bradley Hand', cursive;
    font-size: 0.9rem;
    line-height: 1.35;
    transform: rotate(-8deg);
  }

  .impact-note svg {
    width: 132px;
    stroke-width: 2;
  }

  .site-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 42px;
    min-height: 95px;
    padding-top: 28px;
    border-top: 2px solid #bfc1bd;
  }

  .footer-left > p,
  .footer-right p:first-child {
    color: #3f4548;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .footer-left a {
    display: inline-flex;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    margin-top: 13px;
    border: 2px solid var(--page-ink);
    border-radius: 7px;
    color: inherit;
    transition: color 180ms ease, background 180ms ease;
  }

  .footer-left a:hover {
    color: #fff;
    background: var(--page-ink);
  }

  .footer-right {
    padding-left: clamp(28px, 4vw, 64px);
    border-left: 2px solid #bfc1bd;
    text-align: right;
  }

  .service-line {
    display: flex;
    gap: 12px;
  }

  .service-line i { font-style: normal; }

  .footer-right p:last-child {
    margin-top: 8px;
    color: #4b5053;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }

  @media (max-width: 1120px) {
    .construction-page { padding-inline: clamp(28px, 5vw, 60px); }
    .hero { grid-template-columns: minmax(390px, 0.98fr) minmax(420px, 1.02fr); }
    h1 { font-size: clamp(3.7rem, 5.5vw, 4.7rem); }
    .impact-note { right: 0; }
  }

  @media (max-width: 820px) {
    .header-note { display: none; }
    .hero {
      grid-template-columns: 1fr;
      gap: 26px;
      padding: 112px 0 46px;
    }
    .margin-note { top: -91px; left: 4px; }
    h1 { max-width: 650px; font-size: clamp(3.6rem, 11.5vw, 5.5rem); }
    .intro { max-width: 590px; }
    .hero-visual { min-height: 440px; }
    .hero-visual > img { width: min(100%, 690px); }
    .impact-note { right: 2%; }
  }

  @media (max-width: 560px) {
    .construction-page { padding: 26px 20px 24px; }
    .wordmark { font-size: 2.2rem; }
    .hero { padding-top: 106px; }
    .margin-note { font-size: 0.78rem; }
    h1 { font-size: clamp(3.25rem, 16.5vw, 4.6rem); line-height: 0.91; }
    .intro { margin-top: 25px; font-size: 1.05rem; }
    .actions { display: grid; gap: 12px; margin-top: 26px; }
    .actions a { width: 100%; }
    .hero-visual { min-height: 350px; }
    .sticky-note { top: 1%; left: 1%; width: 112px; padding: 13px; font-size: 0.77rem; }
    .doodle-arrow { top: 7%; left: 31%; width: 54px; }
    .idea-note { top: 20%; right: 0; width: 58px; padding: 8px; }
    .impact-note { right: 0; bottom: -12%; font-size: 0.7rem; }
    .impact-note svg { width: 86px; }
    .site-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 26px;
      margin-top: 36px;
    }
    .footer-right {
      width: 100%;
      padding: 22px 0 0;
      border-top: 2px solid #bfc1bd;
      border-left: 0;
      text-align: left;
    }
    .service-line { flex-wrap: wrap; }
  }

  @media (prefers-reduced-motion: reduce) {
    .actions a,
    .footer-left a { transition: none; }
  }
</style>

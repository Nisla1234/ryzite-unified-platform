---
import { localeLabels, type Locale } from '../../Constants';

interface Props {
    content: any;
    showLanguages?: boolean;
    activePath?: string;
}

const { content, showLanguages = true, activePath = Astro.url.pathname } = Astro.props;

const navItems = [
    { href: '/services/', label: content.nav.services, key: 'nav.services' },
    { href: '/about/', label: content.nav.about, key: 'nav.about' },
    { href: '/how-we-work/', label: content.nav.process, key: 'nav.process' },
    { href: '/contact/', label: content.nav.contact, key: 'nav.contact' },
];

const isActive = (href: string) => activePath === href || (href !== '/' && activePath.startsWith(href));
---

<header class="site-header" data-header>
    <a class="wordmark" href="/" aria-label="Ryzite home">Ryzite<span>*</span></a>
    <nav class="desktop-nav" aria-label="Primary navigation">
        {navItems.map((item) => (
            <a href={item.href} data-i18n={item.key} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
            </a>
        ))}
    </nav>
    <div class="header-actions">
        {showLanguages && <div class="language-switcher" aria-label="Language">
            {(Object.entries(localeLabels) as Array<[Locale, string]>).map(([locale, label]) => (
                <button type="button" data-locale-button={locale} aria-pressed={locale === 'en'}>
                    {label}
                </button>
            ))}
        </div>}
        <a class="header-cta" href="/contact/">
            <span data-i18n="nav.cta">{content.nav.cta}</span>
            <span aria-hidden="true">↗</span>
        </a>
        <details class="mobile-nav">
            <summary>Menu</summary>
            <nav aria-label="Mobile navigation">
                {navItems.map((item) => (
                    <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
                ))}
                <a class="mobile-nav__cta" href="/contact/">{content.nav.cta} <span aria-hidden="true">↗</span></a>
            </nav>
        </details>
    </div>
</header>

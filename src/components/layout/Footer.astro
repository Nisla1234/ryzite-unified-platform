---
import { company } from '../../Constants';

const year = new Date().getFullYear();
---

<footer class="footer" id="site-footer">
  <div class="footer-backdrop">
    <div class="footer-glass">
      <div class="footer-grid">
        <div class="footer-brand">
          <a class="footer-logo-link" href="/" aria-label="Ryzite home">
            <img class="footer-logo" src="/assets/ryzite-footer-logo.png" alt="Ryzite" width="1061" height="731" loading="lazy" />
          </a>
          <p data-home-key="footerTagline">One Agency. All Your Business Solutions.</p>
          <a class="footer-email" href={`mailto:${company.email}`}>{company.email}</a>
        </div>

        <nav class="footer-column" aria-label="Explore" data-home-aria="footerExplore">
          <h2 data-home-key="footerExplore">Explore</h2>
          <a href="/" data-home-key="footerLinkHome">Home</a>
          <a href="/about" data-home-key="footerLinkAbout">About Us</a>
          <a href="/services/" data-home-key="footerLinkServices">Services</a>
          <a href="/solutions/" data-home-key="footerLinkSolutions">Solutions</a>
          <a href="/contact/" data-home-key="footerLinkContact">Contact</a>
        </nav>

        <nav class="footer-column" aria-label="More" data-home-aria="footerMore">
          <h2 data-home-key="footerMore">More</h2>
          <a href="/packages/" data-home-key="footerLinkPackages">Packages</a>
          <a href="/privacy-policy" data-home-key="footerLinkPrivacy">Privacy Policy</a>
        </nav>

        <div class="footer-connect">
          <h2 data-home-key="footerConnect">Let’s connect</h2>
          <a class="footer-contact-link" href="/contact/">
            <span data-home-key="footerConnectCta">Start a conversation</span> <span aria-hidden="true">↗</span>
          </a>
          <p data-home-key="footerConnectBody">Have a project in mind? Let’s build something that matters.</p>
        </div>
      </div>

      <div class="footer-bottom">
        <p>© {year} Ryzite. <span data-home-key="footerRights">All rights reserved.</span></p>
        <span data-home-key="footerBottom">Designed to move forward.</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--color-ink);
    background: var(--color-paper);
  }

  .footer-backdrop {
    padding: clamp(1.5rem, 4vw, 3.5rem) var(--space-frame);
  }

  .footer-glass {
    width: min(100%, var(--content-max));
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 4.75rem);
    border: 1px solid rgb(255 255 255 / 82%);
    border-radius: var(--radius-large);
    background: linear-gradient(135deg, rgb(255 255 255 / 69%), rgb(248 250 255 / 50%));
    box-shadow:
      0 1.5rem 4rem rgb(31 43 62 / 12%),
      inset 0 1px 0 rgb(255 255 255 / 90%);
    -webkit-backdrop-filter: blur(28px) saturate(150%);
    backdrop-filter: blur(28px) saturate(150%);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(15rem, 1.3fr) minmax(8rem, 0.7fr) minmax(8rem, 0.7fr) minmax(15rem, 0.95fr);
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .footer-brand,
  .footer-column,
  .footer-connect {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-logo-link {
    display: block;
    width: clamp(14rem, 22vw, 19rem);
    max-width: 100%;
    overflow: hidden;
  }

  .footer-logo {
    display: block;
    width: 100%;
    height: auto;
  }

  .footer-brand p {
    max-width: 22rem;
    margin: 1.25rem 0 0;
    color: var(--color-muted-light);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.6;
  }

  .footer-email {
    margin-top: 2rem;
    color: #5d626a;
    font-size: 1rem;
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .footer-email:hover {
    color: #0655e9;
  }

  .footer-column h2,
  .footer-connect h2 {
    margin: 0 0 1.5rem;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 0.84rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .footer-column a {
    margin: 0 0 0.85rem;
    color: #5d626a;
    font-size: 1rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color var(--duration-fast) ease, transform var(--duration-fast) var(--ease-out);
  }

  .footer-column a:hover {
    color: #0655e9;
    transform: translateX(3px);
  }

  .footer-contact-link {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    gap: 0.8rem;
    padding: 0.75rem 1rem;
    border: 1px solid rgb(6 85 233 / 18%);
    border-radius: 999px;
    color: #3f4650;
    background: rgb(255 255 255 / 54%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 90%), 0 0.5rem 1.5rem rgb(8 12 17 / 6%);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-out), background var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
  }

  .footer-contact-link:hover {
    transform: translateY(-3px);
    background: rgb(255 255 255 / 88%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 95%), 0 0.85rem 1.8rem rgb(6 85 233 / 14%);
  }

  .footer-contact-link span {
    color: #0655e9;
    font-size: 1.15rem;
  }

  .footer-connect p {
    max-width: 22rem;
    margin: 1.25rem 0 0;
    color: var(--color-muted-light);
    font-size: 1rem;
    line-height: 1.65;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(3rem, 6vw, 5.5rem);
    padding-top: 1.35rem;
    border-top: 1px solid rgb(8 12 17 / 14%);
    color: #72767c;
    font-size: 0.88rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer a:focus-visible {
    outline: 3px solid #0655e9;
    outline-offset: 4px;
  }

  @media (max-width: 1040px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .footer-backdrop {
      padding-inline: 1rem;
    }

    .footer-glass {
      padding: 1.75rem;
      border-radius: var(--radius-medium);
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-brand {
      grid-column: auto;
    }

    .footer-brand p {
      margin-top: 0.5rem;
    }

    .footer-email {
      margin-top: 1.25rem;
    }

    .footer-column h2,
    .footer-connect h2 {
      margin-bottom: 0.9rem;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      margin-top: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-email,
    .footer-column a,
    .footer-contact-link {
      transition: none;
    }
  }
</style>

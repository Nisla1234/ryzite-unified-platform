---
// [PROPOSAL] Brand-blue footer (client brief 2026-11-18, inspired by a reference — not a copy):
// big call-to-action headline, contact and menus on top, faint looping lines behind, and a giant
// RYZITE wordmark along the bottom. All text keeps its translation keys (data-label-key).
import ArrowUpRight from '../ui/ArrowUpRight.astro';
import { company } from '../../Constants';

const year = new Date().getFullYear();
const whatsappUrl = `https://wa.me/${company.whatsapp.number}`;
const phoneHref = `tel:+${company.whatsapp.number}`;
---

<footer class="footer" id="site-footer">
  <svg class="footer-loops" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <path pathLength="1" d="M-60 140 C 180 -40 440 250 310 310 C 180 370 150 170 330 140 C 540 105 610 430 830 390 C 1050 350 990 120 870 160 C 740 205 830 430 1070 470 C 1310 510 1450 300 1520 250" />
    <path pathLength="1" d="M-60 720 C 170 560 390 830 300 870 C 200 910 150 730 360 690 C 620 640 760 870 1000 790 C 1210 720 1110 560 1000 600 C 880 650 1060 880 1520 770" />
  </svg>

  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-cta">
        <p class="footer-label" data-label-key="footerConnect">Let’s Connect</p>
        <h2 class="footer-headline" data-label-key="footerConnectBody">Have a project in mind? Let’s build something meaningful.</h2>
        <a class="footer-cta-button" href="/contact">
          <span data-label-key="footerConnectCta">Start a Conversation</span>
          <span class="footer-cta-icon" aria-hidden="true"><ArrowUpRight /></span>
        </a>
        <div class="footer-contact-list">
          <a href={`mailto:${company.email}`}>{company.email}</a>
          <a href={phoneHref}>{company.whatsapp.display}</a>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp <span aria-hidden="true"><ArrowUpRight /></span></a>
        </div>
      </div>

      <div class="footer-menus">
        <nav class="footer-column" aria-label="Explore" data-aria-label-key="footerExplore">
          <h2 data-label-key="footerExplore">Explore</h2>
          <a href="/" data-label-key="home">Home</a>
          <a href="/about" data-label-key="about">About Us</a>
          <a href="/services" data-label-key="services">Services</a>
          <a href="/solutions" data-label-key="solutions">Solutions</a>
          <a href="/contact" data-label-key="contact">Contact</a>
        </nav>

        <nav class="footer-column" aria-label="Resources" data-aria-label-key="footerResources">
          <h2 data-label-key="footerResources">Resources</h2>
          <a href="/packages" data-label-key="packages">Packages</a>
          <a href="/how-we-work" data-label-key="process">How We Work</a>
          <a href="/our-work" data-label-key="work">Our Work</a>
          <a href="/articles" data-label-key="articles">Articles</a>
        </nav>

        <p class="footer-tagline" data-label-key="footerTagline">One Agency. All Your Business Solutions.</p>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} RYZITE. <span data-label-key="footerRights">All rights reserved.</span></p>
      <span data-label-key="footerBottom">Designed to move forward.</span>
    </div>

    <a class="footer-wordmark" href="/" aria-label="RYZITE home">
      <svg viewBox="0 0 1000 268" aria-hidden="true" focusable="false">
        <text x="0" y="262" textLength="1000" lengthAdjust="spacingAndGlyphs">RYZITE</text>
      </svg>
    </a>
  </div>
</footer>

<style>
  .footer {
    --footer-blue: #0655e9;
    --footer-deep: #0643cf;
    --footer-ink: #ffffff;
    --footer-muted: rgb(255 255 255 / 72%);
    --footer-word: #eef3ff;
    --footer-gutter: max(1.5rem, calc((100vw - 1300px) / 2)); /* matches the header */

    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(165deg, var(--footer-blue) 0%, var(--footer-deep) 100%);
    color: var(--footer-ink);
    font-family: var(--font-body);
  }

  /* Faint looping lines behind everything. */
  .footer-loops {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .footer-loops path {
    fill: none;
    stroke: rgb(255 255 255 / 8%);
    stroke-linecap: round;
    stroke-width: 34;
  }

  .footer-inner {
    padding: clamp(3.5rem, 7vw, 6rem) var(--footer-gutter) 0;
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .footer-label {
    margin: 0 0 1rem;
    color: var(--footer-muted);
    font-size: var(--size-small);
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .footer-headline {
    max-width: 14ch;
    margin: 0;
    color: var(--footer-ink);
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 5vw, 4.6rem);
    font-weight: 700;
    letter-spacing: -.03em;
    line-height: 1;
    text-wrap: balance;
  }

  :global(html[lang='ta']) .footer-headline,
  :global(html[lang='si']) .footer-headline {
    max-width: 22ch;
    font-size: clamp(1.8rem, 3.4vw, 3rem);
    line-height: 1.2;
  }

  .footer-cta-button {
    display: inline-flex;
    align-items: center;
    gap: .85rem;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding: .55rem .55rem .55rem 1.4rem;
    border-radius: 999px;
    background: #0a1734;
    box-shadow: 0 12px 26px rgb(10 23 52 / 30%);
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }

  .footer-cta-icon {
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    border-radius: 50%;
    background: linear-gradient(140deg, #078be9, var(--footer-blue));
    font-size: 1.05rem;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .footer-cta-button:hover {
    box-shadow: 0 16px 32px rgb(10 23 52 / 38%);
    transform: translateY(-3px);
  }

  .footer-cta-button:hover .footer-cta-icon { transform: rotate(45deg); }

  .footer-contact-list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .35rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .footer-contact-list a {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    color: var(--footer-ink);
    font-size: 1.05rem;
    font-weight: 500;
    text-decoration: none;
    text-underline-offset: .25em;
  }

  .footer-contact-list a:hover { text-decoration: underline; }

  .footer-menus {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    justify-self: end;
    width: min(100%, 30rem);
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-column h2 {
    margin: 0 0 1rem;
    color: var(--footer-muted);
    font-size: var(--size-small);
    font-weight: 600;
    letter-spacing: .16em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .footer-column a {
    margin: 0 0 .55rem;
    color: var(--footer-ink);
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.45;
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-out), opacity var(--duration-fast) ease;
  }

  .footer-column a:hover {
    opacity: .8;
    transform: translateX(3px);
  }

  .footer-tagline {
    grid-column: 1 / -1;
    margin: 1.5rem 0 0;
    color: var(--footer-ink);
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: .5rem 1.5rem;
    margin-top: clamp(3rem, 7vw, 6rem);
    color: var(--footer-muted);
    font-size: var(--size-small);
  }

  .footer-bottom p { margin: 0; }

  /* Giant wordmark: SVG text stretched to exactly the content width. */
  .footer-wordmark {
    display: block;
    margin-top: clamp(.75rem, 1.5vw, 1.25rem);
    line-height: 0;
    text-decoration: none;
  }

  .footer-wordmark svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .footer-wordmark text {
    fill: var(--footer-word);
    font-family: 'Fira Sans Extra Condensed', var(--font-heading);
    font-size: 352px;
    font-weight: 700;
  }

  .footer a:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }

  /* Scroll-linked motion where supported: loops draw in and the wordmark rises into place. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .footer-loops path {
        stroke-dasharray: 1 1;
        animation: footer-draw linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 55%;
      }

      .footer-wordmark svg {
        animation: footer-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 100%;
      }
    }
  }

  @keyframes footer-draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }

  @keyframes footer-rise {
    from { opacity: .2; transform: translateY(35%); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 900px) {
    .footer-top { grid-template-columns: 1fr; }
    .footer-menus { justify-self: start; }
  }

  @media (max-width: 520px) {
    .footer-menus { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-cta-button,
    .footer-cta-icon,
    .footer-column a {
      transition: none;
    }
  }
</style>

---
// [PROPOSAL] Footer layout (client reference 2026-11-19): logo and social icons on top, a divider,
// link columns with underlined headings, then a darker bottom bar with copyright and legal links.
// The reference's newsletter box is replaced by the existing "Let's Connect" call to action, since
// no subscription backend exists. All text keeps its translation keys (labels live in Navbar.astro).
import ArrowUpRight from '../ui/ArrowUpRight.astro';
import { company } from '../../Constants';

const year = new Date().getFullYear();
const whatsappUrl = `https://wa.me/${company.whatsapp.number}`;
const phoneHref = `tel:+${company.whatsapp.number}`;

// Social profiles in a fixed order; an icon shows only once its real URL exists in Constants.ts.
// Icons are simplified monochrome marks on each platform's colour.
const socialLinks = [
  { name: 'Facebook', url: company.social.facebook, colour: '#1877f2', icon: 'M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1z' },
  { name: 'Instagram', url: company.social.instagram, colour: '#d6249f', icon: 'M8 3.5h8A4.5 4.5 0 0 1 20.5 8v8a4.5 4.5 0 0 1-4.5 4.5H8A4.5 4.5 0 0 1 3.5 16V8A4.5 4.5 0 0 1 8 3.5zm0 1.8A2.7 2.7 0 0 0 5.3 8v8A2.7 2.7 0 0 0 8 18.7h8a2.7 2.7 0 0 0 2.7-2.7V8A2.7 2.7 0 0 0 16 5.3H8zm4 3.2a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7zm0 1.8a1.7 1.7 0 1 0 0 3.4 1.7 1.7 0 0 0 0-3.4zm4.6-3.1a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8z' },
  { name: 'LinkedIn', url: company.social.linkedin, colour: '#0a66c2', icon: 'M5 9h3v10H5V9zm1.5-4.8a1.75 1.75 0 1 1 0 3.5 1.75 1.75 0 0 1 0-3.5zM10.2 9h2.9v1.4c.4-.8 1.4-1.6 2.9-1.6 3.1 0 3.7 2 3.7 4.7V19h-3v-4.9c0-1.2 0-2.6-1.6-2.6s-1.9 1.2-1.9 2.5v5h-3V9z' },
  { name: 'TikTok', url: company.social.tiktok, colour: '#111111', icon: 'M16.6 3c.3 2.1 1.6 3.5 3.6 3.7v2.9c-1.3.1-2.5-.3-3.6-1v5.7c0 3.3-2.6 5.7-5.6 5.7a5.5 5.5 0 0 1-1-10.9v3a2.6 2.6 0 1 0 1.8 2.5V3h4.8z' },
].filter((link) => link.url);
---

<footer class="footer" id="site-footer">
  <div class="footer-shell">
    <div class="footer-head">
      <a class="footer-logo" href="/" aria-label="RYZITE home">
        <img src="/assets/ryzite-footer-logo.webp" alt="" width="1061" height="731" loading="lazy" decoding="async" />
      </a>
      <p class="footer-tagline" data-label-key="footerTagline">One Agency. All Your Business Solutions.</p>
      <nav class="footer-social" aria-label="Follow Us" data-aria-label-key="footerFollow">
        {socialLinks.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer" style={`--social:${link.colour}`} aria-label={`RYZITE on ${link.name}`} title={link.name}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={link.icon} fill="currentColor" fill-rule="evenodd" /></svg>
          </a>
        ))}
      </nav>
    </div>
  </div>

  <div class="footer-shell footer-columns">
    <nav class="footer-column" aria-label="Explore" data-aria-label-key="footerExplore">
      <h2 data-label-key="footerExplore">Explore</h2>
      <a href="/" data-label-key="home">Home</a>
      <a href="/about" data-label-key="about">About Us</a>
      <a href="/services" data-label-key="services">Services</a>
      <a href="/solutions" data-label-key="solutions">Solutions</a>
      <a href="/contact" data-label-key="contact">Contact</a>
    </nav>

    <nav class="footer-column" aria-label="Resources" data-aria-label-key="footerResources">
      <h2 data-label-key="footerResources">Resources</h2>
      <a href="/packages" data-label-key="packages">Packages</a>
      <a href="/how-we-work" data-label-key="process">How We Work</a>
      <a href="/our-work" data-label-key="work">Our Work</a>
      <a href="/articles" data-label-key="articles">Articles</a>
    </nav>

    <div class="footer-column">
      <h2 data-label-key="contact">Contact</h2>
      <a href={`mailto:${company.email}`}>{company.email}</a>
      <a href={phoneHref}>{company.whatsapp.display}</a>
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp <span class="footer-arrow" aria-hidden="true"><ArrowUpRight /></span></a>
    </div>

    <div class="footer-column footer-connect">
      <h2 data-label-key="footerConnect">Let’s Connect</h2>
      <p data-label-key="footerConnectBody">Have a project in mind? Let’s build something meaningful.</p>
      <a class="footer-cta-button" href="/contact">
        <span data-label-key="footerConnectCta">Start a Conversation</span>
        <span class="footer-arrow" aria-hidden="true"><ArrowUpRight /></span>
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-shell footer-bottom__inner">
      <p>© {year} RYZITE. <span data-label-key="footerRights">All rights reserved.</span></p>
      <!-- [OPEN] Legal pages are placeholders until the client supplies reviewed policy text. -->
      <nav class="footer-legal" aria-label="Legal" data-aria-label-key="footerLegal">
        <a href="/privacy-policy/" data-label-key="footerPrivacy">Privacy Policy</a>
        <a href="/terms-and-conditions/" data-label-key="footerTerms">Terms &amp; Conditions</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    --footer-bg: var(--color-brand);
    --footer-bar: #081443;
    --footer-ink: #ffffff;
    --footer-muted: rgb(255 255 255 / 78%);
    --footer-line: rgb(255 255 255 / 18%);
    --footer-gutter: max(1.5rem, calc((100vw - 1300px) / 2)); /* matches the header */

    color: var(--footer-ink);
    background: var(--footer-bg);
    font-family: var(--font-body);
  }

  .footer-shell { padding-inline: var(--footer-gutter); }

  /* Top row: logo and tagline on the left, social icons on the right, divider below. */
  .footer-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    padding-block: clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid var(--footer-line);
  }

  /* The official logo is blue, so it sits on a white plate to stay legible on navy. */
  .footer-logo {
    display: block;
    flex-shrink: 0;
    padding: .35rem .75rem;
    border-radius: .85rem;
    background: #fff;
  }

  .footer-logo img { display: block; width: 6.5rem; height: auto; }

  .footer-tagline {
    margin: 0;
    color: var(--footer-muted);
    font-size: var(--size-small);
    font-weight: 500;
  }

  .footer-social {
    display: flex;
    gap: .75rem;
    margin-left: auto;
  }

  .footer-social a {
    display: grid;
    width: 2.6rem;
    height: 2.6rem;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    background: var(--social);
    box-shadow: 0 0 0 2px rgb(255 255 255 / 20%);
    transition: translate var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) ease;
  }

  .footer-social a:hover { translate: 0 -3px; box-shadow: 0 0 0 2px #fff; }
  .footer-social svg { width: 1.25rem; height: 1.25rem; }

  /* Link columns with short underlined headings. */
  .footer-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.35fr);
    gap: 2rem clamp(1.5rem, 3vw, 3rem);
    padding-block: clamp(2rem, 4vw, 2.75rem);
  }

  .footer-column {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: .55rem;
  }

  .footer-column h2 {
    position: relative;
    margin: 0 0 .7rem;
    padding-bottom: .45rem;
    color: var(--footer-ink);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .footer-column h2::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 2rem;
    height: 2px;
    border-radius: 2px;
    background: #fff;
  }

  .footer-column a {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    color: var(--footer-muted);
    font-size: .9375rem;
    line-height: 1.45;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--duration-fast) ease;
  }

  .footer-column a:hover { color: var(--footer-ink); text-decoration: underline; text-underline-offset: .2em; }

  .footer-arrow { display: inline-flex; font-size: .85em; }

  .footer-connect p {
    margin: 0;
    color: var(--footer-muted);
    font-size: .9375rem;
    line-height: 1.55;
  }

  /* Light button, the counterpart of the reference's subscribe button. */
  .footer-column .footer-cta-button {
    justify-content: center;
    gap: .5rem;
    width: min(100%, 17rem);
    margin-top: .5rem;
    padding: .7rem 1.25rem;
    border-radius: .6rem;
    color: var(--color-brand);
    background: #fff;
    font-size: .9375rem;
    font-weight: 600;
    text-align: center;
    transition: background-color var(--duration-fast) ease;
  }

  .footer-column .footer-cta-button:hover { color: var(--color-brand); background: #e6ecfb; text-decoration: none; }

  /* Darker bottom bar: copyright left, legal links right. */
  .footer-bottom { background: var(--footer-bar); }

  .footer-bottom__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: .5rem 1.5rem;
    padding-block: 1rem;
    color: var(--footer-muted);
    font-size: var(--size-small);
  }

  .footer-bottom p { margin: 0; }

  .footer-legal { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; }

  .footer-legal a {
    color: var(--footer-muted);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .footer-legal a:hover { color: var(--footer-ink); text-decoration: underline; text-underline-offset: .2em; }

  .footer a:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }

  @media (max-width: 1000px) {
    .footer-columns { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .footer-head { justify-content: center; text-align: center; }
    .footer-tagline { flex-basis: 100%; order: 2; }
    .footer-social { order: 3; margin-inline: auto; }
    .footer-columns { grid-template-columns: 1fr 1fr; gap: 1.75rem 1.25rem; }
    .footer-connect { grid-column: 1 / -1; }
    .footer-bottom__inner { flex-direction: column; justify-content: center; text-align: center; }
    .footer-legal { justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-social a,
    .footer-column a,
    .footer-legal a {
      transition: none;
    }

    .footer-social a:hover { translate: none; }
  }
</style>

---
import ArrowUpRight from '../ui/ArrowUpRight.astro';
import { company } from '../../Constants';

const year = new Date().getFullYear();
const whatsappUrl = `https://wa.me/${company.whatsapp.number}`;
const phoneHref = `tel:+${company.whatsapp.number}`;
---

<footer class="footer" id="site-footer">
  <div class="footer-backdrop">
    <div class="footer-glass">
      <div class="footer-grid">
        <div class="footer-brand">
          <a class="footer-logo-link" href="/" aria-label="Ryzite home">
            <img class="footer-logo" src="/assets/ryzite-footer-logo.webp" alt="Ryzite" width="1061" height="731" loading="lazy" />
          </a>
          <p data-label-key="footerTagline">One Agency. All Your Business Solutions.</p>
          <div class="footer-contact-list">
            <a class="footer-email" href={`mailto:${company.email}`}>{company.email}</a>
            <a class="footer-phone" href={phoneHref}>{company.whatsapp.display}</a>
            <a class="footer-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a>
          </div>
        </div>

        <nav class="footer-column" aria-label="Explore" data-aria-label-key="footerExplore">
          <h2 data-label-key="footerExplore">Explore</h2>
          <a href="/" data-label-key="home">Home</a>
          <a href="/about" data-label-key="about">About Us</a>
          <a href="/services" data-label-key="services">Services</a>
          <a href="/solutions" data-label-key="solutions">Solutions</a>
          <a href="/contact" data-label-key="contact">Contact</a>
        </nav>

        <nav class="footer-column" aria-label="Resources" data-aria-label-key="footerResources">
          <h2 data-label-key="footerResources">Resources</h2>
          <a href="/packages" data-label-key="packages">Packages</a>
          <a href="/how-we-work" data-label-key="process">How We Work</a>
          <a href="/our-work" data-label-key="work">Our Work</a>
          <a href="/articles" data-label-key="articles">Articles</a>
        </nav>

        <div class="footer-connect">
          <h2 data-label-key="footerConnect">Let’s Connect</h2>
          <p data-label-key="footerConnectBody">Have a project in mind? Let’s build something meaningful.</p>
          <a class="footer-contact-link" href="/contact">
            <span data-label-key="footerConnectCta">Start a Conversation</span> <span aria-hidden="true"><ArrowUpRight /></span>
          </a>
        </div>
      </div>

      <div class="footer-bottom">
        <p>© {year} RYZITE. <span data-label-key="footerRights">All rights reserved.</span></p>
        <span data-label-key="footerBottom">Designed to move forward.</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--color-ink);
    background: var(--color-paper);
  }

  .footer-backdrop {
    box-sizing: border-box;
    width: 96%;
    max-width: 1600px;
    margin-inline: auto;
    padding: clamp(1.75rem, 4vw, 3rem) 0;
    background:
      radial-gradient(60rem 22rem at 15% 0%, rgb(191 219 255 / 55%), transparent 70%),
      radial-gradient(50rem 20rem at 85% 100%, rgb(214 231 255 / 50%), transparent 70%),
      linear-gradient(180deg, rgb(233 241 255 / 92%), rgb(250 248 244 / 55%));
  }

  .footer-glass {
    box-sizing: border-box;
    width: 100%;
    padding: 3rem clamp(1.5rem, 4vw, 4rem) 1.75rem;
    border: 1px solid rgb(255 255 255 / 65%);
    border-radius: 2rem;
    background: rgb(255 255 255 / 68%);
    box-shadow:
      0 18px 55px rgb(5 45 115 / 10%),
      inset 0 1px 0 rgb(255 255 255 / 85%);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    backdrop-filter: blur(22px) saturate(150%);
    position: relative;
    overflow: hidden;
  }

  .footer-glass::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(115deg, rgb(255 255 255 / 55%) 0%, rgb(255 255 255 / 0%) 38%);
  }

  .footer-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(13rem, 1.2fr) minmax(7rem, 0.6fr) minmax(7rem, 0.6fr) minmax(12rem, 1fr);
    gap: 2.5rem;
  }

  .footer-brand,
  .footer-column,
  .footer-connect {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-logo-link {
    display: block;
    width: 11rem;
    max-width: 100%;
    overflow: hidden;
  }

  .footer-logo {
    display: block;
    width: 100%;
    height: auto;
  }

  .footer-brand p {
    max-width: 20rem;
    margin: 0.9rem 0 0;
    color: var(--color-muted-light);
    font-size: var(--size-small);
    line-height: 1.55;
  }

  .footer-contact-list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    margin-top: 1rem;
  }

  .footer-contact-list a {
    color: #5d626a;
    font-size: 0.875rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .footer-contact-list a:hover {
    color: #0655e9;
  }

  .footer-whatsapp {
    font-weight: 600;
  }

  .footer-column h2,
  .footer-connect h2 {
    margin: 0 0 0.9rem;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .footer-column a {
    margin: 0 0 0.6rem;
    color: #5d626a;
    font-size: 0.9375rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color var(--duration-fast) ease, transform var(--duration-fast) var(--ease-out);
  }

  .footer-column a:hover {
    color: #0655e9;
    transform: translateX(3px);
  }

  .footer-connect p {
    max-width: 18rem;
    margin: 0 0 1rem;
    color: var(--color-muted-light);
    font-size: var(--size-small);
    line-height: 1.6;
  }

  .footer-contact-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1rem;
    border: 1px solid rgb(6 85 233 / 18%);
    border-radius: 999px;
    color: #3f4650;
    background: rgb(255 255 255 / 54%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 90%), 0 0.5rem 1.5rem rgb(8 12 17 / 6%);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-out), background var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
  }

  .footer-contact-link:hover {
    transform: translateY(-3px);
    background: rgb(255 255 255 / 88%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 95%), 0 0.85rem 1.8rem rgb(6 85 233 / 14%);
  }

  .footer-contact-link span {
    color: #0655e9;
    font-size: 1.05rem;
  }

  .footer-bottom {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(8 12 17 / 14%);
    color: #72767c;
    font-size: 0.8125rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer a:focus-visible {
    outline: 3px solid #0655e9;
    outline-offset: 4px;
  }

  @media (max-width: 1100px) {
    .footer-backdrop {
      width: 96%;
    }

    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  @media (max-width: 600px) {
    .footer-backdrop {
      width: 96%;
      padding: 1.75rem 0 1.5rem;
    }

    .footer-glass {
      padding: 1.75rem 1.375rem;
      border-radius: 1.375rem;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .footer-column h2,
    .footer-connect h2 {
      margin-bottom: 0.7rem;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
      margin-top: 1.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-contact-list a,
    .footer-column a,
    .footer-contact-link {
      transition: none;
    }
  }
</style>

---
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  openGraph?: boolean;
  canonicalUrl?: string;
}

const { title, description, openGraph = false, canonicalUrl } = Astro.props;
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {openGraph && <>
      <meta property="og:type" content="website" />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
    </>}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@600;700;800&family=Noto+Sans+Sinhala:wght@400;600;700;800&family=Noto+Sans+Tamil:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/Original%20Logo.png" />
    <link rel="apple-touch-icon" href="/Original%20Logo.png" />
    <title>RYZITE</title>
    <slot name="head" />
    <script is:inline define:vars={{ isHome }}>
      if (isHome) {
        document.documentElement.classList.add('home-intro');
        window.ryziteIntroFallback = setTimeout(() => document.documentElement.classList.remove('home-intro'), 20000);
      }
    </script>
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  html.home-intro { overflow: hidden; }
  html.home-intro .site-header, html.home-intro .footer { visibility: hidden; opacity: 0; pointer-events: none; }
  html.home-intro .connection-hero { position: fixed; inset: 0; z-index: 100; }
  html.home-intro .connection-stage { height: 100svh; max-width: none; }
  html.home-transition:not(.home-intro) .connection-hero { position: relative; z-index: 100; }
</style>

---
import ArrowUpRight from '../../components/ui/ArrowUpRight.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import WindingRoad from '../../components/sections/WindingRoad.astro';
import { solutionCoverImages } from '../../data/solution-cover-images';
import { solutionIcons } from '../../data/detail-icons';
import { technologySolutions, technologySolutionBySlug } from '../../data/technology-solutions';
import { technologySolutionTranslations } from '../../data/technology-solution-translations';

const solution = technologySolutionBySlug[Astro.params.slug ?? ''];
if (!solution) return Astro.redirect('/solutions/');

const relatedSolutions = solution.related
  .map(({ slug }) => technologySolutionBySlug[slug])
  .filter(Boolean);

const englishItems = Object.fromEntries(technologySolutions.map((item) => [item.slug, {
  title: item.title,
  description: item.description,
  challenges: item.challenges,
  provides: item.provides,
  capabilities: item.capabilities,
  benefits: item.benefits,
  related: item.related,
}]));
const pageTranslations = {
  ...technologySolutionTranslations,
  en: { ...technologySolutionTranslations.en, items: englishItems },
};
const approachSteps = technologySolutionTranslations.en.deliverySteps;
const coverImage = solutionCoverImages[solution.title];
const detailFaqs = technologySolutionTranslations.en.detailFaqs;
---

<MainLayout title={`${solution.title} | RYZITE`} description={solution.description} openGraph={true}>
  <div class="solution-detail-page" data-solution-slug={solution.slug}>
    <section class="solution-detail-hero" aria-labelledby="solution-detail-title">
      <div class="solution-detail-hero__orb solution-detail-hero__orb--one" aria-hidden="true"></div>
      <div class="solution-detail-hero__inner">
        <div class="solution-detail-hero__copy">
          <a class="solution-back-link" href="/solutions/"><span aria-hidden="true">←</span><span data-technology-key="backToSolutions">All Technology Solutions</span></a>
          <h1 id="solution-detail-title" data-solution-field="title">{solution.title}</h1>
          <p class="solution-detail-hero__description" data-solution-field="description">{solution.description}</p>
          <a class="solution-button solution-button--primary" href="/contact/">
            <span data-technology-key="contactCta">Start a Project</span><span aria-hidden="true"><ArrowUpRight /></span>
          </a>
        </div>
        <div class="solution-detail-hero__visual" aria-hidden="true">
          <div class="solution-detail-hero__grid"></div>
          <div class="solution-detail-hero__symbol">{solution.icon}</div>
          <span class="solution-detail-hero__orbit solution-detail-hero__orbit--one"></span>
          <span class="solution-detail-hero__orbit solution-detail-hero__orbit--two"></span>
          <span class="solution-detail-hero__spark solution-detail-hero__spark--one">✳</span>
          <span class="solution-detail-hero__spark solution-detail-hero__spark--two">✦</span>
          <span class="solution-detail-hero__index">{String(technologySolutions.findIndex(({ slug }) => slug === solution.slug) + 1).padStart(2, '0')} / 09</span>
        </div>
      </div>
    </section>

    <section class="solution-detail-section challenge-section" aria-labelledby="challenge-title">
      <div class="solution-shell challenge-layout">
        <header class="solution-section-heading" data-solution-reveal>
          <h2 id="challenge-title" data-technology-key="challengesTitle">When the Current Approach No Longer Fits.</h2>
        </header>
        <ul class="challenge-list">
          {solution.challenges.map((challenge, index) => (
            <li data-solution-reveal><span class="challenge-number">0{index + 1}</span><p data-solution-list="challenges" data-solution-index={index}>{challenge}</p></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="solution-detail-section provides-section" aria-labelledby="provides-title">
      {coverImage && (
        <div class="provides-backdrop" aria-hidden="true">
          <img src={coverImage.src} alt="" width={coverImage.width} height={coverImage.height} loading="lazy" decoding="async" />
        </div>
      )}
      <div class="solution-shell provides-layout">
        <div class="provides-mark" aria-hidden="true">
          {solutionIcons[solution.slug]
            ? <svg class="provides-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false" set:html={solutionIcons[solution.slug]} />
            : solution.icon}
        </div>
        <div class="provides-glass" data-solution-reveal>
          <h2 id="provides-title" data-technology-key="providesTitle">What RYZITE Provides.</h2>
          <p class="provides-copy" data-solution-field="provides">{solution.provides}</p>
        </div>
      </div>
    </section>

    <section class="solution-detail-section capabilities-section" aria-labelledby="capabilities-title">
      <div class="solution-shell capabilities-layout">
        <header class="solution-section-heading" data-solution-reveal>
          <h2 id="capabilities-title" data-technology-key="capabilitiesTitle">Capabilities to Scope Together.</h2>
        </header>
        <ul class="capability-list">
          {solution.capabilities.map((capability, index) => (
            <li data-solution-reveal><span class="capability-index">0{index + 1}</span><p data-solution-list="capabilities" data-solution-index={index}>{capability}</p><span class="capability-mark" aria-hidden="true"><ArrowUpRight /></span></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="solution-detail-section benefits-section" aria-labelledby="benefits-title">
      <div class="solution-shell">
        <header class="solution-section-heading solution-section-heading--center" data-solution-reveal>
          <h2 id="benefits-title" data-technology-key="benefitsTitle">What This Can Help You Work Toward.</h2>
        </header>
        <div class="benefit-grid">
          {solution.benefits.map((benefit, index) => (
            <article class="benefit-card" data-solution-reveal><span aria-hidden="true">0{index + 1}</span><p data-solution-list="benefits" data-solution-index={index}>{benefit}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="solution-detail-section delivery-section" aria-labelledby="delivery-title">
      <div class="solution-shell">
        <header class="solution-section-heading solution-section-heading--center" data-solution-reveal>
          <h2 id="delivery-title" data-technology-key="approachTitle">A Clear Delivery Approach.</h2>
          <p class="solution-section-intro" data-technology-key="approachIntro">The exact scope is shaped around your requirements and agreed before implementation.</p>
        </header>
        <WindingRoad steps={approachSteps.map((step, index) => ({
          title: step.title,
          body: step.body,
          itemAttrs: { 'data-solution-reveal': true, 'data-delivery-step': index },
          titleAttrs: { 'data-delivery-title': true },
          bodyAttrs: { 'data-delivery-body': true },
        }))} />
      </div>
    </section>

    <section class="solution-detail-section related-section" aria-labelledby="related-title">
      <div class="solution-shell">
        <header class="solution-section-heading" data-solution-reveal>
          <h2 id="related-title" data-technology-key="relatedTitle">Related Technology Solutions.</h2>
        </header>
        <div class="related-grid">
          {relatedSolutions.map((related, index) => (
            <a class="related-card" href={`/solutions/${related.slug}/`} data-related-slug={related.slug} data-solution-reveal>
              <span class="related-card__index">0{index + 1}</span>
              <span class="related-card__icon" aria-hidden="true">{related.icon === "\u2197" ? <ArrowUpRight /> : related.icon}</span>
              <span class="related-card__title">{related.title}</span>
              <span class="related-card__arrow" aria-hidden="true"><ArrowUpRight /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="solution-detail-section detail-faq-section" aria-labelledby="detail-faq-title">
      <div class="solution-shell faq-layout">
        <header class="solution-section-heading" data-solution-reveal>
          <h2 id="detail-faq-title" data-technology-key="detailFaqTitle">Questions About This Solution?</h2>
        </header>
        <div class="solution-faq-list" data-solution-reveal>
          {detailFaqs.map((faq, index) => (
            <details class="solution-faq-item">
              <summary data-detail-faq-index={index} data-detail-faq-field="question">{faq.question}</summary>
              <div class="solution-faq-item__answer"><p data-detail-faq-index={index} data-detail-faq-field="answer">{faq.answer}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </div>
</MainLayout>

<script is:inline define:vars={{ pageTranslations, solutionSlug: solution.slug }}>
  const applySolutionLocale = (locale) => {
    const content = pageTranslations[locale] || pageTranslations.en;
    const solution = content.items[solutionSlug] || pageTranslations.en.items[solutionSlug];
    document.querySelectorAll('[data-technology-key]').forEach((element) => {
      const value = content[element.dataset.technologyKey];
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('[data-solution-field]').forEach((element) => {
      const value = solution[element.dataset.solutionField];
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('[data-solution-list]').forEach((element) => {
      const values = solution[element.dataset.solutionList];
      const value = values?.[Number(element.dataset.solutionIndex)];
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('[data-delivery-step]').forEach((element) => {
      const step = content.deliverySteps[Number(element.dataset.deliveryStep)];
      const title = element.querySelector('[data-delivery-title]');
      const body = element.querySelector('[data-delivery-body]');
      if (step && title) title.textContent = step.title;
      if (step && body) body.textContent = step.body;
    });
    document.querySelectorAll('[data-related-slug]').forEach((element) => {
      const related = content.items[element.dataset.relatedSlug];
      const title = element.querySelector('.related-card__title');
      if (related && title) title.textContent = related.title;
    });
    document.querySelectorAll('[data-detail-faq-index]').forEach((element) => {
      const faq = content.detailFaqs[Number(element.dataset.detailFaqIndex)];
      const value = faq?.[element.dataset.detailFaqField];
      if (typeof value === 'string') element.textContent = value;
    });
    const description = document.querySelector('meta[name="description"]');
    if (description) description.setAttribute('content', solution.description);
    const openGraphTitle = document.querySelector('meta[property="og:title"]');
    if (openGraphTitle) openGraphTitle.setAttribute('content', `${solution.title} | RYZITE`);
    const openGraphDescription = document.querySelector('meta[property="og:description"]');
    if (openGraphDescription) openGraphDescription.setAttribute('content', solution.description);
  };

  applySolutionLocale(document.body.dataset.locale || 'en');
  window.addEventListener('ryzite:locale-change', (event) => applySolutionLocale(event.detail?.locale || 'en'));
</script>

<script>
  import { gsap } from 'gsap';

  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!motionPreference.matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        gsap.fromTo(entry.target, { autoAlpha: 0, y: 18 }, {
          autoAlpha: 1,
          y: 0,
          duration: 0.65,
          ease: 'power2.out',
          // Clear only what GSAP set: 'all' would wipe the inline style, including the
          // winding-road steps' --col / --pin-y placement variables.
          clearProps: 'opacity,visibility,transform',
        });
        currentObserver.unobserve(entry.target);
      });
    }, { threshold: 0.14 });
    document.querySelectorAll('.solution-detail-page [data-solution-reveal]').forEach((element) => observer.observe(element));
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  }
</script>

<style>
  .solution-detail-page { --solution-blue: var(--color-brand); --solution-deep: var(--color-brand); --solution-cyan: var(--color-brand); --solution-ink: var(--color-heading); --solution-muted: var(--color-body); color: var(--solution-ink); background: var(--color-paper); }
  .solution-detail-page *, .solution-detail-page *::before, .solution-detail-page *::after { box-sizing: border-box; }
  .solution-shell { width: min(100%, var(--content-max)); margin-inline: auto; padding-inline: var(--space-frame); }
  .solution-detail-hero { position: relative; isolation: isolate; overflow: hidden; padding: clamp(4rem, 7vw, 6.5rem) var(--space-frame) clamp(4rem, 7vw, 6.5rem); background: linear-gradient(118deg, var(--color-paper), var(--color-milk-highlight) 64%, var(--color-milk)); }
  .solution-detail-hero__inner { display: grid; width: min(100%, var(--content-max)); min-height: 470px; margin-inline: auto; grid-template-columns: minmax(0, 1fr) minmax(270px, .7fr); align-items: center; gap: clamp(2rem, 6vw, 6rem); }
  .solution-detail-hero__copy { position: relative; z-index: 1; max-width: 780px; }.solution-back-link { display: inline-flex; align-items: center; gap: .55rem; margin-bottom: 2rem; color: #52647b; font-size: .902rem; font-weight: 600; text-decoration: none; }.solution-back-link:hover { color: var(--solution-blue); }.solution-back-link:focus-visible, .related-card:focus-visible, .solution-button:focus-visible { outline: 3px solid var(--solution-blue); outline-offset: 4px; }
  .solution-eyebrow { display: flex; align-items: center; gap: .65rem; margin: 0 0 1rem; color: var(--solution-blue); font-size: var(--size-eyebrow); font-weight: 600; letter-spacing: .15em; text-transform: uppercase; }.solution-eyebrow::before { width: 1.5rem; height: 2px; border-radius: 2px; background: currentColor; content: ''; }
  .solution-detail-hero h1 { max-width: var(--measure-h1); margin: 0; color: #101827; font-family: var(--font-display); font-size: var(--size-h1); font-weight: 700; letter-spacing: var(--tracking-h1); line-height: var(--leading-h1); }.solution-detail-hero__description { max-width: 650px; margin: 1.3rem 0 0; color: var(--solution-muted); font-size: var(--size-lead); line-height: 1.75; }
  .solution-button { display: inline-flex; min-height: 3.1rem; align-items: center; justify-content: center; gap: 1rem; margin-top: 1.6rem; padding: .78rem 1.2rem; border: 1px solid transparent; border-radius: 999px; font-size: .968rem; font-weight: 600; text-decoration: none; transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease; }.solution-button:hover { transform: translateY(-3px); }.solution-button span:last-child { transition: transform 180ms ease; }.solution-button:hover span:last-child { transform: translateX(3px); }.solution-button--primary { color: #fff; background: var(--color-brand); box-shadow: 0 .7rem 1.5rem #0b1c5830; }.solution-button--primary:hover { background: var(--color-brand-hover); }
  .solution-detail-hero__visual { position: relative; width: min(100%, 400px); aspect-ratio: 1; justify-self: center; overflow: hidden; border: 1px solid #d5e5f8; border-radius: 2.2rem; background: radial-gradient(circle at center, var(--color-milk) 0 22%, #eef6ff 23% 66%, #e1efff 67%); box-shadow: inset 0 0 0 1rem #ffffff50, 0 1.5rem 3.5rem #173b7110; animation: solution-art-in 700ms var(--ease-out) both; }.solution-detail-hero__grid { position: absolute; inset: 12%; border: 1px solid #8cb9ee80; border-radius: 50%; background-image: linear-gradient(#0b1c5814 1px, transparent 1px), linear-gradient(90deg, #0b1c5814 1px, transparent 1px); background-size: 16% 16%; mask-image: radial-gradient(circle, #000 0 68%, transparent 69%); }.solution-detail-hero__symbol { position: absolute; top: 50%; left: 50%; display: grid; width: 34%; aspect-ratio: 1; place-items: center; transform: translate(-50%, -50%); border: 1px solid #ffffffa0; border-radius: 1.5rem; color: #fff; background: var(--color-brand); box-shadow: 0 1.2rem 2.7rem #0b1c583b; font-family: var(--font-display); font-size: clamp(2.2rem, 4.4vw, 3.3rem); font-weight: 700; }.solution-detail-hero__orbit { position: absolute; inset: 7%; border: 1px solid #0b1c582e; border-radius: 50%; }.solution-detail-hero__orbit--two { inset: 22%; border-style: dashed; border-color: #0b1c5855; }.solution-detail-hero__spark { position: absolute; color: var(--solution-blue); }.solution-detail-hero__spark--one { top: 15%; right: 22%; }.solution-detail-hero__spark--two { bottom: 16%; left: 19%; }.solution-detail-hero__index { position: absolute; right: 1.2rem; bottom: 1rem; color: #617794; font-size: .8125rem; font-weight: 600; letter-spacing: .13em; }.solution-detail-hero__orb { position: absolute; z-index: -1; top: -38%; right: 5%; width: min(40vw, 560px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, #0b1c5828, transparent 68%); }
  .solution-detail-section { padding-block: clamp(4.5rem, 8vw, 7rem); }.solution-section-heading h2 { max-width: var(--measure-h2); margin: 0; color: #111d30; font-family: var(--font-display); font-size: var(--size-h2); font-weight: 700; letter-spacing: var(--tracking-h2); line-height: var(--leading-h2); }.solution-section-heading--center { display: flex; flex-direction: column; align-items: center; text-align: center; }.solution-section-heading--center .solution-eyebrow { justify-content: center; }.solution-section-intro { max-width: 700px; margin: 1rem 0 0; color: var(--solution-muted); line-height: 1.7; }
  .challenge-section { background: var(--color-milk); }.challenge-layout { display: grid; grid-template-columns: minmax(250px, .75fr) minmax(0, 1.25fr); align-items: start; gap: clamp(2rem, 7vw, 7rem); }.challenge-list { display: grid; grid-template-columns: 1fr; list-style: none; margin: 0; padding: 0; border-top: 1px solid #dce5f0; }.challenge-list li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); align-items: start; gap: 1rem; padding: 1.3rem .3rem; border-bottom: 1px solid #dce5f0; }.challenge-number { color: var(--solution-blue); font-size: .8125rem; font-weight: 600; letter-spacing: .12em; }.challenge-list p { margin: 0; color: #30435c; line-height: 1.6; }
  /* Glassmorphism over the solution's cover image: the image sits behind a navy tint, and the copy and
     icon tile are frosted-glass panels that blur it. Without backdrop-filter the panels turn solid. */
  .provides-section { position: relative; isolation: isolate; overflow: hidden; color: #fff; background: #101d32; }
  .provides-backdrop { position: absolute; z-index: -1; inset: 0; }
  .provides-backdrop img { display: block; width: 100%; height: 100%; object-fit: cover; filter: blur(3px) saturate(1.1); transform: scale(1.05); }
  .provides-backdrop::after { position: absolute; inset: 0; background: linear-gradient(120deg, rgb(11 28 88 / 82%), rgb(16 29 50 / 62%) 55%, rgb(8 12 17 / 78%)); content: ''; }
  .provides-glass { padding: clamp(1.5rem, 3.2vw, 2.75rem); border: 1px solid rgb(255 255 255 / 22%); border-radius: 1.75rem; background: linear-gradient(145deg, rgb(255 255 255 / 14%), rgb(255 255 255 / 5%)); box-shadow: inset 0 1px 0 rgb(255 255 255 / 28%), 0 1.5rem 3.5rem rgb(4 10 30 / 35%); -webkit-backdrop-filter: blur(18px) saturate(140%); backdrop-filter: blur(18px) saturate(140%); }
  .provides-mark .provides-icon { width: 48%; height: auto; filter: drop-shadow(0 .4rem .9rem rgb(133 198 255 / 35%)); }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) { .provides-glass, .provides-mark { background: rgb(16 29 50 / 88%); } }
 .provides-layout { display: grid; grid-template-columns: minmax(180px, .5fr) minmax(0, 1.5fr); align-items: center; gap: clamp(2rem, 7vw, 7rem); }.provides-layout .solution-eyebrow { color: #85c6ff; }.provides-layout h2 { max-width: var(--measure-h2); margin: 0; color: #fff; font-family: var(--font-display); font-size: var(--size-h2); line-height: var(--leading-h2); letter-spacing: var(--tracking-h2); }.provides-copy { max-width: 850px; margin: 1.2rem 0 0; color: #cad6e4; font-size: var(--size-lead); line-height: 1.75; }.provides-mark { display: grid; width: min(100%, 220px); aspect-ratio: 1; place-items: center; justify-self: center; border: 1px solid #8ac8ff60; border-radius: 2rem; color: #9dd7ff; background: linear-gradient(145deg, rgb(255 255 255 / 16%), rgb(255 255 255 / 5%)); -webkit-backdrop-filter: blur(16px) saturate(140%); backdrop-filter: blur(16px) saturate(140%); box-shadow: 0 0 0 1.1rem #ffffff05, 0 0 0 2.2rem #ffffff03; font-family: var(--font-display); font-size: 5.5rem; font-weight: 700; }
  .capabilities-section { background: #f0f6fd; }.capabilities-layout { display: grid; grid-template-columns: minmax(250px, .75fr) minmax(0, 1.25fr); align-items: start; gap: clamp(2rem, 7vw, 7rem); }.capability-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid #d3e0ef; }.capability-list li { display: grid; grid-template-columns: 2.3rem minmax(0, 1fr) 2rem; align-items: center; gap: 1rem; padding: 1.15rem .2rem; border-bottom: 1px solid #d3e0ef; }.capability-index { color: var(--solution-blue); font-size: .8125rem; font-weight: 600; }.capability-list p { margin: 0; color: #223b5a; line-height: 1.5; }.capability-mark { color: var(--color-brand); font-size: 1.21rem; }
  .benefits-section { background: var(--color-milk); }.benefit-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 2.8rem; }.benefit-card { min-height: 190px; padding: 1.5rem; border: 1px solid #dce5f0; border-radius: var(--radius-medium); background: linear-gradient(145deg, var(--color-milk-highlight), var(--color-milk)); box-shadow: 0 .8rem 1.8rem #173b7109; }.benefit-card > span { color: var(--solution-blue); font-size: .8125rem; font-weight: 600; letter-spacing: .12em; }.benefit-card p { margin: 2rem 0 0; color: #30435c; font-family: var(--font-display); font-size: 1.595rem; font-weight: 700; line-height: 1.2; }
  .delivery-section { background: #f7f9fc; }

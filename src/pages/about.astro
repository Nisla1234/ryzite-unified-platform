---
import ArrowUpRight from '../components/ui/ArrowUpRight.astro';
import MainLayout from '../layouts/MainLayout.astro';
import { aboutTranslations } from '../data/about-translations';

const ctaUrl = '/contact/';
---

<MainLayout
  title="About RYZITE | Digital Marketing & Technology Solutions"
  description="Meet RYZITE, a digital solutions company bringing marketing services and technology solutions together to help businesses grow."
  openGraph={true}
>
  <div class="about-page">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="about-hero__glow about-hero__glow--one" aria-hidden="true"></div>
      <div class="about-hero__glow about-hero__glow--two" aria-hidden="true"></div>
      <div class="about-hero__inner">
        <div class="about-hero__copy">
          <h1 id="about-title" data-about-key="heroTitle">Turning Ideas Into Digital Possibilities.</h1>
          <p class="about-hero__description" data-about-key="heroDescription">At RYZITE, we believe every business deserves the right combination of technology, creativity, and digital strategy to grow.</p>
          <p class="about-hero__statement" data-about-key="heroStatement">One Site. Solve Every Problem.</p>
          <div class="about-hero__actions">
            <a class="about-button about-button--primary" href="/services/#services">
              <span data-about-key="heroExplore">Explore Our Services</span><span aria-hidden="true"><ArrowUpRight /></span>
            </a>
            <a class="about-button about-button--quiet" href={ctaUrl}>
              <span data-about-key="startProject">Start a Project</span><span aria-hidden="true"><ArrowUpRight /></span>
            </a>
          </div>
        </div>
        <div class="about-hero__visual" aria-hidden="true">
          <div class="orbit orbit--outer"></div>
          <div class="orbit orbit--inner"></div>
          <div class="visual-grid"></div>
          <div class="visual-core"><span>&lt;/&gt;</span></div>
          <span class="visual-node visual-node--one">01</span>
          <span class="visual-node visual-node--two">02</span>
          <span class="visual-node visual-node--three">03</span>
          <span class="visual-caption">IDEAS <i>×</i> DESIGN <i>×</i> TECHNOLOGY</span>
        </div>
      </div>
      <div class="about-hero__footer" aria-hidden="true"><span>RYZITE / ABOUT</span><span>Ideas into possibilities <b>↓</b></span></div>
    </section>

    <section class="about-section who-section" aria-labelledby="who-title">
      <div class="section-shell who-layout">
        <div class="who-copy" data-reveal>
          <h2 id="who-title" data-about-key="whoTitle">A Digital Partner for Modern Businesses.</h2>
          <p data-about-key="whoParagraphOne">We are a digital solutions company focused on helping businesses establish a strong online presence, connect with customers, and simplify their operations through modern technology.</p>
          <p data-about-key="whoParagraphTwo">From professional websites and mobile applications to digital marketing, branding, and business automation, we bring creative thinking and technical expertise together to deliver solutions tailored to each business.</p>
        </div>
        <div class="who-art" data-reveal aria-hidden="true">
          <div class="who-art__halo"></div>
          <div class="who-art__line who-art__line--one"></div>
          <div class="who-art__line who-art__line--two"></div>
          <div class="who-art__panel who-art__panel--main"><span class="art-code">&lt;/&gt;</span><span class="art-rule"></span><span class="art-rule art-rule--short"></span></div>
          <div class="who-art__panel who-art__panel--small"><span class="art-dot"></span><span>CONNECTED<br />SOLUTIONS</span></div>
          <span class="who-art__spark who-art__spark--one">✳</span><span class="who-art__spark who-art__spark--two">✦</span>
          <div class="who-art__caption"><strong data-about-key="whoHighlight">One Agency. All Your Business Solutions.</strong><span data-about-key="whoNote">Connected thinking for the way your business works.</span></div>
        </div>
      </div>
    </section>

    <section class="about-section purpose-section" aria-labelledby="purpose-title">
      <div class="section-shell">
        <header class="section-heading section-heading--center" data-reveal>
          <h2 id="purpose-title" data-about-key="purposeTitle">Driven by Purpose. Focused on Possibilities.</h2>
        </header>
        <div class="purpose-grid">
          <article class="purpose-card" data-reveal>
            <span class="purpose-card__icon" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="M24 5v38M5 24h38M10.6 10.6l26.8 26.8m0-26.8L10.6 37.4"/><circle cx="24" cy="24" r="10"/></svg></span>
            <span class="purpose-card__index">01</span>
            <h3 data-about-key="missionTitle">Our Mission</h3>
            <p data-about-key="missionBody">To empower businesses with accessible, innovative, and reliable digital solutions that improve efficiency, strengthen their online presence, and support sustainable growth.</p>
          </article>
          <article class="purpose-card purpose-card--blue" data-reveal>
            <span class="purpose-card__icon" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="M4 24s7.3-12 20-12 20 12 20 12-7.3 12-20 12S4 24 4 24Z"/><circle cx="24" cy="24" r="6"/></svg></span>
            <span class="purpose-card__index">02</span>
            <h3 data-about-key="visionTitle">Our Vision</h3>
            <p data-about-key="visionBody">To become a trusted digital solutions partner, helping businesses of all sizes embrace technology, unlock new opportunities, and succeed in an evolving digital world.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="about-section divisions-section" aria-labelledby="divisions-title">
      <div class="section-shell">
        <header class="section-heading divisions-heading" data-reveal>
          <div><h2 id="divisions-title" data-about-key="divisionsTitle">Two Divisions. One Connected Digital Partner.</h2></div>
          <p data-about-key="divisionsIntro">RYZITE combines marketing expertise and technology solutions to help businesses build their digital presence, reach customers, and operate more efficiently.</p>
        </header>
        <div class="division-grid">
          <article class="division-card division-card--marketing" data-reveal>
            <div class="division-card__top"><span class="division-card__icon" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="M7 21h8l20-9v24l-20-9H7v-6Zm8 6 4 12h8l-6-15m14-10 7-5m-7 23 7 5M15 21v6"/><path d="M39 17a10 10 0 0 1 0 14"/></svg></span><span class="division-card__index">01</span></div>
            <h3 data-about-key="marketingTitle">Marketing Services</h3>
            <p class="division-card__description" data-about-key="marketingBody">We help businesses build their brands, improve online visibility, reach the right audiences, and turn digital engagement into meaningful business opportunities.</p>
            <p class="division-card__list-label" data-about-key="marketingListLabel">Explore services such as</p>
            <ul class="division-tags">
              <li data-about-key="marketingItemOne">Search visibility and SEO</li><li data-about-key="marketingItemTwo">Digital advertising</li>
              <li data-about-key="marketingItemThree">Social media management</li><li data-about-key="marketingItemFour">Branding and visual identity</li>
              <li data-about-key="marketingItemFive">Content marketing</li><li data-about-key="marketingItemSix">Marketing automation and CRM</li>
              <li data-about-key="marketingItemSeven">Website tracking and conversion improvement</li><li data-about-key="marketingItemEight">Practical AI marketing support</li>
            </ul>
            <a class="division-card__link" href="/services/#services"><span data-about-key="marketingCta">Explore Marketing Services</span><span aria-hidden="true"><ArrowUpRight /></span></a>
          </article>
          <article class="division-card division-card--technology" data-reveal>
            <div class="division-card__top"><span class="division-card__icon" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><rect x="5" y="8" width="38" height="27" rx="3"/><path d="M17 42h14m-7-7v7M16 18l-5 4 5 4m16-8 5 4-5 4m-5-7-4 6"/></svg></span><span class="division-card__index">02</span></div>
            <h3 data-about-key="technologyTitle">Technology Solutions</h3>
            <p class="division-card__description" data-about-key="technologyBody">We design and develop websites, e-commerce platforms, mobile applications, custom software, and automation solutions that help businesses operate smarter.</p>
            <p class="division-card__list-label" data-about-key="technologyListLabel">Explore solutions such as</p>
            <ul class="division-tags">
              <li data-about-key="technologyItemOne">Business website development</li><li data-about-key="technologyItemTwo">Online store development</li>
              <li data-about-key="technologyItemThree">Mobile applications</li><li data-about-key="technologyItemFour">Custom business software</li>
              <li data-about-key="technologyItemFive">UI/UX design</li><li data-about-key="technologyItemSix">Customer chatbots and assistants</li>
              <li data-about-key="technologyItemSeven">Workflow automation and integrations</li><li data-about-key="technologyItemEight">Website care and maintenance</li>
            </ul>
            <a class="division-card__link" href="/solutions/#solutions"><span data-about-key="technologyCta">Explore Technology Solutions</span><span aria-hidden="true"><ArrowUpRight /></span></a>
          </article>
        </div>
      </div>
    </section>

    <section class="about-section values-section" aria-labelledby="values-title">
      <div class="section-shell">
        <header class="section-heading section-heading--center" data-reveal>
          <h2 id="values-title" data-about-key="valuesTitle">The Principles Behind Everything We Create.</h2>
          <p data-about-key="valuesIntro">Our work is guided by values that help us deliver thoughtful, practical, and meaningful digital solutions.</p>
        </header>
        <div class="values-grid">
          <article class="value-card" data-reveal><span class="value-card__number">01</span><span class="value-card__icon" aria-hidden="true">✳</span><h3 data-about-key="valueOneTitle">Creativity</h3><p data-about-key="valueOneBody">We explore fresh ideas and thoughtful design approaches to create meaningful digital experiences.</p></article>
          <article class="value-card" data-reveal><span class="value-card__number">02</span><span class="value-card__icon" aria-hidden="true">⌁</span><h3 data-about-key="valueTwoTitle">Innovation</h3><p data-about-key="valueTwoBody">We embrace modern technologies and practical solutions to help businesses adapt and grow.</p></article>
          <article class="value-card" data-reveal><span class="value-card__number">03</span><span class="value-card__icon" aria-hidden="true">◉</span><h3 data-about-key="valueThreeTitle">Reliability</h3><p data-about-key="valueThreeBody">We focus on clear communication, consistent quality, and dependable solutions.</p></article>
          <article class="value-card" data-reveal><span class="value-card__number">04</span><span class="value-card__icon" aria-hidden="true"><ArrowUpRight /></span><h3 data-about-key="valueFourTitle">Collaboration</h3><p data-about-key="valueFourBody">We believe strong results come from understanding our clients and working together toward shared goals.</p></article>
        </div>
      </div>
    </section>

    <section class="about-section why-section" aria-labelledby="why-title">
      <div class="section-shell why-layout">
        <header class="why-heading" data-reveal><h2 id="why-title" data-about-key="whyTitle">Built Around Your Business Goals.</h2><span class="why-mark" aria-hidden="true">R<span>.</span></span></header>
        <div class="why-grid">
          <article class="why-feature" data-reveal><span class="why-feature__icon" aria-hidden="true">✳</span><div><h3 data-about-key="whyOneTitle">Creative Thinking</h3><p data-about-key="whyOneBody">We combine modern design with practical business-focused solutions.</p></div></article>
          <article class="why-feature" data-reveal><span class="why-feature__icon" aria-hidden="true">⌘</span><div><h3 data-about-key="whyTwoTitle">Technology-Driven</h3><p data-about-key="whyTwoBody">We use suitable technologies to build scalable, responsive, and efficient digital experiences.</p></div></article>
          <article class="why-feature" data-reveal><span class="why-feature__icon" aria-hidden="true">◎</span><div><h3 data-about-key="whyThreeTitle">Business-Focused Approach</h3><p data-about-key="whyThreeBody">We focus on understanding business challenges before recommending solutions.</p></div></article>
          <article class="why-feature" data-reveal><span class="why-feature__icon" aria-hidden="true">⇄</span><div><h3 data-about-key="whyFourTitle">Connected Digital Solutions</h3><p data-about-key="whyFourBody">We bring marketing and technology together to support businesses from initial ideas to digital growth.</p></div></article>
        </div>
      </div>
    </section>

    <section class="about-section approach-section" aria-labelledby="approach-title">
      <div class="section-shell">
        <header class="section-heading section-heading--center" data-reveal>
          <h2 id="approach-title" data-about-key="approachTitle">From First Conversation to Final Launch.</h2>
          <p data-about-key="approachIntro">We follow a structured approach to understand business needs, plan suitable solutions, and deliver digital experiences with clarity and purpose.</p>
        </header>
        <ol class="approach-timeline">
          <li data-reveal><span class="approach-step">01</span><div><h3 data-about-key="stepOneTitle">Discovery</h3><p data-about-key="stepOneBody">We learn about the business, its challenges, target audience, and project goals.</p></div></li>
          <li data-reveal><span class="approach-step">02</span><div><h3 data-about-key="stepTwoTitle">Planning</h3><p data-about-key="stepTwoBody">We define the project scope, requirements, priorities, and implementation approach.</p></div></li>
          <li data-reveal><span class="approach-step">03</span><div><h3 data-about-key="stepThreeTitle">Design</h3><p data-about-key="stepThreeBody">We create user-focused layouts and digital experiences aligned with the business identity.</p></div></li>
          <li data-reveal><span class="approach-step">04</span><div><h3 data-about-key="stepFourTitle">Development</h3><p data-about-key="stepFourBody">We build the approved solution using suitable technologies and reusable components.</p></div></li>
          <li data-reveal><span class="approach-step">05</span><div><h3 data-about-key="stepFiveTitle">Testing</h3><p data-about-key="stepFiveBody">We review functionality, responsiveness, accessibility, and performance before launch.</p></div></li>
          <li data-reveal><span class="approach-step">06</span><div><h3 data-about-key="stepSixTitle">Launch</h3><p data-about-key="stepSixBody">We prepare and deploy the completed solution, with the agreed handover and guidance.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="about-closing" aria-labelledby="closing-title">
      <div class="about-closing__orb about-closing__orb--one" aria-hidden="true"></div><div class="about-closing__orb about-closing__orb--two" aria-hidden="true"></div>
      <div class="about-closing__inner" data-reveal>
        <h2 id="closing-title" data-about-key="closingTitle">Let’s Build Something Meaningful.</h2>
        <p data-about-key="closingBodyOne">Have a business idea, a digital challenge, or a project in mind?</p>
        <p data-about-key="closingBodyTwo">Let’s explore how RYZITE can help bring your vision to life.</p>
        <a class="about-button about-button--light" href={ctaUrl}><span data-about-key="startProject">Start a Project</span><span aria-hidden="true"><ArrowUpRight /></span></a>
      </div>
      <span class="about-closing__wordmark" aria-hidden="true">RYZITE</span>
    </section>
  </div>
</MainLayout>

<script is:inline define:vars={{ aboutTranslations }}>
  const applyAboutLocale = (locale) => {
    const translations = aboutTranslations[locale] || aboutTranslations.en;
    document.querySelectorAll('[data-about-key]').forEach((element) => {
      const value = translations[element.dataset.aboutKey];
      if (typeof value === 'string') element.textContent = value;
    });
    const description = document.querySelector('meta[name="description"]');
    if (description) description.setAttribute('content', translations.metaDescription);
    const openGraphTitle = document.querySelector('meta[property="og:title"]');
    if (openGraphTitle) openGraphTitle.setAttribute('content', translations.pageTitle);
    const openGraphDescription = document.querySelector('meta[property="og:description"]');
    if (openGraphDescription) openGraphDescription.setAttribute('content', translations.metaDescription);
  };

  const initialAboutLocale = document.body.dataset.locale || 'en';
  applyAboutLocale(initialAboutLocale);
  window.addEventListener('ryzite:locale-change', (event) => applyAboutLocale(event.detail?.locale || 'en'));

  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!motionPreference.matches && 'IntersectionObserver' in window) {
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-revealed');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('[data-reveal]').forEach((element) => {
      element.classList.add('about-reveal-pending');
      revealObserver.observe(element);
    });
  }
</script>

<style>
  .about-page {
    --about-blue: #0655e9;
    --about-blue-deep: #073db7;
    --about-cyan: #00a6fa;
    --about-ink: #101d32;
    --about-muted: #5c6674;
    --about-line: #dce4ee;
    overflow: hidden;
    color: var(--about-ink);
    background: var(--color-paper);
  }

  .about-page *, .about-page *::before, .about-page *::after { box-sizing: border-box; }
  .section-shell { width: min(100%, var(--content-max)); margin-inline: auto; padding-inline: var(--space-frame); }

  .about-hero {
    position: relative;
    isolation: isolate;
    min-height: min(780px, calc(100svh - 86px));
    padding: clamp(5rem, 9vw, 8.5rem) var(--space-frame) 2rem;
    overflow: hidden;
    background: linear-gradient(118deg, #faf8f4 0%, #f7f9fc 56%, #edf5ff 100%);
  }
  .about-hero__inner { position: relative; z-index: 1; display: grid; width: min(100%, var(--content-max)); min-height: 570px; margin-inline: auto; grid-template-columns: minmax(0, 1fr) minmax(320px, .8fr); align-items: center; gap: clamp(2rem, 6vw, 7rem); }
  .about-hero__copy { max-width: 760px; animation: about-rise 700ms var(--ease-out) both; }
  .about-eyebrow { display: flex; align-items: center; gap: .7rem; margin: 0 0 1.25rem; color: var(--about-blue); font-family: var(--font-body); font-size: var(--size-eyebrow); font-weight: 800; letter-spacing: .16em; line-height: 1.4; text-transform: uppercase; }
  .about-eyebrow::before { width: 1.7rem; height: 2px; border-radius: 2px; background: currentColor; content: ''; }
  .about-hero h1 { max-width: var(--measure-h1); margin: 0; color: #101827; font-family: var(--font-display); font-size: var(--size-h1); font-weight: 900; letter-spacing: var(--tracking-h1); line-height: var(--leading-h1); }
  .about-hero__description { max-width: 620px; margin: 1.7rem 0 0; color: var(--about-muted); font-size: var(--size-lead); line-height: 1.75; animation: about-rise 700ms 100ms var(--ease-out) both; }
  .about-hero__statement { display: inline-flex; margin: 1.2rem 0 0; color: var(--about-blue-deep); font-family: var(--font-display); font-size: var(--size-h3); font-weight: 700; letter-spacing: .025em; }
  .about-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .85rem; margin-top: 2rem; animation: about-rise 700ms 180ms var(--ease-out) both; }
  .about-button { display: inline-flex; min-height: 3.25rem; align-items: center; justify-content: center; gap: 1.2rem; padding: .8rem 1.25rem; border: 1px solid transparent; border-radius: 999px; font-family: var(--font-body); font-size: .9rem; font-weight: 700; line-height: 1.3; text-decoration: none; transition: transform var(--duration-fast) var(--ease-out), background var(--duration-fast) ease, color var(--duration-fast) ease, box-shadow var(--duration-fast) ease, border-color var(--duration-fast) ease; }
  .about-button:hover { transform: translateY(-3px); }
  .about-button span:last-child { font-size: 1.1rem; transition: transform var(--duration-fast) var(--ease-out); }
  .about-button:hover span:last-child { transform: translate(2px, -2px); }
  .about-button--primary { color: #fff; background: linear-gradient(110deg, #078be9, #064bed); box-shadow: 0 .7rem 1.6rem rgb(6 75 237 / 20%); }
  .about-button--primary:hover { background: linear-gradient(110deg, #087bd2, #043ec9); box-shadow: 0 .95rem 1.8rem rgb(6 75 237 / 26%); }
  .about-button--quiet { border-color: #d4dfed; color: #183158; background: rgb(255 255 255 / 48%); }
  .about-button--quiet:hover { border-color: #aac4ee; background: #fff; }
  .about-hero__visual { position: relative; width: min(100%, 520px); aspect-ratio: 1; justify-self: center; animation: about-visual-in 900ms 150ms var(--ease-out) both; }
  .about-hero__glow { position: absolute; z-index: -1; border-radius: 50%; filter: blur(1px); pointer-events: none; }
  .about-hero__glow--one { top: 6%; right: 9%; width: 35vw; max-width: 500px; aspect-ratio: 1; background: radial-gradient(circle, rgb(66 166 255 / 17%), transparent 68%); }
  .about-hero__glow--two { bottom: -38%; left: 24%; width: 28vw; max-width: 380px; aspect-ratio: 1; background: radial-gradient(circle, rgb(0 166 250 / 10%), transparent 70%); }
  .orbit { position: absolute; inset: 10%; border: 1px solid rgb(6 85 233 / 20%); border-radius: 50%; }
  .orbit--outer { inset: 5%; border-color: rgb(6 85 233 / 17%); animation: orbit-turn 34s linear infinite; }
  .orbit--inner { inset: 23%; border-style: dashed; border-color: rgb(6 85 233 / 26%); animation: orbit-turn 40s linear infinite reverse; }
  .visual-grid { position: absolute; inset: 17%; border: 1px solid rgb(6 85 233 / 12%); border-radius: 50%; background-image: linear-gradient(rgb(6 85 233 / 8%) 1px, transparent 1px), linear-gradient(90deg, rgb(6 85 233 / 8%) 1px, transparent 1px); background-position: center; background-size: 18% 18%; mask-image: radial-gradient(circle, black 0 65%, transparent 66%); }
  .visual-core { position: absolute; top: 50%; left: 50%; display: grid; width: 33%; aspect-ratio: 1; place-items: center; transform: translate(-50%, -50%); border: 1px solid rgb(255 255 255 / 90%); border-radius: 29%; color: #fff; background: linear-gradient(145deg, #168fff, #0743ce); box-shadow: 0 1.4rem 3rem rgb(6 75 237 / 30%), inset 0 1px 0 rgb(255 255 255 / 50%); }
  .visual-core span { font-family: var(--font-body); font-size: clamp(1.4rem, 3.5vw, 2.7rem); font-weight: 800; letter-spacing: -.08em; }
  .visual-node { position: absolute; display: grid; width: 3.3rem; aspect-ratio: 1; place-items: center; border: 1px solid rgb(6 85 233 / 20%); border-radius: 1.1rem; color: var(--about-blue); background: rgb(255 255 255 / 85%); box-shadow: 0 .6rem 1.8rem rgb(24 59 112 / 10%); font-family: var(--font-display); font-size: 1rem; font-weight: 700; }
  .visual-node--one { top: 16%; left: 16%; }.visual-node--two { top: 24%; right: 8%; }.visual-node--three { right: 18%; bottom: 12%; }
  .visual-caption { position: absolute; bottom: 7%; left: 50%; width: max-content; transform: translateX(-50%); color: #667891; font-size: .66rem; font-weight: 800; letter-spacing: .16em; }
  .visual-caption i { margin-inline: .5rem; color: var(--about-cyan); font-style: normal; }
  .about-hero__footer { display: flex; width: min(100%, var(--content-max)); justify-content: space-between; gap: 1rem; margin: clamp(2rem, 5vw, 4rem) auto 0; padding-top: 1rem; border-top: 1px solid rgb(19 51 91 / 12%); color: #788494; font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .about-hero__footer b { margin-left: .6rem; color: var(--about-blue); font-size: 1rem; }

  .about-section { padding-block: var(--space-section); }
  .who-section { background: #fff; }
  .who-layout { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(340px, .95fr); align-items: center; gap: clamp(3rem, 8vw, 9rem); }
  .who-copy h2, .section-heading h2, .why-heading h2 { max-width: var(--measure-h2); margin: 0; color: #111d30; font-family: var(--font-display); font-size: var(--size-h2); font-weight: 800; letter-spacing: var(--tracking-h2); line-height: var(--leading-h2); }
  .who-copy > p:not(.about-eyebrow) { max-width: 680px; margin: 1.3rem 0 0; color: var(--about-muted); font-size: 1rem; line-height: 1.8; }

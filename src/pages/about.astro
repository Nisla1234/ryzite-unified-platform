---
import ArrowUpRight from '../components/ui/ArrowUpRight.astro';
import MainLayout from '../layouts/MainLayout.astro';
import { aboutTranslations } from '../data/about-translations';
import ProcessRoad from '../components/sections/ProcessRoad.astro';

const ctaUrl = '/contact/';

// Approach steps use the homepage "winding road" layout (client request 2026-11-19).
const stepKeys = ['One', 'Two', 'Three', 'Four', 'Five', 'Six'];
const approachSteps = stepKeys.map((key) => ({
  name: aboutTranslations.en[`step${key}Title` as keyof typeof aboutTranslations.en] as string,
  description: aboutTranslations.en[`step${key}Body` as keyof typeof aboutTranslations.en] as string,
  nameAttrs: { 'data-about-key': `step${key}Title` },
  descriptionAttrs: { 'data-about-key': `step${key}Body` },
}));
---

<MainLayout
  title="About RYZITE | Digital Marketing & Technology Solutions"
  description="Meet RYZITE, a digital solutions company bringing marketing services and technology solutions together to help businesses grow."
  openGraph={true}
>
  <div class="about-page">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="about-hero__glow about-hero__glow--one" aria-hidden="true"></div>
      <div class="about-hero__glow about-hero__glow--two" aria-hidden="true"></div>
      <div class="about-hero__inner">
        <div class="about-hero__copy">
          <h1 id="about-title" data-about-key="heroTitle">Turning Ideas Into Digital Possibilities.</h1>
          <p class="about-hero__description" data-about-key="heroDescription">At RYZITE, we believe every business deserves the right combination of technology, creativity, and digital strategy to grow.</p>
          <p class="about-hero__statement" data-about-key="heroStatement">One Site. Solve Every Problem.</p>
          <div class="about-hero__actions">
            <a class="about-button about-button--primary" href="/services/#services">
              <span data-about-key="heroExplore">Explore Our Services</span><span aria-hidden="true"><ArrowUpRight /></span>
            </a>
            <a class="about-button about-button--quiet" href={ctaUrl}>
              <span data-about-key="startProject">Start a Project</span><span aria-hidden="true"><ArrowUpRight /></span>
            </a>
          </div>
        </div>
        <figure class="about-hero__visual about-hero__visual--photo">
          <img src="/images/about/team-hands-together.webp" alt="A smiling team seen from above, joining hands in a circle around a burst of light." width="736" height="736" fetchpriority="high" decoding="async" />
        </figure>
      </div>
    </section>

    <section class="about-section who-section" aria-labelledby="who-title">
      <div class="section-shell who-layout">
        <div class="who-copy" data-reveal>
          <h2 id="who-title" data-about-key="whoTitle">A Digital Partner for Modern Businesses.</h2>
          <p data-about-key="whoParagraphOne">We are a digital solutions company focused on helping businesses establish a strong online presence, connect with customers, and simplify their operations through modern technology.</p>
          <p data-about-key="whoParagraphTwo">From professional websites and mobile applications to digital marketing, branding, and business automation, we bring creative thinking and technical expertise together to deliver solutions tailored to each business.</p>
        </div>
        <figure class="who-art who-art--photo" data-reveal>
          <img src="/images/about/digital-partner-team.webp" alt="A team gathered around a table while a presenter points to a target among digital strategy charts." width="735" height="420" loading="lazy" decoding="async" />
          <figcaption class="who-art__caption"><strong data-about-key="whoHighlight">One Agency. All Your Business Solutions.</strong><span data-about-key="whoNote">Connected thinking for the way your business works.</span></figcaption>
        </figure>
      </div>
    </section>

    <section class="about-section purpose-section" aria-labelledby="purpose-title">
      <div class="section-shell">
        <header class="section-heading section-heading--center" data-reveal>
          <h2 id="purpose-title" data-about-key="purposeTitle">Driven by Purpose. Focused on Possibilities.</h2>
        </header>
        <div class="purpose-grid">
          <article class="purpose-card" data-reveal>
            <div class="purpose-card__head">
              <div>
                <h3 data-about-key="missionTitle">Our Mission</h3>
              </div>
              <span class="purpose-card__icon purpose-card__icon--contain"><img src="/images/about/mission.webp" alt="" width="450" height="450" loading="lazy" decoding="async" /></span>
            </div>
            <p data-about-key="missionBody">To empower businesses with accessible, innovative, and reliable digital solutions that improve efficiency, strengthen their online presence, and support sustainable growth.</p>
          </article>
          <article class="purpose-card purpose-card--blue" data-reveal>
            <div class="purpose-card__head">
              <div>
                <h3 data-about-key="visionTitle">Our Vision</h3>
              </div>
              <span class="purpose-card__icon"><img src="/images/about/vision.webp" alt="" width="735" height="490" loading="lazy" decoding="async" /></span>
            </div>
            <p data-about-key="visionBody">To become a trusted digital solutions partner, helping businesses of all sizes embrace technology, unlock new opportunities, and succeed in an evolving digital world.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="about-section divisions-section" aria-labelledby="divisions-title">
      <div class="section-shell">
        <header class="section-heading divisions-heading" data-reveal>
          <div><h2 id="divisions-title" data-about-key="divisionsTitle">Two Divisions. One Connected Digital Partner.</h2></div>
          <p data-about-key="divisionsIntro">RYZITE combines marketing expertise and technology solutions to help businesses build their digital presence, reach customers, and operate more efficiently.</p>
        </header>
        <div class="division-grid">
          <article class="division-card division-card--marketing" data-reveal>
            <figure class="division-card__art"><img src="/images/divisions/marketing-division.webp" alt="A strategist talking through business questions and growth data with two clients" width="736" height="411" loading="lazy" decoding="async" /></figure>
            <h3 data-about-key="marketingTitle">Marketing Services</h3>
            <p class="division-card__description" data-about-key="marketingBody">We help businesses build their brands, improve online visibility, reach the right audiences, and turn digital engagement into meaningful business opportunities.</p>
            <p class="division-card__list-label" data-about-key="marketingListLabel">Explore services such as</p>
            <ul class="division-tags">
              <li data-about-key="marketingItemOne">Search visibility and SEO</li><li data-about-key="marketingItemTwo">Digital advertising</li>
              <li data-about-key="marketingItemThree">Social media management</li><li data-about-key="marketingItemFour">Branding and visual identity</li>
              <li data-about-key="marketingItemFive">Content marketing</li><li data-about-key="marketingItemSix">Marketing automation and CRM</li>
              <li data-about-key="marketingItemSeven">Website tracking and conversion improvement</li><li data-about-key="marketingItemEight">Practical AI marketing support</li>
            </ul>
            <a class="division-card__link" href="/services/#services"><span data-about-key="marketingCta">Explore Marketing Services</span><span aria-hidden="true"><ArrowUpRight /></span></a>
          </article>
          <article class="division-card division-card--technology" data-reveal>
            <figure class="division-card__art"><img src="/images/divisions/technology-division.webp" alt="Connected devices, buildings and systems linked to a central digital network" width="735" height="490" loading="lazy" decoding="async" /></figure>
            <h3 data-about-key="technologyTitle">Technology Solutions</h3>
            <p class="division-card__description" data-about-key="technologyBody">We design and develop websites, e-commerce platforms, mobile applications, custom software, and automation solutions that help businesses operate smarter.</p>
            <p class="division-card__list-label" data-about-key="technologyListLabel">Explore solutions such as</p>
            <ul class="division-tags">
              <li data-about-key="technologyItemOne">Business website development</li><li data-about-key="technologyItemTwo">Online store development</li>
              <li data-about-key="technologyItemThree">Mobile applications</li><li data-about-key="technologyItemFour">Custom business software</li>
              <li data-about-key="technologyItemFive">UI/UX design</li><li data-about-key="technologyItemSix">Customer chatbots and assistants</li>
              <li data-about-key="technologyItemSeven">Workflow automation and integrations</li><li data-about-key="technologyItemEight">Website care and maintenance</li>
            </ul>
            <a class="division-card__link" href="/solutions/#solutions"><span data-about-key="technologyCta">Explore Technology Solutions</span><span aria-hidden="true"><ArrowUpRight /></span></a>
          </article>
        </div>
      </div>
    </section>

    <section class="about-section values-section" aria-labelledby="values-title">
      <div class="section-shell">
        <header class="section-heading section-heading--center" data-reveal>
          <h2 id="values-title" data-about-key="valuesTitle">The Principles Behind Everything We Create.</h2>
          <p data-about-key="valuesIntro">Our work is guided by values that help us deliver thoughtful, practical, and meaningful digital solutions.</p>
        </header>
        <div class="values-grid">
          <article class="value-card value-card--one" data-reveal>
            <div class="value-card__media" aria-hidden="true"><img src="/images/about/value-creativity.webp" alt="" width="736" height="736" loading="lazy" decoding="async" /></div>
            <div class="value-card__content"><h3 data-about-key="valueOneTitle">Creativity</h3><p data-about-key="valueOneBody">We explore fresh ideas and thoughtful design approaches to create meaningful digital experiences.</p></div>
          </article>
          <article class="value-card value-card--two" data-reveal>
            <div class="value-card__media" aria-hidden="true"><img src="/images/about/value-innovation.webp" alt="" width="736" height="736" loading="lazy" decoding="async" /></div>
            <div class="value-card__content"><h3 data-about-key="valueTwoTitle">Innovation</h3><p data-about-key="valueTwoBody">We embrace modern technologies and practical solutions to help businesses adapt and grow.</p></div>
          </article>
          <article class="value-card value-card--three" data-reveal>
            <div class="value-card__media" aria-hidden="true"><img src="/images/about/value-reliability.webp" alt="" width="736" height="736" loading="lazy" decoding="async" /></div>
            <div class="value-card__content"><h3 data-about-key="valueThreeTitle">Reliability</h3><p data-about-key="valueThreeBody">We focus on clear communication, consistent quality, and dependable solutions.</p></div>
          </article>
          <article class="value-card value-card--four" data-reveal>
            <div class="value-card__media" aria-hidden="true"><img src="/images/about/value-collaboration.webp" alt="" width="736" height="736" loading="lazy" decoding="async" /></div>
            <div class="value-card__content"><h3 data-about-key="valueFourTitle">Collaboration</h3><p data-about-key="valueFourBody">We believe strong results come from understanding our clients and working together toward shared goals.</p></div>
          </article>
        </div>
      </div>
    </section>

    <section class="about-section why-section" aria-labelledby="why-title">
      <div class="why-bg" aria-hidden="true"><img src="/images/about/why-background.webp" alt="" width="736" height="670" loading="lazy" decoding="async" /></div>
      <div class="section-shell why-layout">
        <header class="why-heading" data-reveal><h2 id="why-title" data-about-key="whyTitle">Built Around Your Business Goals.</h2></header>
        <div class="why-grid">
          <article class="why-feature" data-reveal><span class="why-feature__icon" aria-hidden="true"><img src="/images/about/why-creative.webp" alt="" width="240" height="302" loading="lazy" decoding="async" /></span><div><h3 data-about-key="whyOneTitle">Creative Thinking</h3><p data-about-key="whyOneBody">We combine modern design with practical business-focused solutions.</p></div></article>
          <article class="why-feature" data-reveal><span class="why-feature__icon" aria-hidden="true"><img src="/images/about/why-technology.webp" alt="" width="240" height="240" loading="lazy" decoding="async" /></span><div><h3 data-about-key="whyTwoTitle">Technology-Driven</h3><p data-about-key="whyTwoBody">We use suitable technologies to build scalable, responsive, and efficient digital experiences.</p></div></article>
          <article class="why-feature" data-reveal><span class="why-feature__icon" aria-hidden="true"><img src="/images/about/why-business.webp" alt="" width="240" height="240" loading="lazy" decoding="async" /></span><div><h3 data-about-key="whyThreeTitle">Business-Focused Approach</h3><p data-about-key="whyThreeBody">We focus on understanding business challenges before recommending solutions.</p></div></article>
          <article class="why-feature" data-reveal><span class="why-feature__icon" aria-hidden="true"><img src="/images/about/why-connected.webp" alt="" width="240" height="298" loading="lazy" decoding="async" /></span><div><h3 data-about-key="whyFourTitle">Connected Digital Solutions</h3><p data-about-key="whyFourBody">We bring marketing and technology together to support businesses from initial ideas to digital growth.</p></div></article>
        </div>
      </div>
    </section>

    <section class="about-section approach-section" aria-labelledby="approach-title">
      <div class="section-shell">
        <header class="section-heading section-heading--center" data-reveal>
          <h2 id="approach-title" data-about-key="approachTitle">From First Conversation to Final Launch.</h2>
          <p data-about-key="approachIntro">We follow a structured approach to understand business needs, plan suitable solutions, and deliver digital experiences with clarity and purpose.</p>
        </header>
        <ProcessRoad steps={approachSteps} />
      </div>
    </section>

  </div>
</MainLayout>

<script is:inline define:vars={{ aboutTranslations }}>
  const applyAboutLocale = (locale) => {
    const translations = aboutTranslations[locale] || aboutTranslations.en;
    document.querySelectorAll('[data-about-key]').forEach((element) => {
      const value = translations[element.dataset.aboutKey];
      if (typeof value === 'string') element.textContent = value;
    });
    const description = document.querySelector('meta[name="description"]');
    if (description) description.setAttribute('content', translations.metaDescription);
    const openGraphTitle = document.querySelector('meta[property="og:title"]');
    if (openGraphTitle) openGraphTitle.setAttribute('content', translations.pageTitle);
    const openGraphDescription = document.querySelector('meta[property="og:description"]');
    if (openGraphDescription) openGraphDescription.setAttribute('content', translations.metaDescription);
  };

  const initialAboutLocale = document.body.dataset.locale || 'en';
  applyAboutLocale(initialAboutLocale);
  window.addEventListener('ryzite:locale-change', (event) => applyAboutLocale(event.detail?.locale || 'en'));

  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!motionPreference.matches && 'IntersectionObserver' in window) {
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-revealed');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('[data-reveal]').forEach((element) => {
      element.classList.add('about-reveal-pending');
      revealObserver.observe(element);
    });
  }
</script>

<style>
  .about-page {
    --about-blue: var(--color-brand);
    --about-blue-deep: var(--color-brand);
    --about-cyan: var(--color-brand);
    --about-ink: var(--color-heading);
    --about-muted: var(--color-body);
    --about-line: #dce4ee;
    overflow: hidden;
    color: var(--about-ink);
    background: var(--color-paper);
  }

  .about-page *, .about-page *::before, .about-page *::after { box-sizing: border-box; }
  .section-shell { width: min(100%, var(--content-max)); margin-inline: auto; padding-inline: var(--space-frame); }

  .about-hero {
    position: relative;
    isolation: isolate;
    min-height: min(780px, calc(100svh - 86px));
    padding: clamp(5rem, 9vw, 8.5rem) var(--space-frame) 2rem;
    overflow: hidden;
    background: var(--color-milk);
  }
  .about-hero__inner { position: relative; z-index: 1; display: grid; width: min(100%, var(--content-max)); min-height: 570px; margin-inline: auto; grid-template-columns: minmax(0, 1fr) minmax(320px, .8fr); align-items: center; gap: clamp(2rem, 6vw, 7rem); }
  .about-hero__copy { max-width: 760px; animation: about-rise 700ms var(--ease-out) both; }
  .about-eyebrow { display: flex; align-items: center; gap: .7rem; margin: 0 0 1.25rem; color: var(--about-blue); font-family: var(--font-body); font-size: var(--size-eyebrow); font-weight: 600; letter-spacing: .16em; line-height: 1.4; text-transform: uppercase; }
  .about-eyebrow::before { width: 1.7rem; height: 2px; border-radius: 2px; background: currentColor; content: ''; }
  .about-hero h1 { max-width: var(--measure-h1); margin: 0; color: #101827; font-family: var(--font-display); font-size: var(--size-h1); font-weight: 700; letter-spacing: var(--tracking-h1); line-height: var(--leading-h1); }
  .about-hero__description { max-width: 620px; margin: 1.7rem 0 0; color: var(--about-muted); font-size: var(--size-lead); line-height: 1.75; animation: about-rise 700ms 100ms var(--ease-out) both; }
  .about-hero__statement { display: inline-flex; margin: 1.2rem 0 0; color: var(--about-blue-deep); font-family: var(--font-display); font-size: var(--size-h3); font-weight: 700; letter-spacing: .025em; }
  .about-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .85rem; margin-top: 2rem; animation: about-rise 700ms 180ms var(--ease-out) both; }
  .about-button { display: inline-flex; min-height: 3.25rem; align-items: center; justify-content: center; gap: 1.2rem; padding: .8rem 1.25rem; border: 1px solid transparent; border-radius: 999px; font-family: var(--font-body); font-size: .99rem; font-weight: 600; line-height: 1.3; text-decoration: none; transition: transform var(--duration-fast) var(--ease-out), background var(--duration-fast) ease, color var(--duration-fast) ease, box-shadow var(--duration-fast) ease, border-color var(--duration-fast) ease; }
  .about-button:hover { transform: translateY(-3px); }
  .about-button span:last-child { font-size: 1.21rem; transition: transform var(--duration-fast) var(--ease-out); }
  .about-button:hover span:last-child { transform: translateX(3px); }
  .about-button--primary { color: #fff; background: var(--color-brand); box-shadow: 0 .7rem 1.6rem rgb(11 28 88 / 20%); }
  .about-button--primary:hover { background: var(--color-brand-hover); box-shadow: 0 .95rem 1.8rem rgb(11 28 88 / 26%); }
  .about-button--quiet { border-color: #d4dfed; color: #183158; background: rgb(255 255 255 / 48%); }
  .about-button--quiet:hover { border-color: #aac4ee; background: var(--color-milk); }
  .about-hero__visual { position: relative; width: min(100%, 520px); aspect-ratio: 1; justify-self: center; animation: about-visual-in 900ms 150ms var(--ease-out) both; }
  /* Photo version of the hero visual (client-supplied image, 2026-11-19). */
  .about-hero__visual.about-hero__visual--photo { width: min(100%, 500px); margin: 0; aspect-ratio: 1; overflow: hidden; border-radius: var(--radius-large); background: #0b1c58; box-shadow: 0 1.6rem 3.2rem rgb(11 28 88 / 18%); }
  .about-hero__visual--photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .about-hero__glow { position: absolute; z-index: -1; border-radius: 50%; filter: blur(1px); pointer-events: none; }
  .about-hero__glow--one { top: 6%; right: 9%; width: 35vw; max-width: 500px; aspect-ratio: 1; background: radial-gradient(circle, rgb(11 28 88 / 17%), transparent 68%); }
  .about-hero__glow--two { bottom: -38%; left: 24%; width: 28vw; max-width: 380px; aspect-ratio: 1; background: radial-gradient(circle, rgb(11 28 88 / 10%), transparent 70%); }
  .orbit { position: absolute; inset: 10%; border: 1px solid rgb(11 28 88 / 20%); border-radius: 50%; }
  .orbit--outer { inset: 5%; border-color: rgb(11 28 88 / 17%); animation: orbit-turn 34s linear infinite; }
  .orbit--inner { inset: 23%; border-style: dashed; border-color: rgb(11 28 88 / 26%); animation: orbit-turn 40s linear infinite reverse; }
  .visual-grid { position: absolute; inset: 17%; border: 1px solid rgb(11 28 88 / 12%); border-radius: 50%; background-image: linear-gradient(rgb(11 28 88 / 8%) 1px, transparent 1px), linear-gradient(90deg, rgb(11 28 88 / 8%) 1px, transparent 1px); background-position: center; background-size: 18% 18%; mask-image: radial-gradient(circle, black 0 65%, transparent 66%); }
  .visual-core { position: absolute; top: 50%; left: 50%; display: grid; width: 33%; aspect-ratio: 1; place-items: center; transform: translate(-50%, -50%); border: 1px solid rgb(255 255 255 / 90%); border-radius: 29%; color: #fff; background: var(--color-brand); box-shadow: 0 1.4rem 3rem rgb(11 28 88 / 30%), inset 0 1px 0 rgb(255 255 255 / 50%); }
  .visual-core span { font-family: var(--font-body); font-size: clamp(1.54rem, 3.85vw, 2.97rem); font-weight: 600; letter-spacing: -.08em; }
  .visual-node { position: absolute; display: grid; width: 3.3rem; aspect-ratio: 1; place-items: center; border: 1px solid rgb(11 28 88 / 20%); border-radius: 1.1rem; color: var(--about-blue); background: rgb(253 255 245 / 85%); box-shadow: 0 .6rem 1.8rem rgb(24 59 112 / 10%); font-family: var(--font-display); font-size: 1.1rem; font-weight: 700; }
  .visual-node--one { top: 16%; left: 16%; }.visual-node--two { top: 24%; right: 8%; }.visual-node--three { right: 18%; bottom: 12%; }
  .visual-caption { position: absolute; bottom: 7%; left: 50%; width: max-content; transform: translateX(-50%); color: #667891; font-size: .8125rem; font-weight: 600; letter-spacing: .16em; }
  .visual-caption i { margin-inline: .5rem; color: var(--about-cyan); font-style: normal; }

  .about-section { padding-block: var(--space-section); }
  .who-section { background: var(--color-milk); }
  .who-layout { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(340px, .95fr); align-items: center; gap: clamp(3rem, 8vw, 9rem); }
  .who-copy h2, .section-heading h2, .why-heading h2 { max-width: var(--measure-h2); margin: 0; color: #111d30; font-family: var(--font-display); font-size: var(--size-h2); font-weight: 700; letter-spacing: var(--tracking-h2); line-height: var(--leading-h2); }
  .who-copy > p:not(.about-eyebrow) { max-width: 680px; margin: 1.3rem 0 0; color: var(--about-muted); font-size: 1.1rem; line-height: 1.8; }
  .who-art { position: relative; min-height: 430px; overflow: hidden; border: 1px solid #e0e9f4; border-radius: var(--radius-large); background: linear-gradient(140deg, #e8f3ff, #f8fbff 65%, #e5f2ff); }
  .who-art__halo { position: absolute; top: 1rem; right: -3rem; width: 23rem; aspect-ratio: 1; border: 1px solid rgb(11 28 88 / 14%); border-radius: 50%; box-shadow: 0 0 0 30px rgb(11 28 88 / 3%), 0 0 0 60px rgb(11 28 88 / 2%); }
  .who-art__line { position: absolute; width: 120%; height: 1px; background: rgb(11 28 88 / 12%); transform: rotate(-31deg); }.who-art__line--one { top: 41%; left: -10%; }.who-art__line--two { top: 62%; left: -8%; transform: rotate(24deg); }
  .who-art__panel { position: absolute; display: flex; flex-direction: column; justify-content: center; border: 1px solid rgb(255 255 255 / 85%); border-radius: 1.2rem; background: rgb(253 255 245 / 80%); box-shadow: 0 1.2rem 2.6rem rgb(18 55 105 / 12%); backdrop-filter: blur(16px); }
  .who-art__panel--main { top: 20%; left: 12%; width: 54%; height: 47%; padding: 1.4rem; }
  .art-code { color: var(--about-blue); font-family: var(--font-body); font-size: clamp(2.75rem, 5.5vw, 4.4rem); font-weight: 600; letter-spacing: -.08em; }
  .art-rule { width: 75%; height: .55rem; margin-top: 1.1rem; border-radius: 1rem; background: #c6dbf6; }.art-rule--short { width: 52%; margin-top: .6rem; background: #dce9f8; }
  .who-art__panel--small { right: 9%; bottom: 18%; gap: .6rem; width: 38%; min-height: 6.4rem; padding: 1rem; color: #24466f; font-size: .8125rem; font-weight: 600; letter-spacing: .1em; line-height: 1.45; }
  .art-dot { width: .65rem; aspect-ratio: 1; border-radius: 50%; background: var(--about-cyan); box-shadow: 0 0 0 .45rem #0b1c5820; }
  .who-art__spark { position: absolute; color: var(--color-brand); font-size: 1.87rem; }.who-art__spark--one { top: 15%; right: 21%; }.who-art__spark--two { bottom: 18%; left: 16%; }

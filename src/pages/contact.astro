---
import MainLayout from '../layouts/MainLayout.astro';
import { company, enquiryForm } from '../Constants';
import { divisions, offeringSlug } from '../data/offerings';
import { contactTranslations } from '../data/contact-translations';

const marketing = divisions.find(({ id }) => id === 'services')?.items ?? [];
const technology = divisions.find(({ id }) => id === 'solutions')?.items ?? [];
const hearOptions = [
  ['hearGoogle', 'Google Search'],
  ['hearFacebook', 'Facebook'],
  ['hearInstagram', 'Instagram'],
  ['hearLinkedin', 'LinkedIn'],
  ['hearYoutube', 'YouTube'],
  ['hearReferral', 'Recommendation from someone'],
  ['hearOther', 'Other'],
];
const enquiryConfig = {
  endpoint: enquiryForm.endpoint,
  accessKey: enquiryForm.accessKey,
  subject: enquiryForm.subject,
  fromName: enquiryForm.fromName,
  whatsappNumber: company.whatsapp.number,
};
---

<MainLayout
  title="Contact RYZITE | Start Your Digital Project"
  description="Contact RYZITE to discuss websites, digital marketing, mobile applications, software development, and business automation solutions."
  openGraph={true}
>
  <div class="contact-page">
    <section class="contact-hero" aria-labelledby="contact-hero-title">
      <div class="contact-hero__glow contact-hero__glow--one" aria-hidden="true"></div>
      <div class="contact-hero__inner">
        <div class="contact-hero__copy">
          <p class="contact-eyebrow" data-contact-key="heroEyebrow">CONTACT RYZITE</p>
          <h1 id="contact-hero-title" data-contact-key="heroTitle">Let’s Turn Your Ideas Into Reality.</h1>
          <p class="contact-hero__description" data-contact-key="heroDescription">Have a project in mind, a business challenge to solve, or a question about our services? We’re here to help you explore the right digital solutions for your business.</p>
          <p class="contact-hero__supporting" data-contact-key="heroSupporting">Whether you need a professional website, digital marketing support, a mobile application, or custom software, let’s start a conversation.</p>
          <p class="contact-hero__tagline" data-contact-key="heroTagline">One Agency. All Your Business Solutions.</p>
          <a class="contact-button contact-button--primary" href="#project-enquiry"><span data-contact-key="closingCta">Start a Conversation</span><span aria-hidden="true">↓</span></a>
        </div>
        <div class="contact-hero__art" aria-hidden="true">
          <div class="contact-hero__ring contact-hero__ring--outer"></div>
          <div class="contact-hero__ring contact-hero__ring--inner"></div>
          <div class="contact-hero__message-card"><span class="message-card__dot"></span><span class="message-card__line"></span><span class="message-card__line message-card__line--short"></span><span class="message-card__send">↗</span></div>
          <span class="contact-hero__orbit-label contact-hero__orbit-label--one" data-contact-key="artIdeas">IDEAS</span>
          <span class="contact-hero__orbit-label contact-hero__orbit-label--two" data-contact-key="artSolutions">SOLUTIONS</span>
          <span class="contact-hero__spark">✳</span>
        </div>
      </div>
      <div class="contact-hero__edge" aria-hidden="true"><span data-contact-key="edgeLabel">RYZITE / CONTACT</span><span><span data-contact-key="edgeNote">Let’s talk about what’s next</span> <b>↓</b></span></div>
    </section>

    <section class="contact-section contact-reach" aria-labelledby="get-in-touch-title">
      <div class="contact-shell">
        <header class="contact-section-heading" data-contact-reveal>
          <p class="contact-eyebrow" data-contact-key="heroEyebrow">CONTACT RYZITE</p>
          <h2 id="get-in-touch-title" data-contact-key="getInTouchTitle">Let’s Start a Conversation.</h2>
        </header>
        <div class="contact-reach__grid">
          <article class="reach-card reach-card--email" data-contact-reveal>
            <span class="reach-card__icon" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><rect x="5" y="9" width="38" height="30" rx="4"/><path d="m7 13 17 13 17-13"/></svg></span>
            <h3 data-contact-key="emailTitle">Email Us</h3>
            <p data-contact-key="emailDescription">Send us a message about your project or question.</p>
            <a class="reach-card__email" href={`mailto:${company.email}`}>{company.email}<span aria-hidden="true">↗</span></a>
          </article>
          <article class="reach-card" data-contact-reveal>
            <span class="reach-card__icon" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="M8 39V12a4 4 0 0 1 4-4h24a4 4 0 0 1 4 4v27l-8-5H16l-8 5Z"/><path d="M16 18h16m-16 8h11"/></svg></span>
            <h3 data-contact-key="businessTitle">Business Enquiries</h3>
            <p data-contact-key="businessDescription">Tell us about your business, your goals, and the digital solutions you’re looking for.</p>
            <a class="reach-card__action" href="#project-enquiry"><span data-contact-key="closingCta">Start a Conversation</span><span aria-hidden="true">↗</span></a>
          </article>
          <article class="reach-card" data-contact-reveal>
            <span class="reach-card__icon" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="18"/><path d="M24 14v11l8 5M6 24h5m26 0h5M24 6v5m0 26v5"/></svg></span>
            <h3 data-contact-key="consultationTitle">Project Consultation</h3>
            <p data-contact-key="consultationDescription">Not sure which service is right for you? Share your requirements, and let’s explore suitable options together.</p>
            <a class="reach-card__action" href="#project-enquiry"><span data-contact-key="formTitle">Tell Us About Your Project.</span><span aria-hidden="true">↗</span></a>
          </article>
        </div>
      </div>
    </section>

    <section class="contact-section enquiry-section" id="project-enquiry" aria-labelledby="project-form-title">
      <div class="contact-shell enquiry-layout">
        <div class="enquiry-copy" data-contact-reveal>
          <p class="contact-eyebrow" data-contact-key="formEyebrow">PROJECT ENQUIRY</p>
          <h2 id="project-form-title" data-contact-key="formTitle">Tell Us About Your Project.</h2>
          <p data-contact-key="formDescription">Complete the enquiry form below and share a few details about your project. Our team can review your requirements and discuss the next steps.</p>
          <div class="enquiry-copy__note"><span aria-hidden="true">✳</span><p><span data-contact-key="emailFallback">Prefer email? Write to us at</span> <a href={`mailto:${company.email}`}>{company.email}</a></p></div>
        </div>

        <form
          class="enquiry-form"
          data-contact-form
          method="post"
          action={enquiryForm.endpoint}
          data-contact-reveal
        >
          <input type="hidden" name="access_key" value={enquiryForm.accessKey} />
          <input type="hidden" name="subject" value={enquiryForm.subject} />
          <input type="hidden" name="from_name" value={enquiryForm.fromName} />
          <input class="enquiry-form__trap" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="form-grid">
            <div class="contact-field">
              <label for="contact-name"><span data-contact-key="fullName">Full Name</span><span class="required-mark" aria-hidden="true">*</span></label>
              <input id="contact-name" name="name" type="text" autocomplete="name" required aria-describedby="contact-name-error" />
              <span class="field-error" id="contact-name-error" data-error-for="name" aria-live="polite"></span>
            </div>
            <div class="contact-field">
              <label for="contact-business"><span data-contact-key="businessName">Business / Company Name</span><span class="optional-mark" data-contact-key="optional">Optional</span></label>
              <input id="contact-business" name="business" type="text" autocomplete="organization" />
            </div>
            <div class="contact-field">
              <label for="contact-email"><span data-contact-key="emailAddress">Email Address</span><span class="required-mark" aria-hidden="true">*</span></label>
              <input id="contact-email" name="email" type="email" autocomplete="email" required aria-describedby="contact-email-error" />
              <span class="field-error" id="contact-email-error" data-error-for="email" aria-live="polite"></span>
            </div>
            <div class="contact-field">
              <label for="contact-phone"><span data-contact-key="phone">Phone / WhatsApp Number</span><span class="optional-mark" data-contact-key="optional">Optional</span></label>
              <input id="contact-phone" name="phone" type="tel" autocomplete="tel" />
            </div>
            <div class="contact-field">
              <label for="contact-service"><span data-contact-key="service">Service Interested In</span><span class="optional-mark" data-contact-key="optional">Optional</span></label>
              <select id="contact-service" name="service">
                <option value="" data-contact-key="servicePlaceholder">Choose a service (optional)</option>
                <optgroup label="Marketing Services" data-contact-group="marketingGroup">
                  {marketing.map(([title]) => <option value={offeringSlug(title)} data-service-title={title}>{title}</option>)}
                </optgroup>
                <optgroup label="Technology Solutions" data-contact-group="technologyGroup">
                  {technology.map(([title]) => <option value={offeringSlug(title)} data-service-title={title}>{title}</option>)}
                </optgroup>
              </select>
            </div>
            <div class="contact-field">
              <label for="contact-package"><span data-contact-key="package">Preferred Package</span><span class="optional-mark" data-contact-key="optional">Optional</span></label>
              <select id="contact-package" name="package">
                <option value="" data-contact-key="packagePlaceholder">No package preference</option>
                <option value="guidance" data-english="I’d like help choosing a suitable option" data-contact-key="packageGuidance">I’d like help choosing a suitable option</option>
              </select>
            </div>
            <div class="contact-field">
              <label for="contact-budget"><span data-contact-key="budget">Estimated Budget</span><span class="optional-mark" data-contact-key="optional">Optional</span></label>
              <input id="contact-budget" name="budget" type="text" inputmode="text" data-contact-placeholder="budgetPlaceholder" placeholder="Optional — share an estimated range" />
            </div>
            <div class="contact-field">
              <label for="contact-start-date"><span data-contact-key="startDate">Preferred Start Date</span><span class="optional-mark" data-contact-key="optional">Optional</span></label>
              <input id="contact-start-date" name="startDate" type="date" />
            </div>
            <div class="contact-field contact-field--wide">
              <label for="contact-hear"><span data-contact-key="hearAbout">How did you hear about us?</span><span class="optional-mark" data-contact-key="optional">Optional</span></label>
              <select id="contact-hear" name="hearAbout">
                <option value="" data-contact-key="hearPlaceholder">Choose an option (optional)</option>
                {hearOptions.map(([key, label]) => <option value={label} data-contact-key={key}>{label}</option>)}
              </select>
            </div>
            <div class="contact-field contact-field--wide">
              <label for="contact-project"><span data-contact-key="projectDescription">Project Description</span><span class="required-mark" aria-hidden="true">*</span></label>
              <textarea id="contact-project" name="project" rows="5" required data-contact-placeholder="projectPlaceholder" placeholder="Tell us about your goals, needs, and any useful details." aria-describedby="contact-project-error"></textarea>
              <span class="field-error" id="contact-project-error" data-error-for="project" aria-live="polite"></span>
            </div>
            <div class="contact-field contact-field--wide consent-field">
              <label class="consent-label" for="contact-consent">
                <input id="contact-consent" name="consent" type="checkbox" required aria-describedby="contact-consent-error" />
                <span data-contact-key="privacyConsent">I agree to share the information in this enquiry with RYZITE so it can respond to my request.</span>
              </label>
              <span class="field-error" id="contact-consent-error" data-error-for="consent" aria-live="polite"></span>
            </div>
          </div>
          <button class="contact-button contact-button--submit" type="submit" data-form-submit><span data-contact-key="submit" data-submit-label>Submit Enquiry & Open WhatsApp</span><span aria-hidden="true">↗</span></button>
          <p class="form-privacy" data-contact-key="formGuidance" data-form-guidance>When you submit, your enquiry is sent to RYZITE through the Web3Forms form service. Once that is confirmed, WhatsApp opens with your enquiry details ready. The WhatsApp message is only sent if you press Send.</p>
          <p class="form-status form-status--error" data-form-error role="alert"></p>
          <div class="form-result" data-form-result role="status" aria-live="polite" tabindex="-1" hidden>
            <p class="form-result__title"><span aria-hidden="true">✓</span> <span data-contact-key="successTitle">Your enquiry was submitted successfully.</span></p>
            <p data-contact-key="successBody">Your enquiry has been submitted to RYZITE through Web3Forms. The WhatsApp message is separate and has not been sent automatically.</p>
            <p data-whatsapp-note></p>
            <div class="form-result__actions">
              <a class="contact-button contact-button--whatsapp" data-whatsapp-link href={`https://wa.me/${company.whatsapp.number}`} target="_blank" rel="noopener noreferrer"><span data-contact-key="openWhatsapp">Open WhatsApp</span><span aria-hidden="true">↗</span></a>
              <button class="form-result__reset" type="button" data-form-reset data-contact-key="sendAnother">Send another enquiry</button>
            </div>
          </div>
        </form>
      </div>
    </section>

    <section class="contact-section contact-services" aria-labelledby="contact-services-title">
      <div class="contact-shell">
        <header class="contact-section-heading contact-section-heading--center" data-contact-reveal>
          <p class="contact-eyebrow" data-contact-key="heroTagline">One Agency. All Your Business Solutions.</p>
          <h2 id="contact-services-title" data-contact-key="servicesTitle">Find the Right Solution for Your Business.</h2>
          <p data-contact-key="servicesIntro">Explore the two areas where RYZITE can support your business.</p>
        </header>
        <div class="service-choice-grid">
          <article class="service-choice-card" data-contact-reveal>
            <span class="service-choice-card__mark" aria-hidden="true">01</span>
            <span class="service-choice-card__icon" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="M7 21h8l20-9v24l-20-9H7v-6Zm8 6 4 12h8l-6-15m14-10 7-5m-7 23 7 5"/></svg></span>
            <h3 data-contact-key="marketingGroup">Marketing Services</h3>
            <p data-contact-key="marketingDescription">Looking to attract more customers, strengthen your brand, or improve online visibility? Explore our marketing services.</p>
            <a href="/services/#services" class="service-choice-card__link"><span data-contact-key="exploreMarketing">Explore Marketing Services</span><span aria-hidden="true">↗</span></a>
          </article>
          <article class="service-choice-card service-choice-card--technology" data-contact-reveal>
            <span class="service-choice-card__mark" aria-hidden="true">02</span>
            <span class="service-choice-card__icon" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><rect x="5" y="8" width="38" height="27" rx="3"/><path d="M17 42h14m-7-7v7M16 18l-5 4 5 4m16-8 5 4-5 4m-5-7-4 6"/></svg></span>
            <h3 data-contact-key="technologyGroup">Technology Solutions</h3>
            <p data-contact-key="technologyDescription">Need a website, e-commerce platform, mobile application, custom software, or automation solution? Explore our technology solutions.</p>
            <a href="/solutions/#solutions" class="service-choice-card__link"><span data-contact-key="exploreTechnology">Explore Technology Solutions</span><span aria-hidden="true">↗</span></a>
          </article>
        </div>
      </div>
    </section>

    <section class="contact-section contact-faq" aria-labelledby="contact-faq-title">
      <div class="contact-shell faq-layout">
        <header class="faq-heading" data-contact-reveal>
          <p class="contact-eyebrow" data-contact-key="faqEyebrow">FREQUENTLY ASKED QUESTIONS</p>
          <h2 id="contact-faq-title" data-contact-key="faqTitle">Questions Before Getting Started?</h2>
        </header>
        <div class="faq-list" data-contact-reveal>
          <details class="faq-item"><summary data-contact-key="faqQuestionOne">How do I start a project with RYZITE?</summary><div class="faq-answer"><p data-contact-key="faqAnswerOne">Share your project details in the enquiry form. It prepares an email in your email app for you to review and send. Your enquiry is not delivered until you send that email.</p></div></details>
          <details class="faq-item"><summary data-contact-key="faqQuestionTwo">Can I request multiple services?</summary><div class="faq-answer"><p data-contact-key="faqAnswerTwo">Yes. Choose one service in the form if helpful, then list any other services you’re considering in the project description.</p></div></details>
          <details class="faq-item"><summary data-contact-key="faqQuestionThree">Can RYZITE help me choose a suitable solution?</summary><div class="faq-answer"><p data-contact-key="faqAnswerThree">Yes. Select the option asking for help choosing and describe your business goals and needs so we can discuss suitable options.</p></div></details>
          <details class="faq-item"><summary data-contact-key="faqQuestionFour">How much does a project cost?</summary><div class="faq-answer"><p data-contact-key="faqAnswerFour">Pricing depends on the project details. No prices are listed on this page; use the enquiry form to describe your needs and ask for pricing information.</p></div></details>
          <details class="faq-item"><summary data-contact-key="faqQuestionFive">Can I discuss my project before choosing a package?</summary><div class="faq-answer"><p data-contact-key="faqAnswerFive">Yes. Describe your requirements in the form and let us know you would like to discuss the project before deciding on a package.</p></div></details>
        </div>
      </div>
    </section>

    <section class="contact-closing" aria-labelledby="contact-closing-title">
      <div class="contact-closing__orb contact-closing__orb--one" aria-hidden="true"></div>
      <div class="contact-closing__orb contact-closing__orb--two" aria-hidden="true"></div>
      <div class="contact-closing__inner" data-contact-reveal>
        <p class="contact-eyebrow" data-contact-key="closingEyebrow">LET’S WORK TOGETHER</p>
        <h2 id="contact-closing-title" data-contact-key="closingTitle">Your Next Big Idea Starts Here.</h2>
        <p data-contact-key="closingDescription">Let’s explore how technology, creativity, and digital strategy can help move your business forward.</p>
        <a class="contact-button contact-button--light" href="#project-enquiry"><span data-contact-key="closingCta">Start a Conversation</span><span aria-hidden="true">↓</span></a>
      </div>
      <span class="contact-closing__wordmark" aria-hidden="true">RYZITE</span>
    </section>
  </div>
</MainLayout>

<script is:inline define:vars={{ contactTranslations, enquiryConfig }}>
  let contactLocale = document.body.dataset.locale || 'en';
  const applyContactLocale = (locale) => {
    const translations = contactTranslations[locale] || contactTranslations.en;
    contactLocale = locale in contactTranslations ? locale : 'en';
    document.querySelectorAll('[data-contact-key]').forEach((element) => {
      const value = translations[element.dataset.contactKey];
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('[data-contact-placeholder]').forEach((element) => {
      const value = translations[element.dataset.contactPlaceholder];
      if (typeof value === 'string') element.setAttribute('placeholder', value);
    });
    document.querySelectorAll('[data-contact-group]').forEach((element) => {
      const value = translations[element.dataset.contactGroup];
      if (typeof value === 'string') element.label = value;
    });
    document.querySelectorAll('[data-service-title]').forEach((element) => {
      const value = translations.serviceOptions[element.dataset.serviceTitle];
      if (typeof value === 'string') element.textContent = value;
    });
    document.querySelectorAll('[data-error-for]').forEach((error) => {
      if (!error.textContent) return;
      const field = document.querySelector(`[name="${error.dataset.errorFor}"]`);
      if (!field) return;
      const messageKey = field.name === 'email' && field.validity.typeMismatch ? 'emailError' : 'requiredError';
      error.textContent = translations[messageKey];
      field.setCustomValidity(translations[messageKey]);
    });
    const description = document.querySelector('meta[name="description"]');
    if (description) description.setAttribute('content', translations.metaDescription);
    const openGraphTitle = document.querySelector('meta[property="og:title"]');
    if (openGraphTitle) openGraphTitle.setAttribute('content', translations.pageTitle);
    const openGraphDescription = document.querySelector('meta[property="og:description"]');
    if (openGraphDescription) openGraphDescription.setAttribute('content', translations.metaDescription);
  };

  applyContactLocale(contactLocale);
  window.addEventListener('ryzite:locale-change', (event) => applyContactLocale(event.detail?.locale || 'en'));

  const form = document.querySelector('[data-contact-form]');
  if (form) {
    const submitButton = form.querySelector('[data-form-submit]');
    const submitLabel = form.querySelector('[data-submit-label]');
    const guidance = form.querySelector('[data-form-guidance]');
    const errorStatus = form.querySelector('[data-form-error]');
    const result = form.querySelector('[data-form-result]');
    const whatsappLink = form.querySelector('[data-whatsapp-link]');
    const whatsappNote = form.querySelector('[data-whatsapp-note]');
    const resetButton = form.querySelector('[data-form-reset]');
    const currentTranslations = () => contactTranslations[contactLocale] || contactTranslations.en;
    // Text set through a key stays in sync when the visitor switches language.
    const setKeyedText = (element, key) => {
      if (!element) return;
      if (key) {
        element.dataset.contactKey = key;
        element.textContent = currentTranslations()[key] || '';
      } else {
        delete element.dataset.contactKey;
        element.textContent = '';
      }
    };
    form.addEventListener('invalid', (event) => {
      const field = event.target;
      const key = field.name === 'email' && field.validity.typeMismatch ? 'emailError' : 'requiredError';
      const translations = contactTranslations[contactLocale] || contactTranslations.en;
      const message = translations[key];
      const error = form.querySelector(`[data-error-for="${field.name}"]`);
      field.setCustomValidity(message);
      field.setAttribute('aria-invalid', 'true');
      if (error) error.textContent = message;
    }, true);

    form.addEventListener('input', (event) => {
      const field = event.target;
      field.setCustomValidity('');
      if (field.validity.valid) {
        field.removeAttribute('aria-invalid');
        const error = form.querySelector(`[data-error-for="${field.name}"]`);
        if (error) error.textContent = '';
      }
    });

    form.addEventListener('change', (event) => {
      const field = event.target;
      field.setCustomValidity('');
      if (field.validity.valid) {
        field.removeAttribute('aria-invalid');
        const error = form.querySelector(`[data-error-for="${field.name}"]`);
        if (error) error.textContent = '';
      }
    });

    const query = new URLSearchParams(window.location.search);
    const serviceField = form.querySelector('[name="service"]');
    const requestedService = (query.get('service') || '').trim().toLowerCase();
    const serviceAliases = { web: 'business-website-design-and-development', website: 'business-website-design-and-development' };
    const serviceValue = serviceAliases[requestedService] || requestedService;
    if ([...serviceField.options].some((option) => option.value === serviceValue && option.value)) {
      serviceField.value = serviceValue;
    }

    const requestedPackage = (query.get('package') || '').trim();
    const packageField = form.querySelector('[name="package"]');
    if ([...packageField.options].some((option) => option.value === requestedPackage && option.value)) {
      packageField.value = requestedPackage;
    }

    const hearField = form.querySelector('[name="hearAbout"]');
    const clean = (value) => String(value || '').trim();

    // Enquiry details are sent in English so the RYZITE team reads the same labels whatever language the visitor used.
    const collectEnquiry = () => {
      const data = new FormData(form);
      const serviceOption = serviceField.selectedOptions[0];
      const packageOption = packageField.selectedOptions[0];
      return {
        name: clean(data.get('name')),
        business: clean(data.get('business')),
        email: clean(data.get('email')),
        phone: clean(data.get('phone')),
        service: serviceField.value ? clean(serviceOption?.dataset.serviceTitle || serviceOption?.textContent) : '',
        package: packageField.value ? clean(packageOption?.dataset.english || packageOption?.textContent) : '',
        budget: clean(data.get('budget')),
        startDate: clean(data.get('startDate')),
        project: clean(data.get('project')),
        hearAbout: clean(hearField?.value),
      };
    };

    const buildPayload = (enquiry) => {
      const payload = {
        access_key: enquiryConfig.accessKey,
        subject: enquiryConfig.subject,
        from_name: enquiryConfig.fromName,
        name: enquiry.name,
        email: enquiry.email,
        message: enquiry.project,
        'Privacy Consent': 'Agreed',
        'Site Language': contactLocale,
      };
      const optional = [
        ['Business / Company', enquiry.business],
        ['Phone / WhatsApp', enquiry.phone],
        ['Service Interested In', enquiry.service],
        ['Preferred Package', enquiry.package],
        ['Estimated Budget', enquiry.budget],
        ['Preferred Start Date', enquiry.startDate],
        ['How did you hear about us?', enquiry.hearAbout],
      ];
      optional.forEach(([label, value]) => { if (value) payload[label] = value; });
      if (form.elements.botcheck?.checked) payload.botcheck = true;
      return payload;
    };

    const buildWhatsappUrl = (enquiry) => {
      const line = (label, value) => `${label}: ${value || 'Not provided'}`;
      const message = [
        '*NEW PROJECT ENQUIRY – RYZITE*',
        '',
        '*Customer Details*',
        line('Full Name', enquiry.name),
        line('Business / Company', enquiry.business),
        line('Email', enquiry.email),
        line('Phone / WhatsApp', enquiry.phone),
        '',
        '*Project Details*',
        line('Service Interested In', enquiry.service),
        line('Preferred Package', enquiry.package),
        line('Estimated Budget', enquiry.budget),
        line('Preferred Start Date', enquiry.startDate),
        line('Project Description', enquiry.project),
        line('How did you hear about us?', enquiry.hearAbout),
      ].join('\n');
      return `https://wa.me/${enquiryConfig.whatsappNumber}?text=${encodeURIComponent(message)}`;
    };

    // Only a 2xx response whose body says success: true counts as a submitted enquiry.
    const sendEnquiry = async (payload) => {
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 20000);
      try {
        const response = await fetch(enquiryConfig.endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });
        const body = await response.json().catch(() => null);
        return response.ok && body?.success === true;
      } catch {
        return false;
      } finally {
        window.clearTimeout(timeout);
      }
    };

    // idle -> submitting -> submitted. Anything other than idle ignores further submits, so one enquiry is sent once.
    let submitState = 'idle';
    const setSubmitting = (active) => {
      if (submitButton) {
        submitButton.disabled = active;
        submitButton.setAttribute('aria-busy', String(active));
      }
      setKeyedText(submitLabel, active ? 'submitting' : 'submit');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitState !== 'idle') return;

      const translations = currentTranslations();
      const emptyRequiredField = [...form.querySelectorAll('[required]')].find((field) => {
        if (field.type === 'checkbox') return !field.checked;
        return !field.value.trim();
      });
      if (emptyRequiredField) {
        emptyRequiredField.setCustomValidity(translations.requiredError);
        emptyRequiredField.reportValidity();
        return;
      }
      if (!form.reportValidity()) return;

      submitState = 'submitting';
      setKeyedText(errorStatus, '');
      setSubmitting(true);

      const enquiry = collectEnquiry();
      const submitted = await sendEnquiry(buildPayload(enquiry));

      if (!submitted) {
        submitState = 'idle';
        setSubmitting(false);
        setKeyedText(errorStatus, 'submitError');
        return;
      }

      submitState = 'submitted';
      setSubmitting(false);
      const whatsappUrl = buildWhatsappUrl(enquiry);
      if (whatsappLink) whatsappLink.href = whatsappUrl;
      // Browsers may block a window opened after the network wait; the visible link covers that case.
      let whatsappWindow = null;
      try {
        whatsappWindow = window.open(whatsappUrl, '_blank');
        if (whatsappWindow) whatsappWindow.opener = null;
      } catch {
        // Losing the opener reference is fine; the window either opened or the link is offered.
      }
      setKeyedText(whatsappNote, whatsappWindow ? 'whatsappOpened' : 'whatsappBlocked');
      if (submitButton) submitButton.hidden = true;
      if (guidance) guidance.hidden = true;
      if (result) {
        result.hidden = false;
        result.focus({ preventScroll: true });
        result.scrollIntoView({ block: 'nearest' });
      }
    });

    resetButton?.addEventListener('click', () => {
      form.reset();
      submitState = 'idle';
      if (result) result.hidden = true;
      if (whatsappLink) whatsappLink.href = `https://wa.me/${enquiryConfig.whatsappNumber}`;
      setKeyedText(whatsappNote, '');
      setKeyedText(errorStatus, '');
      if (guidance) guidance.hidden = false;
      if (submitButton) submitButton.hidden = false;
      setSubmitting(false);
      form.querySelector('[name="name"]')?.focus();
    });
  }

  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!motionPreference.matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        currentObserver.unobserve(entry.target);
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('[data-contact-reveal]').forEach((element) => {
      element.classList.add('contact-reveal-pending');
      observer.observe(element);
    });
  }
</script>

